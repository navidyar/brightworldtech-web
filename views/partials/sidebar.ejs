<%
  const accessibleDashboards =
    Array.isArray(dashboardDefinitions)
      ? dashboardDefinitions.filter((dashboard) => canAccessDashboard(dashboard.key))
      : [];

  const dashboardHref =
    accessibleDashboards.length === 1
      ? `/dashboards/${accessibleDashboards[0].key}`
      : '/';

  const dashboardSectionActive =
    currentNav === 'dashboard' || String(currentNav || '').startsWith('dashboard:');
  const adminConfigurationNavKeys = [
    'admin-config-values',
    'admin-config-processor-families',
    'admin-config-processors',
    'admin-config-models',
    'admin-config-database'
  ];
  const adminSectionActive = adminConfigurationNavKeys.includes(currentNav) || ['management', 'management-qc-reporting', 'management-printers'].includes(currentNav);
  const managementSectionActive = ['management-login-activity', 'management-lots', 'management-label-library', 'management-virtual-huddle'].includes(currentNav);
  const sidebarRoleCodes = typeof currentRoles !== 'undefined' && Array.isArray(currentRoles) ? currentRoles : [];
  const isQcOnlyNavigationUser = sidebarRoleCodes.includes('qc')
    && !sidebarRoleCodes.some((roleCode) => ['admin', 'management', 'tech_lead', 'tech'].includes(roleCode));
  const qcSectionActive = currentNav === 'qc-review' || (isQcOnlyNavigationUser && currentNav === 'unit-requests');
  const techSectionActive = ['tech-units', 'tech-printers', 'unit-requests'].includes(currentNav);
%>

<aside class="sidebar" id="app-sidebar" aria-label="Primary navigation">
  <div class="sidebar-brand">
    <button
      type="button"
      class="sidebar-pin-button"
      data-sidebar-pin
      aria-pressed="false"
      title="Pin sidebar"
    >Pin</button>

    <a href="/" class="brand-card">
      <div class="brand-mark">BWT</div>
      <div>
        <p>Bright World</p>
        <strong>Technologies</strong>
      </div>
    </a>
  </div>

  <nav class="sidebar-nav">
    <% if (accessibleDashboards.length > 1) { %>
      <section class="sidebar-section <%= dashboardSectionActive ? 'is-active' : '' %>">
        <div class="sidebar-section-heading <%= dashboardSectionActive ? 'is-active' : '' %>">
          <span class="sidebar-icon" aria-hidden="true">⌂</span>
          <span>Dashboard</span>
        </div>

        <div class="sidebar-subnav">
          <% accessibleDashboards.forEach((dashboard) => { %>
            <a href="/dashboards/<%= dashboard.key %>" class="sidebar-sublink <%= currentNav === `dashboard:${dashboard.key}` ? 'active' : '' %>" <%= currentNav === `dashboard:${dashboard.key}` ? 'aria-current="page"' : '' %>>
              <span><%= dashboard.menuLabel || dashboard.title %></span>
            </a>
          <% }) %>
        </div>
      </section>
    <% } else { %>
      <a href="<%= dashboardHref %>" class="sidebar-link <%= dashboardSectionActive ? 'active' : '' %>" <%= dashboardSectionActive ? 'aria-current="page"' : '' %>>
        <span class="sidebar-icon" aria-hidden="true">⌂</span>
        <span>Dashboard</span>
      </a>
    <% } %>

    <a href="/my-huddles" class="sidebar-link <%= currentNav === 'my-huddles' ? 'active' : '' %>" <%= currentNav === 'my-huddles' ? 'aria-current="page"' : '' %>>
      <span class="sidebar-icon" aria-hidden="true">✉</span>
      <span>My Huddles</span>
    </a>

    <% if (canAccessMenuArea('admin')) { %>
      <section class="sidebar-section <%= adminSectionActive ? 'is-active' : '' %>">
        <div class="sidebar-section-heading <%= adminSectionActive ? 'is-active' : '' %>">
          <span class="sidebar-icon" aria-hidden="true">✦</span>
          <span>Admin</span>
        </div>

        <div class="sidebar-subnav">
          <a href="/management/config" class="sidebar-sublink <%= adminConfigurationNavKeys.includes(currentNav) ? 'active' : '' %>" <%= currentNav === 'admin-config-values' ? 'aria-current="page"' : '' %>>
            <span>Configuration</span>
          </a>

          <% if (typeof canAccessFeature === 'function' && canAccessFeature('userAdministration')) { %>
            <a href="/management/users" class="sidebar-sublink <%= currentNav === 'management' ? 'active' : '' %>" <%= currentNav === 'management' ? 'aria-current="page"' : '' %>>
              <span>Users</span>
            </a>
          <% } %>

          <% if (typeof canAccessFeature === 'function' && canAccessFeature('qcReporting')) { %>
            <a href="/management/qc-reporting" class="sidebar-sublink <%= currentNav === 'management-qc-reporting' ? 'active' : '' %>" <%= currentNav === 'management-qc-reporting' ? 'aria-current="page"' : '' %>>
              <span>QC Reporting</span>
            </a>
          <% } %>

          <% if (typeof canAccessFeature === 'function' && canAccessFeature('managedPrinters')) { %>
            <a href="/management/printers" class="sidebar-sublink <%= currentNav === 'management-printers' ? 'active' : '' %>" <%= currentNav === 'management-printers' ? 'aria-current="page"' : '' %>>
              <span>Printer Management</span>
            </a>
          <% } %>
        </div>
      </section>
    <% } %>

    <% if (canAccessMenuArea('management')) { %>
      <section class="sidebar-section <%= managementSectionActive ? 'is-active' : '' %>">
        <div class="sidebar-section-heading <%= managementSectionActive ? 'is-active' : '' %>">
          <span class="sidebar-icon" aria-hidden="true">◎</span>
          <span>Management</span>
        </div>

        <div class="sidebar-subnav">
          <a href="/management/virtual-huddle" class="sidebar-sublink <%= currentNav === 'management-virtual-huddle' ? 'active' : '' %>" <%= currentNav === 'management-virtual-huddle' ? 'aria-current="page"' : '' %>>
            <span>Virtual Huddle</span>
          </a>

          <a href="/management/lots" class="sidebar-sublink <%= currentNav === 'management-lots' ? 'active' : '' %>" <%= currentNav === 'management-lots' ? 'aria-current="page"' : '' %>>
            <span>Lots</span>
          </a>

          <a href="/management/login-activity" class="sidebar-sublink <%= currentNav === 'management-login-activity' ? 'active' : '' %>" <%= currentNav === 'management-login-activity' ? 'aria-current="page"' : '' %>>
            <span>Login Activity</span>
          </a>

          <a href="/management/label-library" class="sidebar-sublink <%= currentNav === 'management-label-library' ? 'active' : '' %>" <%= currentNav === 'management-label-library' ? 'aria-current="page"' : '' %>>
            <span>Label Library</span>
          </a>
        </div>
      </section>
    <% } %>

    <% if (canAccessMenuArea('qc')) { %>
      <section class="sidebar-section <%= qcSectionActive ? 'is-active' : '' %>">
        <div class="sidebar-section-heading <%= qcSectionActive ? 'is-active' : '' %>">
          <span class="sidebar-icon" aria-hidden="true">✓</span>
          <span>QC Portal</span>
        </div>

        <div class="sidebar-subnav">
          <a href="/qc/review" class="sidebar-sublink <%= currentNav === 'qc-review' ? 'active' : '' %>" <%= currentNav === 'qc-review' ? 'aria-current="page"' : '' %>>
            <span>QC Review</span>
          </a>

          <% if (isQcOnlyNavigationUser && typeof canAccessUnitRequests === 'function' && canAccessUnitRequests()) { %>
            <a href="/unit-requests" class="sidebar-sublink <%= currentNav === 'unit-requests' ? 'active' : '' %>" <%= currentNav === 'unit-requests' ? 'aria-current="page"' : '' %>>
              <span>Requests</span>
            </a>
          <% } %>

        </div>
      </section>
    <% } %>

    <% if (canAccessMenuArea('tech') && !isQcOnlyNavigationUser) { %>
      <section class="sidebar-section <%= techSectionActive ? 'is-active' : '' %>">
        <div class="sidebar-section-heading <%= techSectionActive ? 'is-active' : '' %>">
          <span class="sidebar-icon" aria-hidden="true">▣</span>
          <span>Tech</span>
        </div>

        <div class="sidebar-subnav">
          <a href="/tech/units" class="sidebar-sublink <%= currentNav === 'tech-units' ? 'active' : '' %>" <%= currentNav === 'tech-units' ? 'aria-current="page"' : '' %>>
            <span>Units</span>
          </a>
          <a href="/tech/printers" class="sidebar-sublink <%= currentNav === 'tech-printers' ? 'active' : '' %>" <%= currentNav === 'tech-printers' ? 'aria-current="page"' : '' %>>
            <span>My Printers</span>
          </a>
          <% if (typeof canAccessUnitRequests === 'function' && canAccessUnitRequests()) { %>
            <a href="/unit-requests" class="sidebar-sublink <%= currentNav === 'unit-requests' ? 'active' : '' %>" <%= currentNav === 'unit-requests' ? 'aria-current="page"' : '' %>>
              <span>Requests</span>
            </a>
          <% } %>
        </div>
      </section>
    <% } %>

    <% if (canAccessMenuArea('warehouse')) { %>
      <section class="sidebar-section">
        <div class="sidebar-section-heading">
          <span class="sidebar-icon" aria-hidden="true">◇</span>
          <span>Warehouse</span>
        </div>

        <div class="sidebar-subnav">
          <span class="sidebar-sublink sidebar-sublink-muted">Warehouse tools planned</span>
        </div>
      </section>
    <% } %>

    <% if (canAccessMenuArea('sales')) { %>
      <section class="sidebar-section">
        <div class="sidebar-section-heading">
          <span class="sidebar-icon" aria-hidden="true">◈</span>
          <span>Sales</span>
        </div>

        <div class="sidebar-subnav">
          <span class="sidebar-sublink sidebar-sublink-muted">Sales tools planned</span>
        </div>
      </section>
    <% } %>

  </nav>
</aside>

<button type="button" class="sidebar-backdrop" data-sidebar-backdrop aria-label="Close navigation" hidden></button>
