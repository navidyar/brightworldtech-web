<label class="form-field">
  <span>Allow Manual Create/Update</span>
  <select name="allowManualCreateUpdate">
    <option value="inherit" <%= formData.allowManualCreateUpdate === 'inherit' ? 'selected' : '' %>>Inherit (default: On)</option>
    <option value="1" <%= formData.allowManualCreateUpdate === '1' ? 'selected' : '' %>>On</option>
    <option value="0" <%= formData.allowManualCreateUpdate === '0' ? 'selected' : '' %>>Off</option>
  </select>
</label>

<label class="form-field">
  <span>Allow ScanTools</span>
  <select name="allowScanTools">
    <option value="inherit" <%= formData.allowScanTools === 'inherit' ? 'selected' : '' %>>Inherit (default: On)</option>
    <option value="1" <%= formData.allowScanTools === '1' ? 'selected' : '' %>>On</option>
    <option value="0" <%= formData.allowScanTools === '0' ? 'selected' : '' %>>Off</option>
