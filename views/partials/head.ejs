<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= pageTitle ? `${pageTitle} | BWTDallas App` : 'BWTDallas App' %></title>

  
  <link rel="icon" href="/favicon.svg?v=20260716-refined-b-v7-final" type="image/svg+xml" sizes="any" />
  <link rel="icon" href="/favicon-16x16.png?v=20260716-refined-b-v7-final" type="image/png" sizes="16x16" />
  <link rel="icon" href="/favicon-32x32.png?v=20260716-refined-b-v7-final" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-48x48.png?v=20260716-refined-b-v7-final" type="image/png" sizes="48x48" />
  <link rel="shortcut icon" href="/favicon.ico?v=20260716-refined-b-v7-final" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20260716-refined-b-v7-final" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest?v=20260716-refined-b-v7-final" />
  <meta name="theme-color" content="#C1E405" />
<script>
    (function () {
      const storageKey = 'bwtdallas-theme';
      const savedTheme = localStorage.getItem(storageKey);

      let theme = 'hybrid';

      if (savedTheme === 'light' || savedTheme === 'hybrid') {
        theme = savedTheme;
      }

      if (savedTheme === 'dark' || savedTheme === 'dim') {
        theme = 'hybrid';
        localStorage.setItem(storageKey, theme);
      }

      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.style.colorScheme = theme === 'light' ? 'light' : 'light';
    })();
  </script>
  <script>
    (function () {
      try {
        if (localStorage.getItem('bwtdallas-sidebar-pinned') === 'true') {
          document.documentElement.setAttribute('data-sidebar-pinned', 'true');
        }
      } catch (error) {
        // localStorage can be unavailable in restricted browser contexts.
      }
    })();
  </script>

  <script src="/js/time-zone-context.js?v=20260930-global-timezone-foundation"></script>

  <!-- Authoritative BWTDallas CSS contract. New UI must reuse these three files. -->
  <link rel="stylesheet" href="/css/theme.css?v=20261002-dashboard-palette-r1" />

  <link rel="stylesheet" href="/css/app.css?v=20261002-global-weight-650" />
  <link rel="stylesheet" href="/css/features.css?v=20260930-modal-sidebar-viewport-lock" />

  <script src="/js/form-history-policy.js?v=20260820-stage10w69d-no-form-history"></script>
  <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
    <script
      src="/js/navigation-policy.js?v=20260820-stage10w69l-request-modal-exemption"
      data-session-expires-at="<%= typeof sessionExpiresAt === 'number' ? sessionExpiresAt : '' %>"
    ></script>
  <% } %>
  <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
    <script defer src="/js/application-live-refresh.js?v=20261002-account-modal-refresh-guard"></script>
    <script defer src="/js/virtual-huddle.js?v=20260923-preserve-work-notice-delivery"></script>
    <script defer src="/js/account-tool-pin.js?v=20261002-tool-pin-self-service-r1"></script>
  <% } %>
  <script defer src="/js/theme.js"></script>
  <script defer src="/js/sidebar.js?v=20261002-phone-hamburger-r6"></script>
  <script defer src="/js/date-picker-only.js?v=20260925-date-picker-viewport-clamp"></script>
  <script defer src="/js/hierarchical-lot-select.js?v=20260819-stage10w68y-mouse-focus-continuity"></script>
  <script defer src="/js/search-clear-controls.js?v=20260828-stage10w74q-sitewide-search-clear"></script>
  <script defer src="/js/auto-submit-filters.js?v=20260918-fragment-preserve-focus"></script>
  <script defer src="/js/live-list-filter.js?v=20261001-permission-expand-collapse"></script>
  <script defer src="/js/success-confirmations.js?v=20260918-success-confirmations"></script>
  <script defer src="/js/management-reporting-controls.js?v=20261002-tech-auto-submit"></script>
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js" integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V" crossorigin="anonymous"></script>
</head>
