<%
  const canViewConfiguration = typeof hasPermission === 'function' && hasPermission('configuration.view');
  const configurationItems = [
    {
      key: 'admin-config-values',
      label: 'Config Values',
      href: '/management/config',
      allowed: canViewConfiguration
    },
    {
      key: 'admin-config-processor-families',
      label: 'Processor Families',
      href: '/management/config/processor-families',
      allowed: canViewConfiguration && hasPermission('configuration.processor_families.manage')
    },
    {
      key: 'admin-config-processors',
      label: 'Processor Catalog',
      href: '/management/config/processors',
      allowed: canViewConfiguration && hasPermission('configuration.processors.manage')
    },
    {
      key: 'admin-config-models',
      label: 'Model Catalog',
      href: '/management/config/models',
      allowed: canViewConfiguration && hasPermission('configuration.models.manage')
    },
    {
      key: 'admin-config-printing',
      label: 'Printing',
      href: '/management/config/printing',
      allowed: canViewConfiguration && hasPermission('configuration.printing.manage')
    },
    {
      key: 'admin-config-database',
      label: 'Database Check',
      href: '/management/config/database',
      allowed: canViewConfiguration && hasPermission('configuration.database.view')
    }
  ];
%>

<nav class="configuration-nav" aria-label="Admin configuration sections">
  <% configurationItems.filter((item) => item.allowed).forEach((item) => { %>
    <a
      class="configuration-nav-link <%= currentNav === item.key ? 'active' : '' %>"
      href="<%= item.href %>"
      <%= currentNav === item.key ? 'aria-current="page"' : '' %>
    >
      <%= item.label %>
    </a>
  <% }) %>
</nav>
