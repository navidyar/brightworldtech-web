<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { pageTitle }) %>
  <script defer src="/js/copy-link.js?v=20260811-stage10w32"></script>

  <body class="css-scope-copy-link">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell">
          <section class="page-heading site-work-page-heading">
            <div>
              <p class="eyebrow">User Administration</p>
              <h1><%= setupLink.linkLabel %> Created</h1>
              <p>Copy this one-time URL before leaving the page. The full token is only shown here immediately after generation.</p>
            </div>
            <div class="site-clean-actions site-inline-actions"><a class="secondary-button" href="/management/users">Back to Users</a></div>
          </section>

          <section class="site-summary-panel site-summary-panel--expanded" aria-label="Generated link summary">
            <div class="site-summary-primary" data-generated-link-expiry data-expires-at="<%= new Date(setupLink.expiresAt).toISOString() %>" data-expiry-display="<%= formatDateTime(setupLink.expiresAt) %>">
              <span data-generated-link-expiry-label>Expires</span>
              <strong data-generated-link-expiry-time><%= formatDateTime(setupLink.expiresAt) %></strong>
              <small><%= setupLink.expiresInHours %> hour<%= Number(setupLink.expiresInHours) === 1 ? '' : 's' %> after generation</small>
            </div>
            <div class="site-summary-stats">
              <article><span class="site-summary-icon" aria-hidden="true">U</span><span><small>User</small><strong><%= user.first_name %> <%= user.last_name %></strong></span></article>
              <article><span class="site-summary-icon" aria-hidden="true">#</span><span><small>BWT Username</small><strong><%= user.username %></strong></span></article>
              <article><span class="site-summary-icon" aria-hidden="true">→</span><span><small>Action</small><strong><%= setupLink.actionLabel %></strong></span></article>
            </div>
          </section>

          <section class="content-card">
            <div class="content-header">
              <div>
                <p class="eyebrow">User</p>
                <h2><%= user.first_name %> <%= user.last_name %></h2>
              </div>

            </div>

            <div class="copy-link-user-card">
              <div>
                <span>Name / BWT Username</span>
                <strong><%= user.first_name %> <%= user.last_name %> · <%= user.username %></strong>
              </div>

              <div>
                <span>Email</span>
                <strong><%= user.email %></strong>
              </div>

              <div>
                <span>Link Type</span>
                <strong><%= setupLink.linkLabel %></strong>
              </div>

              <div>
                <span>Action</span>
                <strong><%= setupLink.actionLabel %></strong>
              </div>
            </div>
          </section>

          <section class="content-card">
            <div class="content-header">
              <div>
                <p class="eyebrow">Copy Link</p>
                <h2>One-Time Password URL</h2>
              </div>
            </div>

            <div class="message success">
              <% if (setupLink.isResetLink) { %>
                A password reset link was created for this existing user.
              <% } else { %>
                An initial password setup link was created for this new or pending user.
              <% } %>
            </div>

            <div class="copy-url-panel">
              <label class="form-field">
                <span><%= setupLink.linkLabel %></span>
                <div class="copy-url-row">
                  <input
                    class="copy-url-input"
                    type="text"
                    value="<%= setupLink.setupUrl %>"
                    readonly
                    autocomplete="off"
                    spellcheck="false"
                    data-copy-url-input
                  />

                  <button
                    type="button"
                    class="copy-url-button"
                    data-copy-button
                    data-copy-text="<%= setupLink.setupUrl %>"
                  >
                    <span aria-hidden="true">⧉</span>
                    <span data-copy-button-label>Copy</span>
                  </button>
                </div>
              </label>

              <p class="copy-url-note" data-generated-link-expiry-note>
                This link expires at <strong><%= formatDateTime(setupLink.expiresAt) %></strong> (<%= setupLink.expiresInHours %> hour<%= Number(setupLink.expiresInHours) === 1 ? '' : 's' %> after generation).
                Generating another link for this same user revokes the previous unused link of the same type.
              </p>
            </div>
          </section>

          <section class="content-card">
            <div class="content-header">
              <div>
                <p class="eyebrow">Security Notes</p>
                <h2>How This Link Works</h2>
              </div>
            </div>

            <div class="workflow-list">
              <div class="workflow-item active">
                <span></span>
                <div>
                  <strong>One-time use</strong>
                  <p>
                    After the user creates or resets their password, this link is marked as used and cannot be reused.
                  </p>
                </div>
              </div>

              <div class="workflow-item slate">
                <span></span>
                <div>
                  <strong>Token is not stored directly</strong>
                  <p>
                    The database stores a hash of the token, not the raw URL token shown on this page.
                  </p>
                </div>
              </div>

              <div class="workflow-item warning">
                <span></span>
                <div>
                  <strong>Send carefully</strong>
                  <p>
                    Only share this link with the intended user through an approved internal communication method.
                  </p>
                </div>
              </div>
            </div>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>