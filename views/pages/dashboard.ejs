<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { pageTitle }) %>

  <body class="css-scope-admin-dashboard">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell">
          <section class="page-heading admin-dashboard-heading">
            <div>
              <p class="eyebrow">Operations Dashboard</p>
              <h1>Dashboard</h1>
              <p>Review the current operational snapshot and drill into the areas available to your account.</p>
            </div>
          </section>

          <%- include('../fragments/dashboard-live-region', { dashboardData, dashboardFilters, dashboardFilterOptions, dashboardFilterConfig, dashboardKey: null }) %>

          <section class="admin-dashboard-access" aria-labelledby="admin-dashboard-access-title">
            <div class="site-clean-section-heading">
              <div>
                <p class="eyebrow">Available Dashboards</p>
                <h2 id="admin-dashboard-access-title">Dashboard Access</h2>
              </div>
              <span class="admin-dashboard-access-count"><strong><%= formatNumber(dashboards.length) %></strong> available</span>
            </div>

            <% if (dashboards.length === 0) { %>
              <div class="message error"><p>No dashboards are currently available for your user account.</p></div>
            <% } else { %>
              <nav class="admin-dashboard-access-list" aria-label="Available dashboards">
                <% dashboards.forEach((dashboard) => { %>
                  <a href="/dashboards/<%= dashboard.key %>">
                    <span><strong><%= dashboard.title %></strong><small><%= dashboard.description %></small></span>
                    <span aria-hidden="true">→</span>
                  </a>
                <% }) %>
              </nav>
            <% } %>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>
