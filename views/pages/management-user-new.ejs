<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { pageTitle }) %>

  <body class="css-scope-management">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell site-work-page">
          <section class="page-heading site-work-page-heading">
            <div>
              <p class="eyebrow">User Administration</p>
              <h1>Create User</h1>
              <p>Create an application account, assign access roles, and optionally register a Tool PIN.</p>
            </div>
            <div class="site-clean-actions site-inline-actions"><a class="secondary-button" href="/management/users">Back to Users</a></div>
          </section>

          <section class="content-card">

            <% if (errorMessages.length > 0) { %>
              <div class="message error">
                <% errorMessages.forEach((errorMessage) => { %>
                  <p><%= errorMessage %></p>
                <% }) %>
              </div>
            <% } %>

            <form class="auth-form management-user-create-form" method="post" action="/management/users" autocomplete="off">
              <div class="form-grid">
                <label class="form-field">
                  <span>First Name</span>
                  <input type="text" name="firstName" value="<%= formData.firstName %>" autocomplete="off" required />
                </label>

                <label class="form-field">
                  <span>Last Name</span>
                  <input type="text" name="lastName" value="<%= formData.lastName %>" autocomplete="off" required />
                </label>
              </div>

              <p class="management-user-role-help">A BWT username is generated from the first two letters of the first and last name. For example, Natalie Garcia becomes NAGA; a duplicate becomes NAGA2. The username remains stable after account creation.</p>

              <div class="form-grid">
                <label class="form-field">
                  <span>Work / Login Email</span>
                  <input type="email" name="email" value="<%= formData.email %>" autocomplete="off" inputmode="email" spellcheck="false" required />
                </label>

                <label class="form-field">
                  <span>Personal Email (optional)</span>
                  <input type="email" name="personalEmail" maxlength="255" value="<%= formData.personalEmail || '' %>" autocomplete="off" inputmode="email" spellcheck="false" />
                </label>
              </div>

              <label class="form-field">
                <span>Phone (optional)</span>
                <input type="tel" name="phone" value="<%= formData.phone || '' %>" autocomplete="off" inputmode="tel" maxlength="50" />
              </label>

              <div class="form-grid">
                <label class="form-field">
                  <span>Start Date (optional)</span>
                  <input type="date" name="startDate" value="<%= formData.startDate || '' %>" />
                </label>

                <label class="form-field">
                  <span>End Date (optional)</span>
                  <input type="date" name="endDate" value="<%= formData.endDate || '' %>" />
                </label>
              </div>

              <label class="form-field">
                <span>Setup Link Expiration (hours)</span>
                <input
                  type="number"
                  name="setupLinkExpiryHours"
                  value="<%= formData.setupLinkExpiryHours || passwordLinkExpiryPolicy.defaultHours %>"
                  min="<%= passwordLinkExpiryPolicy.minHours %>"
                  max="<%= passwordLinkExpiryPolicy.maxHours %>"
                  step="1"
                  inputmode="numeric"
                  required
                />
                <small class="field-hint">Choose 1–8 hours before the initial setup link is generated. Default: 1 hour.</small>
              </label>

              <% if (canManageLoginInactivityOnCreate) { %>
                <label class="form-field">
                  <span>Login Inactivity Monitoring</span>
                  <select name="loginInactivityMode">
                    <option value="inherit" <%= (formData.loginInactivityMode || 'inherit') === 'inherit' ? 'selected' : '' %>>Inherit from assigned role(s)</option>
                    <option value="allow" <%= formData.loginInactivityMode === 'allow' ? 'selected' : '' %>>Monitor this user</option>
                    <option value="deny" <%= formData.loginInactivityMode === 'deny' ? 'selected' : '' %>>Do not monitor this user</option>
                  </select>
                  <small class="field-hint">Monitored active users are flagged after more than 5 business days without a login. Role defaults can be set through Roles &amp; Permissions.</small>
                </label>
              <% } %>

              <% if (canManageToolPinsOnCreate) { %>
              <div class="form-grid management-user-tool-pin-grid">
                <label class="form-field">
                  <span>Tool PIN (6–10 digits) (optional)</span>
                  <input type="password" name="toolPin" inputmode="numeric" pattern="[0-9]{6,10}" minlength="6" maxlength="10" autocomplete="new-password" />
                </label>
                <label class="form-field">
                  <span>Confirm Tool PIN</span>
                  <input type="password" name="confirmToolPin" inputmode="numeric" pattern="[0-9]{6,10}" minlength="6" maxlength="10" autocomplete="new-password" />
                </label>
              </div>
              <p class="management-user-role-help">The Tool PIN is separate from the account password and cannot be used to sign into the BWTDallas website. It becomes useful only for accounts authorized to use ScanTools/TechTools. Avoid repeated digits, 4+ digit sequences, and repeating or grouped patterns.</p>
              <% } %>

              <% if (canAssignRolesOnCreate) { %>
                <div>
                  <p class="eyebrow site-space-top-xs">Access Roles</p>
                  <p class="management-user-role-help">Select one or more roles. Approved default permissions from all selected roles combine for the user.</p>

                  <div class="workflow-list">
                    <% roles.forEach((role) => { %>
                      <label class="workflow-item <%= formData.roleCodes.includes(role.code) ? 'active' : '' %>">
                        <input
                          type="checkbox"
                          name="roleCodes"
                          value="<%= role.code %>"
                          <%= formData.roleCodes.includes(role.code) ? 'checked' : '' %>
                        />

                        <div>
                          <strong><%= role.name %></strong>
                          <p><%= role.description || role.code %></p>
                        </div>
                      </label>
                    <% }) %>
                  </div>
                </div>
              <% } else { %>
                <div class="message info"><p>This account will be created without roles. A user with Assign Roles permission can add roles later.</p></div>
              <% } %>

              <div class="action-row">
                <button type="submit" class="primary-button">Create User & Generate Setup Link</button>
                <a class="secondary-button" href="/management/users">Cancel</a>
              </div>
            </form>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>