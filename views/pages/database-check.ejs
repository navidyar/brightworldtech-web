<%
  const requiredTableCount = Array.isArray(status.schema.requiredTables) ? status.schema.requiredTables.length : 0;
  const requiredViewCount = Array.isArray(status.schema.requiredViews) ? status.schema.requiredViews.length : 0;
  const missingTableCount = Array.isArray(status.schema.missingTables) ? status.schema.missingTables.length : 0;
  const missingViewCount = Array.isArray(status.schema.missingViews) ? status.schema.missingViews.length : 0;
  const missingObjectCount = missingTableCount + missingViewCount;
%>
<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { pageTitle }) %>

  <body class="configuration-clean-page">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell configuration-page database-check-page">
          <%- include('../partials/configuration-nav', { currentNav }) %>

          <section class="page-heading configuration-page-heading">
            <div>
              <h1>Database Check</h1>
              <p>Review the live database connection, required schema objects, and selected table counts. This page is read-only.</p>
            </div>
          </section>

          <section class="site-summary-panel database-check-summary-panel" aria-label="Database health summary">
            <div class="site-summary-primary">
              <span>Database connection</span>
              <strong><%= status.database.connected ? 'Connected' : 'Unavailable' %></strong>
              <small>
                <% if (status.database.connected) { %>
                  <%= status.database.connectionInfo.database_name %> · <%= status.database.connectionInfo.mysql_version %>
                <% } else { %>
                  <%= status.database.error %>
                <% } %>
              </small>
            </div>

            <div class="site-summary-stats">
              <article>
                <span class="site-summary-icon" aria-hidden="true">T</span>
                <span><small>Tables found</small><strong><%= formatNumber(status.schema.tableCount || 0) %></strong></span>
              </article>
              <article>
                <span class="site-summary-icon" aria-hidden="true">V</span>
                <span><small>Views found</small><strong><%= formatNumber(status.schema.viewCount || 0) %></strong></span>
              </article>
              <article>
                <span class="site-summary-icon" aria-hidden="true"><%= status.schema.ok ? '✓' : '!' %></span>
                <span><small>Required objects</small><strong><%= status.schema.ok ? 'Complete' : `${formatNumber(missingObjectCount)} missing` %></strong></span>
              </article>
            </div>
          </section>

          <% if (!status.database.connected) { %>
            <div class="message error"><p><%= status.database.error %></p></div>
          <% } %>

          <section class="site-clean-section site-clean-surface database-summary-counts-section">
            <div class="site-clean-section-heading">
              <div>
                <h2>Summary Counts</h2>
                <p>Selected operational tables and their current row totals.</p>
              </div>
            </div>

            <div class="table-card database-summary-counts-table">
              <div class="table-scroll">
                <table>
                  <thead>
                    <tr>
                      <th>Table</th>
                      <th>Rows</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!status.schema.summaryCounts.length) { %>
                      <tr><td colspan="3">Summary counts are unavailable until the database connection succeeds.</td></tr>
                    <% } %>

                    <% status.schema.summaryCounts.forEach((table) => { %>
                      <tr>
                        <td><code><%= table.tableName %></code></td>
                        <td><%= table.rowCount === null ? '—' : formatNumber(table.rowCount) %></td>
                        <td><span class="pill <%= table.rowCount === null ? 'bad' : 'good' %>"><%= table.rowCount === null ? 'Missing' : 'Available' %></span></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <section class="site-clean-section site-clean-surface database-required-objects-section">
            <div class="site-clean-section-heading">
              <div>
                <h2>Required Schema Objects</h2>
                <p><%= formatNumber(requiredTableCount) %> required tables and <%= formatNumber(requiredViewCount) %> required views are checked against the active schema.</p>
              </div>
            </div>

            <div class="database-object-grid">
              <div>
                <h3>Required Tables</h3>
                <div class="table-card">
                  <div class="table-scroll">
                    <table>
                      <thead>
                        <tr>
                          <th>Table</th>
                          <th>Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (!status.schema.requiredTables.length) { %>
                          <tr><td colspan="2">Required table status is unavailable.</td></tr>
                        <% } %>

                        <% status.schema.requiredTables.forEach((table) => { %>
                          <tr>
                            <td><code><%= table.tableName %></code></td>
                            <td><span class="pill <%= table.exists ? 'good' : 'bad' %>"><%= table.exists ? 'Found' : 'Missing' %></span></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>

              <div>
                <h3>Required Views</h3>
                <div class="table-card">
                  <div class="table-scroll">
                    <table>
                      <thead>
                        <tr>
                          <th>View</th>
                          <th>Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (!status.schema.requiredViews.length) { %>
                          <tr><td colspan="2">Required view status is unavailable.</td></tr>
                        <% } %>

                        <% status.schema.requiredViews.forEach((view) => { %>
                          <tr>
                            <td><code><%= view.viewName %></code></td>
                            <td><span class="pill <%= view.exists ? 'good' : 'bad' %>"><%= view.exists ? 'Found' : 'Missing' %></span></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>
