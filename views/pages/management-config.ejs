<%
  const systemConfigCategoryCodes = new Set([
    'production_weight_types',
    'lot_types',
    'unit_categories',
    'cosmetic_grades',
    'pass_fail_statuses',
    'unit_statuses',
    'unit_outcomes',
    'issue_types',
    'ram_types',
    'storage_types',
    'os_types',
    'manufacturer_types',
    'processor_types',
    'user_roles',
    'roles',
    'security_settings'
  ]);

  const getConfigCategoryCode = (category) => String(category && category.code ? category.code : '').toLowerCase();
  const isProductionWeightCategory = (category) => getConfigCategoryCode(category) === 'production_weight_types';
  const isCanonicalCosmeticGradeCategory = (category) => getConfigCategoryCode(category) === 'cosmetic_grades';
  const isSystemUsedCategory = (category) => {
    const categoryCode = getConfigCategoryCode(category);
    return systemConfigCategoryCodes.has(categoryCode) || isProductionWeightCategory(category);
  };
  const isPasswordLinkExpirySetting = (category, value) => getConfigCategoryCode(category) === 'security_settings'
    && String(value && value.code ? value.code : '').toLowerCase() === 'password_link_expiry_hours';
  const visibleValueCount = categorySections.reduce((sectionTotal, section) => (
    sectionTotal + section.categories.reduce((categoryTotal, category) => categoryTotal + category.values.length, 0)
  ), 0);
%>
<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { pageTitle, stylesheets: ['/css/modal.css?v=stage8-config-clean'] }) %>

  <body class="configuration-clean-page">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell configuration-page">
          <%- include('../partials/configuration-nav', { currentNav }) %>

          <section class="page-heading configuration-page-heading">
            <div>
              <h1>Configuration Values</h1>
              <p>Maintain the shared values used by Unit, Lot, user, and security workflows. Open a category to review its values or add a new one.</p>
            </div>

            <div class="site-clean-actions">
              <a class="primary-button" href="/management/config/values/new/modal?includeInactive=<%= includeInactiveValues ? '1' : '0' %>" hx-get="/management/config/values/new/modal?includeInactive=<%= includeInactiveValues ? '1' : '0' %>" hx-target="#modal-root" hx-swap="innerHTML">Create Config Value</a>
              <% if (includeInactiveValues) { %>
                <a class="secondary-button" href="/management/config">Hide Inactive</a>
              <% } else { %>
                <a class="secondary-button" href="/management/config?includeInactive=1">Show Inactive</a>
              <% } %>
            </div>
          </section>

          <section class="site-summary-panel configuration-summary-panel" aria-label="Configuration totals">
            <div class="site-summary-primary">
              <span>Visible values</span>
              <strong><%= formatNumber(visibleValueCount) %></strong>
              <small><%= includeInactiveValues ? 'Active and inactive values are shown.' : 'Inactive values are hidden from this view.' %></small>
            </div>

            <div class="site-summary-stats">
              <article>
                <span class="site-summary-icon" aria-hidden="true">▦</span>
                <span><small>Categories</small><strong><%= formatNumber(summary.categoryCount) %></strong></span>
              </article>
              <article>
                <span class="site-summary-icon" aria-hidden="true">✓</span>
                <span><small>Active values</small><strong><%= formatNumber(summary.activeValueCount || 0) %></strong></span>
              </article>
              <article>
                <span class="site-summary-icon" aria-hidden="true">◌</span>
                <span><small>Inactive values</small><strong><%= formatNumber(summary.inactiveValueCount || 0) %></strong></span>
              </article>
            </div>
          </section>

          <%- include('../fragments/operational-option-ranking-administration', { rankingAdministration }) %>

          <section class="site-clean-section site-clean-surface configuration-browser-section" data-configuration-browser>
            <div class="site-clean-section-heading configuration-browser-heading">
              <div>
                <h2>Configuration Browser</h2>
                <p>Search by category, label, code, stored value, or description. Categories stay collapsed until you need them.</p>
              </div>

              <div class="configuration-browser-heading-actions">
                <button class="secondary-button button-small" type="button" data-configuration-expand-all>Expand All</button>
                <button class="secondary-button button-small" type="button" data-configuration-collapse-all>Collapse All</button>
              </div>
            </div>

            <div class="configuration-browser-toolbar">
              <label class="form-field configuration-browser-search">
                <span>Search Configuration</span>
                <input type="search" placeholder="Category, label, code, value, or description" autocomplete="off" data-configuration-search />
              </label>
              <p class="configuration-browser-status" data-configuration-status aria-live="polite"><%= formatNumber(visibleValueCount) %> values across <%= formatNumber(summary.categoryCount) %> categories.</p>
            </div>

            <div class="configuration-empty-state" data-configuration-empty hidden>
              No configuration values match that search.
            </div>

            <div class="configuration-group-list" data-configuration-groups>
              <% if (categorySections.length === 0) { %>
                <div class="configuration-empty-state">No configuration categories were returned.</div>
              <% } %>

              <% categorySections.forEach((section) => { %>
                <section class="configuration-group" data-configuration-group>
                  <header class="configuration-group-heading">
                    <div>
                      <h2><%= section.label %></h2>
                      <p><%= section.description %></p>
                    </div>
                    <div class="configuration-group-counts" aria-label="Group totals">
                      <span><strong><%= formatNumber(section.categoryCount) %></strong> categories</span>
                      <span><strong><%= formatNumber(section.activeValueCount) %></strong> active</span>
                      <% if (section.inactiveValueCount > 0) { %>
                        <span><strong><%= formatNumber(section.inactiveValueCount) %></strong> inactive</span>
                      <% } %>
                    </div>
                  </header>

                  <div class="configuration-category-list">
                    <% section.categories.forEach((category) => { %>
                      <%
                        const categorySearchText = [
                          section.label,
                          section.description,
                          category.label,
                          category.code,
                          category.description
                        ].filter(Boolean).join(' ').toLowerCase();
                        const canonicalCosmeticGrades = isCanonicalCosmeticGradeCategory(category);
                        const supportsDragOrdering = Boolean(!canonicalCosmeticGrades && category.supportsDragOrdering && category.values.length >= 3);
                        const tableColumnCount = supportsDragOrdering ? 7 : 6;
                      %>
                      <details class="configuration-category" data-configuration-category data-search-text="<%= categorySearchText %>">
                        <summary class="configuration-category-summary">
                          <span class="configuration-category-summary-title">
                            <strong><%= category.label || category.code %></strong>
                            <code><%= category.code %></code>
                          </span>
                          <span class="configuration-category-summary-meta">
                            <span><%= formatNumber(category.values.length) %> shown</span>
                            <span><%= formatNumber(category.activeValueCount) %> active</span>
                            <% if (category.inactiveValueCount > 0) { %><span><%= formatNumber(category.inactiveValueCount) %> inactive</span><% } %>
                            <% if (!category.isActive) { %><span class="pill neutral">Inactive category</span><% } %>
                            <% if (isSystemUsedCategory(category)) { %><span class="pill neutral">System-used</span><% } %>
                            <% if (canonicalCosmeticGrades) { %><span class="pill neutral">Canonical / read-only</span><% } %>
                            <% if (category.usesPopularitySorting) { %><span class="pill neutral">Popularity sorted</span><% } %>
                            <% if (supportsDragOrdering) { %><span class="pill neutral">Drag order</span><% } %>
                          </span>
                        </summary>

                        <div class="configuration-category-body">
                          <div class="configuration-category-toolbar">
                            <div class="configuration-category-toolbar-copy">
                              <p><%= category.description || 'No category description is configured.' %></p>
                              <% if (supportsDragOrdering) { %>
                                <p class="configuration-ordering-help">Drag the grip to reorder this list. Changes save automatically. Search can remain active; matching values move while hidden values keep their positions. Use the arrow keys while the grip is focused for keyboard ordering.</p>
                                <p class="configuration-ordering-status" data-configuration-order-status aria-live="polite"></p>
                              <% } else if (category.usesPopularitySorting) { %>
                                <p class="configuration-ordering-help">Operational dropdowns use the cached popularity order. This table keeps the configured fallback order.</p>
                              <% } %>
                            </div>
                            <% if (canonicalCosmeticGrades) { %>
                              <span class="pill neutral">A · AB · B · C · D</span>
                            <% } else { %>
                              <a class="secondary-button button-small" href="/management/config/values/new/modal?categoryId=<%= category.config_category_id %>&includeInactive=<%= includeInactiveValues ? '1' : '0' %>" hx-get="/management/config/values/new/modal?categoryId=<%= category.config_category_id %>&includeInactive=<%= includeInactiveValues ? '1' : '0' %>" hx-target="#modal-root" hx-swap="innerHTML">Add Value</a>
                            <% } %>
                          </div>

                          <div class="table-card configuration-values-table" data-reorderable="<%= supportsDragOrdering ? '1' : '0' %>">
                            <div class="table-scroll">
                              <table>
                                <thead>
                                  <tr>
                                    <% if (supportsDragOrdering) { %><th class="configuration-order-column">Order</th><% } %>
                                    <th>Label</th>
                                    <th>Code</th>
                                    <th>Stored Value</th>
                                    <th>Status</th>
                                    <th>Description</th>
                                    <th>Actions</th>
                                  </tr>
                                </thead>

                                <tbody
                                  <% if (supportsDragOrdering) { %>
                                    data-configuration-reorder-list
                                    data-reorder-url="/management/config/categories/<%= category.config_category_id %>/order"
                                    data-include-inactive="<%= includeInactiveValues ? '1' : '0' %>"
                                  <% } %>>
                                  <% if (category.values.length === 0) { %>
                                    <tr data-configuration-no-values>
                                      <td colspan="<%= tableColumnCount %>">
                                        <% if (category.inactiveValueCount > 0 && !includeInactiveValues) { %>
                                          This category only has inactive values. Use Show Inactive to review them.
                                        <% } else { %>
                                          No values are configured in this category.
                                        <% } %>
                                      </td>
                                    </tr>
                                  <% } %>

                                  <% category.values.forEach((value) => { %>
                                    <%
                                      const valueSearchText = [
                                        section.label,
                                        category.label,
                                        category.code,
                                        value.label,
                                        value.code,
                                        value.value,
                                        value.description,
                                        value.isActive ? 'active' : 'inactive'
                                      ].filter(Boolean).join(' ').toLowerCase();
                                    %>
                                    <tr class="<%= value.isActive ? '' : 'configuration-value-row--inactive' %>" data-configuration-value-row data-search-text="<%= valueSearchText %>" <% if (supportsDragOrdering) { %>data-configuration-order-row data-config-value-id="<%= value.config_value_id %>"<% } %>>
                                      <% if (supportsDragOrdering) { %>
                                        <td class="configuration-order-cell">
                                          <button
                                            class="configuration-drag-handle"
                                            type="button"
                                            data-configuration-drag-handle
                                            aria-label="Reorder <%= value.label || value.code %>. Drag with a mouse or touch, or use the arrow keys.">
                                            <svg viewBox="0 0 18 18" aria-hidden="true" focusable="false">
                                              <circle cx="6" cy="4" r="1.2"></circle>
                                              <circle cx="12" cy="4" r="1.2"></circle>
                                              <circle cx="6" cy="9" r="1.2"></circle>
                                              <circle cx="12" cy="9" r="1.2"></circle>
                                              <circle cx="6" cy="14" r="1.2"></circle>
                                              <circle cx="12" cy="14" r="1.2"></circle>
                                            </svg>
                                          </button>
                                        </td>
                                      <% } %>
                                      <td><strong><%= value.label || value.code %></strong></td>
                                      <td><code><%= value.code %></code></td>
                                      <td>
                                        <% if (isProductionWeightCategory(category) && value.value) { %>
                                          <span class="configuration-value-emphasis"><%= value.value %></span>
                                        <% } else { %>
                                          <%= value.value || '—' %>
                                        <% } %>
                                      </td>
                                      <td><span class="pill <%= value.isActive ? 'good' : 'neutral' %>"><%= value.isActive ? 'Active' : 'Inactive' %></span></td>
                                      <td><%= value.description || '—' %></td>
                                      <td>
                                        <div class="configuration-value-actions">
                                          <% if (canonicalCosmeticGrades) { %>
                                            <span class="pill neutral">System-managed</span>
                                          <% } else { %>
                                            <a class="secondary-button button-small" href="/management/config/values/<%= value.config_value_id %>/edit/modal?includeInactive=<%= includeInactiveValues ? '1' : '0' %>" hx-get="/management/config/values/<%= value.config_value_id %>/edit/modal?includeInactive=<%= includeInactiveValues ? '1' : '0' %>" hx-target="#modal-root" hx-swap="innerHTML">Edit</a>

                                            <% if (isPasswordLinkExpirySetting(category, value)) { %>
                                              <span class="pill neutral">Required</span>
                                            <% } else if (value.isActive) { %>
                                              <a class="danger-button button-small" href="/management/config/values/<%= value.config_value_id %>/deactivate/modal?includeInactive=<%= includeInactiveValues ? '1' : '0' %>" hx-get="/management/config/values/<%= value.config_value_id %>/deactivate/modal?includeInactive=<%= includeInactiveValues ? '1' : '0' %>" hx-target="#modal-root" hx-swap="innerHTML">Deactivate</a>
                                            <% } else { %>
                                              <a class="secondary-button button-small" href="/management/config/values/<%= value.config_value_id %>/activate/modal?includeInactive=<%= includeInactiveValues ? '1' : '0' %>" hx-get="/management/config/values/<%= value.config_value_id %>/activate/modal?includeInactive=<%= includeInactiveValues ? '1' : '0' %>" hx-target="#modal-root" hx-swap="innerHTML">Activate</a>
                                            <% } %>
                                          <% } %>
                                        </div>
                                      </td>
                                    </tr>
                                  <% }) %>
                                </tbody>
                              </table>
                            </div>
                          </div>
                        </div>
                      </details>
                    <% }) %>
                  </div>
                </section>
              <% }) %>
            </div>
          </section>
        </main>

        <div id="modal-root"></div>
      </div>
    </div>

    <script defer src="/js/modal.js?v=20260729-stage9k-modal-accessibility"></script>
    <script defer src="/js/config-values.js?v=20260804-stage10w-ranking-administration"></script>
  </body>
</html>
