<%
  const formatTechUnitsPickerDate = (value) => {
    const normalized = String(value || '').slice(0, 10);
    if (!/^\d{4}-\d{2}-\d{2}$/.test(normalized)) {
      return 'Select date';
    }

    const date = new Date(`${normalized}T00:00:00.000Z`);
    return Number.isNaN(date.getTime()) ? 'Select date' : new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC'
    }).format(date);
  };
  const pageRoleCodes = typeof currentRoles !== 'undefined' && Array.isArray(currentRoles) ? currentRoles : [];
  const canCreateTechUnits = typeof canCreateOrEditTechUnits === 'function'
    ? canCreateOrEditTechUnits()
    : pageRoleCodes.some((roleCode) => ['admin', 'management', 'tech_lead', 'tech'].includes(roleCode));
  const isQcUnitBrowserUser = pageRoleCodes.includes('qc') && !canCreateTechUnits;
%>
<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', {
    pageTitle,
    stylesheets: [
      '/css/modal.css',
      '/css/tech-units-clean.css?v=20260811-stage10w31-lot-hierarchy-context'
    ]
  }) %>
  <script defer src="/js/modal.js?v=20260729-stage9k-modal-accessibility"></script>
  <script defer src="/js/tech-units.js?v=20260811-stage10w31-lot-hierarchy-context"></script>
  <script defer src="/js/tech-units-date-picker.js"></script>
  <script defer src="/js/tech-unit-form.js?v=20260811-stage10w31-lot-hierarchy-context"></script>

  <body>
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell tech-units-clean-page">
          <section class="tech-units-clean-page-heading tech-units-clean-page-heading--save-status">
            <h1><%= isQcUnitBrowserUser ? 'QC Unit Browser' : 'Tech Units Browser' %></h1>

            <div
              id="tech-unit-save-notification"
              class="message success tech-unit-save-notification"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              hidden
            ></div>

            <div class="tech-units-clean-heading-actions">
              <% if (canCreateTechUnits) { %>
                <a class="primary-button tech-units-clean-create-button" href="/tech/units/new" hx-get="/tech/units/new/modal" hx-target="#modal-root" hx-swap="innerHTML">
                  Create Unit
                </a>
              <% } %>
            </div>
          </section>

          <% if (successMessage) { %>
            <div class="message success tech-units-clean-message"><%= successMessage %></div>
          <% } %>

          <% if (typeof warningMessage !== 'undefined' && warningMessage) { %>
            <div class="message warning tech-units-clean-message"><%= warningMessage %></div>
          <% } %>

          <% if (!result.supported) { %>
            <div class="message error tech-units-clean-message">
              <p><%= result.message %></p>
            </div>
          <% } else { %>
              <%
                const unitCategoryOptions = Array.isArray(result.unitCategories) ? result.unitCategories : [];
                const gradeFilterOptions = Array.isArray(result.gradeFilterOptions) ? result.gradeFilterOptions : [];
                const techUserOptions = Array.isArray(result.techUserOptions) ? result.techUserOptions : [];
                const pagination = result.pagination || {};
                const isRegularTechBrowserUser = pageRoleCodes.includes('tech') && !pageRoleCodes.some((roleCode) => ['admin', 'management', 'tech_lead'].includes(roleCode));
                const canViewParkedUnits = pageRoleCodes.some((roleCode) => ['admin', 'management', 'tech_lead'].includes(roleCode));
                const isLast24HourDrilldown = filters.createdWindow === '24h';
                const isGradeFilterSelected = (grade) => String(filters.gradeFilter || '') === String(grade.filterValue || '');
              %>
              <section class="tech-units-clean-section tech-units-qc-summary-section" aria-labelledby="tech-units-qc-summary-heading">
                <div class="tech-units-clean-section-heading">
                  <h2 id="tech-units-qc-summary-heading">QC Performance</h2>
                </div>

                <div
                  id="tech-units-qc-summary"
                  data-tech-qc-summary-refresh-url="<%= qcSummaryUrl %>"
                  hx-get="<%= qcSummaryUrl %>"
                  hx-trigger="load"
                  hx-swap="innerHTML"
                >
                  <div class="tech-qc-summary-loading" role="status">Loading QC performance...</div>
                </div>
              </section>

              <section class="tech-units-clean-section tech-units-clean-filters-section" aria-labelledby="tech-units-filters-heading">
                <div class="tech-units-clean-section-heading tech-units-clean-section-heading--filters">
                  <h2 id="tech-units-filters-heading">Search &amp; Filters</h2>

                  <% if (isLast24HourDrilldown || filters.unitState === 'parked' || filters.categoryId || filters.lotId || filters.gradeFilter || filters.qcReviewFilter || filters.techUserId || filters.createdStartDate || filters.createdEndDate || filters.search) { %>
                    <div class="tech-filter-panel-header-actions">
                      <span class="tech-filter-active-pill">Filtered View</span>
                    </div>
                  <% } %>
                </div>

                <% if (filters.unitState !== 'parked' && result.qcReviewQueue) { %>
                  <%- include('../fragments/tech-units-qc-review-queue', { queue: result.qcReviewQueue, filters, oob: false }) %>
                <% } %>

                <form class="tech-filter-form tech-filter-panel tech-units-clean-filter-workspace" method="get" action="/tech/units">
                  <% if (filters.qcReviewFilter) { %>
                    <input type="hidden" name="qcReviewFilter" value="<%= filters.qcReviewFilter %>" />
                  <% } %>
                  <input type="hidden" name="perPage" value="<%= pagination.perPageParam || filters.perPage || '50' %>" />
                  <% if (filters.sort) { %>
                    <input type="hidden" name="sort" value="<%= filters.sort %>" />
                  <% } %>
                  <div class="tech-filter-layout">
                  <label class="form-field tech-filter-search-field">
                    <span>Search Units</span>
                    <textarea name="search" rows="5" placeholder="Scan or paste asset tags, BIOS serials, or unit serials — one per line"><%= filters.search %></textarea>
                  </label>

                  <div class="tech-filter-grid <%= isRegularTechBrowserUser ? 'tech-filter-grid--regular-tech' : 'tech-filter-grid--tech-lead-plus' %>" aria-label="Unit filters">
                    <label class="form-field">
                      <span>Assignable Lot</span>
                      <select name="lotId" data-tech-filter-auto-submit data-hierarchical-lot-select>
                        <option value="">All visible lots</option>
                        <%- include('../partials/hierarchical-lot-options', {
                          lotOptions: Array.isArray(result.lotHierarchyOptions) && result.lotHierarchyOptions.length > 0 ? result.lotHierarchyOptions : result.lots,
                          selectedLotId: filters.lotId
                        }) %>
                      </select>
                    </label>

                    <label class="form-field">
                      <span>Category</span>
                      <select name="categoryId" data-tech-filter-auto-submit>
                        <option value="">All categories</option>
                        <% unitCategoryOptions.forEach((category) => { %>
                          <option value="<%= category.id %>" <%= String(filters.categoryId) === String(category.id) ? 'selected' : '' %>><%= category.label %></option>
                        <% }) %>
                      </select>
                    </label>

                    <label class="form-field">
                      <span>Grade</span>
                      <select name="gradeFilter" data-tech-filter-auto-submit>
                        <option value="">All grades</option>
                        <% gradeFilterOptions.forEach((grade) => { %>
                          <option value="<%= grade.filterValue %>" <%= isGradeFilterSelected(grade) ? 'selected' : '' %>><%= grade.label %></option>
                        <% }) %>
                      </select>
                    </label>

                    <% if (!isRegularTechBrowserUser) { %>
                      <label class="form-field">
                        <span>Tech User</span>
                        <select name="techUserId" data-tech-filter-auto-submit>
                          <option value="">All Tech Users</option>
                          <% techUserOptions.forEach((techUser) => { %>
                            <option value="<%= techUser.id %>" <%= String(filters.techUserId) === String(techUser.id) ? 'selected' : '' %>><%= techUser.label %></option>
                          <% }) %>
                        </select>
                      </label>
                    <% } %>

                    <fieldset class="form-field tech-created-date-range">
                      <legend>Created Date Range</legend>
                      <div class="tech-created-date-range-inputs">
                        <div class="tech-created-date-picker" data-tech-created-date-picker>
                          <input type="hidden" name="createdStartDate" value="<%= filters.createdStartDate || '' %>" data-tech-created-date-picker-input />
                          <button class="tech-created-date-picker-trigger" type="button" data-tech-created-date-picker-trigger aria-haspopup="dialog" aria-expanded="false" aria-controls="tech-created-start-date-calendar">
                            <span data-tech-created-date-picker-label><%= formatTechUnitsPickerDate(filters.createdStartDate) %></span>
                            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6.25 8 10l4-3.75" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
                          </button>
                          <span class="tech-created-date-picker-label">From</span>
                          <div id="tech-created-start-date-calendar" class="tech-created-date-calendar" data-tech-created-date-picker-popover role="dialog" aria-label="Choose From date" hidden>
                            <div class="tech-created-date-calendar-heading">
                              <button type="button" class="tech-created-date-calendar-nav" data-tech-created-date-picker-previous aria-label="Previous month">‹</button>
                              <strong data-tech-created-date-picker-month-label></strong>
                              <button type="button" class="tech-created-date-calendar-nav" data-tech-created-date-picker-next aria-label="Next month">›</button>
                            </div>
                            <div class="tech-created-date-calendar-weekdays" aria-hidden="true"><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div>
                            <div class="tech-created-date-calendar-days" data-tech-created-date-picker-grid role="grid" aria-label="Calendar days"></div>
                            <div class="tech-created-date-calendar-footer"><button type="button" class="button-link" data-tech-created-date-picker-today>Today</button><button type="button" class="button-link" data-tech-created-date-picker-clear>Clear</button></div>
                          </div>
                        </div>

                        <div class="tech-created-date-picker" data-tech-created-date-picker>
                          <input type="hidden" name="createdEndDate" value="<%= filters.createdEndDate || '' %>" data-tech-created-date-picker-input />
                          <button class="tech-created-date-picker-trigger" type="button" data-tech-created-date-picker-trigger aria-haspopup="dialog" aria-expanded="false" aria-controls="tech-created-end-date-calendar">
                            <span data-tech-created-date-picker-label><%= formatTechUnitsPickerDate(filters.createdEndDate) %></span>
                            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6.25 8 10l4-3.75" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
                          </button>
                          <span class="tech-created-date-picker-label">Through</span>
                          <div id="tech-created-end-date-calendar" class="tech-created-date-calendar" data-tech-created-date-picker-popover role="dialog" aria-label="Choose Through date" hidden>
                            <div class="tech-created-date-calendar-heading">
                              <button type="button" class="tech-created-date-calendar-nav" data-tech-created-date-picker-previous aria-label="Previous month">‹</button>
                              <strong data-tech-created-date-picker-month-label></strong>
                              <button type="button" class="tech-created-date-calendar-nav" data-tech-created-date-picker-next aria-label="Next month">›</button>
                            </div>
                            <div class="tech-created-date-calendar-weekdays" aria-hidden="true"><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div>
                            <div class="tech-created-date-calendar-days" data-tech-created-date-picker-grid role="grid" aria-label="Calendar days"></div>
                            <div class="tech-created-date-calendar-footer"><button type="button" class="button-link" data-tech-created-date-picker-today>Today</button><button type="button" class="button-link" data-tech-created-date-picker-clear>Clear</button></div>
                          </div>
                        </div>
                      </div>
                    </fieldset>
                  </div>
                </div>

                <% if (isLast24HourDrilldown) { %>
                  <input type="hidden" name="createdWindow" value="24h" />
                  <div class="message success tech-filter-drilldown-note">
                    <p>This Unit Browser view is filtered to records created in the last 24 hours.</p>
                  </div>
                <% } %>

                  <div class="tech-filter-actions">
                    <% if (canViewParkedUnits) { %>
                      <label class="tech-unit-state-toggle">
                        <span class="tech-unit-state-toggle-control">
                          <input
                            type="checkbox"
                            name="unitState"
                            value="parked"
                            data-unit-state-toggle
                            data-tech-filter-auto-submit
                            <%= filters.unitState === 'parked' ? 'checked' : '' %>
                          />
                          <span class="tech-unit-state-toggle-track" aria-hidden="true"></span>
                        </span>
                        <span class="tech-unit-state-toggle-label">Show Parked Units</span>
                      </label>
                    <% } else { %>
                      <span class="tech-filter-actions-spacer" aria-hidden="true"></span>
                    <% } %>

                    <span class="tech-filter-action-buttons">
                      <button class="primary-button" type="submit">Apply Filters</button>
                      <a class="secondary-button" href="/tech/units">Clear</a>
                    </span>
                  </div>
                </form>
              </section>

              <section class="tech-units-clean-section tech-units-clean-results-workspace" aria-labelledby="tech-units-results-heading">
                <div class="tech-units-clean-section-heading tech-units-clean-section-heading--results">
                  <h2 id="tech-units-results-heading">Units</h2>

                  <p class="tech-units-clean-loaded-count" aria-live="polite">
                    <strong id="tech-units-loaded-count"><%= result.supported && pagination.totalRows !== undefined ? formatNumber(pagination.totalRows) : '—' %></strong>
                    <span>matching</span>
                  </p>
                </div>

                <div class="tech-units-clean-results-panel">
                  <div class="tech-table-shell" id="tech-units-list" data-tech-units-refresh-url="<%= tableUrl %>" hx-get="<%= tableUrl %>" hx-trigger="load" hx-swap="innerHTML">
                    <div class="tech-loading-card">
                      Loading units...
                    </div>
                  </div>
                </div>
              </section>
            <% } %>

        </main>

        <div id="modal-root"></div>
      </div>
    </div>
  </body>
</html>