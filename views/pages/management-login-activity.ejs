<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { pageTitle }) %>

  <body class="css-scope-management">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell">
          <section class="page-heading site-work-page-heading management-login-page-heading">
            <div>
              <p class="eyebrow">Security Audit</p>
              <h1>Login Activity</h1>
              <p>Review successful sign-ins by day. Times are shown automatically in the browser time zone: <%= timeZone %>.</p>
            </div>

            <% if (typeof hasPermission === 'function' && hasPermission('users.view')) { %>
              <div class="site-clean-actions site-inline-actions">
                <a class="secondary-button" href="/management/users">Back to Users</a>
              </div>
            <% } %>
          </section>

          <section class="site-summary-panel site-summary-panel--expanded management-login-summary-panel" aria-label="Login activity summary">
            <div class="site-summary-primary">
              <span>Selected date</span>
              <strong><%= formatDateKeyLabel(selectedDate) %></strong>
              <small>Daily successful sign-in audit</small>
            </div>

            <div class="site-summary-stats">
              <article>
                <span class="site-summary-icon" aria-hidden="true">#</span>
                <span><small>Unique Users Signed In</small><strong><%= formatNumber(signedInUserCount) %></strong></span>
              </article>
              <article>
                <span class="site-summary-icon" aria-hidden="true">✓</span>
                <span><small>Successful Sign-ins</small><strong><%= formatNumber(successfulLoginCount) %></strong></span>
              </article>
              <article>
                <span class="site-summary-icon" aria-hidden="true">◉</span>
                <span><small>Permission</small><strong>Login Audit</strong></span>
              </article>
            </div>
          </section>

          <section class="content-card">
            <div class="content-header management-login-header">
              <div>
                <p class="eyebrow">Daily Sign-in Audit</p>
                <h2>Successful Login Activity</h2>
              </div>

            </div>

            <form class="management-login-filter-form" method="get" action="/management/login-activity" data-auto-submit-filter-form>
              <div class="form-field">
                <label for="login-activity-date">Date</label>
                <input id="login-activity-date" type="date" name="date" value="<%= selectedDate %>" max="<%= todayDate %>" required data-auto-submit-filter="immediate" />
              </div>

              <div class="management-login-filter-actions">
                <% if (selectedDate !== todayDate) { %>
                  <a class="secondary-button" href="/management/login-activity">Today</a>
                <% } %>
              </div>
            </form>

            <p class="management-login-note">
              A user appears once per selected day; use View Day to review every recorded successful sign-in for that user on the selected date.
            </p>

            <div class="table-card management-login-table-card">
              <table>
                <thead>
                  <tr>
                    <th>User</th>
                    <th>Role at First Sign-in</th>
                    <th>First Sign-in</th>
                    <th>Most Recent Sign-in</th>
                    <th>Successful Sign-ins</th>
                    <th>Action</th>
                  </tr>
                </thead>

                <tbody>
                  <% if (loginActivity.length === 0) { %>
                    <tr>
                      <td colspan="6">No successful sign-ins were recorded for this date.</td>
                    </tr>
                  <% } %>

                  <% loginActivity.forEach((activity) => { %>
                    <tr>
                      <td>
                        <div class="management-login-user">
                          <strong><%= activity.first_name %> <%= activity.last_name %></strong>
                          <span><%= activity.username %> · <%= activity.email %></span>
                        </div>
                      </td>
                      <td><span class="pill slate"><%= activity.first_login_role_label %></span></td>
                      <td><%= formatTimeWithZone(activity.first_login_at) %></td>
                      <td><%= formatTimeWithZone(activity.last_login_at) %></td>
                      <td><%= formatNumber(activity.successful_login_count) %></td>
                      <td>
                        <a
                          class="secondary-button button-small"
                          href="/management/login-activity/<%= activity.user_id %>/modal?date=<%= encodeURIComponent(selectedDate) %>"
                          hx-get="/management/login-activity/<%= activity.user_id %>/modal?date=<%= encodeURIComponent(selectedDate) %>"
                          hx-target="#modal-root"
                          hx-swap="innerHTML"
                        >View Day</a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </section>
        </main>
      </div>
    </div>

    <div id="modal-root"></div>
    <script defer src="/js/modal.js?v=20260729-stage9k-modal-accessibility"></script>
  </body>
</html>
