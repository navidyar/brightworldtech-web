<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { pageTitle }) %>
  <script defer src="/js/modal.js?v=20260819-stage10w68p-interaction-refinements"></script>
  <script defer src="/js/password-link-status.js?v=20260811-stage10w32"></script>
  <script defer src="/js/copy-link.js?v=20260811-stage10w32"></script>

  <body class="css-scope-management css-scope-copy-link">
    <%
      const userListBasePath = isInactiveView ? '/management/users/inactive' : '/management/users';
      const canCreateUsers = typeof hasPermission === 'function' && hasPermission('users.create');
      const canDeleteUsers = typeof hasPermission === 'function' && hasPermission('users.delete');
      const canManageUserStatus = typeof hasPermission === 'function' && hasPermission('users.status.manage');
      const canManageUserSetupLinks = typeof hasPermission === 'function' && hasPermission('users.setup_links.manage');
      const canViewUserManagementAudit = typeof hasPermission === 'function' && hasPermission('audit.user_management.view');
      const normalizedActiveSort = activeSort || 'user_az';
      const nextUserSort = (forward, reverse) => normalizedActiveSort === forward ? reverse : forward;
      const userSortClass = (forward, reverse) => `table-sort-link${[forward, reverse].includes(normalizedActiveSort) ? ' is-active' : ''}`;
      const userSortIndicator = (forward, reverse, forwardIndicator = '↑', reverseIndicator = '↓') => {
        if (normalizedActiveSort === forward) return forwardIndicator;
        if (normalizedActiveSort === reverse) return reverseIndicator;
        return '';
      };
      const userSortHref = (forward, reverse) => `${userListBasePath}?sort=${encodeURIComponent(nextUserSort(forward, reverse))}`;
      const userRoleFilterMap = new Map();
      users.forEach((user) => {
        const roleNames = String(user.role_names || '').split(', ').filter(Boolean);
        (Array.isArray(user.roles) ? user.roles : []).forEach((roleCode, index) => {
          if (roleCode && !userRoleFilterMap.has(roleCode)) userRoleFilterMap.set(roleCode, roleNames[index] || roleCode);
        });
      });
      const loginInactivityOverdueCount = users.filter((user) => user.login_inactivity_overdue).length;
      const loginInactivityMonitoredCount = users.filter((user) => user.monitor_login_inactivity).length;
      const userRoleFilterOptions = Array.from(userRoleFilterMap.entries())
        .map(([code, name]) => ({ code, name }))
        .sort((left, right) => left.name.localeCompare(right.name));
    %>
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell">
          <section class="page-heading site-work-page-heading management-users-page-heading">
            <div>
              <p class="eyebrow">User Administration</p>
              <h1><%= isInactiveView ? 'Inactive Users' : 'User Management' %></h1>
              <p>
                <%= isInactiveView
                  ? 'Review inactive users and reactivate returning employees without losing their work history.'
                  : (canCreateUsers
                    ? 'Create users, assign one or more access roles, issue BWT usernames and initial setup links.'
                    : 'Review active users, assigned roles, account state, and recent login information.') %>
              </p>
            </div>

            <div class="site-clean-actions site-inline-actions management-user-actions">
              <% if (canViewUserManagementAudit) { %>
                <a class="secondary-button" href="/management/users/history" hx-get="/management/users/history" hx-target="#modal-root" hx-swap="innerHTML">Account History</a>
              <% } %>
              <% if (isInactiveView) { %>
                <a class="secondary-button" href="/management/users">Active Users (<%= userCounts.activeCount %>)</a>
              <% } else { %>
                <a class="secondary-button" href="/management/users/inactive">Inactive Users (<%= userCounts.inactiveCount %>)</a>
                <% if (canCreateUsers) { %>
                  <a class="primary-button" href="/management/users/new" hx-get="/management/users/new" hx-target="#modal-root" hx-swap="innerHTML">Create User</a>
                <% } %>
              <% } %>
            </div>
          </section>

          <section class="site-summary-panel site-summary-panel--expanded management-users-summary-panel" aria-label="User management summary">
            <div class="site-summary-primary">
              <span><%= isInactiveView ? 'Inactive users' : 'Active users' %></span>
              <strong><%= formatNumber(isInactiveView ? userCounts.inactiveCount : userCounts.activeCount) %></strong>
              <small><%= isInactiveView ? 'Accounts currently disabled from sign-in' : 'Accounts currently active in BWTDallas' %></small>
            </div>
            <div class="site-summary-stats">
              <article>
                <span class="site-summary-icon" aria-hidden="true">#</span>
                <span><small><%= isInactiveView ? 'Active Users' : 'Inactive Users' %></small><strong><%= formatNumber(isInactiveView ? userCounts.activeCount : userCounts.inactiveCount) %></strong></span>
              </article>
              <article>
                <span class="site-summary-icon" aria-hidden="true">!</span>
                <span><small>Login Inactivity Alerts</small><strong><%= loginInactivityOverdueCount %></strong><small><%= loginInactivityMonitoredCount %> monitored</small></span>
              </article>
              <article>
                <span class="site-summary-icon" aria-hidden="true">+</span>
                <span><small>Access Model</small><strong>Multiple Roles</strong><small>Approved grants combine</small></span>
              </article>
            </div>
          </section>
          <% if (!isInactiveView) { %>
            <p class="management-user-monitoring-note"><strong>Login inactivity monitoring:</strong> grant <em>Monitor Login Inactivity</em> on a role, or choose Inherit / Monitor / Do not monitor in Edit User. Monitored active users are flagged after more than 5 business days without a login.</p>
          <% } %>

          <section class="content-card">
            <div class="content-header management-user-header">
              <div>
                <p class="eyebrow"><%= isInactiveView ? 'Inactive Users' : 'Active Users' %></p>
                <h2><%= isInactiveView ? 'Inactive Application Users' : 'Application Users' %></h2>
              </div>

            </div>

            <% if (successMessage) { %>
              <div class="message success" data-auto-dismiss-success><%= successMessage %></div>
            <% } %>

            <% if (errorMessages.length > 0) { %>
              <div class="message error">
                <% errorMessages.forEach((errorMessage) => { %>
                  <p><%= errorMessage %></p>
                <% }) %>
              </div>
            <% } %>

            <% if (isInactiveView) { %>
              <div class="message error management-user-note">
                <p>Inactive users are hidden from the normal users list and cannot sign in. Their completed work, comments, grades, and unit history remain linked to their user record.</p>
              </div>
            <% } %>

            <div class="message management-user-note">
              <p><strong>Role assignment rule:</strong> users may receive multiple roles. Approved default permissions from every assigned role combine; a role that does not approve a permission does not cancel another role's grant. Protected administrator safeguards remain in place.</p>
            </div>

            <div class="management-live-filter-scope site-space-top-lg" data-live-filter>
              <div class="management-live-filter-bar" aria-label="User filters">
                <label class="form-field management-live-filter-search">
                  <span>Search Users</span>
                  <input type="search" autocomplete="off" placeholder="Name, username, email, role..." data-live-filter-control="search" />
                </label>
                <label class="form-field">
                  <span>Role</span>
                  <select data-live-filter-control="role">
                    <option value="">All roles</option>
                    <% userRoleFilterOptions.forEach((role) => { %><option value="<%= role.code %>"><%= role.name %></option><% }) %>
                  </select>
                </label>
                <button type="button" class="secondary-button button-small management-live-filter-clear" data-live-filter-clear>Clear</button>
                <span class="management-live-filter-count"><strong data-live-filter-count><%= users.length %></strong> shown</span>
              </div>

              <div class="table-card management-users-table-card">
                <table>
                <thead>
                  <tr>
                    <th>
                      <a class="<%= userSortClass('user_az', 'user_za') %>" href="<%= userSortHref('user_az', 'user_za') %>">
                        User
                        <% if (userSortIndicator('user_az', 'user_za')) { %><span aria-hidden="true"><%= userSortIndicator('user_az', 'user_za') %></span><% } %>
                      </a>
                    </th>
                    <th>
                      <a class="<%= userSortClass('role_az', 'role_za') %>" href="<%= userSortHref('role_az', 'role_za') %>">
                        Roles
                        <% if (userSortIndicator('role_az', 'role_za')) { %><span aria-hidden="true"><%= userSortIndicator('role_az', 'role_za') %></span><% } %>
                      </a>
                    </th>
                    <th>
                      <a class="<%= userSortClass('employee_asc', 'employee_desc') %>" href="<%= userSortHref('employee_asc', 'employee_desc') %>">
                        Employee
                        <% if (userSortIndicator('employee_asc', 'employee_desc')) { %><span aria-hidden="true"><%= userSortIndicator('employee_asc', 'employee_desc') %></span><% } %>
                      </a>
                    </th>
                    <th>
                      <a class="<%= userSortClass('account_setup_asc', 'account_setup_desc') %>" href="<%= userSortHref('account_setup_asc', 'account_setup_desc') %>">
                        Account Setup
                        <% if (userSortIndicator('account_setup_asc', 'account_setup_desc')) { %><span aria-hidden="true"><%= userSortIndicator('account_setup_asc', 'account_setup_desc') %></span><% } %>
                      </a>
                    </th>
                    <th>
                      <a class="<%= userSortClass('last_login_desc', 'last_login_asc') %>" href="<%= userSortHref('last_login_desc', 'last_login_asc') %>">
                        Last Login
                        <% if (userSortIndicator('last_login_desc', 'last_login_asc', '↓', '↑')) { %><span aria-hidden="true"><%= userSortIndicator('last_login_desc', 'last_login_asc', '↓', '↑') %></span><% } %>
                      </a>
                    </th>
                    <th>Actions</th>
                  </tr>
                </thead>

                <tbody>
                  <% if (users.length === 0) { %>
                    <tr>
                      <td colspan="6"><%= isInactiveView ? 'No inactive users found.' : 'No active users found.' %></td>
                    </tr>
                  <% } %>

                  <% users.forEach((user) => { %>
                    <% const roleLabel = user.role_names || user.primary_role_name || 'No role assigned'; %>
                    <% const userSearchText = [user.first_name, user.last_name, user.username, user.email, user.personal_email, user.phone, roleLabel, user.account_status_label].filter(Boolean).join(' '); %>
                    <tr data-live-filter-row data-live-filter-search="<%= userSearchText %>" data-live-filter-role="<%= Array.isArray(user.roles) ? user.roles.join('|') : '' %>">
                      <td>
                        <div class="management-user-identity">
                          <strong><%= user.first_name %> <%= user.last_name %></strong>
                          <span class="management-user-username">Username: <b><%= user.username || 'Migration required' %></b></span>
                          <span>Work: <%= user.email %></span>
                          <% if (user.personal_email) { %><span>Personal: <%= user.personal_email %></span><% } %>
                          <% if (user.phone) { %><span>Phone: <%= user.phone %></span><% } %>
                          <% if (Number(user.user_id) === Number(currentUserId)) { %>
                            <em>Current user</em>
                          <% } %>
                        </div>
                      </td>
                      <td>
                        <% if (user.role_count > 0) { %>
                          <div class="management-user-role-stack">
                            <span class="pill slate"><%= roleLabel %></span>
                            <small><%= user.role_count %> role<%= user.role_count === 1 ? '' : 's' %> assigned</small>
                          </div>
                        <% } else { %>
                          <span class="pill bad">No role</span>
                        <% } %>
                      </td>
                      <td>
                        <div class="management-user-account-stack">
                          <% if (user.is_active) { %>
                            <span class="pill good">Active</span>
                          <% } else { %>
                            <span class="pill bad">Inactive</span>
                          <% } %>
                          <% if (user.start_date) { %><small>Start: <%= user.start_date %></small><% } %>
                          <% if (user.end_date) { %><small>End: <%= user.end_date %></small><% } %>
                        </div>
                      </td>
                      <td>
                        <div class="management-user-account-stack">
                          <% if (user.account_status_code === 'active') { %>
                            <span class="pill good">Active Account</span>
                          <% } else { %>
                            <span class="pill bad"><%= user.account_status_label || user.account_status_code || 'Unknown Account' %></span>
                          <% } %>
                          <% if (!user.has_password) { %>
                            <small>Pending setup</small>
                          <% } %>
                          <% if (user.latest_password_link_expires_at) { %>
                            <small
                              class="management-user-link-status <%= user.latest_password_link_status === 'expired' ? 'is-expired' : (user.latest_password_link_status === 'active' ? 'is-active' : '') %>"
                              data-password-link-expires-at="<%= new Date(user.latest_password_link_expires_at).toISOString() %>"
                              data-password-link-status="<%= user.latest_password_link_status || '' %>"
                              data-password-link-type="<%= user.latest_password_link_type_code || '' %>"
                              data-password-link-expiry-display="<%= formatDateTime(user.latest_password_link_expires_at) %>"
                            >
                              <% if (user.latest_password_link_status === 'expired') { %>
                                <%= user.latest_password_link_type_code === 'password_reset' ? 'Reset link' : 'Setup link' %> expired <%= formatDateTime(user.latest_password_link_expires_at) %>
                              <% } else if (user.latest_password_link_status === 'used') { %>
                                <%= user.latest_password_link_type_code === 'password_reset' ? 'Reset link' : 'Setup link' %> used
                              <% } else if (user.latest_password_link_status === 'revoked') { %>
                                <%= user.latest_password_link_type_code === 'password_reset' ? 'Reset link' : 'Setup link' %> revoked
                              <% } else { %>
                                <%= user.latest_password_link_type_code === 'password_reset' ? 'Reset link' : 'Setup link' %> expires <%= formatDateTime(user.latest_password_link_expires_at) %>
                              <% } %>
                            </small>
                          <% } %>
                        </div>
                      </td>
                      <td>
                        <%= formatDateTime(user.last_login_at) %>
                        <% if (user.monitor_login_inactivity) { %>
                          <% if (user.login_inactivity_overdue) { %><br/><span class="pill bad">Inactive <%= user.login_inactivity_business_days %> business days</span>
                          <% } else if (user.login_inactivity_business_days !== null) { %><br/><small>Monitored · <%= user.login_inactivity_business_days %> business days</small>
                          <% } else { %><br/><small>Monitored</small><% } %>
                        <% } %>
                      </td>
                      <td>
                        <div class="management-user-row-actions site-inline-actions">
                          <% if (canViewUserManagementAudit) { %>
                            <a class="secondary-button" href="/management/users/history?userId=<%= user.user_id %>" hx-get="/management/users/history?userId=<%= user.user_id %>" hx-target="#modal-root" hx-swap="innerHTML">History</a>
                          <% } %>
                          <% if (typeof hasPermission === 'function' && hasPermission('users.tool_pin.manage')) { %>
                            <a class="secondary-button" href="/management/users/<%= user.user_id %>/tool-pin/modal?returnPath=<%= isInactiveView ? 'inactive' : 'active' %>" hx-get="/management/users/<%= user.user_id %>/tool-pin/modal?returnPath=<%= isInactiveView ? 'inactive' : 'active' %>" hx-target="#modal-root" hx-swap="innerHTML">Tool PIN</a>
                          <% } %>
                          <% if (typeof hasPermission === 'function' && hasPermission('users.edit')) { %>
                            <% if (Number(user.user_id) !== Number(protectedAdminUserId) || Number(currentUserId) === Number(protectedAdminUserId)) { %>
                          <a class="secondary-button" href="/management/users/<%= user.user_id %>/edit/modal?returnPath=<%= isInactiveView ? 'inactive' : 'active' %>" hx-get="/management/users/<%= user.user_id %>/edit/modal?returnPath=<%= isInactiveView ? 'inactive' : 'active' %>" hx-target="#modal-root" hx-swap="innerHTML">Edit</a>
                            <% } else { %>
                              <span class="pill">Protected Admin</span>
                            <% } %>
                          <% } %>
                          <% if (Number(user.user_id) !== Number(protectedAdminUserId) || Number(currentUserId) === Number(protectedAdminUserId)) { %>
                            <% if (typeof hasPermission === 'function' && hasPermission('roles.view')) { %>
                              <a class="secondary-button" href="/management/users/<%= user.user_id %>/permissions/modal" hx-get="/management/users/<%= user.user_id %>/permissions/modal" hx-target="#modal-root" hx-swap="innerHTML">Permissions</a>
                            <% } %>
                            <% if (canDeleteUsers) { %>
                              <% if (isInactiveView) { %>
                                <% if (user.can_delete_pending_setup) { %>
                                  <a class="secondary-button danger-button" href="/management/users/<%= user.user_id %>/delete-pending/modal?returnPath=inactive" hx-get="/management/users/<%= user.user_id %>/delete-pending/modal?returnPath=inactive" hx-target="#modal-root" hx-swap="innerHTML">Delete Pending User</a>
                                <% } %>
                              <% } else { %>
                                <% if (Number(user.user_id) !== Number(currentUserId) && user.can_delete_pending_setup) { %>
                                  <a class="secondary-button danger-button" href="/management/users/<%= user.user_id %>/delete-pending/modal?returnPath=active" hx-get="/management/users/<%= user.user_id %>/delete-pending/modal?returnPath=active" hx-target="#modal-root" hx-swap="innerHTML">Delete Pending User</a>
                                <% } %>
                              <% } %>
                            <% } %>

                            <% if (!isInactiveView && canManageUserSetupLinks) { %>
                              <a
                                class="secondary-button"
                                href="/management/users/<%= user.user_id %>/setup-link/modal?returnPath=active"
                                hx-get="/management/users/<%= user.user_id %>/setup-link/modal?returnPath=active"
                                hx-target="#modal-root"
                                hx-swap="innerHTML"
                              >
                                <%= user.has_password ? 'Generate Reset Link' : 'Generate Setup Link' %>
                              </a>
                            <% } %>

                            <% if (canManageUserStatus) { %>
                              <% if (isInactiveView) { %>
                                <a class="secondary-button" href="/management/users/<%= user.user_id %>/reactivate/modal?returnPath=inactive" hx-get="/management/users/<%= user.user_id %>/reactivate/modal?returnPath=inactive" hx-target="#modal-root" hx-swap="innerHTML">Reactivate</a>
                              <% } else if (Number(user.user_id) !== Number(currentUserId)) { %>
                                <a class="secondary-button danger-button" href="/management/users/<%= user.user_id %>/deactivate/modal?returnPath=active" hx-get="/management/users/<%= user.user_id %>/deactivate/modal?returnPath=active" hx-target="#modal-root" hx-swap="innerHTML">Deactivate</a>
                              <% } %>
                            <% } %>
                          <% } else { %>
                            <span class="pill">Protected Admin</span>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                  <tr data-live-filter-empty hidden><td colspan="6">No users match the current search and role filter.</td></tr>
                </tbody>
              </table>
              </div>
            </div>
          </section>

        </main>

        <div id="modal-root"></div>
      </div>
    </div>
  </body>
</html>
