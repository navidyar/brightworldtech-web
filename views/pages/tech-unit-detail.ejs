<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', {
    pageTitle,
    stylesheets: [
      '/css/modal.css',
      '/css/tech-units-clean.css?v=20260819-stage10w68o-toggle-label-cleanup'
    ]
  }) %>
  <script defer src="/js/modal.js?v=20260819-stage10w68p-interaction-refinements"></script>
  <script defer src="/js/tech-units.js?v=20260819-stage10w68l-filter-toggles&r=20260824-stage10w70d-qc-reversion-request"></script>
  <script defer src="/js/tech-unit-form.js?v=20260819-stage10w68z-assignable-lot-closed-on-focus"></script>

  <body>
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell tech-units-clean-page tech-unit-detail-page">
          <section class="tech-units-clean-page-heading">
            <div>
              <h1>Unit Details</h1>
              <p>Complete Unit record</p>
            </div>

            <a class="secondary-button" href="/tech/units">Back to Tech Units</a>
          </section>

          <div
            id="tech-unit-detail-record"
            data-tech-unit-detail-refresh-url="/tech/units/<%= result.units[0].unitId %>/record"
          >
            <%- include('../fragments/tech-units-table', {
              result,
              filters,
              singleUnitView: true
            }) %>
          </div>
        </main>

        <div id="modal-root"></div>
      </div>
    </div>
  </body>
</html>
