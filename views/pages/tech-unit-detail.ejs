<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { pageTitle }) %>
  <script defer src="/js/modal.js?v=20260819-stage10w68p-interaction-refinements"></script>
  <script defer src="/js/unit-export-shared.js?v=20260921-cleanup-stage2b"></script>
  <script defer src="/js/tech-units.js?v=20260922-unit-scoped-realtime"></script>
  <script defer src="/js/tech-unit-form.js?v=20260924-lot-objectives-viewport-clamp"></script>

  <body class="css-scope-tech-units">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell tech-units-clean-page tech-unit-detail-page">
          <section class="tech-units-clean-page-heading">
            <div>
              <h1>Unit Details</h1>
              <p>Complete Unit record</p>
            </div>

            <a class="secondary-button" href="/tech/units">Back to Tech Units</a>
          </section>

          <div
            id="tech-unit-detail-record"
            data-tech-unit-detail-refresh-url="/tech/units/<%= result.units[0].unitId %>/record"
          >
            <%- include('../fragments/tech-units-table', {
              result,
              filters,
              singleUnitView: true,
              unitBrowserPresentation
            }) %>
          </div>
        </main>

        <div id="modal-root"></div>
      </div>
    </div>
  </body>
</html>
