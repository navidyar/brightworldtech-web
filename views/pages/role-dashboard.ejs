<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { pageTitle }) %>

  <body>
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell">
          <section class="page-heading site-work-page-heading role-dashboard-page-heading">
            <div>
              <p class="eyebrow"><%= dashboard.kicker || 'Dashboard' %></p>
              <h1><%= dashboard.title %></h1>
              <p><%= dashboard.description %></p>
            </div>
          </section>

          <%- include('../fragments/dashboard-live-region', { dashboardData, dashboardFilters, dashboardFilterOptions, dashboardFilterConfig, dashboardKey: dashboard.key }) %>

        </main>
      </div>
    </div>
  </body>
</html>
