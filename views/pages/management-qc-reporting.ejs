<%
  const formatQcPercent = (value) => value === null || value === undefined
    ? 'Not graded'
    : `${Number(value).toFixed(1)}%`;
  const summary = report && report.summary ? report.summary : {};
  const selectedTechnicianIds = new Set(
    Array.isArray(scope && scope.selectedTechnicianIds) ? scope.selectedTechnicianIds.map(Number) : []
  );
  const selectedTeamCount = selectedTechnicianIds.size;
%>
<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { pageTitle }) %>

  <body>
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell site-work-page">
          <section class="page-heading site-work-page-heading">
            <div>
              <h1>Quality Control Reporting</h1>
              <p>Compare reviewed technician work, identify repeated rejection notes, and review Quality Control activity by completion-date and technician-team scope.</p>
            </div>
            <span class="pill neutral">Admin / Management</span>
          </section>

          <% if (!reportAvailable) { %>
            <div class="message error">
              <p><strong>QC reporting is unavailable.</strong> <%= reportError %></p>
            </div>
          <% } %>

          <% if (filterError) { %>
            <div class="message error">
              <p><strong>The reporting scope could not be applied.</strong> <%= filterError %></p>
            </div>
          <% } %>

          <section class="site-clean-section site-clean-surface qc-reporting-filter-section" aria-labelledby="qc-reporting-scope-heading">
            <div class="site-clean-section-heading">
              <div>
                <h2 id="qc-reporting-scope-heading">Reporting Scope</h2>
                <p class="site-section-description">Date ranges use the Unit completion date. Choose one or more technicians to create an ad hoc reporting team, or leave every technician unchecked to include all reviewed technicians.</p>
              </div>
              <span class="pill neutral"><%= scope.scopeLabel %></span>
            </div>

            <form class="qc-reporting-scope-form" data-reporting-controls method="get" action="/management/qc-reporting">
              <label class="form-field qc-reporting-scope-control qc-reporting-period-main-field">
                <span>Reporting Period</span>
                <select name="period" data-reporting-period-select>
                  <% reportingPeriods.forEach((periodOption) => { %>
                    <option value="<%= periodOption.value %>" <%= scope.period === periodOption.value ? 'selected' : '' %>><%= periodOption.label %></option>
                  <% }) %>
                </select>
                <small data-period-guidance>Choose a reporting period. Only the visible date fields are used.</small>
              </label>

              <div class="qc-reporting-period-field" data-period-field="day">
                <label class="form-field qc-reporting-scope-control">
                  <span>Completion Day</span>
                  <input type="date" data-date-picker-only inputmode="none" autocomplete="off" name="date" value="<%= scope.selectedDate || '' %>" max="<%= scope.todayDate || '' %>" />
                  <small>Includes completion cycles recorded on this date.</small>
                </label>
              </div>

              <div class="qc-reporting-period-field" data-period-field="work_week">
                <label class="form-field qc-reporting-scope-control">
                  <span>Completion Week</span>
                  <input type="week" data-date-picker-only inputmode="none" autocomplete="off" name="week" value="<%= scope.selectedWeek || '' %>" />
                  <small>Reports Monday through Sunday using completion dates.</small>
                </label>
              </div>

              <div class="qc-reporting-period-field" data-period-field="month">
                <label class="form-field qc-reporting-scope-control">
                  <span>Completion Month</span>
                  <input type="month" data-date-picker-only inputmode="none" autocomplete="off" name="month" value="<%= scope.selectedMonth || '' %>" max="<%= String(scope.todayDate || '').slice(0, 7) %>" />
                  <small>Includes the selected full calendar month.</small>
                </label>
              </div>

              <div class="qc-reporting-period-field qc-reporting-period-field--no-picker qc-reporting-scope-control" data-period-field="month_to_date">
                <span class="qc-reporting-scope-label">Completion Date</span>
                <div class="qc-reporting-static-control"><strong>No date needed</strong></div>
                <small>Current month through today in the BWTDallas display time zone.</small>
              </div>

              <div class="qc-reporting-period-field qc-reporting-period-field--range" data-period-field="custom_range">
                <label class="form-field qc-reporting-scope-control">
                  <span>Start Date</span>
                  <input type="date" data-date-picker-only inputmode="none" autocomplete="off" name="startDate" value="<%= scope.customStartDate || '' %>" max="<%= scope.todayDate || '' %>" />
                  <small>First completion date included.</small>
                </label>
                <label class="form-field qc-reporting-scope-control">
                  <span>End Date</span>
                  <input type="date" data-date-picker-only inputmode="none" autocomplete="off" name="endDate" value="<%= scope.customEndDate || '' %>" max="<%= scope.todayDate || '' %>" />
                  <small>Last completion date included.</small>
                </label>
              </div>

              <div class="qc-reporting-team-field qc-reporting-scope-control">
                <span class="qc-reporting-scope-label">Reporting Team</span>
                <details class="qc-reporting-team-picker" <%= selectedTeamCount > 0 ? 'open' : '' %>>
                  <summary>
                    <span><%= selectedTeamCount > 0 ? `${selectedTeamCount} selected` : 'All reviewed technicians' %></span>
                  </summary>

                  <div class="qc-reporting-team-options">
                    <% if (!technicianOptions.length) { %>
                      <p>No reviewed technicians are available yet.</p>
                    <% } %>

                    <% technicianOptions.forEach((technician) => { %>
                      <label class="qc-reporting-team-option">
                        <input
                          type="checkbox"
                          name="technicianId"
                          value="<%= technician.userId %>"
                          <%= selectedTechnicianIds.has(Number(technician.userId)) ? 'checked' : '' %>
                        />
                        <span><%= technician.label %></span>
                      </label>
                    <% }) %>
                  </div>
                </details>
                <small>Leave every technician unchecked to include all reviewed technicians.</small>
              </div>

              <div class="qc-reporting-scope-actions" aria-label="Reporting scope actions">
                <button class="primary-button" type="submit">Apply Scope</button>
                <a class="secondary-button" href="/management/qc-reporting">Reset</a>
              </div>
            </form>

            <div class="qc-reporting-selected-scope" aria-live="polite">
              <strong>Currently showing:</strong>
              <span><%= scope.scopeLabel %></span>
              <small>Completion-date scope; QC review and correction actions remain attached to their original completion cycle.</small>
            </div>
          </section>

          <section class="site-summary-panel" aria-label="Quality Control reporting summary">
            <div class="site-summary-primary">
              <span>Overall QC Grade</span>
              <strong><%= formatQcPercent(summary.qualityGrade) %></strong>
              <small><%= formatNumber(summary.firstPassAcceptedUnits || 0) %> first-pass accepted of <%= formatNumber(summary.reviewedUnits || 0) %> reviewed completion cycle<%= Number(summary.reviewedUnits || 0) === 1 ? '' : 's' %> across <%= formatNumber(report.reviewedTechnicians || 0) %> technician<%= Number(report.reviewedTechnicians || 0) === 1 ? '' : 's' %>.</small>
            </div>

            <div class="site-summary-stats">
              <article>
                <span class="site-summary-icon" aria-hidden="true">✓</span>
                <span><small>Currently accepted</small><strong><%= formatNumber(summary.currentlyAcceptedUnits || 0) %> of <%= formatNumber(summary.reviewedUnits || 0) %> · <%= formatQcPercent(summary.currentAcceptanceRate) %></strong></span>
              </article>
              <article>
                <span class="site-summary-icon" aria-hidden="true">↻</span>
                <span><small>Correction resolution</small><strong><%= formatQcPercent(summary.correctionResolutionRate) %></strong></span>
              </article>
              <article>
                <span class="site-summary-icon" aria-hidden="true">!</span>
                <span><small>Open correction work</small><strong><%= formatNumber((summary.pendingCorrectionUnits || 0) + (summary.readyForRecheckUnits || 0)) %></strong></span>
              </article>
            </div>
          </section>

          <section class="site-clean-section site-clean-surface">
            <div class="site-clean-section-heading">
              <div>
                <h2>Technician Comparison</h2>
                <p class="site-section-description">Reviewed Units counts completion cycles with at least one QC decision. First-Pass Accepted counts Units that passed without any rejection; Currently Accepted shows the latest accepted status. Each count and percentage stays on one line, and a correction never restores first-pass credit.</p>
              </div>
              <span class="site-section-meta">Generated <%= formatDateTime(generatedAt) %></span>
            </div>

            <div class="table-card">
              <div class="table-scroll">
                <table>
                  <thead>
                    <tr>
                      <th>Technician</th>
                      <th class="table-numeric">Reviewed Units</th>
                      <th class="table-numeric">First-Pass Accepted</th>
                      <th class="table-numeric">Currently Accepted</th>
                      <th class="table-numeric">Rejected First Pass</th>
                      <th class="table-numeric">Corrected After Rejection</th>
                      <th class="table-numeric">Pending Correction</th>
                      <th class="table-numeric">Ready for Recheck</th>
                      <th class="table-numeric">Rechecked Units</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!report.technicianComparisons.length) { %>
                      <tr><td colspan="9">No reviewed completion cycles match the selected reporting scope.</td></tr>
                    <% } %>

                    <% report.technicianComparisons.forEach((technician) => { %>
                      <tr>
                        <td><strong><%= technician.technicianName %></strong></td>
                        <td class="table-numeric"><%= formatNumber(technician.reviewedUnits) %></td>
                        <td class="table-numeric">
                          <span class="table-value-inline" aria-label="<%= formatNumber(technician.firstPassAcceptedUnits) %> first-pass accepted; QC Grade <%= formatQcPercent(technician.qualityGrade) %>">
                            <strong><%= formatNumber(technician.firstPassAcceptedUnits) %></strong>
                            <span class="table-value-inline-separator" aria-hidden="true">·</span>
                            <small><%= formatQcPercent(technician.qualityGrade) %></small>
                          </span>
                        </td>
                        <td class="table-numeric">
                          <span class="table-value-inline" aria-label="<%= formatNumber(technician.currentlyAcceptedUnits) %> currently accepted; Current Acceptance <%= formatQcPercent(technician.currentAcceptanceRate) %>">
                            <strong><%= formatNumber(technician.currentlyAcceptedUnits) %></strong>
                            <span class="table-value-inline-separator" aria-hidden="true">·</span>
                            <small><%= formatQcPercent(technician.currentAcceptanceRate) %></small>
                          </span>
                        </td>
                        <td class="table-numeric"><%= formatNumber(technician.firstPassRejectedUnits) %></td>
                        <td class="table-numeric"><%= formatNumber(technician.correctedUnits) %></td>
                        <td class="table-numeric"><span class="pill <%= technician.pendingCorrectionUnits > 0 ? 'bad' : 'neutral' %>"><%= formatNumber(technician.pendingCorrectionUnits) %></span></td>
                        <td class="table-numeric"><span class="pill <%= technician.readyForRecheckUnits > 0 ? 'warning' : 'neutral' %>"><%= formatNumber(technician.readyForRecheckUnits) %></span></td>
                        <td class="table-numeric"><%= formatNumber(technician.repeatedReviewUnits) %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <section class="site-clean-section site-clean-surface">
            <div class="site-clean-section-heading">
              <div>
                <h2>Rejection Patterns</h2>
                <p class="site-section-description">Exact rejection notes are grouped after whitespace and capitalization are normalized. Similar wording is not automatically merged.</p>
              </div>
              <span class="pill neutral"><%= formatNumber(report.rejectionActions) %> rejection action<%= report.rejectionActions === 1 ? '' : 's' %></span>
            </div>

            <div class="table-card">
              <div class="table-scroll">
                <table>
                  <thead>
                    <tr>
                      <th>Rejection Note</th>
                      <th class="table-numeric">Occurrences</th>
                      <th class="table-numeric">Technicians</th>
                      <th class="table-numeric">Resolved Later</th>
                      <th class="table-numeric">Pending Correction</th>
                      <th class="table-numeric">Ready for Recheck</th>
                      <th class="table-numeric">Most Recent</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!report.rejectionPatterns.length) { %>
                      <tr><td colspan="7">No QC rejection notes match the selected reporting scope.</td></tr>
                    <% } %>

                    <% report.rejectionPatterns.forEach((pattern) => { %>
                      <tr>
                        <td class="table-wrap-cell"><span><%= pattern.reason %></span></td>
                        <td class="table-numeric"><%= formatNumber(pattern.occurrences) %></td>
                        <td class="table-numeric"><%= formatNumber(pattern.techniciansAffected) %></td>
                        <td class="table-numeric"><%= formatNumber(pattern.resolvedAfterCorrection) %></td>
                        <td class="table-numeric"><%= formatNumber(pattern.pendingCorrection) %></td>
                        <td class="table-numeric"><%= formatNumber(pattern.readyForRecheck) %></td>
                        <td class="table-numeric"><%= pattern.latestReviewedAt ? formatDateTime(pattern.latestReviewedAt) : '—' %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <section class="site-clean-section site-clean-surface">
            <div class="site-clean-section-heading">
              <div>
                <h2>Reviewer Activity</h2>
                <p class="site-section-description">Review volume includes first-pass decisions and rechecks. Acceptance rate reflects review actions, not unique Units.</p>
              </div>
              <span class="pill neutral"><%= formatNumber(report.activeReviewers) %> active reviewer<%= report.activeReviewers === 1 ? '' : 's' %></span>
            </div>

            <div class="table-card">
              <div class="table-scroll">
                <table>
                  <thead>
                    <tr>
                      <th>Reviewer</th>
                      <th class="table-numeric">Reviews</th>
                      <th class="table-numeric">Accepted</th>
                      <th class="table-numeric">Rejected</th>
                      <th class="table-numeric">Acceptance Rate</th>
                      <th class="table-numeric">First-pass Reviews</th>
                      <th class="table-numeric">Rechecks</th>
                      <th class="table-numeric">Technicians Reviewed</th>
                      <th class="table-numeric">Most Recent</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!report.reviewerActivity.length) { %>
                      <tr><td colspan="9">No Quality Control reviewer activity matches the selected reporting scope.</td></tr>
                    <% } %>

                    <% report.reviewerActivity.forEach((reviewer) => { %>
                      <tr>
                        <td><strong><%= reviewer.reviewerName %></strong></td>
                        <td class="table-numeric"><%= formatNumber(reviewer.reviews) %></td>
                        <td class="table-numeric"><%= formatNumber(reviewer.acceptedReviews) %></td>
                        <td class="table-numeric"><%= formatNumber(reviewer.rejectedReviews) %></td>
                        <td class="table-numeric"><%= formatQcPercent(reviewer.acceptanceRate) %></td>
                        <td class="table-numeric"><%= formatNumber(reviewer.firstPassReviews) %></td>
                        <td class="table-numeric"><%= formatNumber(reviewer.rechecks) %></td>
                        <td class="table-numeric"><%= formatNumber(reviewer.techniciansReviewed) %></td>
                        <td class="table-numeric"><%= reviewer.latestReviewedAt ? formatDateTime(reviewer.latestReviewedAt) : '—' %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>
