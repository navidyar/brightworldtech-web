<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', {
    pageTitle,
    stylesheets: [
      '/css/tech.css',
      '/css/unit-requests.css?v=20260810-stage10w30-processor-catalog-integrity'
    ]
  }) %>

  <body>
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell unit-requests-page">
          <section class="dashboard-hero accent-green">
            <div>
              <p class="eyebrow"><%= request.requestTypeLabel %></p>
              <h2>Request #<%= request.unitRequestId %></h2>
              <p>
                <%= request.isIntentionalDuplicateRequest
                  ? 'Review the matching existing record, immutable requested intake snapshot, and request history.'
                  : request.isQcReversionRequest
                    ? 'Review the exact QC decision being challenged, the QC requester reason, and the immutable audit context.'
                    : 'Review the original observed catalog value, requester explanation, canonical approval details, and request history.' %>
              </p>
            </div>

            <div class="hero-badge"><span>Status</span><strong><%= request.statusLabel %></strong></div>
          </section>

          <section class="content-card">
            <div class="content-header unit-request-detail-header">
              <div>
                <p class="eyebrow">Request Summary</p>
                <h2><%= request.requestTypeLabel %></h2>
                <p class="unit-request-detail-meta">
                  Requested by <%= request.requestedByName %> · <%= request.submittedAt ? formatDateTime(request.submittedAt) : '—' %>
                  <% if (request.isArchived) { %> · Archived <%= request.archivedAt ? formatDateTime(request.archivedAt) : '—' %><% } %>
                </p>
              </div>
              <a class="secondary-button" href="<%= unitRequestQueueUrl %>">Back to Requests</a>
            </div>

            <% if (successMessage) { %><div class="message success"><p><%= successMessage %></p></div><% } %>
            <% if (errorMessages.length > 0) { %><div class="message error"><% errorMessages.forEach((errorMessage) => { %><p><%= errorMessage %></p><% }) %></div><% } %>

            <% if (request.isIntentionalDuplicateRequest) { %>
              <div class="unit-request-detail-grid unit-request-detail-overview">
                <section class="unit-request-detail-card">
                  <p class="eyebrow">Matching Existing Unit</p>
                  <h3><%= request.matchedUnitLabel %></h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Current / Last Lot</dt><dd><%= request.matchedUnitCurrentLotName %></dd></div>
                    <div><dt>Unit Serial</dt><dd><%= request.matchedUnitSnapshot.unitSerialNumber || '—' %></dd></div>
                    <div><dt>BIOS Serial</dt><dd><%= request.matchedUnitSnapshot.biosSerialNumber || '—' %></dd></div>
                    <div><dt>Manufacturer</dt><dd><%= request.matchedUnitSnapshot.manufacturerLabel || '—' %></dd></div>
                    <div><dt>Model</dt><dd><%= request.matchedUnitSnapshot.modelLabel || request.matchedUnitSnapshot.modelSummary || '—' %></dd></div>
                    <div><dt>Processor</dt><dd><%= request.matchedUnitSnapshot.cpuSummary || '—' %></dd></div>
                    <div><dt>Assigned To</dt><dd><%= request.matchedUnitSnapshot.assignedToName || 'Unassigned' %></dd></div>
                  </dl>
                </section>

                <section class="unit-request-detail-card">
                  <p class="eyebrow">Requested New Unit</p>
                  <h3>Immutable Intake Snapshot</h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Destination Lot</dt><dd><%= request.snapshotDisplay.destinationLotName || request.requestedDestinationLotName %></dd></div>
                    <div><dt>Category</dt><dd><%= request.snapshotDisplay.unitCategoryLabel || '—' %></dd></div>
                    <div><dt>Manufacturer</dt><dd><%= request.snapshotDisplay.manufacturerLabel || '—' %></dd></div>
                    <div><dt>Model</dt><dd><%= request.snapshotDisplay.modelLabel || '—' %></dd></div>
                    <div><dt>Processor</dt><dd><%= request.snapshotDisplay.processorLabel || '—' %></dd></div>
                    <div><dt>Operating System</dt><dd><%= request.snapshotDisplay.operatingSystemLabel || '—' %></dd></div>
                    <div><dt>Serials</dt><dd><%= request.snapshotDisplay.serialSummary || '—' %></dd></div>
                  </dl>
                </section>
              </div>

              <% if (request.snapshotDisplay.manufacturerDiffers || request.snapshotDisplay.modelDiffers) { %>
                <section class="unit-request-detail-section">
                  <p class="eyebrow">Identity Differences</p>
                  <p>The proposed Unit has different identity details from the matching record. This is permitted for an Intentional Duplicate request and is shown here for explicit review.</p>
                  <dl class="unit-request-detail-list">
                    <% if (request.snapshotDisplay.manufacturerDiffers) { %>
                      <div><dt>Manufacturer</dt><dd><%= request.snapshotDisplay.existingManufacturerLabel || request.matchedUnitSnapshot.manufacturerLabel || '—' %> → <%= request.snapshotDisplay.manufacturerLabel || '—' %></dd></div>
                    <% } %>
                    <% if (request.snapshotDisplay.modelDiffers) { %>
                      <div><dt>Model</dt><dd><%= request.snapshotDisplay.existingModelLabel || request.matchedUnitSnapshot.modelLabel || '—' %> → <%= request.snapshotDisplay.modelLabel || '—' %></dd></div>
                    <% } %>
                  </dl>
                </section>
              <% } %>
            <% } else if (request.isQcReversionRequest && request.qcReversionContext) { %>
              <div class="unit-request-detail-grid unit-request-detail-overview">
                <section class="unit-request-detail-card">
                  <p class="eyebrow">Quality Control Decision</p>
                  <h3><%= request.qcReversionContext.unitLabel %></h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Decision</dt><dd><%= request.qcReversionContext.decisionLabel %></dd></div>
                    <div><dt>Exact QC Check</dt><dd>#<%= request.qcReversionContext.qcCheckId %></dd></div>
                    <div><dt>Work Completion</dt><dd>#<%= request.qcReversionContext.unitWorkCompletionId %></dd></div>
                    <div><dt>Recorded By</dt><dd><%= request.qcReversionContext.qcReviewedByName || 'User not recorded' %></dd></div>
                    <div><dt>Recorded At</dt><dd><%= request.qcReversionContext.qcReviewedAt ? formatDateTime(request.qcReversionContext.qcReviewedAt) : '—' %></dd></div>
                  </dl>
                </section>
                <section class="unit-request-detail-card">
                  <p class="eyebrow">Immutable QC Snapshot</p>
                  <h3><%= request.qcReversionContext.detailLabel %></h3>
                  <p><%= request.qcReversionContext.qcReviewNotes || 'No QC review note was recorded.' %></p>
                  <p class="table-muted-line">While this request is pending, the <%= request.qcReversionContext.decisionLabel %> decision remains current. Approval reverts only this exact QC check, preserves the original decision in audit history, and returns the Unit to Awaiting QC.</p>
                </section>
              </div>
            <% } else if (request.catalogContext && request.catalogContext.kind === 'model') { %>
              <div class="unit-request-detail-grid unit-request-detail-overview">
                <section class="unit-request-detail-card">
                  <p class="eyebrow">Observed Model</p>
                  <h3><%= request.catalogContext.requestedModelName %></h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Manufacturer</dt><dd><%= request.catalogContext.manufacturerName %></dd></div>
                    <div><dt>Unit Category</dt><dd><%= request.catalogContext.unitCategoryLabel %></dd></div>
                  </dl>
                </section>
                <section class="unit-request-detail-card">
                  <p class="eyebrow">Canonical Approval Result</p>
                  <h3><%= request.catalogContext.approvedModelName || 'Pending Review' %></h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Managed Unit Model</dt><dd><%= request.catalogContext.approvedUnitModelLabel || 'Not added yet' %></dd></div>
                    <div><dt>Result</dt><dd><%= request.status === 'approved' ? 'Available for Create Unit selection' : 'No catalog change yet' %></dd></div>
                  </dl>
                </section>
              </div>
            <% } else if (request.catalogContext && request.catalogContext.kind === 'processor') { %>
              <div class="unit-request-detail-grid unit-request-detail-overview">
                <section class="unit-request-detail-card">
                  <p class="eyebrow">Observed Processor</p>
                  <h3><%= request.catalogContext.requestedProcessorName %></h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Processor Type</dt><dd><%= request.catalogContext.requestedProcessorType %></dd></div>
                    <div><dt>Processor Speed</dt><dd><%= request.catalogContext.requestedProcessorSpeedGhz ? `${request.catalogContext.requestedProcessorSpeedGhz} GHz` : 'Not provided' %></dd></div>
                    <div><dt>Manufacturer</dt><dd><%= request.catalogContext.manufacturerName %></dd></div>
                    <div><dt>Unit Model</dt><dd><%= request.catalogContext.unitModelName %></dd></div>
                    <div><dt>Unit Category</dt><dd><%= request.catalogContext.unitCategoryLabel %></dd></div>
                  </dl>
                </section>
                <section class="unit-request-detail-card">
                  <p class="eyebrow">Canonical Approval Result</p>
                  <h3><%= request.catalogContext.approvedProcessorModelLabel || 'Pending Review' %></h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Processor Type</dt><dd><%= request.catalogContext.approvedProcessorBrandName || 'Not selected yet' %></dd></div>
                    <div><dt>Processor Speed</dt><dd><%= request.catalogContext.approvedProcessorBaseSpeedGhz ? `${request.catalogContext.approvedProcessorBaseSpeedGhz} GHz` : 'Not confirmed yet' %></dd></div>
                    <div><dt>Compatibility</dt><dd><%= request.status === 'approved' ? `Mapped to ${request.catalogContext.unitModelName}` : 'No catalog change yet' %></dd></div>
                  </dl>
                </section>
              </div>
            <% } %>

            <section class="unit-request-detail-section">
              <p class="eyebrow">Requester Explanation</p>
              <p class="unit-request-requester-note"><%= request.requesterNote || 'No requester note entered.' %></p>
            </section>

            <% if (request.isIntentionalDuplicateRequest && request.createdUnitId) { %>
              <section class="unit-request-detail-section">
                <p class="eyebrow">Approval Result</p>
                <p>Created Unit: <a href="/tech/units?search=<%= encodeURIComponent(request.createdUnitLabel || '') %>"><%= request.createdUnitLabel || `Unit #${request.createdUnitId}` %></a></p>
              </section>
            <% } %>

            <% if (canReviewThisRequest && request.isPending) { %>
              <section class="unit-request-review-panel">
                <div>
                  <p class="eyebrow">Reviewer Action</p>
                  <h3>Approve or Reject</h3>
                  <p>
                    <%= request.isIntentionalDuplicateRequest
                      ? 'Approval creates the requested new Unit in the original destination lot only if that lot is still open, visible, and assignable.'
                      : request.isQcReversionRequest
                        ? 'Approval revalidates and reverts only the exact current QC decision shown here. The QC requester reason becomes the permanent reversion reason; an optional reviewer note remains separate.'
                        : 'Approval writes only the canonical catalog value or compatibility mapping shown here. It does not create a Unit.' %>
                  </p>
                </div>

                <% if (request.isQcReversionRequest) { %>
                  <div class="unit-request-review-actions">
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/approve">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <label class="form-field"><span>Reviewer Note <small>(optional)</small></span><textarea name="reviewerNote" rows="3" maxlength="1000" placeholder="Optional context for approving this QC reversion request."></textarea></label>
                      <button class="primary-button" type="submit">Approve Reversion</button>
                    </form>
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/reject">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <label class="form-field"><span>Rejection Note</span><textarea name="reviewerNote" rows="3" minlength="3" maxlength="1000" required placeholder="Explain why the current QC decision should remain in effect."></textarea></label>
                      <button class="secondary-button" type="submit">Reject Reversion</button>
                    </form>
                  </div>
                <% } else if (request.isIntentionalDuplicateRequest) { %>
                  <div class="unit-request-review-actions">
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/approve">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <label class="form-field"><span>Approval Note <small>(optional)</small></span><textarea name="reviewerNote" rows="3" maxlength="1000" placeholder="Optional approval context"></textarea></label>
                      <button class="primary-button" type="submit">Approve and Create New Unit</button>
                    </form>
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/reject">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <label class="form-field"><span>Rejection Note</span><textarea name="reviewerNote" rows="3" minlength="3" maxlength="1000" required placeholder="Explain why this should not create a new unit."></textarea></label>
                      <button class="secondary-button" type="submit">Reject Request</button>
                    </form>
                  </div>
                <% } else if (request.catalogContext && request.catalogContext.kind === 'model') { %>
                  <div class="unit-request-review-actions">
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/approve">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <label class="form-field"><span>Canonical Unit Model Name</span><input type="text" name="approvedModelName" value="<%= request.catalogContext.requestedModelName %>" minlength="2" maxlength="150" required /></label>
                      <label class="form-field"><span>Approval Note <small>(optional)</small></span><textarea name="reviewerNote" rows="3" maxlength="1000" placeholder="Optional normalization or source note"></textarea></label>
                      <button class="primary-button" type="submit">Approve Model Request</button>
                    </form>
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/reject">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <label class="form-field"><span>Rejection Note</span><textarea name="reviewerNote" rows="3" minlength="3" maxlength="1000" required placeholder="Explain why this model should not be added or reactivated."></textarea></label>
                      <button class="secondary-button" type="submit">Reject Request</button>
                    </form>
                  </div>
                <% } else if (request.catalogContext && request.catalogContext.kind === 'processor') { %>
                  <div class="unit-request-review-actions processor-request-review-actions">
                    <form class="processor-request-approval-form" method="post" action="/unit-requests/<%= request.unitRequestId %>/approve" data-processor-request-approval-form data-reviewer-is-admin="<%= isAdminCatalogReviewer ? '1' : '0' %>">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <input type="hidden" name="approvedExistingProcessorModelId" value="" data-existing-processor-id />

                      <div class="processor-request-mode-section processor-request-mode-section--existing">
                        <div class="processor-request-mode-heading">
                          <strong>1. Reuse an Existing Processor whenever possible</strong>
                          <span>This adds the canonical Processor to <%= request.catalogContext.manufacturerName %> <%= request.catalogContext.unitModelName %>; it does not create a duplicate Processor record.</span>
                        </div>

                        <% if (processorCatalogMatches.length > 0) { %>
                          <div class="processor-request-catalog-matches">
                            <strong>Global Processor Catalog matches for this request</strong>
                            <% processorCatalogMatches.forEach((match) => { %>
                              <div class="processor-request-catalog-match <%= match.identityMatch ? 'processor-request-catalog-match--strong' : '' %>">
                                <span><strong>#<%= match.id %> · <%= match.displayLabel %></strong> <span class="pill <%= match.isActive ? 'good' : 'neutral' %>"><%= match.isActive ? 'Active' : 'Inactive' %></span></span>
                                <small><%= match.unitModelLabels.length ? `Currently associated with ${match.unitModelLabels.slice(0, 4).join(', ')}${match.unitModelLabels.length > 4 ? ` +${match.unitModelLabels.length - 4} more` : ''}.` : 'Not currently associated with any Unit Models.' %></small>
                                <% if (match.isActive) { %><button type="button" class="secondary-button button-small" data-use-existing-processor-value="#<%= match.id %> · <%= match.displayLabel %>">Use Existing</button><% } else if (isAdminCatalogReviewer) { %><small>Reactivate this Processor in Processor Catalog before using it.</small><% } else { %><small>Ask an Admin to reactivate this Processor in Configuration before using it.</small><% } %>
                              </div>
                            <% }) %>
                          </div>
                        <% } %>

                        <label class="form-field processor-request-existing-field">
                          <span>Existing Canonical Processor</span>
                          <input type="search" list="processor-catalog-options" autocomplete="off" placeholder="Search the global catalog, for example i5-9500T" data-existing-processor-search />
                          <datalist id="processor-catalog-options">
                            <% processorCatalogOptions.forEach((processor) => { %>
                              <option value="#<%= processor.id %> · <%= processor.displayLabel %>" data-processor-id="<%= processor.id %>" data-model-code="<%= processor.modelCode %>" data-brand-name="<%= processor.brandName %>" data-model-labels="<%= processor.unitModelLabels.join(' | ') %>"></option>
                            <% }) %>
                          </datalist>
                          <small class="field-hint" data-existing-processor-hint>Searches the entire Processor Catalog, not only processors already associated with this Unit Model.</small>
                        </label>
                      </div>

                      <div class="processor-request-mode-divider"><span>OR</span></div>

                      <div class="processor-request-mode-section" data-new-processor-section>
                        <div class="processor-request-mode-heading">
                          <strong>2. Create a New Canonical Processor only when none exists</strong>
                          <span>Keep the Processor name concise. Store family, generation, and GHz in their separate fields.</span>
                        </div>

                        <div class="message" data-processor-similarity-warning hidden>
                          <p><strong>Possible existing processor:</strong> <span data-processor-similarity-text></span></p>
                          <p>Select the existing canonical Processor above rather than creating a duplicate.</p>
                        </div>
                        <div class="message error" data-processor-format-warning hidden>
                          <p><strong>Canonical Processor name needs correction:</strong> <span data-processor-format-text></span></p>
                        </div>

                        <div class="processor-request-approval-grid">
                          <label class="form-field">
                            <span>Processor Type</span>
                            <select name="approvedProcessorBrandId" data-processor-brand-select data-new-processor-field>
                              <option value="">Create/reactivate the Processor Type named beside this field</option>
                              <% processorBrands.forEach((processorBrand) => { %><option value="<%= processorBrand.id %>"><%= processorBrand.label %></option><% }) %>
                            </select>
                          </label>
                          <label class="form-field">
                            <span>Canonical Processor Type Name</span>
                            <input type="text" name="approvedProcessorBrandName" value="<%= request.catalogContext.requestedProcessorType %>" minlength="2" maxlength="100" required data-canonical-processor-brand data-new-processor-field />
                          </label>
                          <label class="form-field">
                            <span>Canonical Processor</span>
                            <input type="text" name="approvedProcessorModelCode" value="<%= request.catalogContext.requestedProcessorName %>" minlength="2" maxlength="150" required data-canonical-processor-model data-new-processor-field />
                          </label>
                          <label class="form-field">
                            <span>Processor Family <small>(optional)</small></span>
                            <input type="text" name="approvedProcessorFamily" maxlength="100" placeholder="Example: Core" data-new-processor-field />
                          </label>
                          <label class="form-field">
                            <span>Generation <small>(optional)</small></span>
                            <input type="text" name="approvedProcessorGeneration" maxlength="80" placeholder="Example: 9th Gen" data-new-processor-field />
                          </label>
                          <label class="form-field">
                            <span>Base Speed GHz</span>
                            <input type="number" name="approvedProcessorBaseSpeedGhz" value="<%= request.catalogContext.requestedProcessorSpeedGhz || '' %>" min="0.01" max="99.99" step="0.01" required placeholder="Example: 2.20" data-canonical-processor-speed data-new-processor-field />
                          </label>
                        </div>

                        <p class="field-hint processor-request-canonical-hint">Example canonical record: <strong>Intel</strong> · <strong>i5-9500T</strong> · Family <strong>Core</strong> · Generation <strong>9th Gen</strong> · Base Speed <strong>2.20 GHz</strong>. Do not put “Intel Core”, “@ 2.20 GHz”, or generation text into the Processor field.</p>

                        <div class="message info processor-request-admin-confirmation-note">
                          <p><strong>Admin Catalog Review:</strong> Reuse an existing Processor whenever one already exists. Keep canonical Processor naming and metadata consistent with the global catalog.</p>
                        </div>
                      </div>

                      <label class="form-field processor-request-approval-note"><span>Approval Note <small>(optional)</small></span><textarea name="reviewerNote" rows="3" maxlength="1000" placeholder="Optional compatibility or normalization note"></textarea></label>
                      <div class="form-actions">
                        <button class="primary-button" type="submit" data-processor-approve-button>Approve Processor Request</button>
                        <% if (isAdminCatalogReviewer) { %>
                          <a class="secondary-button" href="/management/config/processors?search=<%= encodeURIComponent(request.catalogContext.requestedProcessorName || '') %>">Open Processor Catalog</a>
                        <% } %>
                      </div>
                    </form>
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/reject">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <label class="form-field"><span>Rejection Note</span><textarea name="reviewerNote" rows="3" minlength="3" maxlength="1000" required placeholder="Explain why this processor should not be added or mapped."></textarea></label>
                      <button class="secondary-button" type="submit">Reject Request</button>
                    </form>
                  </div>
                <% } %>
              </section>
            <% } else if (canReviewRequests && request.isCatalogRequest && request.isPending && !canManageCatalogRequests) { %>
              <section class="unit-request-detail-section">
                <p class="eyebrow">Catalog Review Access</p>
                <p>Tech Leads and Management can inspect Model and Processor Catalog requests, but only Admin can approve or reject them.</p>
              </section>
            <% } else if (canWithdrawRequest) { %>
              <section class="unit-request-review-panel">
                <div><p class="eyebrow">Requester Action</p><h3>Withdraw Pending Request</h3><p>Withdrawing does not change any Unit record or catalog value and cannot be undone.</p></div>
                <form method="post" action="/unit-requests/<%= request.unitRequestId %>/withdraw" onsubmit="return window.confirm('Withdraw this pending request?');">
                  <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                  <label class="form-field"><span>Withdrawal Note <small>(optional)</small></span><textarea name="withdrawalNote" rows="3" maxlength="1000" placeholder="Optional context"></textarea></label>
                  <button class="secondary-button" type="submit">Withdraw Request</button>
                </form>
              </section>
            <% } else if (!request.isPending && request.reviewerNote) { %>
              <section class="unit-request-detail-section">
                <p class="eyebrow">Reviewer Note</p>
                <p class="unit-request-requester-note"><%= request.reviewerNote %></p>
                <p class="table-muted-line"><%= request.reviewedByName || 'Reviewed' %> · <%= request.reviewedAt ? formatDateTime(request.reviewedAt) : '—' %></p>
              </section>
            <% } %>

            <section class="unit-request-detail-section">
              <p class="eyebrow">Request History</p>
              <ol class="unit-request-event-list">
                <% if (!request.events || request.events.length === 0) { %><li>No request history was recorded.</li><% } %>
                <% (request.events || []).forEach((event) => { %>
                  <li>
                    <strong><%= event.eventType.charAt(0).toUpperCase() + event.eventType.slice(1) %></strong>
                    <span><%= event.performedByName %> · <%= event.occurredAt ? formatDateTime(event.occurredAt) : '—' %></span>
                    <% if (event.eventNote) { %><p><%= event.eventNote %></p><% } %>
                  </li>
                <% }) %>
              </ol>
            </section>
          </section>
        </main>
      </div>
    </div>
    <script defer src="/js/processor-request-review.js?v=20260810-stage10w30-processor-catalog-integrity"></script>
  </body>
</html>
