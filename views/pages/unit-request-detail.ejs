<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { pageTitle }) %>

  <body class="css-scope-unit-requests">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell unit-requests-page">
          <section class="page-heading site-work-page-heading record-detail-intro record-detail-intro--<%= request.statusClass %>">
            <div>
              <p class="eyebrow"><%= request.requestTypeLabel %></p>
              <h1><%= request.displaySubject %></h1>
              <p>
                <%= request.isIntentionalDuplicateRequest
                  ? 'Review the matching existing record, immutable requested intake snapshot, and request history.'
                  : request.isQcReversionRequest
                    ? 'Review the exact QC decision being challenged, the QC requester reason, and the immutable audit context.'
                    : 'Review the original observed catalog value, requester explanation, catalog approval details, and request history.' %>
              </p>
            </div>
            <div class="site-clean-actions site-inline-actions"><a class="secondary-button" href="<%= unitRequestQueueUrl %>">Back to Requests</a></div>
          </section>

          <section class="site-summary-panel site-summary-panel--expanded record-detail-summary-panel unit-request-detail-header" aria-label="Request summary">
            <div class="site-summary-primary record-detail-status record-detail-status--<%= request.statusClass %>">
              <span>Status</span>
              <strong><%= request.statusLabel %></strong>
              <small class="unit-request-detail-meta">Requested by <%= request.requestedByName %> · <%= request.submittedAt ? formatDateTime(request.submittedAt) : '—' %><% if (request.isArchived) { %> · Archived <%= request.archivedAt ? formatDateTime(request.archivedAt) : '—' %><% } %></small>
            </div>
            <div class="site-summary-stats">
              <article><span class="site-summary-icon" aria-hidden="true">R</span><span><small>Request Type</small><strong><%= request.requestTypeLabel %></strong></span></article>
              <article><span class="site-summary-icon" aria-hidden="true">U</span><span><small>Requested By</small><strong><%= request.requestedByName %></strong></span></article>
              <article><span class="site-summary-icon" aria-hidden="true">↗</span><span><small>Submitted</small><strong><%= request.submittedAt ? formatDateTime(request.submittedAt) : '—' %></strong></span></article>
            </div>
          </section>

          <section class="content-card record-detail-shell">
            <% if (successMessage) { %><div class="message success" data-auto-dismiss-success><p><%= successMessage %></p></div><% } %>
            <% if (errorMessages.length > 0) { %><div class="message error"><% errorMessages.forEach((errorMessage) => { %><p><%= errorMessage %></p><% }) %></div><% } %>

            <% if (request.isIntentionalDuplicateRequest) { %>
              <div class="unit-request-detail-grid unit-request-detail-overview record-detail-split">
                <section class="unit-request-detail-card record-detail-section">
                  <p class="eyebrow">Matching Existing Unit</p>
                  <h3><%= request.matchedUnitLabel %></h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Current / Last Lot</dt><dd><%= request.matchedUnitCurrentLotName %></dd></div>
                    <div><dt>Unit Serial</dt><dd><%= request.matchedUnitSnapshot.unitSerialNumber || '—' %></dd></div>
                    <div><dt>BIOS Serial</dt><dd><%= request.matchedUnitSnapshot.biosSerialNumber || '—' %></dd></div>
                    <div><dt>System UUID</dt><dd><%= request.matchedUnitSnapshot.systemUuid || request.snapshotDisplay.existingSystemUuid || '—' %></dd></div>
                    <div><dt>Manufacturer</dt><dd><%= request.matchedUnitSnapshot.manufacturerLabel || '—' %></dd></div>
                    <div><dt>Model</dt><dd><%= request.matchedUnitSnapshot.modelLabel || request.matchedUnitSnapshot.modelSummary || '—' %></dd></div>
                    <div><dt>Processor</dt><dd><%= request.matchedUnitSnapshot.cpuSummary || '—' %></dd></div>
                    <div><dt>Assigned To</dt><dd><%= request.matchedUnitSnapshot.assignedToName || 'Unassigned' %></dd></div>
                  </dl>
                </section>

                <section class="unit-request-detail-card record-detail-section">
                  <p class="eyebrow">Requested New Unit</p>
                  <h3>Immutable Intake Snapshot</h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Destination Lot</dt><dd><%= request.snapshotDisplay.destinationLotName || request.requestedDestinationLotName %></dd></div>
                    <div><dt>Category</dt><dd><%= request.snapshotDisplay.unitCategoryLabel || '—' %></dd></div>
                    <div><dt>Manufacturer</dt><dd><%= request.snapshotDisplay.manufacturerLabel || '—' %></dd></div>
                    <div><dt>Model</dt><dd><%= request.snapshotDisplay.modelLabel || '—' %></dd></div>
                    <div><dt>Processor</dt><dd><%= request.snapshotDisplay.processorLabel || '—' %></dd></div>
                    <div><dt>Operating System</dt><dd><%= request.snapshotDisplay.operatingSystemLabel || '—' %></dd></div>
                    <div><dt>Serials</dt><dd><%= request.snapshotDisplay.serialSummary || '—' %></dd></div>
                    <div><dt>System UUID</dt><dd><%= request.snapshotDisplay.systemUuid || '—' %></dd></div>
                  </dl>
                </section>
              </div>


              <% if (request.snapshotDisplay.systemUuidMatchesExisting) { %>
                <section class="unit-request-detail-section record-detail-section">
                  <p class="eyebrow">System UUID Collision</p>
                  <div class="message warning">
                    <p><strong>Exact valid UUID match requires manual approval.</strong> The proposed physical Unit reports the same System UUID as the existing BWTDallas Unit. The Lot's duplicate allowance does not bypass this review.</p>
                  </div>
                </section>
              <% } %>

              <% if (request.snapshotDisplay.manufacturerDiffers || request.snapshotDisplay.modelDiffers) { %>
                <section class="unit-request-detail-section record-detail-section">
                  <p class="eyebrow">Identity Differences</p>
                  <p>The proposed Unit has different identity details from the matching record. This is permitted for an Intentional Duplicate request and is shown here for explicit review.</p>
                  <dl class="unit-request-detail-list">
                    <% if (request.snapshotDisplay.manufacturerDiffers) { %>
                      <div><dt>Manufacturer</dt><dd><%= request.snapshotDisplay.existingManufacturerLabel || request.matchedUnitSnapshot.manufacturerLabel || '—' %> → <%= request.snapshotDisplay.manufacturerLabel || '—' %></dd></div>
                    <% } %>
                    <% if (request.snapshotDisplay.modelDiffers) { %>
                      <div><dt>Model</dt><dd><%= request.snapshotDisplay.existingModelLabel || request.matchedUnitSnapshot.modelLabel || '—' %> → <%= request.snapshotDisplay.modelLabel || '—' %></dd></div>
                    <% } %>
                  </dl>
                </section>
              <% } %>
            <% } else if (request.isQcReversionRequest && request.qcReversionContext) { %>
              <div class="unit-request-detail-grid unit-request-detail-overview record-detail-split">
                <section class="unit-request-detail-card record-detail-section">
                  <p class="eyebrow">Quality Control Decision</p>
                  <h3><%= request.qcReversionContext.unitLabel %></h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Decision</dt><dd><%= request.qcReversionContext.decisionLabel %></dd></div>
                    <div><dt>Exact QC Check</dt><dd>#<%= request.qcReversionContext.qcCheckId %></dd></div>
                    <div><dt>Work Completion</dt><dd>#<%= request.qcReversionContext.unitWorkCompletionId %></dd></div>
                    <div><dt>Recorded By</dt><dd><%= request.qcReversionContext.qcReviewedByName || 'User not recorded' %></dd></div>
                    <div><dt>Recorded At</dt><dd><%= request.qcReversionContext.qcReviewedAt ? formatDateTime(request.qcReversionContext.qcReviewedAt) : '—' %></dd></div>
                  </dl>
                </section>
                <section class="unit-request-detail-card record-detail-section">
                  <p class="eyebrow">Immutable QC Snapshot</p>
                  <h3><%= request.qcReversionContext.detailLabel %></h3>
                  <p><%= request.qcReversionContext.qcReviewNotes || 'No QC review note was recorded.' %></p>
                  <p class="table-muted-line">While this request is pending, the <%= request.qcReversionContext.decisionLabel %> decision remains current. Approval reverts only this exact QC check, preserves the original decision in audit history, and returns the Unit to Awaiting QC.</p>
                </section>
              </div>
            <% } else if (request.catalogContext && request.catalogContext.kind === 'model') { %>
              <div class="unit-request-detail-grid unit-request-detail-overview record-detail-split">
                <section class="unit-request-detail-card record-detail-section">
                  <p class="eyebrow">Observed Model</p>
                  <h3><%= request.catalogContext.requestedModelName %></h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Manufacturer</dt><dd><%= request.catalogContext.manufacturerName %></dd></div>
                    <div><dt>Unit Category</dt><dd><%= request.catalogContext.unitCategoryLabel %></dd></div>
                  </dl>
                </section>
                <section class="unit-request-detail-card record-detail-section record-detail-result-section record-detail-result-section--<%= request.statusClass %>">
                  <p class="eyebrow">Catalog Approval Result</p>
                  <h3><%= request.catalogContext.approvedModelName || 'Pending Review' %></h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Managed Unit Model</dt><dd><%= request.catalogContext.approvedUnitModelLabel || 'Not added yet' %></dd></div>
                    <div><dt>Result</dt><dd><%= request.status === 'approved' ? 'Available for Create Unit selection' : 'No catalog change yet' %></dd></div>
                  </dl>
                </section>
              </div>
            <% } else if (request.catalogContext && request.catalogContext.kind === 'processor') { %>
              <div class="unit-request-detail-grid unit-request-detail-overview record-detail-split">
                <section class="unit-request-detail-card record-detail-section">
                  <p class="eyebrow">Observed Processor</p>
                  <h3><%= request.catalogContext.requestedProcessorName %></h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Processor Type</dt><dd><%= request.catalogContext.requestedProcessorType %></dd></div>
                    <div><dt>Processor Speed</dt><dd><%= request.catalogContext.requestedProcessorSpeedGhz ? `${request.catalogContext.requestedProcessorSpeedGhz} GHz` : 'Not provided' %></dd></div>
                    <div><dt>Manufacturer</dt><dd><%= request.catalogContext.manufacturerName %></dd></div>
                    <div><dt>Unit Model</dt><dd><%= request.catalogContext.unitModelName %></dd></div>
                    <div><dt>Unit Category</dt><dd><%= request.catalogContext.unitCategoryLabel %></dd></div>
                  </dl>
                </section>
                <section class="unit-request-detail-card record-detail-section record-detail-result-section record-detail-result-section--<%= request.statusClass %>">
                  <p class="eyebrow">Catalog Approval Result</p>
                  <h3><%= request.catalogContext.approvedProcessorModelLabel || 'Pending Review' %></h3>
                  <dl class="unit-request-detail-list">
                    <div><dt>Processor Type</dt><dd><%= request.catalogContext.approvedProcessorBrandName || 'Not selected yet' %></dd></div>
                    <div><dt>Processor Speed</dt><dd><%= request.catalogContext.approvedProcessorBaseSpeedGhz ? `${request.catalogContext.approvedProcessorBaseSpeedGhz} GHz` : 'Not confirmed yet' %></dd></div>
                    <div><dt>Compatibility</dt><dd><%= request.status === 'approved' ? `Mapped to ${request.catalogContext.unitModelName}` : 'No catalog change yet' %></dd></div>
                  </dl>
                </section>
              </div>
            <% } %>

            <section class="unit-request-detail-section record-detail-section record-detail-user-section">
              <p class="eyebrow">Requester Explanation</p>
              <p class="unit-request-requester-note"><%= request.requesterNote || 'No requester note entered.' %></p>
            </section>

            <% if (request.isIntentionalDuplicateRequest && request.createdUnitId) { %>
              <section class="unit-request-detail-section record-detail-section">
                <p class="eyebrow">Approval Result</p>
                <p>Created Unit: <a href="/tech/units?search=<%= encodeURIComponent(request.createdUnitLabel || '') %>"><%= request.createdUnitLabel || `Unit #${request.createdUnitId}` %></a></p>
              </section>
            <% } %>

            <% if (request.isToolUuidDuplicateAuthorization && request.status === 'approved' && !request.createdUnitId) { %>
              <section class="unit-request-detail-section record-detail-section">
                <p class="eyebrow">Approval Result</p>
                <p>Approved for one Tool Commit. The requesting Tool user must rerun Resolve + Preflight with this request ID before creating the duplicate Unit.</p>
              </section>
            <% } %>

            <% if (canReviewThisRequest && request.isPending) { %>
              <section class="unit-request-review-panel">
                <div>
                  <p class="eyebrow">Reviewer Action</p>
                  <h3>Approve or Reject</h3>
                  <p>
                    <%= request.isIntentionalDuplicateRequest
                      ? (request.isToolUuidDuplicateAuthorization
                        ? 'Approval authorizes exactly one Tool Commit for this verified System UUID collision. It does not create the Unit from this page.'
                        : 'Approval creates the requested new Unit in the original destination lot only if that lot is still open, visible, and assignable.')
                      : request.isQcReversionRequest
                        ? 'Approval revalidates and reverts only the exact current QC decision shown here. The QC requester reason becomes the permanent reversion reason; an optional reviewer note remains separate.'
                        : 'Approval writes only the saved catalog value or compatibility mapping shown here. It does not create a Unit.' %>
                  </p>
                </div>

                <% if (request.isQcReversionRequest) { %>
                  <div class="unit-request-review-actions">
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/approve">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <label class="form-field"><span>Reviewer Note <small>(optional)</small></span><textarea name="reviewerNote" rows="3" maxlength="1000" placeholder="Optional context for approving this QC reversion request."></textarea></label>
                      <button class="primary-button" type="submit">Approve Reversion</button>
                    </form>
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/reject">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <label class="form-field"><span>Rejection Note</span><textarea name="reviewerNote" rows="3" minlength="3" maxlength="1000" required placeholder="Explain why the current QC decision should remain in effect."></textarea></label>
                      <button class="secondary-button" type="submit">Reject Reversion</button>
                    </form>
                  </div>
                <% } else if (request.isIntentionalDuplicateRequest) { %>
                  <div class="unit-request-review-actions">
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/approve">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <label class="form-field"><span>Approval Note <small>(optional)</small></span><textarea name="reviewerNote" rows="3" maxlength="1000" placeholder="Optional approval context"></textarea></label>
                      <button class="primary-button" type="submit"><%= request.isToolUuidDuplicateAuthorization ? 'Approve UUID Duplicate Authorization' : 'Approve and Create New Unit' %></button>
                    </form>
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/reject">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <label class="form-field"><span>Rejection Note</span><textarea name="reviewerNote" rows="3" minlength="3" maxlength="1000" required placeholder="Explain why this should not create a new unit."></textarea></label>
                      <button class="secondary-button" type="submit">Reject Request</button>
                    </form>
                  </div>
                <% } else if (request.catalogContext && request.catalogContext.kind === 'model') { %>
                  <div class="unit-request-review-actions">
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/approve" data-model-request-approval-form>
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <div class="processor-request-mode-section processor-request-mode-section--existing" data-model-request-existing-section>
                        <div class="processor-request-mode-heading">
                          <strong>1. Reuse an Existing Catalog Model whenever possible</strong>
                          <span>BWTDallas recommends exact matches first. Likely alternatives are shown below, and the full manufacturer catalog is available only through search when needed.</span>
                        </div>
                        <div class="message info model-request-observed-category">
                          <p><strong>Observed Unit Category:</strong> <%= request.catalogContext.unitCategoryLabel || 'Unspecified' %></p>
                          <p>This is the category reported with the incoming model. The Catalog Unit Category below may be corrected before approval without changing an existing Catalog Model record.</p>
                        </div>

                        <input
                          type="hidden"
                          name="approvedExistingUnitModelId"
                          value="<%= recommendedModelCatalogMatch?.id || '' %>"
                          data-existing-model-id
                        />

                        <% if (inactiveModelCatalogMatch) { %>
                          <div class="message info">
                            <p><strong>Inactive catalog record found:</strong> #<%= inactiveModelCatalogMatch.id %> · <%= inactiveModelCatalogMatch.manufacturerName %> <%= inactiveModelCatalogMatch.modelName %> · <%= inactiveModelCatalogMatch.unitCategoryLabel %>.</p>
                            <p>This record is not currently active. It is already selected as the recommended Catalog Model. Approving this request will reactivate it instead of creating a duplicate. Choose another match only if this recommendation is not correct.</p>
                            <button
                              type="button"
                              class="secondary-button button-small"
                              data-use-existing-model-id="<%= inactiveModelCatalogMatch.id %>"
                              data-use-existing-model-label="#<%= inactiveModelCatalogMatch.id %> · <%= inactiveModelCatalogMatch.manufacturerName %> <%= inactiveModelCatalogMatch.modelName %> · <%= inactiveModelCatalogMatch.unitCategoryLabel %> (Inactive — will reactivate)"
                              data-use-existing-model-category-id="<%= inactiveModelCatalogMatch.unitCategoryConfigValueId %>"
                              data-use-existing-model-category-label="<%= inactiveModelCatalogMatch.unitCategoryLabel %>"
                            >Use This Inactive Model</button>
                          </div>
                        <% } else if (recommendedModelCatalogMatch) { %>
                          <div class="processor-request-catalog-matches">
                            <strong>Recommended Catalog Model</strong>
                            <div class="processor-request-catalog-match processor-request-catalog-match--strong">
                              <span><strong>#<%= recommendedModelCatalogMatch.id %> · <%= recommendedModelCatalogMatch.manufacturerName %> <%= recommendedModelCatalogMatch.modelName %></strong> · <%= recommendedModelCatalogMatch.unitCategoryLabel %> <span class="pill good">Selected</span></span>
                              <small>Exact model match. This existing Catalog Model is preselected for approval.</small>
                              <button
                                type="button"
                                class="secondary-button button-small"
                                data-use-existing-model-id="<%= recommendedModelCatalogMatch.id %>"
                                data-use-existing-model-label="#<%= recommendedModelCatalogMatch.id %> · <%= recommendedModelCatalogMatch.manufacturerName %> <%= recommendedModelCatalogMatch.modelName %> · <%= recommendedModelCatalogMatch.unitCategoryLabel %>"
                                data-use-existing-model-category-id="<%= recommendedModelCatalogMatch.unitCategoryConfigValueId %>"
                                data-use-existing-model-category-label="<%= recommendedModelCatalogMatch.unitCategoryLabel %>"
                              >Use Recommended Model</button>
                            </div>
                          </div>
                        <% } %>

                        <% const alternativeModelMatches = modelCatalogMatches.filter((match) => String(match.id) !== String(recommendedModelCatalogMatch?.id || '')); %>
                        <% if (alternativeModelMatches.length) { %>
                          <div class="processor-request-catalog-matches">
                            <strong><%= recommendedModelCatalogMatch ? 'Other likely Catalog Models' : 'Likely Catalog Models' %></strong>
                            <% alternativeModelMatches.forEach((match) => { %>
                              <div class="processor-request-catalog-match">
                                <span><strong>#<%= match.id %> · <%= match.manufacturerName %> <%= match.modelName %></strong> · <%= match.unitCategoryLabel %></span>
                                <small><%= match.categoryMatch ? 'Same incoming Unit Category.' : 'Different saved Catalog Model category.' %></small>
                                <button
                                  type="button"
                                  class="secondary-button button-small"
                                  data-use-existing-model-id="<%= match.id %>"
                                  data-use-existing-model-label="#<%= match.id %> · <%= match.manufacturerName %> <%= match.modelName %> · <%= match.unitCategoryLabel %>"
                                  data-use-existing-model-category-id="<%= match.unitCategoryConfigValueId %>"
                                  data-use-existing-model-category-label="<%= match.unitCategoryLabel %>"
                                >Use This Model</button>
                              </div>
                            <% }) %>
                          </div>
                        <% } %>

                        <div class="message" data-existing-model-selection-summary>
                          <p><strong>Selected Catalog Model:</strong> <span data-existing-model-selection-text><%= recommendedModelCatalogMatch ? `#${recommendedModelCatalogMatch.id} · ${recommendedModelCatalogMatch.manufacturerName} ${recommendedModelCatalogMatch.modelName} · ${recommendedModelCatalogMatch.unitCategoryLabel}${recommendedModelCatalogMatch.isActive === false ? ' (Inactive — will reactivate)' : ''}` : 'None selected' %></span></p>
                        </div>

                        <label class="form-field model-request-catalog-category-field">
                          <span>Catalog Unit Category</span>
                          <select name="approvedUnitCategoryConfigValueId" required data-model-category-select>
                            <option value="">Select Unit Category</option>
                            <% modelUnitCategories.forEach((category) => { %>
                              <% const initialCategoryId = recommendedModelCatalogMatch?.unitCategoryConfigValueId || request.catalogContext.unitCategoryConfigValueId || ''; %>
                              <option value="<%= category.id %>" <%= String(category.id) === String(initialCategoryId) ? 'selected' : '' %>><%= category.label %></option>
                            <% }) %>
                          </select>
                          <small class="field-hint" data-model-category-hint>Choose the category this model should use in the Model Catalog. If it differs from the selected model, BWTDallas will create or reuse a separate same-name model in the chosen category.</small>
                        </label>

                        <label class="form-field processor-request-existing-field">
                          <span>Search for a different Catalog Model</span>
                          <input
                            type="search"
                            list="model-catalog-options"
                            autocomplete="off"
                            placeholder="Search <%= request.catalogContext.manufacturerName %> Model Catalog"
                            data-existing-model-search
                          />
                          <datalist id="model-catalog-options">
                            <% if (inactiveModelCatalogMatch) { %>
                              <option
                                value="#<%= inactiveModelCatalogMatch.id %> · <%= inactiveModelCatalogMatch.manufacturerName %> <%= inactiveModelCatalogMatch.modelName %> · <%= inactiveModelCatalogMatch.unitCategoryLabel %> (Inactive — will reactivate)"
                                data-model-id="<%= inactiveModelCatalogMatch.id %>"
                                data-model-category-id="<%= inactiveModelCatalogMatch.unitCategoryConfigValueId %>"
                                data-model-category-label="<%= inactiveModelCatalogMatch.unitCategoryLabel %>"
                              ></option>
                            <% } %>
                            <% modelCatalogOptions.forEach((model) => { %>
                              <option
                                value="#<%= model.id %> · <%= model.manufacturerName %> <%= model.modelName %> · <%= model.unitCategoryLabel %>"
                                data-model-id="<%= model.id %>"
                                data-model-category-id="<%= model.unitCategoryConfigValueId %>"
                                data-model-category-label="<%= model.unitCategoryLabel %>"
                              ></option>
                            <% }) %>
                          </datalist>
                          <small class="field-hint" data-existing-model-search-hint>Use this only when the recommendation and likely matches are not correct. Search is limited to this manufacturer's active Model Catalog.</small>
                        </label>
                      </div>
                      <div class="processor-request-mode-divider"><span>OR</span></div>
                      <div class="processor-request-mode-heading" data-new-model-section>
                        <strong>2. Create a New Catalog Model</strong>
                        <span>Use these fields only if the catalog does not already contain the physical model.</span>
                      </div>
                      <div class="processor-request-approval-grid">
                        <label class="form-field"><span>Catalog Model Name</span><input type="text" name="approvedModelName" data-new-model-field value="<%= request.catalogContext.requestedModelName %>" minlength="2" maxlength="150" /></label>
                      </div>
                      <button type="button" class="secondary-button button-small" data-create-new-model-instead>Create a New Catalog Model Instead</button>
                      <label class="form-field"><span>Approval Note <small>(optional)</small></span><textarea name="reviewerNote" rows="3" maxlength="1000" placeholder="Optional normalization, category, or source note"></textarea></label>
                      <button class="primary-button" type="submit" data-model-approve-button>Approve Model Request</button>
                    </form>
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/reject">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <label class="form-field"><span>Rejection Note <small>(optional)</small></span><textarea name="reviewerNote" rows="3" maxlength="1000" placeholder="Optional reason this model should not be added or reactivated."></textarea></label>
                      <button class="secondary-button" type="submit">Reject Request</button>
                    </form>
                  </div>
                <% } else if (request.catalogContext && request.catalogContext.kind === 'processor') { %>
                  <div class="unit-request-review-actions processor-request-review-actions">
                    <form class="processor-request-approval-form" method="post" action="/unit-requests/<%= request.unitRequestId %>/approve" data-processor-request-approval-form data-reviewer-is-admin="<%= isAdminCatalogReviewer ? '1' : '0' %>">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <input type="hidden" name="approvedExistingProcessorModelId" value="" data-existing-processor-id />

                      <div class="processor-request-mode-section processor-request-mode-section--existing">
                        <div class="processor-request-mode-heading">
                          <strong>1. Reuse an Existing Processor whenever possible</strong>
                          <span>This adds the Catalog Processor to <%= request.catalogContext.manufacturerName %> <%= request.catalogContext.unitModelName %>; it does not create a duplicate Processor record.</span>
                        </div>

                        <% if (processorCatalogMatches.length > 0) { %>
                          <div class="processor-request-catalog-matches">
                            <strong>Global Processor Catalog matches for this request</strong>
                            <% processorCatalogMatches.forEach((match) => { %>
                              <div class="processor-request-catalog-match <%= match.identityMatch ? 'processor-request-catalog-match--strong' : '' %>">
                                <span><strong>#<%= match.id %> · <%= match.displayLabel %></strong> <span class="pill <%= match.isActive ? 'good' : 'neutral' %>"><%= match.isActive ? 'Active' : 'Inactive' %></span></span>
                                <small><%= match.unitModelLabels.length ? `Currently associated with ${match.unitModelLabels.slice(0, 4).join(', ')}${match.unitModelLabels.length > 4 ? ` +${match.unitModelLabels.length - 4} more` : ''}.` : 'Not currently associated with any Unit Models.' %></small>
                                <% if (match.isActive) { %><button type="button" class="secondary-button button-small" data-use-existing-processor-value="#<%= match.id %> · <%= match.displayLabel %>">Use Existing</button><% } else if (isAdminCatalogReviewer) { %><small>Reactivate this Processor in Processor Catalog before using it.</small><% } else { %><small>Ask an Admin to reactivate this Processor in Configuration before using it.</small><% } %>
                              </div>
                            <% }) %>
                          </div>
                        <% } %>

                        <label class="form-field processor-request-existing-field">
                          <span>Existing Catalog Processor</span>
                          <input type="search" list="processor-catalog-options" autocomplete="off" placeholder="Search the global catalog, for example i5-9500T" data-existing-processor-search />
                          <datalist id="processor-catalog-options">
                            <% processorCatalogOptions.forEach((processor) => { %>
                              <option value="#<%= processor.id %> · <%= processor.displayLabel %>" data-processor-id="<%= processor.id %>" data-model-code="<%= processor.modelCode %>" data-brand-name="<%= processor.brandName %>" data-model-labels="<%= processor.unitModelLabels.join(' | ') %>"></option>
                            <% }) %>
                          </datalist>
                          <small class="field-hint" data-existing-processor-hint>Searches the entire Processor Catalog, not only processors already associated with this Unit Model.</small>
                        </label>
                      </div>

                      <div class="processor-request-mode-divider"><span>OR</span></div>

                      <div class="processor-request-mode-section" data-new-processor-section>
                        <div class="processor-request-mode-heading">
                          <strong>2. Create a New Catalog Processor only when none exists</strong>
                          <span>BWTDallas has interpreted the observed string into catalog fields. Review them before approval.</span>
                        </div>

                        <% if (processorInterpretation && processorInterpretation.rawValue && processorInterpretation.changed) { %>
                          <div class="message info">
                            <p><strong>Interpreted from:</strong> <%= processorInterpretation.rawValue %></p>
                            <p><strong>Suggested catalog values:</strong> <%= [
                              processorInterpretation.brandName,
                              processorInterpretation.modelCode,
                              processorInterpretation.family ? `Family ${processorInterpretation.family}` : '',
                              processorInterpretation.generation,
                              processorInterpretation.baseSpeedGhz !== null ? `${processorInterpretation.baseSpeedGhz} GHz` : ''
                            ].filter(Boolean).join(' · ') %></p>
                          </div>
                        <% } %>

                        <div class="message" data-processor-similarity-warning hidden>
                          <p><strong>Possible existing processor:</strong> <span data-processor-similarity-text></span></p>
                          <p>Select the existing Catalog Processor above rather than creating a duplicate.</p>
                        </div>
                        <div class="message info" data-processor-format-warning hidden>
                          <p><strong>Natural Processor string detected:</strong> <span data-processor-format-text></span>. BWTDallas will normalize recognized pieces when you submit.</p>
                        </div>

                        <div class="processor-request-approval-grid">
                          <label class="form-field">
                            <span>Processor Type</span>
                            <select name="approvedProcessorBrandId" data-processor-brand-select data-new-processor-field>
                              <option value="">Create/reactivate the Processor Type named beside this field</option>
                              <% processorBrands.forEach((processorBrand) => { %><option value="<%= processorBrand.id %>" <%= String(processorSuggestedBrandId || '') === String(processorBrand.id) ? 'selected' : '' %>><%= processorBrand.label %></option><% }) %>
                            </select>
                          </label>
                          <label class="form-field">
                            <span>Processor Type Name</span>
                            <input type="text" name="approvedProcessorBrandName" value="<%= processorInterpretation?.brandName || request.catalogContext.requestedProcessorType %>" minlength="2" maxlength="100" required data-canonical-processor-brand data-new-processor-field />
                          </label>
                          <label class="form-field">
                            <span>Catalog Processor</span>
                            <input type="text" name="approvedProcessorModelCode" value="<%= processorInterpretation?.modelCode || request.catalogContext.requestedProcessorName %>" minlength="2" maxlength="150" required data-canonical-processor-model data-new-processor-field />
                          </label>
                          <label class="form-field">
                            <span>Processor Family <small>(optional)</small></span>
                            <input type="text" name="approvedProcessorFamily" value="<%= processorInterpretation?.family || '' %>" maxlength="100" placeholder="Example: Core" data-new-processor-field />
                          </label>
                          <label class="form-field">
                            <span>Generation <small>(optional)</small></span>
                            <input type="text" name="approvedProcessorGeneration" value="<%= processorInterpretation?.generation || '' %>" maxlength="80" placeholder="Example: 9th Gen" data-new-processor-field />
                          </label>
                          <label class="form-field">
                            <span>Base Speed GHz</span>
                            <input type="number" name="approvedProcessorBaseSpeedGhz" value="<%= processorInterpretation?.baseSpeedGhz ?? request.catalogContext.requestedProcessorSpeedGhz ?? '' %>" min="0.01" max="99.99" step="0.01" required placeholder="Example: 2.20" data-canonical-processor-speed data-new-processor-field />
                          </label>
                        </div>

                        <p class="field-hint processor-request-canonical-hint">The original observed Processor string remains part of the request. These fields are the normalized catalog record BWTDallas will create only when an existing Processor is not reused.</p>

                        <div class="message info processor-request-admin-confirmation-note">
                          <p><strong>Processor Catalog Review:</strong> Reuse an existing Processor whenever one already exists. Keep Processor Catalog naming and metadata consistent with the global catalog.</p>
                        </div>
                      </div>

                      <label class="form-field processor-request-approval-note"><span>Approval Note <small>(optional)</small></span><textarea name="reviewerNote" rows="3" maxlength="1000" placeholder="Optional compatibility or normalization note"></textarea></label>
                      <div class="form-actions">
                        <button class="primary-button" type="submit" data-processor-approve-button>Approve Processor Request</button>
                        <% if (hasPermission('configuration.view') && hasPermission('configuration.processors.manage')) { %>
                          <a class="secondary-button" href="/management/config/processors?search=<%= encodeURIComponent(request.catalogContext.requestedProcessorName || '') %>">Open Processor Catalog</a>
                        <% } %>
                      </div>
                    </form>
                    <form method="post" action="/unit-requests/<%= request.unitRequestId %>/reject">
                      <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                      <label class="form-field"><span>Rejection Note <small>(optional)</small></span><textarea name="reviewerNote" rows="3" maxlength="1000" placeholder="Optional reason this processor should not be added or mapped."></textarea></label>
                      <button class="secondary-button" type="submit">Reject Request</button>
                    </form>
                  </div>
                <% } %>
              </section>
            <% } else if (canReviewRequests && request.isCatalogRequest && request.isPending && !canManageCatalogRequests && !canWithdrawRequest) { %>
              <section class="unit-request-detail-section record-detail-section">
                <p class="eyebrow">Catalog Review Access</p>
                <p>You can inspect this Catalog request. The matching Model or Processor Catalog approval permission is required to approve or reject it.</p>
              </section>
            <% } else if (canWithdrawRequest) { %>
              <section class="unit-request-review-panel">
                <div><p class="eyebrow">Requester Action</p><h3>Withdraw Pending Request</h3><p>Withdrawing does not change any Unit record or catalog value and cannot be undone.</p></div>
                <form method="post" action="/unit-requests/<%= request.unitRequestId %>/withdraw" onsubmit="return window.confirm('Withdraw this pending request?');">
                  <input type="hidden" name="returnStatus" value="<%= statusFilter %>" />
                      <input type="hidden" name="returnRequestType" value="<%= requestTypeFilter %>" />
                      <input type="hidden" name="returnSearch" value="<%= searchTerm %>" />
                  <label class="form-field"><span>Withdrawal Note <small>(optional)</small></span><textarea name="withdrawalNote" rows="3" maxlength="1000" placeholder="Optional context"></textarea></label>
                  <button class="secondary-button" type="submit">Withdraw Request</button>
                </form>
              </section>
            <% } else if (!request.isPending && request.reviewerNote) { %>
              <section class="unit-request-detail-section record-detail-section record-detail-user-section">
                <p class="eyebrow">Reviewer Note</p>
                <p class="unit-request-requester-note"><%= request.reviewerNote %></p>
                <p class="table-muted-line"><%= request.reviewedByName || 'Reviewed' %> · <%= request.reviewedAt ? formatDateTime(request.reviewedAt) : '—' %></p>
              </section>
            <% } %>

            <section class="unit-request-detail-section record-detail-section record-detail-history-section">
              <p class="eyebrow">Request History</p>
              <ol class="unit-request-event-list">
                <% if (!request.events || request.events.length === 0) { %><li>No request history was recorded.</li><% } %>
                <% (request.events || []).forEach((event) => {
                  const eventTypeKey = String(event.eventType || '').toLowerCase();
                  const eventTone = eventTypeKey.includes('approved')
                    ? 'success'
                    : eventTypeKey.includes('rejected')
                      ? 'danger'
                      : eventTypeKey.includes('withdrawn')
                        ? 'slate'
                        : 'info';
                %>
                  <li class="record-detail-event record-detail-event--<%= eventTone %>">
                    <strong><%= event.eventType.charAt(0).toUpperCase() + event.eventType.slice(1) %></strong>
                    <span><%= event.performedByName %> · <%= event.occurredAt ? formatDateTime(event.occurredAt) : '—' %></span>
                    <% if (event.eventNote) { %><p><%= event.eventNote %></p><% } %>
                  </li>
                <% }) %>
              </ol>
            </section>
          </section>
        </main>
      </div>
    </div>
    <script defer src="/js/model-request-review.js?v=20261002-category-correction"></script>
    <script defer src="/js/processor-request-review.js?v=20260923-processor-string-interpretation"></script>
  </body>
</html>
