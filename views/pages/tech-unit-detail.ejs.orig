<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', {
    pageTitle,
    stylesheets: [
      '/css/modal.css',
      '/css/tech-units-clean.css?v=20260730-stage10a-unit-export'
    ]
  }) %>
  <script defer src="/js/modal.js?v=20260729-stage9k-modal-accessibility"></script>
  <script defer src="/js/tech-units.js?v=20260731-stage10b-column-selection"></script>

  <body>
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentNav }) %>

      <div class="app-main">
        <%- include('../partials/topbar', { pageTitle }) %>

        <main class="content-shell tech-units-clean-page tech-unit-detail-page">
          <section class="tech-units-clean-page-heading">
            <div>
              <h1>Unit Details</h1>
              <p>Complete Unit record</p>
            </div>

            <a class="secondary-button" href="/tech/units">Back to Tech Units</a>
          </section>

          <div
            id="tech-unit-detail-record"
            data-tech-unit-detail-refresh-url="/tech/units/<%= result.units[0].unitId %>/record"
          >
            <%- include('../fragments/tech-units-table', {
              result,
              filters,
              singleUnitView: true
            }) %>
          </div>
        </main>

        <div id="modal-root"></div>
      </div>
    </div>
  </body>
</html>
