<%
  const safeErrors = Array.isArray(errorMessages) ? errorMessages : [];
  const safeRoles = Array.isArray(roles) ? roles : [];
  const safeFormData = formData || {};
  const selectedRoles = Array.isArray(safeFormData.roleCodes) ? safeFormData.roleCodes : [];
  const safePolicy = passwordLinkExpiryPolicy || { minHours: 1, maxHours: 8, defaultHours: 1 };
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel management-user-modal management-user-form-modal flat-form-modal" role="dialog" aria-modal="true" aria-labelledby="management-user-create-title">
    <header class="modal-header">
      <div>
        <p class="eyebrow">Management</p>
        <h2 id="management-user-create-title">Create User</h2>
      </div>
      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </header>

    <div class="modal-body">
      <% if (safeErrors.length > 0) { %>
        <div class="message error">
          <% safeErrors.forEach((errorMessage) => { %>
            <p><%= errorMessage %></p>
          <% }) %>
        </div>
      <% } %>

      <form
        class="auth-form management-user-edit-form"
        method="post"
        action="/management/users"
        hx-post="/management/users"
        hx-target="#modal-root"
        hx-swap="innerHTML"
        autocomplete="off"
      >
        <div class="form-grid">
          <label class="form-field">
            <span>First Name</span>
            <input type="text" name="firstName" value="<%= safeFormData.firstName || '' %>" autocomplete="off" required autofocus />
          </label>

          <label class="form-field">
            <span>Last Name</span>
            <input type="text" name="lastName" value="<%= safeFormData.lastName || '' %>" autocomplete="off" required />
          </label>
        </div>

        <p class="management-user-role-help">A BWT username is generated from the first two letters of the first and last name. For example, Natalie Garcia becomes NAGA; a duplicate becomes NAGA2. The username remains stable after account creation.</p>

        <div class="form-grid">
          <label class="form-field">
            <span>Work / Login Email</span>
            <input type="email" name="email" value="<%= safeFormData.email || '' %>" autocomplete="off" inputmode="email" spellcheck="false" required />
          </label>

          <label class="form-field">
            <span>Personal Email (optional)</span>
            <input type="email" name="personalEmail" maxlength="255" value="<%= safeFormData.personalEmail || '' %>" autocomplete="off" inputmode="email" spellcheck="false" />
          </label>
        </div>

        <label class="form-field">
          <span>Phone (optional)</span>
          <input type="tel" name="phone" value="<%= safeFormData.phone || '' %>" autocomplete="off" inputmode="tel" maxlength="50" />
        </label>

        <div class="form-grid">
          <label class="form-field">
            <span>Start Date (optional)</span>
            <input type="date" name="startDate" value="<%= safeFormData.startDate || '' %>" />
          </label>

          <label class="form-field">
            <span>End Date (optional)</span>
            <input type="date" name="endDate" value="<%= safeFormData.endDate || '' %>" />
          </label>
        </div>

        <label class="form-field">
          <span>Setup Link Expiration (hours)</span>
          <input
            type="number"
            name="setupLinkExpiryHours"
            value="<%= safeFormData.setupLinkExpiryHours || safePolicy.defaultHours %>"
            min="<%= safePolicy.minHours %>"
            max="<%= safePolicy.maxHours %>"
            step="1"
            inputmode="numeric"
            required
          />
          <small class="field-hint">Choose <%= safePolicy.minHours %>–<%= safePolicy.maxHours %> hours before the initial setup link is generated. Default: <%= safePolicy.defaultHours %> hour.</small>
        </label>

        <% if (canManageLoginInactivityOnCreate) { %>
          <label class="form-field">
            <span>Login Inactivity Monitoring</span>
            <select name="loginInactivityMode">
              <option value="inherit" <%= (safeFormData.loginInactivityMode || 'inherit') === 'inherit' ? 'selected' : '' %>>Inherit from assigned role(s)</option>
              <option value="allow" <%= safeFormData.loginInactivityMode === 'allow' ? 'selected' : '' %>>Monitor this user</option>
              <option value="deny" <%= safeFormData.loginInactivityMode === 'deny' ? 'selected' : '' %>>Do not monitor this user</option>
            </select>
            <small class="field-hint">Monitored active users are flagged after more than 5 business days without a login. Role defaults can be set through Roles &amp; Permissions.</small>
          </label>
        <% } %>

        <% if (canManageToolPinsOnCreate) { %>
        <div class="form-grid management-user-tool-pin-grid">
          <label class="form-field">
            <span>Tool PIN (6–10 digits) (optional)</span>
            <input type="password" name="toolPin" inputmode="numeric" pattern="[0-9]{6,10}" minlength="6" maxlength="10" autocomplete="new-password" />
          </label>
          <label class="form-field">
            <span>Confirm Tool PIN</span>
            <input type="password" name="confirmToolPin" inputmode="numeric" pattern="[0-9]{6,10}" minlength="6" maxlength="10" autocomplete="new-password" />
          </label>
        </div>
        <p class="management-user-role-help">The Tool PIN is separate from the account password and cannot be used to sign into the BWTDallas website. It becomes useful only for accounts authorized to use ScanTools/TechTools. Avoid repeated digits, 4+ digit sequences, and repeating or grouped patterns.</p>
        <% } %>

        <% if (canAssignRolesOnCreate) { %>
          <div>
            <p class="eyebrow management-user-modal-roles-label">Access Roles</p>
            <p class="management-user-role-help">Select one or more roles. Approved default permissions from all selected roles combine for the user.</p>

            <div class="workflow-list management-user-modal-roles">
              <% safeRoles.forEach((role) => { %>
                <label class="workflow-item <%= selectedRoles.includes(role.code) ? 'active' : '' %>">
                  <input type="checkbox" name="roleCodes" value="<%= role.code %>" <%= selectedRoles.includes(role.code) ? 'checked' : '' %> />
                  <div>
                    <strong><%= role.name %></strong>
                    <p><%= role.description || role.code %></p>
                  </div>
                </label>
              <% }) %>
            </div>
          </div>
        <% } else { %>
          <div class="message info"><p>This account will be created without roles. A user with Assign Roles permission can add roles later.</p></div>
        <% } %>

        <div class="action-row">
          <button type="submit" class="primary-button">Create User &amp; Generate Setup Link</button>
          <button type="button" class="secondary-button" data-modal-close>Cancel</button>
        </div>
      </form>
    </div>
  </section>
</div>
