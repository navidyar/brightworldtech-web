  <div class="form-section tech-form-section--cosmetic-issues" data-unit-form-field-key="cosmetic_issues" data-unit-form-repeatable-type="cosmeticIssue">
    <div class="form-section-header tech-repeatable-section-header">
      <div class="tech-repeatable-section-heading">
        <div>
          <p class="eyebrow">Cosmetic Issues</p>
          <h3>Cosmetic Issue Rows</h3>
        </div>
        <button type="button" class="secondary-button" data-add-module-row="cosmeticIssue" aria-label="Add cosmetic issue">+ Add</button>
      </div>
      <p>
        Choose None when the unit has no cosmetic issue. Severity and location are required only when an actual cosmetic issue is selected.
      </p>
    </div>

    <% if (cosmeticIssueTypes.length === 0 || issueSeverities.length === 0 || issueLocations.length === 0) { %>
      <div class="message error">
        <p>Cosmetic issue options are not ready yet. Run the Step 3f SQL migration to seed issue types, severities, and locations.</p>
      </div>
    <% } %>

    <div class="workflow-list" data-module-list="cosmeticIssue">
      <% cosmeticIssueRows.forEach((issueRow, index) => { %>
        <% const cosmeticIssueIsNone = noCosmeticIssueTypeIds.has(String(issueRow.issueTypeConfigValueId || '')); %>
        <article class="workflow-item slate" data-module-row="cosmeticIssue" data-cosmetic-no-issue="<%= cosmeticIssueIsNone ? 'true' : 'false' %>">
          <span></span>
          <div style="width: 100%;">
            <div class="content-header" style="align-items: center; margin-bottom: 12px;">
              <div>
                <strong>Cosmetic Issue <span data-module-display-number><%= index + 1 %></span></strong>
                <p>Severity and location apply only to an actual cosmetic issue.</p>
              </div>
              <button type="button" class="secondary-button" data-remove-module-row aria-label="Remove cosmetic issue <%= index + 1 %>">Remove</button>
            </div>

            <div class="form-grid">
              <label class="form-field">
                <span>Issue Type</span>
                <select name="cosmeticIssues[<%= index %>][issueTypeConfigValueId]" data-module-field data-cosmetic-issue-type-select>
                  <option value="">Select cosmetic issue</option>
                  <% cosmeticIssueTypes.forEach((issueType) => { %>
                    <option value="<%= issueType.id %>" data-no-issue="<%= issueType.isNoIssue ? 'true' : 'false' %>" <%= selected(issueRow.issueTypeConfigValueId, issueType.id) %>><%= issueType.label %></option>
                  <% }) %>
                </select>
                <input type="hidden" name="cosmeticIssues[<%= index %>][isNoIssue]" value="<%= cosmeticIssueIsNone ? '1' : '' %>" data-cosmetic-no-issue-flag />
      </label>

              <label class="form-field" data-cosmetic-detail-field data-no-issue-disabled="<%= cosmeticIssueIsNone ? 'true' : 'false' %>">
                <span>Severity</span>
                <select name="cosmeticIssues[<%= index %>][severityConfigValueId]" data-module-field <%= cosmeticIssueIsNone ? 'disabled' : '' %>>
                  <option value="">Select severity</option>
                  <% issueSeverities.forEach((severity) => { %>
                    <option value="<%= severity.id %>" <%= selected(issueRow.severityConfigValueId, severity.id) %>><%= severity.label %></option>
                  <% }) %>
                </select>
      </label>

              <label class="form-field" data-cosmetic-detail-field data-no-issue-disabled="<%= cosmeticIssueIsNone ? 'true' : 'false' %>">
                <span>Location</span>
                <select name="cosmeticIssues[<%= index %>][locationConfigValueId]" data-module-field <%= cosmeticIssueIsNone ? 'disabled' : '' %>>
                  <option value="">Select location</option>
                  <% issueLocations.forEach((location) => { %>
                    <option value="<%= location.id %>" <%= selected(issueRow.locationConfigValueId, location.id) %>><%= location.label %></option>
                  <% }) %>
                </select>
      </label>

              <label class="form-field">
                <span>Remarks</span>
                <input type="text" name="cosmeticIssues[<%= index %>][issueRemark]" value="<%= issueRow.issueRemark || '' %>" maxlength="500" placeholder="Short note explaining the issue" data-module-field />
              </label>
            </div>
          </div>
        </article>
      <% }) %>
    </div>

  </div>

  <div class="form-section tech-form-section--hardware-issues" data-unit-form-field-key="hardware_issues" data-unit-form-repeatable-type="hardwareIssue">
    <div class="form-section-header tech-repeatable-section-header">
      <div class="tech-repeatable-section-heading">
        <div>
          <p class="eyebrow">Hardware Issues</p>
          <h3>Hardware Issue Rows</h3>
        </div>
        <button type="button" class="secondary-button" data-add-module-row="hardwareIssue" aria-label="Add hardware issue">+ Add</button>
      </div>
      <p>
        Choose None when the unit has no hardware issue. For an actual issue, select a configured issue or enter a custom issue name.
      </p>
    </div>

    <% if (hardwareIssueTypes.length === 0 || issueLocations.length === 0) { %>
      <div class="message error">
        <p>Hardware issue options are not ready yet. Run the Step 3f SQL migration to seed hardware issue types and locations.</p>
      </div>
    <% } %>

    <div class="workflow-list" data-module-list="hardwareIssue">
      <% hardwareIssueRows.forEach((issueRow, index) => { %>
        <% const hardwareIssueIsNone = noHardwareIssueTypeIds.has(String(issueRow.issueTypeConfigValueId || '')); %>
        <article class="workflow-item slate" data-module-row="hardwareIssue" data-hardware-no-issue="<%= hardwareIssueIsNone ? 'true' : 'false' %>">
          <span></span>
          <div style="width: 100%;">
            <div class="content-header" style="align-items: center; margin-bottom: 12px;">
              <div>
                <strong>Hardware Issue <span data-module-display-number><%= index + 1 %></span></strong>
                <p>Custom issue and location apply only to an actual hardware issue.</p>
              </div>
              <button type="button" class="secondary-button" data-remove-module-row aria-label="Remove hardware issue <%= index + 1 %>">Remove</button>
            </div>

            <div class="form-grid">
              <label class="form-field">
                <span>Configured Issue</span>
                <select name="hardwareIssues[<%= index %>][issueTypeConfigValueId]" data-module-field data-hardware-issue-type-select>
                  <option value="">Select configured issue</option>
                  <% hardwareIssueTypes.forEach((issueType) => { %>
                    <option value="<%= issueType.id %>" data-no-issue="<%= issueType.isNoIssue ? 'true' : 'false' %>" <%= selected(issueRow.issueTypeConfigValueId, issueType.id) %>><%= issueType.label %></option>
                  <% }) %>
                </select>
                <input type="hidden" name="hardwareIssues[<%= index %>][isNoIssue]" value="<%= hardwareIssueIsNone ? '1' : '' %>" data-hardware-no-issue-flag />
                <small class="field-hint">Choose None when there is no hardware issue.</small>
              </label>

              <label class="form-field" data-hardware-detail-field data-no-issue-disabled="<%= hardwareIssueIsNone ? 'true' : 'false' %>">
                <span>Custom Issue</span>
                <input type="text" name="hardwareIssues[<%= index %>][customIssueLabel]" value="<%= issueRow.customIssueLabel || '' %>" maxlength="120" placeholder="Example: Cannot install OS" data-module-field <%= hardwareIssueIsNone ? 'disabled' : '' %> />
                <small class="field-hint">Use this when the issue is not configured yet.</small>
              </label>

              <label class="form-field" data-hardware-detail-field data-no-issue-disabled="<%= hardwareIssueIsNone ? 'true' : 'false' %>">
                <span>Location</span>
                <select name="hardwareIssues[<%= index %>][locationConfigValueId]" data-module-field <%= hardwareIssueIsNone ? 'disabled' : '' %>>
                  <option value="">Select location</option>
                  <% issueLocations.forEach((location) => { %>
                    <option value="<%= location.id %>" <%= selected(issueRow.locationConfigValueId, location.id) %>><%= location.label %></option>
                  <% }) %>
                </select>
      </label>

              <label class="form-field">
                <span>Remarks</span>
                <input type="text" name="hardwareIssues[<%= index %>][issueRemark]" value="<%= issueRow.issueRemark || '' %>" maxlength="500" placeholder="Short note explaining the issue" data-module-field />
              </label>
            </div>
          </div>
        </article>
      <% }) %>
    </div>

  </div>

  <div class="form-section form-section--grade-outcome tech-form-section--outcome" data-unit-form-auto-collapse>
    <div class="form-section-header">
      <div>
        <p class="eyebrow">Grade & Outcome</p>
        <h3>Cosmetic Grade and Unit Pass/Fail</h3>
      </div>
      <p>
        Cosmetic Grade A-D only describes appearance. Unit Pass/Fail describes the working condition and is tracked separately for completion reporting.
      </p>
    </div>

    <% if (overallGradeOptions.length === 0) { %>
      <div class="message error">
        <p>Cosmetic Grade options are not ready yet. Run the Step 3g SQL migration to seed grade values.</p>
      </div>
    <% } %>

    <% if (formOptions.outcomeOptionsSupported === false) { %>
      <div class="message error">
        <p>Unit Pass/Fail outcomes are not ready yet. Run the Step 4h SQL migration before saving unit outcomes.</p>
      </div>
    <% } %>

    <div class="form-grid tech-grade-outcome-grid">
      <label class="form-field" data-unit-form-field-key="overall_grade">
        <span>Cosmetic Grade</span>
        <select name="overallGradeConfigValueId">
          <option value="">Select cosmetic grade</option>
          <% overallGradeOptions.forEach((gradeOption) => { %>
            <option value="<%= gradeOption.id %>" <%= selected(formData.overallGradeConfigValueId, gradeOption.id) %>><%= gradeOption.label %></option>
          <% }) %>
        </select>
        <small class="field-hint">A-D grade is cosmetic only and does not determine pass/fail by itself.</small>
      </label>

      <fieldset class="form-field tech-outcome-field" data-unit-form-field-key="unit_outcome">
        <legend>Unit Outcome</legend>
        <div class="tech-outcome-options" role="radiogroup" aria-label="Unit outcome">
          <% outcomeOptions.forEach((outcomeOption) => { %>
            <label class="tech-outcome-option <%= selectedOutcomeCode === outcomeOption.code ? 'active' : '' %>">
              <input type="radio" name="outcomeCode" value="<%= outcomeOption.code %>" <%= selectedOutcomeCode === outcomeOption.code ? 'checked' : '' %> />
              <span><%= outcomeOption.label %></span>
            </label>
          <% }) %>
        </div>
        <small class="field-hint">Pass/Fail is based on the working condition of the unit, including hardware issues and cosmetic grade.</small>
      </fieldset>

      <label class="form-field" data-unit-form-field-key="overall_grade_notes">
        <span>Cosmetic Grade Notes</span>
        <input type="text" name="overallGradeNotes" value="<%= formData.overallGradeNotes || '' %>" maxlength="500" placeholder="Optional cosmetic grade note" />
      </label>

      <label class="form-field" data-unit-form-field-key="outcome_notes">
        <span>Outcome Notes</span>
        <input type="text" name="outcomeNotes" value="<%= formData.outcomeNotes || '' %>" maxlength="500" placeholder="Optional Pass/Fail note" />
      </label>
    </div>

    <div class="tech-outcome-approval-box" data-unit-form-follows-key="unit_outcome" data-outcome-approval-request-box data-request-active="<%= outcomeApprovalRequested ? 'true' : 'false' %>">
      <label class="tech-outcome-approval-check">
        <input type="checkbox" name="outcomeApprovalRequested" value="1" data-outcome-approval-request-toggle <%= outcomeApprovalRequested ? 'checked' : '' %> />
        <span>Request Management/Lead approval for this Pass/Fail decision</span>
      </label>

      <label class="form-field">
        <span>Approval Request Notes</span>
        <textarea name="outcomeApprovalRequestNotes" rows="3" maxlength="1000" data-outcome-approval-request-notes placeholder="Check the request box to enter a note." <%= outcomeApprovalRequested ? '' : 'disabled aria-disabled="true"' %>><%= formData.outcomeApprovalRequestNotes || '' %></textarea>
      </label>
    </div>
  </div>

  <div class="form-section tech-form-section--comments" data-unit-form-auto-collapse>
    <div class="form-section-header">
      <div>
        <p class="eyebrow">Comments</p>
        <h3>Add General Comment</h3>
      </div>
      <p>
        General comments are appended as history. Existing comments stay visible in the expanded unit mini-menu and are not overwritten by this field.
      </p>
    </div>

    <input type="hidden" name="generalCommentTypeConfigValueId" data-unit-form-companion-key="general_comment" value="<%= generalCommentTypeConfigValueId %>" />

    <div class="form-grid">
      <label class="form-field form-field-wide" data-unit-form-field-key="general_comment">
        <span>General Comment</span>
        <textarea name="generalCommentText" rows="4" maxlength="2000" placeholder="Add a new general comment. Leave blank if no new comment is needed."><%= formData.generalCommentText || '' %></textarea>
        <small class="field-hint">Hardware and cosmetic issue comments should be entered in their matching issue rows above.</small>
      </label>
    </div>
  </div>

  <input type="hidden" name="hardwareNotes" value="<%= formData.hardwareNotes || '' %>" />
  <input type="hidden" name="cosmeticNotes" value="<%= formData.cosmeticNotes || '' %>" />

  <template data-module-template="cosmeticIssue">
    <article class="workflow-item slate" data-module-row="cosmeticIssue" data-cosmetic-no-issue="false">
      <span></span>
      <div style="width: 100%;">
        <div class="content-header" style="align-items: center; margin-bottom: 12px;">
          <div>
            <strong>Cosmetic Issue <span data-module-display-number>__DISPLAY__</span></strong>
            <p>Severity and location apply only to an actual cosmetic issue.</p>
          </div>
          <button type="button" class="secondary-button" data-remove-module-row aria-label="Remove cosmetic issue __DISPLAY__">Remove</button>
        </div>
        <div class="form-grid">
          <label class="form-field"><span>Issue Type</span><select name="cosmeticIssues[__INDEX__][issueTypeConfigValueId]" data-module-field data-cosmetic-issue-type-select><option value="">Select cosmetic issue</option><% cosmeticIssueTypes.forEach((issueType) => { %><option value="<%= issueType.id %>" data-no-issue="<%= issueType.isNoIssue ? 'true' : 'false' %>"><%= issueType.label %></option><% }) %></select><input type="hidden" name="cosmeticIssues[__INDEX__][isNoIssue]" value="" data-cosmetic-no-issue-flag /></label>
          <label class="form-field" data-cosmetic-detail-field data-no-issue-disabled="false"><span>Severity</span><select name="cosmeticIssues[__INDEX__][severityConfigValueId]" data-module-field><option value="">Select severity</option><% issueSeverities.forEach((severity) => { %><option value="<%= severity.id %>"><%= severity.label %></option><% }) %></select></label>
          <label class="form-field" data-cosmetic-detail-field data-no-issue-disabled="false"><span>Location</span><select name="cosmeticIssues[__INDEX__][locationConfigValueId]" data-module-field><option value="">Select location</option><% issueLocations.forEach((location) => { %><option value="<%= location.id %>"><%= location.label %></option><% }) %></select></label>
          <label class="form-field"><span>Remarks</span><input type="text" name="cosmeticIssues[__INDEX__][issueRemark]" maxlength="500" placeholder="Short note explaining the issue" data-module-field /></label>
        </div>
      </div>
    </article>
  </template>

  <template data-module-template="hardwareIssue">
    <article class="workflow-item slate" data-module-row="hardwareIssue" data-hardware-no-issue="false">
      <span></span>
      <div style="width: 100%;">
        <div class="content-header" style="align-items: center; margin-bottom: 12px;">
          <div>
            <strong>Hardware Issue <span data-module-display-number>__DISPLAY__</span></strong>
            <p>Custom issue and location apply only to an actual hardware issue.</p>
          </div>
          <button type="button" class="secondary-button" data-remove-module-row aria-label="Remove hardware issue __DISPLAY__">Remove</button>
        </div>
        <div class="form-grid">
          <label class="form-field"><span>Configured Issue</span><select name="hardwareIssues[__INDEX__][issueTypeConfigValueId]" data-module-field data-hardware-issue-type-select><option value="">Select configured issue</option><% hardwareIssueTypes.forEach((issueType) => { %><option value="<%= issueType.id %>" data-no-issue="<%= issueType.isNoIssue ? 'true' : 'false' %>"><%= issueType.label %></option><% }) %></select><input type="hidden" name="hardwareIssues[__INDEX__][isNoIssue]" value="" data-hardware-no-issue-flag /><small class="field-hint">Choose None when there is no hardware issue.</small></label>
          <label class="form-field" data-hardware-detail-field data-no-issue-disabled="false"><span>Custom Issue</span><input type="text" name="hardwareIssues[__INDEX__][customIssueLabel]" maxlength="120" placeholder="Example: Cannot install OS" data-module-field /><small class="field-hint">Use this when the issue is not configured yet.</small></label>
          <label class="form-field" data-hardware-detail-field data-no-issue-disabled="false"><span>Location</span><select name="hardwareIssues[__INDEX__][locationConfigValueId]" data-module-field><option value="">Select location</option><% issueLocations.forEach((location) => { %><option value="<%= location.id %>"><%= location.label %></option><% }) %></select></label>
          <label class="form-field"><span>Remarks</span><input type="text" name="hardwareIssues[__INDEX__][issueRemark]" maxlength="500" placeholder="Short note explaining the issue" data-module-field /></label>
        </div>
      </div>
    </article>
  </template>

  <template data-module-template="previousMemory">
    <div class="tech-memory-edit-row" data-module-row="previousMemory">
      <span class="tech-memory-row-number" data-module-display-number>__DISPLAY__</span>
      <input type="hidden" name="previousMemoryModules[__INDEX__][slotLabel]" value="Slot __DISPLAY__" />
      <label class="form-field tech-memory-size-field"><span>Size</span><input type="text" inputmode="decimal" name="previousMemoryModules[__INDEX__][sizeGb]" placeholder="0, 8GB, or 1TB" autocomplete="off" spellcheck="false" data-capacity-input data-previous-memory-size-input data-module-field /></label>
      <label class="form-field tech-memory-type-field"><span>Memory Type</span><select name="previousMemoryModules[__INDEX__][ramTypeConfigValueId]" data-module-field><option value="">Select memory type</option><% formOptions.ramTypes.forEach((ramType) => { %><option value="<%= ramType.id %>"><%= ramType.label %></option><% }) %></select></label>
      <label class="form-field tech-memory-install-field"><span>Install Type</span><select name="previousMemoryModules[__INDEX__][memoryInstallTypeCode]" data-module-field><option value="">Select install type</option><% memoryInstallTypes.forEach((installType) => { %><option value="<%= installType.code %>"><%= installType.label %></option><% }) %></select></label>
      <input type="hidden" name="previousMemoryModules[__INDEX__][speedMhz]" />
      <input type="hidden" name="previousMemoryModules[__INDEX__][manufacturerName]" />
      <input type="hidden" name="previousMemoryModules[__INDEX__][partNumber]" />
      <input type="hidden" name="previousMemoryModules[__INDEX__][serialNumber]" />
      <input type="hidden" name="previousMemoryModules[__INDEX__][changeNotes]" />
      <button type="button" class="secondary-button tech-memory-remove-button" data-remove-module-row aria-label="Remove previous memory module __DISPLAY__">Remove</button>
    </div>
  </template>

  <template data-module-template="memory">
    <div class="tech-memory-edit-row" data-module-row="memory">
      <span class="tech-memory-row-number" data-module-display-number>__DISPLAY__</span>
      <input type="hidden" name="memoryModules[__INDEX__][slotLabel]" value="Slot __DISPLAY__" />
      <label class="form-field tech-memory-size-field"><span>Size</span><input type="text" inputmode="decimal" name="memoryModules[__INDEX__][sizeGb]" placeholder="0, 8GB, or 1TB" autocomplete="off" spellcheck="false" data-capacity-input data-memory-size-input data-module-field /></label>
      <label class="form-field tech-memory-type-field"><span>Memory Type</span><select name="memoryModules[__INDEX__][ramTypeConfigValueId]" data-module-field><option value="">Select memory type</option><% formOptions.ramTypes.forEach((ramType) => { %><option value="<%= ramType.id %>"><%= ramType.label %></option><% }) %></select></label>
      <label class="form-field tech-memory-install-field"><span>Install Type</span><select name="memoryModules[__INDEX__][memoryInstallTypeCode]" data-module-field><option value="">Select install type</option><% memoryInstallTypes.forEach((installType) => { %><option value="<%= installType.code %>"><%= installType.label %></option><% }) %></select></label>
      <input type="hidden" name="memoryModules[__INDEX__][speedMhz]" />
      <input type="hidden" name="memoryModules[__INDEX__][manufacturerName]" />
      <input type="hidden" name="memoryModules[__INDEX__][partNumber]" />
      <input type="hidden" name="memoryModules[__INDEX__][serialNumber]" />
      <input type="hidden" name="memoryModules[__INDEX__][changeNotes]" />
      <button type="button" class="secondary-button tech-memory-remove-button" data-remove-module-row aria-label="Remove current memory module __DISPLAY__">Remove</button>
    </div>
  </template>

  <template data-module-template="previousStorage">
    <div class="tech-memory-edit-row tech-storage-edit-row tech-storage-edit-row--previous" data-module-row="previousStorage">
      <span class="tech-memory-row-number" data-module-display-number>__DISPLAY__</span>
      <input type="hidden" name="previousStorageDevices[__INDEX__][slotLabel]" value="Drive __DISPLAY__" />
      <label class="form-field tech-memory-size-field"><span>Size</span><input type="text" inputmode="decimal" name="previousStorageDevices[__INDEX__][sizeGb]" placeholder="0, 512GB, or 1TB" autocomplete="off" spellcheck="false" data-capacity-input data-previous-storage-size-input data-module-field /></label>
      <label class="form-field tech-memory-type-field"><span>Storage Type</span><select name="previousStorageDevices[__INDEX__][storageTypeConfigValueId]" data-module-field><option value="">Select storage type</option><% formOptions.storageTypes.forEach((storageType) => { %><option value="<%= storageType.id %>"><%= storageType.label %></option><% }) %></select></label>
      <input type="hidden" name="previousStorageDevices[__INDEX__][wipeStatusConfigValueId]" />
      <input type="hidden" name="previousStorageDevices[__INDEX__][manufacturerName]" />
      <input type="hidden" name="previousStorageDevices[__INDEX__][modelNumber]" />
      <input type="hidden" name="previousStorageDevices[__INDEX__][serialNumber]" />
      <input type="hidden" name="previousStorageDevices[__INDEX__][firmwareVersion]" />
      <input type="hidden" name="previousStorageDevices[__INDEX__][changeNotes]" />
      <button type="button" class="secondary-button tech-memory-remove-button" data-remove-module-row aria-label="Remove previous storage device __DISPLAY__">Remove</button>
    </div>
  </template>

  <template data-module-template="storage">
    <div class="tech-memory-edit-row tech-storage-edit-row tech-storage-edit-row--current" data-module-row="storage">
      <span class="tech-memory-row-number" data-module-display-number>__DISPLAY__</span>
      <input type="hidden" name="storageDevices[__INDEX__][slotLabel]" value="Drive __DISPLAY__" />
      <label class="form-field tech-memory-size-field"><span>Size</span><input type="text" inputmode="decimal" name="storageDevices[__INDEX__][sizeGb]" placeholder="0, 512GB, or 1TB" autocomplete="off" spellcheck="false" data-capacity-input data-storage-size-input data-module-field /></label>
      <label class="form-field tech-memory-type-field"><span>Storage Type</span><select name="storageDevices[__INDEX__][storageTypeConfigValueId]" data-module-field><option value="">Select storage type</option><% formOptions.storageTypes.forEach((storageType) => { %><option value="<%= storageType.id %>"><%= storageType.label %></option><% }) %></select></label>
      <label class="form-field tech-memory-install-field"><span>Wipe Status</span><select name="storageDevices[__INDEX__][wipeStatusConfigValueId]" data-module-field><option value="">Select wipe status</option><% (formOptions.storageWipeStatuses || []).forEach((wipeStatus) => { %><option value="<%= wipeStatus.id %>"><%= wipeStatus.label %></option><% }) %></select></label>
      <input type="hidden" name="storageDevices[__INDEX__][manufacturerName]" />
      <input type="hidden" name="storageDevices[__INDEX__][modelNumber]" />
      <input type="hidden" name="storageDevices[__INDEX__][serialNumber]" />
      <input type="hidden" name="storageDevices[__INDEX__][firmwareVersion]" />
      <input type="hidden" name="storageDevices[__INDEX__][changeNotes]" />
      <button type="button" class="secondary-button tech-memory-remove-button" data-remove-module-row aria-label="Remove current storage device __DISPLAY__">Remove</button>
    </div>
  </template>

  <div class="form-actions">
    <button class="primary-button" type="submit">
      <%= isEditMode ? 'Update Unit' : 'Create Unit' %>
    </button>

    <% if (isModal) { %>
      <button type="button" class="secondary-button" data-modal-close>Cancel</button>
    <% } else { %>
      <a class="secondary-button" href="/tech/units">Cancel</a>
    <% } %>
  </div>
</form>
