<%
  const isEditMode = mode === 'edit';
  const htmxAttrs = isModal ? `hx-post="${formAction}" hx-target="#modal-root" hx-swap="innerHTML" hx-disabled-elt="find button[type='submit']"` : '';
  const memoryInstallTypes = Array.isArray(formOptions.memoryInstallTypes) && formOptions.memoryInstallTypes.length > 0
    ? formOptions.memoryInstallTypes
    : [
        { code: 'removable_module', label: 'Removable Module' },
        { code: 'integrated_soldered', label: 'Integrated / Soldered' },
        { code: 'unknown', label: 'Unknown' }
      ];
  const blankMemoryRow = { slotLabel: 'Slot 1', sizeGb: '', ramTypeConfigValueId: '', memoryInstallTypeCode: '', speedMhz: '', manufacturerName: '', partNumber: '', serialNumber: '', changeNotes: '' };
  const blankStorageRow = { slotLabel: 'Drive 1', sizeGb: '', storageTypeConfigValueId: '', manufacturerName: '', modelNumber: '', serialNumber: '', firmwareVersion: '', wipeStatusConfigValueId: '', changeNotes: '' };
  const previousMemoryRows = Array.isArray(formData.previousMemoryModules) && formData.previousMemoryModules.length > 0
    ? formData.previousMemoryModules
    : [blankMemoryRow];
  const memoryRows = Array.isArray(formData.memoryModules) && formData.memoryModules.length > 0
    ? formData.memoryModules
    : [blankMemoryRow];
  const previousStorageRows = Array.isArray(formData.previousStorageDevices) && formData.previousStorageDevices.length > 0
    ? formData.previousStorageDevices
    : [blankStorageRow];
  const storageRows = Array.isArray(formData.storageDevices) && formData.storageDevices.length > 0
    ? formData.storageDevices
    : [blankStorageRow];
  const cosmeticIssueTypes = Array.isArray(formOptions.cosmeticIssueTypes) ? formOptions.cosmeticIssueTypes : [];
  const noCosmeticIssueTypeIds = new Set(
    cosmeticIssueTypes
      .filter((issueType) => issueType && issueType.isNoIssue)
      .map((issueType) => String(issueType.id || ''))
  );
  const hardwareIssueTypes = Array.isArray(formOptions.hardwareIssueTypes) ? formOptions.hardwareIssueTypes : [];
  const noHardwareIssueTypeIds = new Set(
    hardwareIssueTypes
      .filter((issueType) => issueType && issueType.isNoIssue)
      .map((issueType) => String(issueType.id || ''))
  );
  const issueLocations = Array.isArray(formOptions.issueLocations) ? formOptions.issueLocations : [];
  const issueSeverities = Array.isArray(formOptions.issueSeverities) ? formOptions.issueSeverities : [];
  const commentTypes = Array.isArray(formOptions.commentTypes) ? formOptions.commentTypes : [];
  const cosmeticIssueRows = Array.isArray(formData.cosmeticIssues) && formData.cosmeticIssues.length > 0
    ? formData.cosmeticIssues
    : [{ issueTypeConfigValueId: '', severityConfigValueId: '', locationConfigValueId: '', issueRemark: '' }];
  const hardwareIssueRows = Array.isArray(formData.hardwareIssues) && formData.hardwareIssues.length > 0
    ? formData.hardwareIssues
    : [{ issueTypeConfigValueId: '', customIssueLabel: '', locationConfigValueId: '', issueRemark: '' }];
  const generalCommentType = commentTypes.find((commentType) => {
    const normalizedCode = String(commentType.code || commentType.value || commentType.label || '').trim().toLowerCase();

    return normalizedCode === 'general';
  }) || null;
  const generalCommentTypeConfigValueId = generalCommentType
    ? generalCommentType.id
    : (formOptions.defaultCommentTypeConfigValueId || '');
  const overallGradeOptions = Array.isArray(formOptions.overallGradeOptions) ? formOptions.overallGradeOptions : [];
  const absoluteStatusOptions = Array.isArray(formOptions.absoluteStatusOptions) ? formOptions.absoluteStatusOptions : [];
  const touchscreenStatusOptions = Array.isArray(formOptions.touchscreenStatusOptions) ? formOptions.touchscreenStatusOptions : [];
  const keyboardLanguageOptions = Array.isArray(formOptions.keyboardLanguageOptions) ? formOptions.keyboardLanguageOptions : [];
  const diagnosticsStatusOptions = Array.isArray(formOptions.diagnosticsStatusOptions) ? formOptions.diagnosticsStatusOptions : [];
  const threatProtectionStatusOptions = Array.isArray(formOptions.virusCheckStatusOptions) ? formOptions.virusCheckStatusOptions : [];
  const driverCheckStatusOptions = Array.isArray(formOptions.driverCheckStatusOptions) ? formOptions.driverCheckStatusOptions : [];
  const skinnedStatusOptions = Array.isArray(formOptions.skinnedStatusOptions) ? formOptions.skinnedStatusOptions : [];
  const yesNoOptions = Array.isArray(formOptions.yesNoOptions) ? formOptions.yesNoOptions : [];
  const testResultOptions = Array.isArray(formOptions.testResultOptions) ? formOptions.testResultOptions : [];
  const availabilityTestResultOptions = Array.isArray(formOptions.availabilityTestResultOptions) ? formOptions.availabilityTestResultOptions : [];
  const lockStatusOptions = Array.isArray(formOptions.lockStatusOptions) ? formOptions.lockStatusOptions : [];
  const displayTypeOptions = Array.isArray(formOptions.displayTypeOptions) ? formOptions.displayTypeOptions : [];
  const screenResolutionOptions = Array.isArray(formOptions.screenResolutionOptions) ? formOptions.screenResolutionOptions : [];
  const refreshRateOptions = Array.isArray(formOptions.refreshRateOptions) ? formOptions.refreshRateOptions : [];
  const colorOptions = Array.isArray(formOptions.colorOptions) ? formOptions.colorOptions : [];
  const cameraTypeOptions = Array.isArray(formOptions.cameraTypeOptions) ? formOptions.cameraTypeOptions : [];
  const cameraLocationOptions = Array.isArray(formOptions.cameraLocationOptions) ? formOptions.cameraLocationOptions : [];
  const biometricHardwareOptions = Array.isArray(formOptions.biometricHardwareOptions) ? formOptions.biometricHardwareOptions : [];
  const portTypeOptions = Array.isArray(formOptions.portTypeOptions) ? formOptions.portTypeOptions : [];
  const boxLanguageOptions = Array.isArray(formOptions.boxLanguageOptions) ? formOptions.boxLanguageOptions : [];
  const cameraRows = Array.isArray(formData.cameras) ? formData.cameras : [];
  const batteryRows = Array.isArray(formData.batteries) ? formData.batteries : [];
  const biometricRows = Array.isArray(formData.biometrics) ? formData.biometrics : [];
  const portRows = Array.isArray(formData.ports) ? formData.ports : [];
  const selectedManufacturer = (formOptions.manufacturers || []).find((manufacturer) => String(manufacturer.id || '') === String(formData.manufacturerId || ''));
  const initialIsApple = Boolean(selectedManufacturer && String(selectedManufacturer.label || '').trim().toLowerCase() === 'apple');
  const outcomeOptions = Array.isArray(formOptions.outcomeOptions) && formOptions.outcomeOptions.length > 0
    ? formOptions.outcomeOptions
    : [
        { code: 'pass', label: 'Pass' },
        { code: 'fail', label: 'Fail' }
      ];
  const selectedOutcomeCode = String(formData.outcomeCode || '').trim().toLowerCase();
  const outcomeApprovalRequested = Boolean(formData.outcomeApprovalRequested);
  const canRequestOutcomeConfirmation = Boolean(formOptions.canRequestOutcomeConfirmation);
  const productionWeightCapabilities = formOptions.productionWeightCapabilities || {};
  const productionWeightDetails = formData.productionWeightDetails || {
    formattedEffectiveWeight: '—',
    sourceLabel: 'Calculated after save',
    sourceCode: 'not_configured',
    notes: '',
    hasOverride: false
  };
  const canViewProductionWeight = Boolean(formOptions.canViewProductionWeight);
  const canOverrideProductionWeight = Boolean(canViewProductionWeight && formOptions.canOverrideProductionWeight && productionWeightCapabilities.hasProductionWeightOverride);
  const productionWeightHasUnitOverride = productionWeightDetails.sourceCode === 'unit_override' || Boolean(productionWeightDetails.hasOverride);
  const initialDuplicateMatches = typeof duplicateMatches !== 'undefined' && Array.isArray(duplicateMatches) ? duplicateMatches : [];
  const duplicateCheckWasForced = typeof duplicateCheckPerformed !== 'undefined' && Boolean(duplicateCheckPerformed);
  const canRequestModelCatalogException = Boolean(formOptions.canRequestCatalogException);
  const canRequestProcessorCatalogException = Boolean(formOptions.canRequestCatalogException);
  const authoritativeFieldErrors = typeof unitFormFieldErrors !== 'undefined' && Array.isArray(unitFormFieldErrors)
    ? unitFormFieldErrors
    : [];


  function selected(currentValue, optionValue) {
    return String(currentValue || '') === String(optionValue || '') ? 'selected' : '';
  }

  function selectedInstallType(currentValue, optionCode) {
    return String(currentValue || '') === String(optionCode || '') ? 'selected' : '';
  }

  function displayAssetTag(value) {
    const assetTagPrefix = formOptions && formOptions.assetTagPrefix
      ? String(formOptions.assetTagPrefix).trim().toUpperCase()
      : 'BWT';
    const rawValue = String(value || '').trim();

    if (!rawValue) {
      return '';
    }

    const compactPrefix = assetTagPrefix.replace(/[\s-]+/g, '').toUpperCase();
    const compactValue = rawValue.replace(/[\s-]+/g, '').toUpperCase();

    if (compactValue.startsWith(compactPrefix)) {
      const suffix = compactValue.slice(compactPrefix.length);
      return suffix ? `${assetTagPrefix}${suffix}` : rawValue;
    }

    if (/^\d+$/.test(compactValue)) {
      return `${assetTagPrefix}${compactValue}`;
    }

    return rawValue;
  }



  function formatCapacity(value) {
    const rawValue = String(value || '').trim();
    const numeric = Number(rawValue);

    if (!rawValue) {
      return '';
    }

    if (!Number.isFinite(numeric) || numeric < 0) {
      return rawValue;
    }

    if (numeric === 0) {
      return '0GB';
    }

    if (Number.isInteger(numeric) && numeric >= 1000) {
      if (numeric % 1024 === 0) {
        return `${numeric / 1024}TB`;
      }

      if (numeric % 1000 === 0) {
        return `${numeric / 1000}TB`;
      }

      if (numeric % 256 === 0) {
        return `${Number((numeric / 1024).toFixed(3))}TB`;
      }
    }

    return `${numeric}GB`;
  }

  function memoryRowsTotalGb(rows) {
    return rows.reduce((sum, row) => {
      const value = Number(row.sizeGb || 0);

      return Number.isFinite(value) && value > 0 ? sum + value : sum;
    }, 0);
  }

  function memoryTotalGb() {
    return memoryRowsTotalGb(memoryRows);
  }


  function hasExplicitCapacityRows(rows) {
    return rows.some((row) => String(row && row.sizeGb !== undefined ? row.sizeGb : '').trim() !== '');
  }

  function storageRowsTotalGb(rows) {
    return rows.reduce((sum, row) => {
      const value = Number(row.sizeGb || 0);

      return Number.isFinite(value) && value > 0 ? sum + value : sum;
    }, 0);
  }

  function memoryTypeLabel(value) {
    const match = (formOptions.ramTypes || []).find((ramType) => String(ramType.id) === String(value || ''));

    return match ? match.label : 'Unknown';
  }

  function memoryInstallTypeLabel(value) {
    const match = memoryInstallTypes.find((installType) => String(installType.code) === String(value || ''));

    return match ? match.label : 'Unknown';
  }

  function storageTotalGb() {
    return storageRowsTotalGb(storageRows);
  }
%>

<% if (!formOptions.supported) { %>
  <div class="message error tech-unit-form-error-summary">
    <p><%= formOptions.message %></p>
  </div>
<% } %>

<% if (errorMessages.length > 0) { %>
  <div class="message error tech-unit-form-error-summary">
    <% errorMessages.forEach((errorMessage) => { %>
      <p><%= errorMessage %></p>
    <% }) %>
  </div>
<% } %>

<form class="app-form tech-unit-form" method="post" action="<%= formAction %>" data-tech-unit-form data-unit-form-mode="<%= mode %>" data-lot-unit-form-profile-url="/tech/units/lot-form-profile" data-lot-requirement-preview-url="/tech/units/lot-requirement-preview" <%- htmxAttrs %>>
  <input type="hidden" name="currentUnitStatusConfigValueId" value="<%= formData.currentUnitStatusConfigValueId || formOptions.defaultUnitStatusId || '' %>" />
  <input type="hidden" name="lotRequirementMode" value="<%= mode %>" />
  <% if (isEditMode) { %>
    <input type="hidden" name="lotRequirementUnitId" value="<%= formData.unitId || '' %>" />
  <% } %>
  <% if (!isEditMode) { %>
    <input type="hidden" name="duplicateAssumptionNonce" value="<%= formData.duplicateAssumptionNonce || '' %>" data-duplicate-assumption-nonce />
  <% } %>

  <% if (authoritativeFieldErrors.length > 0) { %>
    <div hidden data-unit-form-server-errors>
      <% authoritativeFieldErrors.forEach((fieldError) => { %>
        <span
          data-unit-form-server-error
          data-field-key="<%= fieldError.fieldKey || '' %>"
          data-error-code="<%= fieldError.code || '' %>"
          data-error-message="<%= fieldError.message || '' %>"
        ></span>
      <% }) %>
    </div>
  <% } %>

  <div class="tech-unit-form-validation-summary" data-unit-form-validation-summary role="alert" aria-live="polite" hidden>
    <strong data-unit-form-validation-summary-heading></strong>
    <div class="tech-unit-form-validation-summary-list" data-unit-form-validation-summary-list></div>
  </div>

  <div class="form-section tech-form-section--assignment">
    <div class="form-section-header">
      <div>
        <p class="eyebrow">Assignment</p>
        <h3>Lot Assignment</h3>
      </div>
      <p>
        Select the open child or standalone lot the Tech is working on before entering serials. Closed and parent/container lots cannot receive units.
        The selected lot also controls whether a confirmed existing unit can be assumed during duplicate matching.
      </p>
    </div>

    <div class="form-grid tech-lot-assignment-grid">
      <%
        const assignableLotHierarchyOptions = Array.isArray(formOptions.lotHierarchyOptions) && formOptions.lotHierarchyOptions.length > 0
          ? formOptions.lotHierarchyOptions
          : formOptions.lots.map((lot) => ({
              lotId: Number(lot.lot_id),
              lotName: lot.lot_name,
              compactLabel: lot.lot_name,
              fullPath: lot.lot_name,
              searchText: lot.lot_name,
              depth: 0,
              selectable: true,
              sourceLot: lot
            }));
        const selectedAssignableLot = formOptions.lots.find((lot) => String(lot.lot_id) === String(formData.lotId || ''));
        const selectedAssignableLotHierarchy = assignableLotHierarchyOptions.find((lot) => String(lot.lotId) === String(formData.lotId || ''));
        const selectedAssignableLotLabel = selectedAssignableLot
          ? (selectedAssignableLot.isCurrentLotClosed
            ? `${selectedAssignableLot.lot_name} (Closed — current lot)`
            : selectedAssignableLot.lot_name)
          : '';
        const selectedAssignableLotAllowsAssumption = Boolean(
          selectedAssignableLot
          && Number(selectedAssignableLot.allow_duplicate_unit_assumption || 0) === 1
        );
      %>
      <label class="form-field tech-assignable-lot-field">
        <span>Assignable Lot</span>
        <div class="tech-assignable-lot-combobox" data-assignable-lot-combobox>
          <input
            type="search"
            class="tech-assignable-lot-combobox-input"
            data-assignable-lot-combobox-input
            value="<%= selectedAssignableLotLabel %>"
            autocomplete="off"
            placeholder="Search or select an assignable lot"
            aria-label="Assignable Lot"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-required="true"
          />
          <select name="lotId" data-lot-select data-assignable-lot-catalog hidden aria-hidden="true" tabindex="-1">
            <option value="">Select assignable lot</option>
            <% assignableLotHierarchyOptions.forEach((hierarchyLot) => { %>
              <%
                const lot = hierarchyLot.sourceLot || {};
                const lotProductionWeightNumber = Number(lot.resolved_default_production_weight);
                const lotProductionWeightValue = Number.isFinite(lotProductionWeightNumber) ? lotProductionWeightNumber.toFixed(2) : '';
                const lotOptionName = hierarchyLot.lotName || lot.lot_name || `Lot #${hierarchyLot.lotId}`;
                const lotOptionCompactLabel = lot.isCurrentLotClosed
                  ? `${lotOptionName} (Closed — current lot)`
                  : lotOptionName;
              %>
              <option
                value="<%= hierarchyLot.lotId %>"
                data-lot-selectable="<%= hierarchyLot.selectable ? '1' : '0' %>"
                data-lot-depth="<%= Number(hierarchyLot.depth || 0) %>"
                data-lot-name="<%= lotOptionName %>"
                data-lot-compact-label="<%= lotOptionCompactLabel %>"
                data-lot-full-path="<%= hierarchyLot.fullPath || lotOptionName %>"
                data-lot-path-ids="<%= Array.isArray(hierarchyLot.pathIds) ? hierarchyLot.pathIds.join(',') : '' %>"
                data-lot-search-text="<%= hierarchyLot.searchText || hierarchyLot.fullPath || lotOptionName %>"
                data-production-weight="<%= hierarchyLot.selectable && canViewProductionWeight ? lotProductionWeightValue : '' %>"
                data-allow-duplicate-unit-assumption="<%= hierarchyLot.selectable && Number(lot.allow_duplicate_unit_assumption || 0) === 1 ? '1' : '0' %>"
                <%= hierarchyLot.selectable ? '' : 'disabled' %>
                <%= hierarchyLot.selectable ? selected(formData.lotId, hierarchyLot.lotId) : '' %>
              ><%= lotOptionName %></option>
            <% }) %>
          </select>
          <div class="tech-assignable-lot-options" data-assignable-lot-options role="listbox" hidden></div>
        </div>
        <small class="field-hint" data-assignable-lot-hint>
          Search by lot name, then choose a listed assignable lot. Closed lots and parent/container lots cannot receive units.
          <% if (formOptions.currentLotIsClosed) { %>
            This unit remains in its current closed lot unless you select an open destination lot.
          <% } %>
        </small>
        <p class="tech-lot-hierarchy-breadcrumb" data-assignable-lot-hierarchy <%= selectedAssignableLotHierarchy ? '' : 'hidden' %>>
          <span>Lot Hierarchy</span>
          <strong data-assignable-lot-hierarchy-path><%= selectedAssignableLotHierarchy?.fullPath || '' %></strong>
        </p>
      </label>

      <p class="field-hint tech-lot-form-profile-status" data-lot-unit-form-profile-status data-status="idle" aria-live="polite">
        Select an assignable Lot to apply its field visibility and requirement settings.
      </p>

      <div class="tech-lot-requirement-workflow-region" data-lot-requirement-workflow-region aria-live="polite">
        <%- include('./tech-unit-lot-requirement-workflow', {
          lotRequirementWorkflow: typeof lotRequirementWorkflow !== 'undefined' ? lotRequirementWorkflow : null
        }) %>
      </div>

      <% if (!isEditMode) { %>
        <p
          class="tech-lot-assumption-status"
          data-assignable-lot-assumption-status
          data-status="<%= selectedAssignableLotAllowsAssumption ? 'enabled' : 'disabled' %>"
          <%= selectedAssignableLot ? '' : 'hidden' %>
          aria-live="polite"
        >
          <strong class="tech-lot-assumption-status-title">Existing Unit Move/Takeover</strong>
          <span data-assignable-lot-assumption-status-state>
            <%= selectedAssignableLotAllowsAssumption
              ? 'Matching existing units can be moved or taken over without approval.'
              : 'Moving or taking over a matching existing unit requires Management or Tech Lead approval.' %>
          </span>
        </p>
      <% } %>
    </div>
  </div>

  <div class="form-section tech-form-section--identity"<% if (!isEditMode) { %> data-unit-form-auto-collapse<% } %>>
    <div class="form-section-header">
      <div>
        <p class="eyebrow">Identity</p>
        <h3>Unit Identity</h3>
      </div>
      <p>
        Asset tags are generated only after a new unit is created. Unit serial and BIOS serial are checked early for possible existing units,
        using case-insensitive matching across both serial fields.
      </p>
    </div>

    <div class="form-grid">
      <% if (isEditMode) { %>
        <div class="form-field tech-unit-asset-tag-readonly">
          <span>Asset Tag</span>
          <output><%= displayAssetTag(formData.assetTag) || '—' %></output>
          <small class="field-hint">Asset tags are permanent and cannot be changed.</small>
        </div>
      <% } %>

      <label class="form-field" data-unit-form-field-key="unit_serial_number">
        <span>Unit Serial Number</span>
        <input
          type="text"
          name="unitSerialNumber"
          value="<%= formData.unitSerialNumber %>"
          placeholder="Physical serial from the unit"
          autocomplete="off"
          spellcheck="false"
          maxlength="150"
          data-duplicate-check-serial
          data-serial-enter-no-submit
        />
        <small class="field-hint">
          Usually copied from the device label or chassis. The system checks both serial types after you leave this field.
        </small>
      </label>

      <label class="form-field" data-unit-form-field-key="bios_serial_number">
        <span data-bios-serial-label><%= initialIsApple ? 'Recovery Number' : 'BIOS Serial Number' %></span>
        <input
          type="text"
          name="biosSerialNumber"
          value="<%= formData.biosSerialNumber %>"
          placeholder="<%= initialIsApple ? 'Recovery Number' : 'Serial reported by BIOS or ScanTool' %>" data-bios-serial-input
          autocomplete="off"
          spellcheck="false"
          maxlength="150"
          data-duplicate-check-serial
          data-serial-enter-no-submit
        />
        <small class="field-hint">
          <span data-bios-serial-hint><%= initialIsApple ? 'Recovery Number is checked against both stored serial types after you leave this field.' : 'BIOS serial is checked against both stored serial types after you leave this field.' %></span>
        </small>
      </label>
    </div>

    <% if (!isEditMode) { %>
      <div class="tech-unit-duplicate-check-region" data-duplicate-check-region aria-live="polite">
        <% if (duplicateCheckWasForced) { %>
          <%- include('./tech-unit-duplicate-check', {
            duplicateMatches: initialDuplicateMatches,
            hasSerialSearch: true,
            destinationLotId: formData.lotId || '',
            canRequestIntentionalDuplicate: typeof canRequestIntentionalDuplicate !== 'undefined' ? canRequestIntentionalDuplicate : false
          }) %>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="form-section tech-form-section--catalog">
    <div class="form-section-header">
      <div>
        <p class="eyebrow">Model</p>
        <h3>Unit Category, Manufacturer, and Model</h3>
      </div>
      <p>
        Select the Unit Category first, then the manufacturer and managed model. Choosing a model can confirm or update the matching Unit Category.
      </p>
    </div>

    <div class="form-grid">
      <label class="form-field">
        <span>Unit Category</span>
        <select name="unitCategoryConfigValueId" required data-unit-category-select>
          <option value="">Select category</option>
          <% formOptions.unitCategories.forEach((category) => { %>
            <option value="<%= category.id %>" data-production-weight="<%= canViewProductionWeight ? (category.defaultProductionWeightValue || '') : '' %>" <%= selected(formData.unitCategoryConfigValueId, category.id) %>>
              <%= category.label %>
            </option>
          <% }) %>
        </select>
        <small class="field-hint">
          Select the Unit Category before choosing a manufacturer. A managed model may update it to the model's configured category.
        </small>
      </label>

      <label class="form-field" data-unit-form-field-key="manufacturer">
        <span>Manufacturer</span>
        <select name="manufacturerId" data-manufacturer-select>
          <option value="">Select manufacturer</option>
          <% formOptions.manufacturers.forEach((manufacturer) => { %>
            <option value="<%= manufacturer.id %>" data-is-apple="<%= String(manufacturer.label || '').trim().toLowerCase() === 'apple' ? '1' : '0' %>" <%= selected(formData.manufacturerId, manufacturer.id) %>>
              <%= manufacturer.label %>
            </option>
          <% }) %>
        </select>
        <small class="field-hint">
          Selecting a manufacturer loads that manufacturer's model catalog. Unit Category further refines the list.
        </small>
      </label>

      <label class="form-field tech-unit-model-field" data-unit-form-field-key="unit_model">
        <span>Unit Model</span>
        <div class="tech-unit-model-combobox" data-unit-model-combobox>
          <input
            type="search"
            class="tech-unit-model-combobox-input"
            data-unit-model-combobox-input
            autocomplete="off"
            placeholder="Select manufacturer first"
            aria-label="Unit Model"
            aria-autocomplete="list"
            aria-expanded="false"
            disabled
          />
          <input type="hidden" name="unitModelId" value="<%= formData.unitModelId || '' %>" data-unit-model-select />
          <div class="tech-unit-model-options" data-unit-model-options role="listbox" hidden></div>
          <select data-unit-model-catalog hidden aria-hidden="true" tabindex="-1">
            <% formOptions.unitModels.forEach((unitModel) => { %>
              <option
                value="<%= unitModel.id %>"
                data-manufacturer-id="<%= unitModel.manufacturerId || '' %>"
                data-category-id="<%= unitModel.unitCategoryConfigValueId || '' %>"
                data-model-active="<%= unitModel.isActive ? '1' : '0' %>"
                data-usage-score="<%= Number(unitModel.operationalUsageScore || 0) %>"
                <%= selected(formData.unitModelId, unitModel.id) %>
              >
                <%= unitModel.label %><%= unitModel.isActive ? '' : ' (Inactive)' %>
              </option>
            <% }) %>
          </select>
        </div>
        <small class="field-hint" data-unit-model-hint>
          Select a manufacturer to load its model catalog. Selecting a Unit Category narrows the list to matching models.
        </small>
      </label>

      <label class="form-field" data-unit-form-field-key="screen_size">
        <span>Screen Size</span>
        <select name="screenSizeConfigValueId">
          <option value="">Choose an option</option>
          <% (formOptions.screenSizes || []).forEach((screenSize) => { %>
            <option value="<%= screenSize.id %>" <%= selected(formData.screenSizeConfigValueId, screenSize.id) %>><%= screenSize.label %></option>
          <% }) %>
        </select>
      </label>

      <label class="form-field tech-spec-short-field tech-spec-short-field--apple-model" data-unit-form-field-key="apple_model_number" data-apple-only-field>
        <span>Apple Model Number</span>
        <input type="text" name="appleModelNumber" value="<%= formData.appleModelNumber || '' %>" maxlength="80" placeholder="Example: A2141" />
      </label>

      <label class="form-field tech-spec-short-field tech-spec-short-field--year" data-unit-form-field-key="model_year" data-apple-only-field>
        <span>Model Year</span>
        <input type="number" name="modelYear" value="<%= formData.modelYear || '' %>" min="1980" max="2100" step="1" inputmode="numeric" placeholder="Example: 2023" />
      </label>

    </div>

    <% if (canRequestModelCatalogException) { %>
      <div class="tech-catalog-request-action" data-catalog-request-action-kind="model">
        <button type="button" class="secondary-button" data-catalog-request-button="model" disabled aria-disabled="true">Request Missing Model</button>
        <small class="field-hint" data-catalog-request-model-hint>Select Manufacturer and Unit Category, then type the exact model name that is missing from the managed catalog.</small>
      </div>
    <% } %>
  </div>

<% if (isEditMode && canViewProductionWeight) { %>
  <div class="form-section form-section--production-weight tech-form-section--weight">
    <div class="form-section-header">
      <div>
        <p class="eyebrow">Production Weight</p>
        <h3>Production Weight</h3>
      </div>
      <p>
        Review the effective weight before saving.
      </p>
    </div>

    <div class="production-weight-preview-grid production-weight-preview-grid--simple">
      <div class="production-weight-preview-card">
        <span>Effective Weight</span>
        <strong data-production-weight-preview-value><%= productionWeightDetails.formattedEffectiveWeight || '—' %></strong>
        <small class="production-weight-unit-override-label" data-production-weight-unit-override-label data-initial-unit-override="<%= productionWeightHasUnitOverride ? 'true' : 'false' %>" <%= productionWeightHasUnitOverride ? '' : 'hidden' %>>Unit override</small>
      </div>
    </div>

    <% if (productionWeightDetails.notes) { %>
      <p class="field-hint production-weight-existing-note">
        Current override note: <%= productionWeightDetails.notes %>
      </p>
    <% } %>

    <% if (canOverrideProductionWeight) { %>
      <div class="form-grid">
        <label class="form-field">
          <span>Unit Override Weight</span>
          <input
            type="number"
            name="productionWeightOverride"
            value="<%= formData.productionWeightOverride || '' %>"
            step="0.01"
            min="0"
            placeholder="Optional custom weight"
            autocomplete="off"
            data-production-weight-override-input
          />
          <small class="field-hint">
            Leave blank to use the selected Lot/category weight. An individual Unit override stays with the Unit and continues to take precedence after it moves to another Lot.
          </small>
        </label>

        <label class="form-field">
          <span>Unit Override Notes</span>
          <textarea name="productionWeightNotes" rows="3" maxlength="500" placeholder="Optional unit override note"><%= formData.productionWeightNotes || '' %></textarea>
          <small class="field-hint">
            Optional note for the unit override.
          </small>
        </label>
      </div>
    <% } %>
  </div>
<% } %>

  <div class="form-section tech-form-section--processor" data-unit-form-auto-collapse>
    <div class="form-section-header">
      <div>
        <p class="eyebrow">CPU</p>
        <h3>Processor Information</h3>
      </div>
      <p>
        CPU details are used as a secondary confidence check when matching a unit by serial number.
        The expected display format is CPU manufacturer, CPU model, and speed.
      </p>
    </div>

    <div class="form-grid">
      <label class="form-field" data-unit-form-follows-key="processor_model">
        <span>Processor Type</span>
        <select data-processor-brand-select disabled>
          <option value="">Select Unit Model first</option>
          <% (formOptions.processorBrands || []).forEach((processorBrand) => { %>
            <option
              value="<%= processorBrand.id %>"
              data-usage-score="<%= Number(processorBrand.usageScore || 0) %>"
              data-context-usage-scores="<%= processorBrand.usageScoresByContextSerialized || '' %>"
            ><%= processorBrand.label %></option>
          <% }) %>
        </select>
        <small class="field-hint" data-processor-brand-hint>
          Processor types are limited to the selected Unit Model.
        </small>
      </label>

      <label class="form-field tech-unit-processor-field" data-unit-form-field-key="processor_model">
        <span>Processor</span>
        <div class="tech-unit-processor-combobox" data-processor-combobox>
          <input
            type="search"
            class="tech-unit-processor-combobox-input"
            data-processor-combobox-input
            autocomplete="off"
            placeholder="Select Unit Model first"
            aria-label="Processor"
            aria-autocomplete="list"
            aria-expanded="false"
            disabled
          />
          <input type="hidden" name="processorModelId" value="<%= formData.processorModelId || '' %>" data-processor-model-select />
          <div class="tech-unit-processor-options" data-processor-options role="listbox" hidden></div>
          <select data-processor-catalog hidden aria-hidden="true" tabindex="-1">
            <% formOptions.processorModels.forEach((processorModel) => { %>
              <option
                value="<%= processorModel.id %>"
                data-processor-brand-id="<%= processorModel.processorBrandId || '' %>"
                data-compatible-unit-model-ids="<%= (processorModel.compatibleUnitModelIds || []).join(',') %>"
                data-base-speed-ghz="<%= processorModel.baseSpeedGhz || '' %>"
                data-usage-score="<%= Number(processorModel.usageScore || 0) %>"
                data-context-usage-scores="<%= processorModel.usageScoresByContextSerialized || '' %>"
                data-is-apple-silicon="<%= /^(?:Apple\s+)?M\d/i.test(String(processorModel.label || '').trim()) ? '1' : '0' %>"
                <%= selected(formData.processorModelId, processorModel.id) %>
              >
                <%= processorModel.label %>
              </option>
            <% }) %>
          </select>
        </div>
        <small class="field-hint" data-processor-model-hint>
          Select a compatible Processor Type, then search its allowed processor values.
        </small>
      </label>

      <label class="form-field" data-unit-form-field-key="processor_speed_ghz" data-processor-speed-applicability-field>
        <span>Processor Speed GHz</span>
        <input
          type="number"
          name="processorSpeedGhz"
          value="<%= formData.processorSpeedGhz %>"
          min="0"
          step="0.01"
          placeholder="Example: 2.40"
          data-processor-speed-input
        />
        <small class="field-hint">
          Store the numeric speed only. The frontend displays it with GHz.
        </small>
      </label>
    </div>

    <% if (canRequestProcessorCatalogException) { %>
      <div class="message info tech-processor-catalog-empty-message" data-processor-catalog-empty-message hidden>
        <p>No compatible processors are cataloged for this Unit Model. Enter the observed values below and send them for review.</p>
      </div>

      <div class="tech-catalog-request-fields" data-processor-catalog-request-fields hidden>
        <div class="form-grid">
          <label class="form-field">
            <span>Observed Processor Type</span>
            <input type="text" maxlength="100" placeholder="Example: Intel, AMD, Apple, Qualcomm" autocomplete="off" data-processor-request-type-input />
          </label>
          <label class="form-field">
            <span>Observed Processor</span>
            <input type="text" maxlength="150" placeholder="Exact value from BIOS, ScanTools, or TechTools" autocomplete="off" data-processor-request-name-input />
          </label>
          <label class="form-field">
            <span>Observed Processor Speed GHz</span>
            <input type="number" min="0.01" max="99.99" step="0.01" placeholder="Example: 2.40" autocomplete="off" data-processor-request-speed-input />
          </label>
        </div>
        <small class="field-hint">These values are used only to prepare the catalog request. They do not save directly to the Unit.</small>
      </div>

      <div class="tech-catalog-request-action" data-catalog-request-action-kind="processor">
        <button type="button" class="secondary-button" data-catalog-request-button="processor" disabled aria-disabled="true">Request Processor Addition</button>
        <small class="field-hint" data-catalog-request-processor-hint>Select a Unit Model first. Use this when the observed Processor Type, Processor, or Processor Speed is unavailable for that model.</small>
      </div>
    <% } %>
  </div>

  <div class="visually-hidden" aria-hidden="true" data-hardware-derived-totals>
    <div>
      <input data-unit-form-companion-key="previous_memory_size"
        type="hidden"
        name="previousRamGb"
        value="<%= hasExplicitCapacityRows(previousMemoryRows) ? memoryRowsTotalGb(previousMemoryRows) : (formData.previousRamGb || '') %>"
        data-previous-memory-total-input
        data-auto-from-components="<%= hasExplicitCapacityRows(previousMemoryRows) ? 'true' : 'false' %>"
      />
    </div>
    <input
      type="hidden"
      name="ramGb"
      value="<%= hasExplicitCapacityRows(memoryRows) ? memoryTotalGb() : (formData.ramGb || '') %>"
      data-unit-form-companion-key="memory_modules"
      data-memory-total-input
      data-auto-from-components="<%= hasExplicitCapacityRows(memoryRows) ? 'true' : 'false' %>"
    />
    <div>
      <input data-unit-form-companion-key="previous_storage_size"
        type="hidden"
        name="previousStorageGb"
        value="<%= hasExplicitCapacityRows(previousStorageRows) ? storageRowsTotalGb(previousStorageRows) : (formData.previousStorageGb || '') %>"
        data-previous-storage-total-input
        data-auto-from-components="<%= hasExplicitCapacityRows(previousStorageRows) ? 'true' : 'false' %>"
      />
    </div>
    <input
      type="hidden"
      name="storageGb"
      value="<%= hasExplicitCapacityRows(storageRows) ? storageTotalGb() : (formData.storageGb || '') %>"
      data-unit-form-companion-key="storage_devices"
      data-storage-total-input
      data-auto-from-components="<%= hasExplicitCapacityRows(storageRows) ? 'true' : 'false' %>"
    />
  </div>

  <div class="form-section tech-form-section--memory" data-unit-form-auto-collapse>
    <div class="form-section-header">
      <div>
        <p class="eyebrow">Memory</p>
        <h3>Memory Modules</h3>
      </div>
      <p>Enter 0 for an empty slot, or sizes such as 8GB, 16GB, or 1TB. Entries such as 1000 or 1024 normalize to 1TB. Previous and Current stay independent; Lot Requirements evaluate Current totals only.</p>
    </div>

    <div class="tech-memory-editor tech-memory-editor--compare" data-memory-editor>
      <section class="tech-memory-state tech-memory-state--previous" data-unit-form-field-key="previous_memory_size" aria-label="Previous memory modules">
        <div class="tech-memory-state-bar">
          <div class="tech-memory-state-title">
            <strong>Previous</strong>
            <span><strong data-previous-memory-total-display><%= formatCapacity(hasExplicitCapacityRows(previousMemoryRows) ? memoryRowsTotalGb(previousMemoryRows) : formData.previousRamGb) || "0GB" %></strong> total</span>
          </div>
          <div class="tech-memory-state-actions">
            <button tabindex="-1" type="button" class="secondary-button" data-add-module-row="previousMemory">+ Add</button>
            <button type="button" class="secondary-button tech-memory-copy-button" data-copy-previous-memory <%= hasExplicitCapacityRows(previousMemoryRows) ? '' : 'disabled aria-disabled="true"' %>>Copy to Current</button>
          </div>
        </div>

        <div class="tech-memory-row-list" data-module-list="previousMemory">
          <% previousMemoryRows.forEach((moduleRow, index) => { %>
            <div class="tech-memory-edit-row" data-module-row="previousMemory">
              <span class="tech-memory-row-number" data-module-display-number><%= index + 1 %></span>
              <input type="hidden" name="previousMemoryModules[<%= index %>][slotLabel]" value="<%= moduleRow.slotLabel || `Slot ${index + 1}` %>" />
              <label class="form-field tech-memory-size-field"><span>Size</span><input type="text" inputmode="decimal" name="previousMemoryModules[<%= index %>][sizeGb]" value="<%= formatCapacity(moduleRow.sizeGb) %>" placeholder="0, 8GB, or 1TB" autocomplete="off" spellcheck="false" data-capacity-input data-previous-memory-size-input data-module-field /></label>
              <label class="form-field tech-memory-type-field"><span>Memory Type</span><select name="previousMemoryModules[<%= index %>][ramTypeConfigValueId]" data-module-field><option value="">Select memory type</option><% formOptions.ramTypes.forEach((ramType) => { %><option value="<%= ramType.id %>" <%= selected(moduleRow.ramTypeConfigValueId, ramType.id) %>><%= ramType.label %></option><% }) %></select></label>
              <label class="form-field tech-memory-install-field"><span>Install Type</span><select name="previousMemoryModules[<%= index %>][memoryInstallTypeCode]" data-module-field><option value="">Select install type</option><% memoryInstallTypes.forEach((installType) => { %><option value="<%= installType.code %>" <%= selectedInstallType(moduleRow.memoryInstallTypeCode, installType.code) %>><%= installType.label %></option><% }) %></select></label>
              <input type="hidden" name="previousMemoryModules[<%= index %>][componentRowId]" value="<%= moduleRow.componentRowId || '' %>" />
              <button tabindex="-1" type="button" class="secondary-button tech-memory-remove-button" data-remove-module-row aria-label="Remove previous memory module <%= index + 1 %>">Remove</button>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="tech-memory-state tech-memory-state--current" data-unit-form-field-key="memory_modules" data-unit-form-repeatable-type="memory" aria-label="Current memory modules">
        <div class="tech-memory-state-bar">
          <div class="tech-memory-state-title">
            <strong>Current</strong>
            <span><strong data-memory-total-display><%= formatCapacity(hasExplicitCapacityRows(memoryRows) ? memoryTotalGb() : formData.ramGb) || "0GB" %></strong> total</span>
          </div>
          <button tabindex="-1" type="button" class="secondary-button" data-add-module-row="memory">+ Add</button>
        </div>

        <div class="tech-memory-row-list" data-module-list="memory">
          <% memoryRows.forEach((moduleRow, index) => { %>
            <div class="tech-memory-edit-row" data-module-row="memory">
              <span class="tech-memory-row-number" data-module-display-number><%= index + 1 %></span>
              <input type="hidden" name="memoryModules[<%= index %>][slotLabel]" value="<%= moduleRow.slotLabel || `Slot ${index + 1}` %>" />
              <label class="form-field tech-memory-size-field"><span>Size</span><input type="text" inputmode="decimal" name="memoryModules[<%= index %>][sizeGb]" value="<%= formatCapacity(moduleRow.sizeGb) %>" placeholder="0, 8GB, or 1TB" autocomplete="off" spellcheck="false" data-capacity-input data-memory-size-input data-module-field /></label>
              <label class="form-field tech-memory-type-field"><span>Memory Type</span><select name="memoryModules[<%= index %>][ramTypeConfigValueId]" data-module-field><option value="">Select memory type</option><% formOptions.ramTypes.forEach((ramType) => { %><option value="<%= ramType.id %>" <%= selected(moduleRow.ramTypeConfigValueId, ramType.id) %>><%= ramType.label %></option><% }) %></select></label>
              <label class="form-field tech-memory-install-field"><span>Install Type</span><select name="memoryModules[<%= index %>][memoryInstallTypeCode]" data-module-field><option value="">Select install type</option><% memoryInstallTypes.forEach((installType) => { %><option value="<%= installType.code %>" <%= selectedInstallType(moduleRow.memoryInstallTypeCode, installType.code) %>><%= installType.label %></option><% }) %></select></label>
              <input type="hidden" name="memoryModules[<%= index %>][componentRowId]" value="<%= moduleRow.componentRowId || '' %>" />
              <button tabindex="-1" type="button" class="secondary-button tech-memory-remove-button" data-remove-module-row aria-label="Remove current memory module <%= index + 1 %>">Remove</button>
            </div>
          <% }) %>
        </div>
      </section>
    </div>
  </div>

  <div class="form-section tech-form-section--storage" data-unit-form-auto-collapse>
    <div class="form-section-header">
      <div>
        <p class="eyebrow">Storage</p>
        <h3>Storage Devices</h3>
      </div>
      <p>Enter 0 for an empty bay, or sizes such as 512GB, 1TB, or 2TB. Entries such as 1000/1024 or 2000/2048 normalize to 1TB or 2TB. Previous and Current stay independent; Lot Requirements evaluate Current totals only.</p>
    </div>

    <div class="tech-memory-editor tech-memory-editor--compare tech-storage-editor" data-storage-editor>
      <section class="tech-memory-state tech-memory-state--previous" data-unit-form-field-key="previous_storage_size" aria-label="Previous storage devices">
        <div class="tech-memory-state-bar">
          <div class="tech-memory-state-title">
            <strong>Previous</strong>
            <span><strong data-previous-storage-total-display><%= formatCapacity(hasExplicitCapacityRows(previousStorageRows) ? storageRowsTotalGb(previousStorageRows) : formData.previousStorageGb) || "0GB" %></strong> total</span>
          </div>
          <div class="tech-memory-state-actions">
            <button tabindex="-1" type="button" class="secondary-button" data-add-module-row="previousStorage">+ Add</button>
            <button type="button" class="secondary-button tech-memory-copy-button" data-copy-previous-storage <%= hasExplicitCapacityRows(previousStorageRows) ? '' : 'disabled aria-disabled="true"' %>>Copy to Current</button>
          </div>
        </div>

        <div class="tech-memory-row-list" data-module-list="previousStorage">
          <% previousStorageRows.forEach((deviceRow, index) => { %>
            <div class="tech-memory-edit-row tech-storage-edit-row tech-storage-edit-row--previous" data-module-row="previousStorage">
              <span class="tech-memory-row-number" data-module-display-number><%= index + 1 %></span>
              <input type="hidden" name="previousStorageDevices[<%= index %>][slotLabel]" value="<%= deviceRow.slotLabel || `Drive ${index + 1}` %>" />
              <label class="form-field tech-memory-size-field"><span>Size</span><input type="text" inputmode="decimal" name="previousStorageDevices[<%= index %>][sizeGb]" value="<%= formatCapacity(deviceRow.sizeGb) %>" placeholder="0, 512GB, or 1TB" autocomplete="off" spellcheck="false" data-capacity-input data-previous-storage-size-input data-module-field /></label>
              <label class="form-field tech-memory-type-field"><span>Storage Type</span><select name="previousStorageDevices[<%= index %>][storageTypeConfigValueId]" data-module-field><option value="">Select storage type</option><% formOptions.storageTypes.forEach((storageType) => { %><option value="<%= storageType.id %>" <%= selected(deviceRow.storageTypeConfigValueId, storageType.id) %>><%= storageType.label %></option><% }) %></select></label>
              <input type="hidden" name="previousStorageDevices[<%= index %>][componentRowId]" value="<%= deviceRow.componentRowId || '' %>" />
              <button tabindex="-1" type="button" class="secondary-button tech-memory-remove-button" data-remove-module-row aria-label="Remove previous storage device <%= index + 1 %>">Remove</button>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="tech-memory-state tech-memory-state--current" data-unit-form-field-key="storage_devices" data-unit-form-repeatable-type="storage" aria-label="Current storage devices">
        <div class="tech-memory-state-bar">
          <div class="tech-memory-state-title">
            <strong>Current</strong>
            <span><strong data-storage-total-display><%= formatCapacity(hasExplicitCapacityRows(storageRows) ? storageTotalGb() : formData.storageGb) || "0GB" %></strong> total</span>
          </div>
          <button tabindex="-1" type="button" class="secondary-button" data-add-module-row="storage">+ Add</button>
        </div>

        <div class="tech-memory-row-list" data-module-list="storage">
          <% storageRows.forEach((deviceRow, index) => { %>
            <div class="tech-memory-edit-row tech-storage-edit-row tech-storage-edit-row--current" data-module-row="storage">
              <span class="tech-memory-row-number" data-module-display-number><%= index + 1 %></span>
              <input type="hidden" name="storageDevices[<%= index %>][slotLabel]" value="<%= deviceRow.slotLabel || `Drive ${index + 1}` %>" />
              <label class="form-field tech-memory-size-field"><span>Size</span><input type="text" inputmode="decimal" name="storageDevices[<%= index %>][sizeGb]" value="<%= formatCapacity(deviceRow.sizeGb) %>" placeholder="0, 512GB, or 1TB" autocomplete="off" spellcheck="false" data-capacity-input data-storage-size-input data-module-field /></label>
              <label class="form-field tech-memory-type-field"><span>Storage Type</span><select name="storageDevices[<%= index %>][storageTypeConfigValueId]" data-module-field><option value="">Select storage type</option><% formOptions.storageTypes.forEach((storageType) => { %><option value="<%= storageType.id %>" <%= selected(deviceRow.storageTypeConfigValueId, storageType.id) %>><%= storageType.label %></option><% }) %></select></label>
              <label class="form-field tech-memory-install-field"><span>Wipe Status</span><select name="storageDevices[<%= index %>][wipeStatusConfigValueId]" data-module-field><option value="">Select wipe status</option><% (formOptions.storageWipeStatuses || []).forEach((wipeStatus) => { %><option value="<%= wipeStatus.id %>" <%= selected(deviceRow.wipeStatusConfigValueId, wipeStatus.id) %>><%= wipeStatus.label %></option><% }) %></select></label>
              <input type="hidden" name="storageDevices[<%= index %>][componentRowId]" value="<%= deviceRow.componentRowId || '' %>" />
              <button tabindex="-1" type="button" class="secondary-button tech-memory-remove-button" data-remove-module-row aria-label="Remove current storage device <%= index + 1 %>">Remove</button>
            </div>
          <% }) %>
        </div>
      </section>
    </div>
  </div>

  <div class="form-section tech-form-section--specifications" data-unit-form-auto-collapse>
    <div class="form-section-header">
      <div>
        <p class="eyebrow">Specifications</p>
        <h3>Unit Specifications</h3>
      </div>
      <p>Record the current unit configuration. Fields hidden by the selected Lot stay out of the workflow and are not required.</p>
    </div>

    <div class="form-grid tech-specs-tests-grid">
      <label class="form-field" data-unit-form-field-key="operating_system">
        <span>Operating System</span>
        <select name="operatingSystemConfigValueId">
          <option value="">Choose an option</option>
          <% formOptions.operatingSystems.forEach((operatingSystem) => { %>
            <option value="<%= operatingSystem.id %>" <%= selected(formData.operatingSystemConfigValueId, operatingSystem.id) %>><%= operatingSystem.label %></option>
          <% }) %>
        </select>
      </label>
      <label class="form-field" data-unit-form-field-key="os_build">
        <span data-os-build-label><%= initialIsApple ? 'OS Version' : 'OS Build' %></span>
        <input type="text" name="osBuild" value="<%= formData.osBuild || '' %>" maxlength="100" placeholder="<%= initialIsApple ? 'Example: Tahoe 26.0' : 'Example: 23H2 / 22631' %>" data-os-build-input />
      </label>
      <label class="form-field" data-unit-form-field-key="bios_version">
        <span data-bios-version-label><%= initialIsApple ? 'Firmware Version' : 'BIOS Version' %></span>
        <input type="text" name="biosVersion" value="<%= formData.biosVersion || '' %>" maxlength="100" placeholder="<%= initialIsApple ? 'Example: firmware version' : 'Example: 1.18.0' %>" data-bios-version-input />
      </label>
      <label class="form-field" data-unit-form-field-key="keyboard_language">
        <span>Keyboard Language</span>
        <select name="keyboardLanguageConfigValueId"><option value="">Choose an option</option><% keyboardLanguageOptions.forEach((option) => { %><option value="<%= option.id %>" <%= selected(formData.keyboardLanguageConfigValueId, option.id) %>><%= option.label %></option><% }) %></select>
      </label>
      <label class="form-field" data-unit-form-field-key="wifi_card_present" data-not-apple-field <%= initialIsApple ? 'hidden' : '' %>>
        <span>Wi-Fi Card Present</span>
        <select name="wifiCardPresentConfigValueId"><option value="">Choose an option</option><% yesNoOptions.forEach((option) => { %><option value="<%= option.id %>" <%= selected(formData.wifiCardPresentConfigValueId, option.id) %>><%= option.label %></option><% }) %></select>
      </label>
      <label class="form-field" data-unit-form-field-key="charger_included">
        <span>Charger Included</span>
        <select name="chargerIncludedConfigValueId"><option value="">Choose an option</option><% yesNoOptions.forEach((option) => { %><option value="<%= option.id %>" <%= selected(formData.chargerIncludedConfigValueId, option.id) %>><%= option.label %></option><% }) %></select>
      </label>
      <label class="form-field" data-unit-form-field-key="display_type">
        <span>Display Type</span>
        <select name="displayTypeConfigValueId" data-display-type-select><option value="">Choose an option</option><% displayTypeOptions.forEach((option) => { %><option value="<%= option.id %>" data-apple-disallowed-option="<%= option.appleDisallowed ? 'true' : 'false' %>" <%= initialIsApple && option.appleDisallowed ? 'hidden disabled' : '' %> <%= selected(formData.displayTypeConfigValueId, option.id) %>><%= option.label %></option><% }) %></select>
      </label>
      <label class="form-field" data-unit-form-field-key="native_screen_resolution" data-not-apple-field <%= initialIsApple ? 'hidden' : '' %>>
        <span>Native Screen Resolution</span>
        <select name="nativeScreenResolutionConfigValueId"><option value="">Choose an option</option><% screenResolutionOptions.forEach((option) => { %><option value="<%= option.id %>" <%= selected(formData.nativeScreenResolutionConfigValueId, option.id) %>><%= option.label %></option><% }) %></select>
      </label>
