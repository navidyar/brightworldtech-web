                <span class="tech-unit-summary-id-label">BIOS</span>
                <span class="tech-unit-summary-id-value"><%= biosSerialValue %></span>
              </span>
              <span class="tech-unit-summary-id-item">
                <span class="tech-unit-summary-id-label">Unit</span>
                <span class="tech-unit-summary-id-value"><%= unitSerialValue %></span>
              </span>
            </div>
          </td>
          <% } %>
          <% if (column.key === 'grade_pass_fail') { %>
          <td class="tech-units-browser-cell tech-units-browser-cell--<%= column.spacingProfile %> tech-units-browser-cell--wrap-<%= column.valueWrapMode %> tech-units-browser-cell--grade_pass_fail">
            <div class="tech-unit-summary-grade-stack">
              <div class="tech-unit-summary-grade-row">
                <span class="tech-unit-summary-grade"><%= currentGradeLabel %></span>
                <% if (currentOutcomeLabel) { %>
                  <span class="tech-outcome-pill tech-outcome-pill--<%= currentOutcomeClass %>"><%= currentOutcomeLabel %></span>
                <% } %>
              </div>

              <% if (currentOutcomeLabel) { %>
                <% if (currentOutcome.isPendingApproval) { %>
                  <small class="tech-outcome-status">Approval Requested</small>
                <% } else if (currentOutcome.isApproved && currentOutcome.approvedByName) { %>
                  <small class="tech-outcome-status">Approved by <%= currentOutcome.approvedByName %></small>
                <% } else if (currentOutcome.approvalStatusCode === 'denied' && currentOutcome.approvedByName) { %>
                  <small class="tech-outcome-status">Review declined by <%= currentOutcome.approvedByName %></small>
                <% } %>
              <% } else { %>
                <small class="tech-outcome-status">No Pass/Fail</small>
              <% } %>
            </div>
          </td>
          <% } %>
          <% if (column.key === 'qc') { %>
          <td class="tech-units-browser-cell tech-units-browser-cell--<%= column.spacingProfile %> tech-units-browser-cell--wrap-<%= column.valueWrapMode %> tech-units-qc-cell">
            <% if (unit.qcReviewStateCode === 'not_required') { %>
              <span
                class="tech-qc-status-empty tech-qc-tooltip--not-required"
                data-qc-tooltip="<%= unit.qcReviewStateLabel || 'QC not required for this Lot' %>"
                aria-label="<%= unit.qcReviewStateLabel || 'QC not required for this Lot' %>"
              >
                <%- include('tech-unit-qc-status-icon', { statusCode: 'not_required', decisionCode: '' }) %>
              </span>
            <% } else if (latestQcReview) { %>
              <%
                const qcTooltipTone = ['accepted', 'corrected'].includes(unit.qcReviewStateCode)
                  ? 'accepted'
                  : (unit.qcReviewStateCode === 'ready_recheck' ? 'ready-recheck' : 'rejected');
                const qcTooltipLabel = unit.qcReviewStateLabel || ('QC ' + latestQcReview.decisionLabel);
              %>
              <a
                class="tech-qc-status-link tech-qc-tooltip--<%= qcTooltipTone %>"
                href="/tech/units/<%= unit.unitId %>/qc-review/details/modal<%= isQcPortalMode ? '?qcPortal=1' : '' %>"
                data-tech-modal-trigger
                data-no-row-toggle
                data-qc-tooltip="<%= qcTooltipLabel %>"
                aria-label="View <%= unit.qcReviewStateLabel || ('Quality Control ' + latestQcReview.decisionLabel.toLowerCase()) %> details"
              >
                <%- include('tech-unit-qc-status-icon', { statusCode: unit.qcReviewStateCode, decisionCode: latestQcReview.decisionCode }) %>
              </a>
            <% } else { %>
              <% const qcTooltipLabel = unit.qcReviewStateLabel || 'QC not performed'; %>
              <span
                class="tech-qc-status-empty tech-qc-tooltip--pending"
                data-qc-tooltip="<%= qcTooltipLabel %>"
                aria-label="<%= qcTooltipLabel %>"
              >
                <%- include('tech-unit-qc-status-icon', { statusCode: unit.qcReviewStateCode, decisionCode: '' }) %>
              </span>
            <% } %>
          </td>
          <% } %>
          <% if (column.key === 'amazon_ids') { %>
          <td class="tech-units-browser-cell tech-units-browser-cell--<%= column.spacingProfile %> tech-units-browser-cell--wrap-<%= column.valueWrapMode %> tech-units-browser-cell--amazon_ids">
            <div class="tech-unit-summary-data-stack" aria-label="Amazon identifiers">
              <span class="tech-unit-summary-data-item">
                <span class="tech-unit-summary-data-label">FNSKU</span>
                <span class="tech-unit-summary-data-value"><%= amazonDetails.fnsku || '—' %></span>
              </span>
              <span class="tech-unit-summary-data-item">
                <span class="tech-unit-summary-data-label">ASIN</span>
                <span class="tech-unit-summary-data-value"><%= amazonDetails.asin || '—' %></span>
              </span>
            </div>
          </td>
          <% } %>
          <% if (column.key === 'amazon_logistics') { %>
          <td class="tech-units-browser-cell tech-units-browser-cell--<%= column.spacingProfile %> tech-units-browser-cell--wrap-<%= column.valueWrapMode %> tech-units-browser-cell--amazon_logistics">
            <div class="tech-unit-summary-data-stack" aria-label="Amazon logistics">
              <span class="tech-unit-summary-data-item">
                <span class="tech-unit-summary-data-label">Tracking</span>
                <span class="tech-unit-summary-data-value"><%= amazonDetails.trackingNumber || '—' %></span>
              </span>
              <span class="tech-unit-summary-data-item">
                <span class="tech-unit-summary-data-label">Pallet</span>
                <span class="tech-unit-summary-data-value"><%= amazonDetails.palletNumber || '—' %></span>
              </span>
            </div>
          </td>
          <% } %>
          <% if (column.key === 'completion') { %>
          <td class="tech-units-browser-cell tech-units-browser-cell--<%= column.spacingProfile %> tech-units-browser-cell--wrap-<%= column.valueWrapMode %> tech-units-browser-cell--completion">
            <div class="tech-unit-summary-data-stack" aria-label="Completion">
              <span class="tech-unit-summary-data-item">
                <span class="tech-unit-summary-data-label">State</span>
                <span class="tech-unit-summary-data-value"><%= latestCompletion ? 'Completed' : 'Not Completed' %></span>
              </span>
              <% if (latestCompletion) { %>
                <span class="tech-unit-summary-data-item">
                  <span class="tech-unit-summary-data-label">By</span>
                  <span class="tech-unit-summary-data-value"><%= latestCompletion.completedByName || 'Unknown user' %></span>
                </span>
                <span class="tech-unit-summary-data-item">
                  <span class="tech-unit-summary-data-label">At</span>
                  <span class="tech-unit-summary-data-value"><%= latestCompletion.completedAt ? formatDateTime(latestCompletion.completedAt) : '—' %></span>
                </span>
              <% } %>
            </div>
          </td>
          <% } %>
          <% if (column.key === 'system_bios') { %>
          <td class="tech-units-browser-cell tech-units-browser-cell--<%= column.spacingProfile %> tech-units-browser-cell--wrap-<%= column.valueWrapMode %> tech-units-browser-cell--system_bios">
            <div class="tech-unit-summary-data-stack" aria-label="System and BIOS">
              <span class="tech-unit-summary-data-item">
                <span class="tech-unit-summary-data-label">OS</span>
                <span class="tech-unit-summary-data-value tech-unit-summary-copy-value"><%= specifications && specifications.osBuild ? specifications.osBuild : '—' %></span>
              </span>
              <span class="tech-unit-summary-data-item">
                <span class="tech-unit-summary-data-label">BIOS</span>
                <span class="tech-unit-summary-data-value tech-unit-summary-copy-value"><%= specifications && specifications.biosVersion ? specifications.biosVersion : '—' %></span>
              </span>
              <% if (specsTests && specsTests.appleModelNumber) { %>
                <span class="tech-unit-summary-data-item">
                  <span class="tech-unit-summary-data-label">Apple</span>
                  <span class="tech-unit-summary-data-value tech-unit-summary-copy-value"><%= specsTests.appleModelNumber %></span>
                </span>
              <% } %>
            </div>
          </td>
          <% } %>
          <% if (column.key === 'display_power') { %>
          <td class="tech-units-browser-cell tech-units-browser-cell--<%= column.spacingProfile %> tech-units-browser-cell--wrap-<%= column.valueWrapMode %> tech-units-browser-cell--display_power">
            <div class="tech-unit-summary-data-stack" aria-label="Display and power">
              <span class="tech-unit-summary-data-item"><span class="tech-unit-summary-data-label">Display</span><span class="tech-unit-summary-data-value"><%= specsLabels.displayTypeConfigValueId || '—' %></span></span>
              <span class="tech-unit-summary-data-item"><span class="tech-unit-summary-data-label">Resolution</span><span class="tech-unit-summary-data-value"><%= specsLabels.nativeScreenResolutionConfigValueId || '—' %></span></span>
              <span class="tech-unit-summary-data-item"><span class="tech-unit-summary-data-label">Refresh</span><span class="tech-unit-summary-data-value"><%= specsLabels.refreshRateConfigValueId || '—' %></span></span>
              <span class="tech-unit-summary-data-item"><span class="tech-unit-summary-data-label">Battery</span><span class="tech-unit-summary-data-value"><%= batteryHealthText || '—' %></span></span>
              <span class="tech-unit-summary-data-item"><span class="tech-unit-summary-data-label">Charger</span><span class="tech-unit-summary-data-value"><%= specsLabels.chargerIncludedConfigValueId || '—' %></span></span>
            </div>
          </td>
          <% } %>
          <% if (column.key === 'security_locks') { %>
          <td class="tech-units-browser-cell tech-units-browser-cell--<%= column.spacingProfile %> tech-units-browser-cell--wrap-<%= column.valueWrapMode %> tech-units-browser-cell--security_locks">
            <div class="tech-unit-summary-data-stack" aria-label="Security and lock status">
              <span class="tech-unit-summary-data-item"><span class="tech-unit-summary-data-label">BIOS</span><span class="tech-unit-summary-data-value"><%= specsLabels.biosLockConfigValueId || '—' %></span></span>
              <span class="tech-unit-summary-data-item"><span class="tech-unit-summary-data-label">EFI</span><span class="tech-unit-summary-data-value"><%= specsLabels.efiLockConfigValueId || '—' %></span></span>
              <span class="tech-unit-summary-data-item"><span class="tech-unit-summary-data-label">MDM</span><span class="tech-unit-summary-data-value"><%= specsLabels.mdmLockConfigValueId || '—' %></span></span>
              <span class="tech-unit-summary-data-item"><span class="tech-unit-summary-data-label">iCloud</span><span class="tech-unit-summary-data-value"><%= specsLabels.icloudActivationLockConfigValueId || '—' %></span></span>
              <span class="tech-unit-summary-data-item"><span class="tech-unit-summary-data-label">Absolute</span><span class="tech-unit-summary-data-value"><%= specifications && specifications.absoluteStatusLabel ? specifications.absoluteStatusLabel : '—' %></span></span>
            </div>
          </td>
          <% } %>
          <% if (column.key === 'comments') { %>
          <td class="tech-units-browser-cell tech-units-browser-cell--<%= column.spacingProfile %> tech-units-browser-cell--wrap-<%= column.valueWrapMode %> tech-units-browser-cell--comments">
            <% if (commentLinks.length > 0) { %>
              <div class="tech-unit-browser-comment-links" aria-label="Available Unit comments">
                <% commentLinks.forEach((commentLink) => { const sourceId = `unit-browser-comment-${unit.unitId}-${commentLink.key}`; %>
                  <a
                    class="tech-unit-browser-comment-link"
                    href="/tech/units/<%= unit.unitId %>"
                    data-unit-browser-comment-link
                    data-unit-browser-comment-source="<%= sourceId %>"
                    data-no-row-toggle
                  ><%= commentLink.label %></a>
                  <span id="<%= sourceId %>" hidden><%= commentLink.text %></span>
                <% }) %>
              </div>
            <% } else { %>
              <span class="tech-unit-summary-data-value">—</span>
            <% } %>
          </td>
          <% } %>
          <% if (column.key === 'unit_actions') { %>
          <td class="tech-units-browser-cell tech-units-browser-cell--<%= column.spacingProfile %> tech-units-browser-cell--wrap-<%= column.valueWrapMode %> tech-units-actions-cell">
            <% if (unit.unitId) { %>
              <div class="tech-summary-actions">
                <div class="tech-summary-actions__primary">
                    <% if (canShowQcReviewActions) { %>
                    <% if (qcReviewActionAvailability.acceptEnabled) { %>
                      <a
                        class="secondary-button tech-action-button tech-action-button--qc-accept"
                        href="/tech/units/<%= unit.unitId %>/qc-review/accepted/modal"
                        data-tech-modal-trigger
                        data-no-row-toggle
                      >
                        Accept
                      </a>
                    <% } else { %>
                      <button
                        type="button"
                        class="secondary-button tech-action-button tech-action-button--qc-accept decision-action-disabled"
                        data-no-row-toggle
                        disabled
                        aria-disabled="true"
                        title="<%= qcReviewActionAvailability.acceptDisabledReason || 'Accept is not available for the current QC state.' %>"
                      >
                        Accept
                      </button>
                    <% } %>

                    <% if (qcReviewActionAvailability.rejectEnabled) { %>
                      <a
                        class="danger-button tech-action-button tech-action-button--qc-reject"
                        href="/tech/units/<%= unit.unitId %>/qc-review/rejected/modal"
                        data-tech-modal-trigger
                        data-no-row-toggle
                      >
                        Reject
                      </a>
                    <% } else { %>
                      <button
                        type="button"
                        class="danger-button tech-action-button tech-action-button--qc-reject decision-action-disabled"
                        data-no-row-toggle
                        disabled
                        aria-disabled="true"
                        title="<%= qcReviewActionAvailability.rejectDisabledReason || 'Reject is not available for the current QC state.' %>"
                      >
                        Reject
                      </button>
                    <% } %>
                  <% } %>
                  <% if (canRecordQcReview && unit.qcRequired !== false && unit.latestWorkCompletion && latestQcReview && latestQcReview.decisionCode === 'rejected' && !latestQcCorrection && !unit.isParked) { %>
                    <span class="tech-chip tech-chip--qc-pending">Awaiting correction</span>
                  <% } %>
                  <% if (canRecordQcReview && unit.qcRequired !== false && !unit.latestWorkCompletion && !unit.isParked) { %>
                    <span class="tech-chip">Awaiting completion</span>
                  <% } %>
                  <% if (canSubmitQcCorrection) { %>
                    <a
                      class="secondary-button tech-action-button tech-action-button--qc-corrected"
                      href="/tech/units/<%= unit.unitId %>/qc-correction/modal"
                      data-tech-modal-trigger
                      data-no-row-toggle
                    >
                      Mark Corrected
                    </a>
                  <% } %>
                  <% if (canEditTechUnits && !unit.isParked && !isReadOnlySearchResult) { %>
                    <a class="secondary-button tech-action-button tech-action-button--edit" href="/tech/units/<%= unit.unitId %>/edit" hx-get="/tech/units/<%= unit.unitId %>/edit/modal" hx-target="#modal-root" hx-swap="innerHTML" data-no-row-toggle>
                      Edit
                    </a>
                  <% } %>
                  <% if (unit.isParked) { %>
                    <span class="tech-chip">Parked</span>
                    <% if (canManageUnitLifecycle) { %>
                      <a
                        class="secondary-button tech-action-button tech-action-button--return"
                        href="/tech/units/<%= unit.unitId %>/return-to-active/modal"
                        data-tech-modal-trigger
                        data-no-row-toggle
                      >
                        Return to Active
                      </a>
                    <% } %>
                  <% } else if (canManageUnitLifecycle) { %>
                    <a
                      class="secondary-button tech-action-button tech-action-button--park tech-delete-action-button"
                      href="/tech/units/<%= unit.unitId %>/park/modal"
                      data-tech-modal-trigger
                      data-no-row-toggle
                    >
                      Park Unit
                    </a>
                  <% } %>
                </div>
                <% if (canCompleteTechUnits && !unit.isParked && !isReadOnlySearchResult) { %>
                  <div class="tech-summary-actions__secondary">
                    <% if (unit.latestWorkCompletion) { %>
                      <button
                        type="button"
                        class="secondary-button tech-action-button tech-action-button--print tech-print-label-action-button"
                        data-no-row-toggle
                        disabled
                        aria-disabled="true"
                        title="Label printing will be connected in the label-printing step."
                      >
                        Print Label
                      </button>
                      <% if (canReverseTechUnitCompletion && unit.latestWorkCompletion.creditSource === 'manual_completion') { %>
                        <a
                          class="secondary-button tech-action-button tech-action-button--undo tech-delete-action-button"
                          href="/tech/units/<%= unit.unitId %>/completions/<%= unit.latestWorkCompletion.unitWorkCompletionId %>/reverse/modal"
                          data-tech-modal-trigger
                          data-no-row-toggle
                        >
                          Undo Completion
                        </a>
                      <% } %>
                    <% } else { %>
                      <a
                        class="secondary-button tech-action-button tech-action-button--complete"
                        href="/tech/units/<%= unit.unitId %>/complete-work/modal"
                        data-tech-modal-trigger
                        data-no-row-toggle
                      >
                        Unit Complete
                      </a>
                    <% } %>
                  </div>
                <% } %>
              </div>
            <% } else { %>
              —
            <% } %>
          </td>

          <% } %>
          <% }) %>
        </tr>

        <tr class="tech-detail-row" id="tech-unit-detail-<%= unit.unitId %>" <%= isSingleUnitViewPage ? '' : 'hidden' %>>
          <td colspan="<%= browserColumnCount %>">
            <div class="tech-detail-offset">
              <div class="tech-detail-panel" data-unit-detail-panel>
                <div class="tech-detail-header tech-detail-header--details" data-unit-panel-header="details">
                  <div class="tech-detail-title">
                    <strong>Unit Details</strong>
                    <span><%= assetTagValue %> · <%= unit.specSummary || 'Unit record' %></span>
                    <% if (unit.latestWorkCompletion && unit.latestWorkCompletion.completedAt) { %>
                      <span class="tech-detail-completion-at">Completed: <%= formatDateTime(unit.latestWorkCompletion.completedAt) %></span>
                    <% } %>
                  </div>

                  <div class="tech-detail-actions">
                    <div class="tech-detail-status">
                      <span class="tech-chip"><%= unit.categoryLabel %></span>
                      <% if (currentGrade) { %>
                        <span class="tech-chip">Grade <%= currentGrade.gradeLabel %></span>
                      <% } %>
                      <% if (currentOutcomeLabel) { %>
                        <span class="tech-chip"><%= currentOutcomeLabel %></span>
                      <% } %>
                      <% if (unit.isParked) { %>
                        <span class="tech-chip">Parked</span>
                      <% } %>
                      <% if (isReadOnlySearchResult) { %>
                        <span class="tech-chip">Read-only search result</span>
                      <% } %>
                      <% if (latestManualOverride) { %>
                        <span class="tech-chip">Override <%= latestManualOverride.statusLabel %></span>
                      <% } %>
                      <% if (unit.qcReviewStateCode === 'not_required') { %>
                        <span class="tech-chip">QC Not Required</span>
                      <% } else if (latestQcReview) { %>
                        <a
                          class="tech-qc-detail-chip tech-qc-detail-chip--<%= latestQcReview.decisionCode %>"
                          href="/tech/units/<%= unit.unitId %>/qc-review/details/modal<%= isQcPortalMode ? '?qcPortal=1' : '' %>"
                          data-tech-modal-trigger
                          data-no-row-toggle
                        >
                          <%- include('tech-unit-qc-status-icon', { statusCode: unit.qcReviewStateCode, decisionCode: latestQcReview.decisionCode }) %>
                          QC <%= unit.qcReviewStateCode === 'corrected' ? 'Corrected' : (unit.qcReviewStateCode === 'ready_recheck' ? 'Ready for Recheck' : latestQcReview.decisionLabel) %>
                        </a>
                      <% } %>
                    </div>

                    <% if (unit.unitId) { %>
                      <% if (canRequestUnitOverride) { %>
                        <% if (hasPendingManualOverride) { %>
                          <button
                            type="button"
                            class="secondary-button tech-action-button tech-action-button--request"
                            data-no-row-toggle
                            disabled
                            aria-disabled="true"
                            title="Tech Lead+ must approve or deny the pending request before another request can be created."
                          >
                            <%= unit.isParked ? 'Takeover Pending' : 'Override Pending' %>
                          </button>
                        <% } else { %>
                          <a
                            class="secondary-button tech-action-button tech-action-button--request"
                            href="/tech/units/<%= unit.unitId %>/override/modal"
                            data-tech-modal-trigger
                            data-no-row-toggle
                          >
                            <%= unit.isParked ? 'Request Takeover' : 'Request Override' %>
                          </a>
                        <% } %>
                      <% } %>

                      <% if (canSubmitQcCorrection) { %>
                        <a
                          class="secondary-button tech-action-button tech-action-button--qc-corrected"
                          href="/tech/units/<%= unit.unitId %>/qc-correction/modal"
                          data-tech-modal-trigger
                          data-no-row-toggle
                        >
                          Mark Corrected
                        </a>
                      <% } %>

                      <% if (canViewTechWeightDetails) { %>
                        <button
                          type="button"
                          class="secondary-button tech-action-button tech-action-button--info tech-personal-credit-action-button"
                          data-unit-panel-button
                          data-panel="my-weight"
                          data-no-row-toggle
                          hx-get="/tech/units/<%= unit.unitId %>/my-weight-earned"
                          hx-target="#tech-unit-my-weight-content-<%= unit.unitId %>"
                          hx-swap="innerHTML"
                        >
                          My Weight Earned
                        </button>
                      <% } %>

                      <% if (canViewUnitHistory) { %>
                        <button
                          type="button"
                          class="secondary-button tech-action-button tech-action-button--history tech-history-action-button"
                          data-unit-panel-button
                          data-panel="history"
                          data-no-row-toggle
                          hx-get="/tech/units/<%= unit.unitId %>/history<%= isQcPortalMode ? '?qcPortal=1' : '' %>"
                          hx-target="#tech-unit-history-content-<%= unit.unitId %>"
                          hx-swap="innerHTML"
                        >
                          History
                        </button>
                      <% } %>
                      <% if (canDeleteTechUnits) { %>
                        <a
                          class="secondary-button danger-button tech-permanent-delete-action-button"
                          href="/tech/units/<%= unit.unitId %>/permanent-delete/modal"
                          data-tech-modal-trigger
                          data-no-row-toggle
                        >
                          Delete Unit Permanently
                        </a>
                      <% } %>
                    <% } %>
                  </div>
                </div>

                <% if (canViewUnitHistory) { %>
                  <div class="tech-detail-header tech-detail-header--history" data-unit-panel-header="history" hidden>
                    <div class="tech-detail-title">
                      <strong>Unit History</strong>
                      <span><%= assetTagValue %> · Audit timeline, newest first</span>
                    </div>

                    <div class="tech-detail-actions tech-detail-actions--history">
                      <button
                        type="button"
                        class="tech-detail-view-link"
                        data-unit-panel-button
                        data-panel="details"
                        data-no-row-toggle
                      >
                        Back to Details
                      </button>
                    </div>
                  </div>
                <% } %>

                <div class="tech-unit-panel-stack">
                  <div id="tech-unit-current-panel-<%= unit.unitId %>" class="tech-unit-panel-view" data-unit-panel-content="details">

                <% if (expanded.schemaReady === false) { %>
                  <div class="message error">
                    <p>Expanded Step 3a tables were not detected. Run the Step 3a database migration before using expanded unit details.</p>
                  </div>
                <% } else if (!expanded.hasAnyExpandedData) { %>
                  <div class="message success">
                    <p>Expanded unit tables are ready. No detailed memory, storage, cellular, GPU, issue, grade, or comment records have been added for this unit yet.</p>
                  </div>
                <% } %>

                <div class="tech-detail-layout tech-detail-layout--identity-grade">
                  <section class="tech-detail-section tech-detail-section--identity tech-detail-section--identity-identifiers">
                    <h3>Identity</h3>

                    <p class="tech-detail-subheading">Identity</p>
                    <dl class="tech-detail-list">
                      <div>
                        <dt>Lot</dt>
                        <dd>
                          <%= unit.lotName || '—' %>
                          <% if (unit.isLotClosed) { %>
                            <span class="tech-chip">Closed</span>
                          <% } %>
                        </dd>
                      </div>

                      <% if (unit.lotFullPath) { %>
                        <div class="tech-detail-list--wide-value">
                          <dt>Lot Hierarchy</dt>
                          <dd class="tech-lot-hierarchy-text"><%= unit.lotFullPath %></dd>
                        </div>
                      <% } %>

                      <div>
                        <dt>Assigned Tech</dt>
                        <dd><%= unit.assignedToName || 'Unassigned' %></dd>
                      </div>

                      <div>
                        <dt>Category</dt>
                        <dd><%= unit.categoryLabel || '—' %></dd>
                      </div>

                      <% if (canViewCurrentLotWeight) { %>
                        <div>
                          <dt>Current Lot Weight</dt>
                          <dd>
                            <div class="tech-production-weight-detail">
                              <div class="tech-production-weight-detail-main">
                                <strong><%= unit.formattedCurrentLotWeight || '—' %></strong>
                              </div>
                            </div>
                          </dd>
                        </div>
                      <% } %>
                    </dl>

                    <p class="tech-detail-subheading">Identifiers</p>
                    <% if (identifiers.length > 0) { %>
                      <dl class="tech-detail-list tech-detail-list--identifiers">
                        <% identifiers.forEach((identifier) => { %>
                          <div>
                            <dt><%= identifier.typeLabel %></dt>
                            <dd>
                              <%= displayIdentifierValue(identifier) %>
                              <% if (identifier.isPrimary) { %>
                                <span class="tech-chip">Primary</span>
                              <% } %>
                            </dd>
                          </div>
                        <% }) %>
                      </dl>
                    <% } else { %>
                      <p class="field-hint">No serial or BIOS identifier rows have been recorded yet.</p>
                    <% } %>
                  </section>

                  <% if (hasAmazonDetails) { %>
                    <section class="tech-detail-section">
                      <h3>Amazon</h3>
                      <dl class="tech-detail-list">
                        <% if (amazonDetails.fnsku) { %><div><dt>FNSKU</dt><dd><%= amazonDetails.fnsku %></dd></div><% } %>
                        <% if (amazonDetails.asin) { %><div><dt>ASIN</dt><dd><%= amazonDetails.asin %></dd></div><% } %>
                        <% if (amazonDetails.trackingNumber) { %><div><dt>Tracking Number</dt><dd><%= amazonDetails.trackingNumber %></dd></div><% } %>
                        <% if (amazonDetails.palletNumber) { %><div><dt>Current Pallet Number</dt><dd><%= amazonDetails.palletNumber %></dd></div><% } %>
                        <% if (amazonDetails.buyerComments) { %><div class="tech-detail-list--wide-value"><dt>Buyer Comments</dt><dd><%= amazonDetails.buyerComments %></dd></div><% } %>
                      </dl>
                    </section>
                  <% } %>

                  <section class="tech-detail-section tech-detail-section--grade">
                    <h3>Cosmetic Grade & Unit Outcome</h3>

                    <dl class="tech-detail-list">
                      <div>
                        <dt>Cosmetic Grade</dt>
                        <dd><%= currentGrade ? currentGrade.gradeLabel : '—' %></dd>
                      </div>

                      <div>
                        <dt>Unit Outcome</dt>
                        <dd>
                          <% if (currentOutcomeLabel) { %>
                            <span class="tech-outcome-pill tech-outcome-pill--<%= currentOutcomeClass %>"><%= currentOutcomeLabel %></span>
                          <% } else { %>
                            —
                          <% } %>
                        </dd>
                      </div>

                      <div>
                        <dt>Outcome Approval</dt>
                        <dd>
                          <% if (currentOutcome && currentOutcome.isApproved && currentOutcome.approvedByName) { %>
                            Approved by <%= currentOutcome.approvedByName %>
                          <% } else if (currentOutcome && currentOutcome.isPendingApproval) { %>
                            Approval Requested
                          <% } else { %>
                            —
                          <% } %>
                        </dd>
                      </div>

                      <% if (currentOutcome && currentOutcome.approvalRequestNotes) { %>
                        <div>
                          <dt>Approval Request Notes</dt>
                          <dd><%= currentOutcome.approvalRequestNotes %></dd>
                        </div>
                      <% } %>

                      <% if (currentOutcome && currentOutcome.isPendingApproval && canApproveUnitOutcomes) { %>
                        <div>
                          <dt>Review</dt>
                          <dd><a href="/unit-requests?status=pending&requestType=outcome_confirmation">Review Request</a></dd>
                        </div>
                      <% } %>

                      <div>
                        <dt>Grade Source</dt>
                        <dd><%= currentGrade ? sourceLabel(currentGrade.sourceCode) : '—' %></dd>
                      </div>

                      <div>
                        <dt>Grade Assessed</dt>
                        <dd><%= currentGrade && currentGrade.assessedAt ? formatDateTime(currentGrade.assessedAt) : '—' %></dd>
                      </div>

                      <% if (currentGrade && currentGrade.notes) { %>
                        <div>
                          <dt>Cosmetic Grade Notes</dt>
                          <dd><%= currentGrade.notes %></dd>
                        </div>
                      <% } %>
                    </dl>
                  </section>
                </div>

                <div class="tech-detail-layout">
                  <section class="tech-detail-section tech-detail-section--hardware">
                    <h3>Hardware</h3>

                    <dl class="tech-detail-list">
                      <div>
                        <dt>Manufacturer</dt>
                        <dd><%= unit.manufacturerLabel || '—' %></dd>
                      </div>

                      <div>
                        <dt>Model</dt>
                        <dd><%= unit.modelLabel || '—' %></dd>
                      </div>

                      <div>
                        <dt>Screen Size</dt>
                        <dd><%= unit.screenSizeLabel || '—' %></dd>
                      </div>

                      <% if (String(unit.manufacturerLabel || '').trim().toLowerCase() === 'apple') { %>
                        <div>
                          <dt>Apple Model Number</dt>
                          <dd><%= specsTests && specsTests.appleModelNumber ? specsTests.appleModelNumber : '—' %></dd>
                        </div>
                        <div>
                          <dt>Model Year</dt>
                          <dd><%= unit.modelYear || '—' %></dd>
                        </div>
                      <% } %>

                      <div>
                        <dt>Processor</dt>
                        <dd><%= unit.processorLabel || '—' %></dd>
                      </div>

                      <div>
                        <dt>Processor Speed</dt>
                        <dd><%= unit.processorSpeedGhz ? `${unit.processorSpeedGhz}GHz` : '—' %></dd>
                      </div>

                      <div>
                        <dt>Previous Memory</dt>
                        <dd><%= formatGb(previousMemoryModules.length > 0 ? expanded.previousMemoryTotalGb : unit.previousRamGb) %></dd>
                      </div>

                      <div>
                        <dt>Current Memory</dt>
                        <dd><%= formatGb(memoryModules.length > 0 ? expanded.memoryTotalGb : unit.ramGb) %></dd>
                      </div>

                      <div>
                        <dt>Previous Storage</dt>
                        <dd><%= formatGb(previousStorageDevices.length > 0 ? expanded.previousStorageTotalGb : unit.previousStorageGb) %></dd>
                      </div>

                      <div>
                        <dt>Current Storage</dt>
                        <dd><%= formatGb(storageDevices.length > 0 ? expanded.storageTotalGb : unit.storageGb) %></dd>
                      </div>

                      <div>
                        <dt>Battery Health</dt>
                        <dd><%= unit.formattedBatteryHealth || '—' %></dd>
                      </div>
                    </dl>
                  </section>

                  <section class="tech-detail-section tech-detail-section--checks">
                    <% const isAppleUnit = String(unit.manufacturerLabel || '').trim().toLowerCase() === 'apple'; %>
                    <h3>Specifications / Tests</h3>
                    <dl class="tech-detail-list">
                      <div><dt>Operating System</dt><dd><%= unit.operatingSystemLabel || '—' %></dd></div>
                      <div><dt><%= isAppleUnit ? 'Firmware Version' : 'BIOS Version' %></dt><dd><%= specifications && specifications.biosVersion ? specifications.biosVersion : '—' %></dd></div>
                      <div><dt><%= isAppleUnit ? 'OS Version' : 'OS Build' %></dt><dd><%= specifications && specifications.osBuild ? specifications.osBuild : '—' %></dd></div>
                      <div><dt>Keyboard Language</dt><dd><%= specifications ? specifications.keyboardLanguageLabel : '—' %></dd></div>
                      <% if (!isAppleUnit) { %><div><dt>Wi-Fi Card Present</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.wifiCardPresentConfigValueId || '—') : '—' %></dd></div><% } %>
                      <div><dt>Charger Included</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.chargerIncludedConfigValueId || '—') : '—' %></dd></div>
                      <div><dt>Display Type</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.displayTypeConfigValueId || '—') : '—' %></dd></div>
                      <% if (!isAppleUnit) { %>
                        <div><dt>Native Resolution</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.nativeScreenResolutionConfigValueId || '—') : '—' %></dd></div>
                        <div><dt>Refresh Rate</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.refreshRateConfigValueId || '—') : '—' %></dd></div>
                      <% } %>
                      <div><dt>Color</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.colorConfigValueId || '—') : '—' %></dd></div>
                      <div><dt>Keyboard Test</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.keyboardTestResultConfigValueId || '—') : '—' %></dd></div>
                      <div><dt>Touchscreen Test</dt><dd><%= specifications ? specifications.touchscreenStatusLabel : '—' %></dd></div>
                      <div><dt>Microphone Check</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.microphoneCheckResultConfigValueId || '—') : '—' %></dd></div>
                      <div><dt>Audio Output Check</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.audioOutputCheckResultConfigValueId || '—') : '—' %></dd></div>
                      <div><dt>All Screws Present</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.allScrewsPresentConfigValueId || '—') : '—' %></dd></div>
                      <div><dt>Diagnostics Test</dt><dd><%= specifications ? specifications.completeDiagnosticsStatusLabel : '—' %></dd></div>
                      <div><dt>Threat Protection Scan</dt><dd><%= specifications ? specifications.virusCheckStatusLabel : '—' %></dd></div>
                      <% if (!isAppleUnit) { %>
                        <div><dt>Driver Check</dt><dd><%= specifications ? specifications.driverCheckStatusLabel : '—' %></dd></div>
                        <div><dt>Absolute Status</dt><dd><%= specifications ? specifications.absoluteStatusLabel : '—' %></dd></div>
                        <div><dt>BIOS Lock</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.biosLockConfigValueId || '—') : '—' %></dd></div>
                      <% } %>
                      <div><dt>MDM Lock</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.mdmLockConfigValueId || '—') : '—' %></dd></div>
                      <% if (isAppleUnit) { %>
                        <div><dt>EFI Lock</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.efiLockConfigValueId || '—') : '—' %></dd></div>
                        <div><dt>iCloud Activation Lock</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.icloudActivationLockConfigValueId || '—') : '—' %></dd></div>
                        <div><dt>CE Certification</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.ceCertificationConfigValueId || '—') : '—' %></dd></div>
                        <div><dt>Open-Box Status</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.openBoxStatusConfigValueId || '—') : '—' %></dd></div>
                        <div><dt>Box Language</dt><dd><%= specsTests && specsTests.labels ? (specsTests.labels.boxLanguageConfigValueId || '—') : '—' %></dd></div>
                      <% } %>
                      <div><dt>Skinned</dt><dd><%= specifications ? specifications.skinnedStatusLabel : '—' %></dd></div>
                    </dl>

                    <% if (specsTests && ((specsTests.cameras || []).length || (specsTests.batteries || []).length || (specsTests.biometrics || []).length || (specsTests.ports || []).length)) { %>
                      <div class="tech-detail-subsection">
                        <% if ((specsTests.cameras || []).length) { %><p><strong>Cameras:</strong> <%= specsTests.cameras.map((row) => [row.cameraTypeLabel, row.cameraLocationLabel, row.testResultLabel].filter(Boolean).join(' · ')).join(' | ') %></p><% } %>
                        <% if ((specsTests.batteries || []).length) { %><p><strong>Batteries:</strong> <%= specsTests.batteries.map((row) => [row.healthPercent !== '' ? `${row.healthPercent}%` : '', String(unit.manufacturerLabel || '').trim().toLowerCase() === 'apple' && row.cycleCount !== '' ? `${row.cycleCount} cycles` : ''].filter(Boolean).join(' · ')).join(' | ') %></p><% } %>
                        <% if ((specsTests.biometrics || []).length) { %><p><strong>Biometrics:</strong> <%= specsTests.biometrics.map((row) => [row.hardwareLabel, row.testResultLabel].filter(Boolean).join(' · ')).join(' | ') %></p><% } %>
                        <% if ((specsTests.ports || []).length) { %><p><strong>Ports / Expansion:</strong> <%= specsTests.ports.map((row) => [row.portTypeLabel, row.portCount !== '' ? `x${row.portCount}` : ''].filter(Boolean).join(' ')).join(' | ') %></p><% } %>
                      </div>
                    <% } %>
                  </section>

                  <section class="tech-detail-section tech-detail-section--workflow">
                    <h3>Workflow</h3>

                    <dl class="tech-detail-list">
                      <div>
                        <dt>Created</dt>
                        <dd><%= unit.createdAt ? formatDateTime(unit.createdAt) : '—' %></dd>
                      </div>

                      <div>
                        <dt>Updated</dt>
                        <dd><%= unit.updatedAt ? formatDateTime(unit.updatedAt) : '—' %></dd>
                      </div>

                      <div>
                        <dt>Completed</dt>
                        <dd><%= unit.completedAt ? formatDateTime(unit.completedAt) : '—' %></dd>
                      </div>

                      <% if (unit.isParked) { %>
                        <div>
                          <dt>Parked</dt>
                          <dd><%= unit.parkedAt ? formatDateTime(unit.parkedAt) : 'Yes' %></dd>
                        </div>
                      <% } %>
                    </dl>
                  </section>
                </div>

                <div class="tech-module-pair-layout tech-component-comparison-layout">
                  <section class="tech-notes-section tech-notes-section--memory tech-component-comparison-section">
                    <div class="tech-section-title-row tech-component-comparison-heading">
                      <div>
                        <h3>Memory Modules</h3>
                        <span>Previous <strong><%= formatGb(previousMemoryModules.length > 0 ? expanded.previousMemoryTotalGb : unit.previousRamGb) %></strong> · Current <strong><%= formatGb(memoryModules.length > 0 ? expanded.memoryTotalGb : unit.ramGb) %></strong></span>
                      </div>
                    </div>

                    <% if (memoryComparisons.length > 0) { %>
                      <div class="tech-component-comparison-list">
                        <% memoryComparisons.forEach((comparison) => { %>
                          <article class="tech-component-comparison-row tech-component-comparison-row--<%= comparison.statusCode %>">
                            <header>
                              <strong><%= comparison.slotLabel %></strong>
                              <span class="tech-component-change-chip tech-component-change-chip--<%= comparison.statusCode %>"><%= comparison.statusLabel %></span>
                            </header>
                            <div class="tech-component-comparison-values">
                              <div>
                                <span>Previous</span>
                                <strong><%= comparison.previousText %></strong>
                              </div>
                              <div>
                                <span>Current</span>
                                <strong><%= comparison.currentText %></strong>
                              </div>
                            </div>
                          </article>
                        <% }) %>
                      </div>
                    <% } else { %>
                      <p class="field-hint">No detailed Previous or Current memory module rows are recorded.</p>
                    <% } %>
                  </section>

                  <section class="tech-notes-section tech-notes-section--storage tech-component-comparison-section">
                    <div class="tech-section-title-row tech-component-comparison-heading">
                      <div>
                        <h3>Storage Devices</h3>
                        <span>Previous <strong><%= formatGb(previousStorageDevices.length > 0 ? expanded.previousStorageTotalGb : unit.previousStorageGb) %></strong> · Current <strong><%= formatGb(storageDevices.length > 0 ? expanded.storageTotalGb : unit.storageGb) %></strong></span>
                      </div>
                    </div>

                    <% if (storageComparisons.length > 0) { %>
                      <div class="tech-component-comparison-list">
                        <% storageComparisons.forEach((comparison) => { %>
                          <article class="tech-component-comparison-row tech-component-comparison-row--<%= comparison.statusCode %>">
                            <header>
                              <strong><%= comparison.slotLabel %></strong>
                              <span class="tech-component-change-chip tech-component-change-chip--<%= comparison.statusCode %>"><%= comparison.statusLabel %></span>
                            </header>
                            <div class="tech-component-comparison-values">
                              <div>
                                <span>Previous</span>
                                <strong><%= comparison.previousText %></strong>
                              </div>
                              <div>
                                <span>Current</span>
                                <strong><%= comparison.currentText %></strong>
                              </div>
                            </div>
                          </article>
                        <% }) %>
                      </div>
                    <% } else { %>
                      <p class="field-hint">No detailed Previous or Current storage device rows are recorded.</p>
                    <% } %>
                  </section>
                </div>

                <section class="tech-notes-section tech-notes-section--cellular">
                  <h3>Cellular / WWAN</h3>
                  <p class="field-hint">Deep cellular module and band details should be populated by ScanTool. Manual unit forms should not edit ScanTool-only band details.</p>

                  <% if (cellularModules.length > 0) { %>
                    <div class="tech-detail-layout">
                      <% cellularModules.forEach((cellularModule) => { %>
                        <section class="tech-detail-section tech-detail-section--cellular-module">
                          <dl class="tech-detail-list">
                            <div>
                              <dt>Status</dt>
                              <dd><%= cellularModule.wwanStatusLabel %></dd>
                            </div>
                            <div>
                              <dt>Module</dt>
                              <dd><%= [cellularModule.moduleManufacturer, cellularModule.moduleModel].filter(Boolean).join(' ') || '—' %></dd>
                            </div>
                            <div>
                              <dt>IMEI</dt>
                              <dd><%= cellularModule.imei || '—' %></dd>
                            </div>
                            <div>
                              <dt>Networks</dt>
                              <dd><%= cellularModule.supportedNetworksText || '—' %></dd>
                            </div>
                            <div>
                              <dt>Bands</dt>
                              <dd><%= cellularModule.bandSummary || '—' %></dd>
                            </div>
                            <div>
                              <dt>Carriers</dt>
                              <dd><%= cellularModule.supportedCarriersText || '—' %></dd>
                            </div>
                            <div>
                              <dt>Source</dt>
                              <dd><%= sourceLabel(cellularModule.sourceCode) %></dd>
                            </div>
                          </dl>
                        </section>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <p class="field-hint">No current cellular / WWAN module details recorded yet.</p>
                  <% } %>
                </section>

                <section class="tech-notes-section tech-notes-section--graphics">
                  <h3>Graphics</h3>

                  <% if (graphicsAdapters.length > 0) { %>
                    <div class="tech-detail-layout tech-current-module-layout">
                      <% graphicsAdapters.forEach((graphicsAdapter) => { %>
                        <section class="tech-detail-section tech-detail-section--graphics-adapter">
                          <dl class="tech-detail-list">
                            <div>
                              <dt>Type</dt>
                              <dd><%= graphicsAdapter.gpuTypeLabel %></dd>
                            </div>
                            <div>
                              <dt>Model</dt>
                              <dd><%= graphicsAdapter.gpuModel || '—' %></dd>
                            </div>
                            <div>
                              <dt>VRAM</dt>
                              <dd><%= formatVram(graphicsAdapter.vramMb) || '—' %></dd>
                            </div>
                            <div>
                              <dt>Source</dt>
                              <dd><%= sourceLabel(graphicsAdapter.sourceCode) %></dd>
                            </div>
                          </dl>
                        </section>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <p class="field-hint">No graphics adapter rows recorded yet.</p>
                  <% } %>
                </section>

                <% if (cosmeticIssues.length > 0 || hardwareIssues.length > 0) { %>
                  <section class="tech-notes-section tech-notes-section--issues">
                    <h3>Issue Details</h3>

                    <div class="tech-notes-grid">
                      <div class="tech-note-block">
                        <strong>Cosmetic Issues</strong>

                        <% if (cosmeticIssues.length > 0) { %>
                          <% cosmeticIssues.forEach((issue) => { %>
                            <p>
                              <strong><%= issue.issueLabel %></strong>
                              <% if (issue.severityLabel) { %> · <%= issue.severityLabel %><% } %>
                              <% if (issue.locationLabel) { %> · <%= issue.locationLabel %><% } %>
                              <% if (issue.issueRemark) { %><br /><%= issue.issueRemark %><% } %>
                            </p>
                          <% }) %>
                        <% } else { %>
                          <p>No cosmetic issues recorded.</p>
                        <% } %>
                      </div>

                      <div class="tech-note-block">
                        <strong>Hardware Issues</strong>

                        <% if (hardwareIssues.length > 0) { %>
                          <% hardwareIssues.forEach((issue) => { %>
                            <p>
                              <strong><%= issue.issueLabel %></strong>
                              <% if (issue.locationLabel) { %> · <%= issue.locationLabel %><% } %>
                              <% if (issue.issueRemark) { %><br /><%= issue.issueRemark %><% } %>
                            </p>
                          <% }) %>
                        <% } else { %>
                          <p>No hardware issues recorded.</p>
                        <% } %>
                      </div>
                    </div>
                  </section>
                <% } %>



                <% if (comments.length > 0) { %>
                  <section class="tech-notes-section tech-notes-section--comments">
                    <h3>Comment History</h3>

                    <div class="tech-comment-history-list">
                      <% comments.forEach((comment) => { %>
                        <article class="tech-comment-history-row">
                          <div class="tech-comment-history-meta">
                            <span class="tech-comment-type-label"><%= comment.noteTypeLabel || 'General' %></span>
                            <span><%= comment.createdByName || sourceLabel(comment.sourceCode) %></span>
                            <span><%= comment.createdAt ? formatDateTime(comment.createdAt) : 'No date recorded' %></span>
                          </div>
                          <p class="tech-comment-history-text"><%= comment.commentText %></p>
                        </article>
                      <% }) %>
                    </div>
                  </section>
                <% } %>
                  </div>

                  <% if (canViewTechWeightDetails) { %>
                    <div id="tech-unit-my-weight-panel-<%= unit.unitId %>" class="tech-unit-panel-view" data-unit-panel-content="my-weight" hidden>
                      <div id="tech-unit-my-weight-content-<%= unit.unitId %>" class="tech-history-panel-placeholder">
                        <p>Select My Weight Earned to load your recorded work credit.</p>
                      </div>
                    </div>
                  <% } %>

                  <% if (canViewUnitHistory) { %>
                    <div id="tech-unit-history-panel-<%= unit.unitId %>" class="tech-unit-panel-view" data-unit-panel-content="history" hidden>
                      <div id="tech-unit-history-content-<%= unit.unitId %>" class="tech-history-panel-placeholder">
                        <p>Select History to load this unit's audit history from the server.</p>
                      </div>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          </td>
        </tr>
      </tbody>
    <% }) %>
  </table>
</div>

<% if (!isSingleUnitViewPage) { %>
  <%- include('../partials/table-pagination', { pagination: result.pagination, filters, basePath: browserBasePath, itemLabel: 'units', pageSizeLabel: 'Units per page', modifierClass: 'table-pagination--bottom', ariaLabel: 'Bottom unit pagination' }) %>
<% } %>
