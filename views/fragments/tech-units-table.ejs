                    Asset
                    <% if (sortDirectionIndicator('asset_asc', 'asset_desc')) { %><span aria-hidden="true"><%= sortDirectionIndicator('asset_asc', 'asset_desc') %></span><% } %>
                  </a>
                  <span class="table-sort-group__separator" aria-hidden="true">/</span>
                  <a class="<%= sortLinkClass('az_asc', 'az_desc') %>" href="<%= makeUnitSortUrl(nextSortValue('az_asc', 'az_desc')) %>" <%= sortAriaCurrent('az_asc', 'az_desc') ? 'aria-current="page"' : '' %>>
                    AZ
                    <% if (sortDirectionIndicator('az_asc', 'az_desc')) { %><span aria-hidden="true"><%= sortDirectionIndicator('az_asc', 'az_desc') %></span><% } %>
                  </a>
                </span>
              </span>
            </th>
          <% } else if (column.key === 'grade_pass_fail') { %>
            <th class="tech-units-browser-header tech-units-browser-header--<%= column.spacingProfile %>">
