              return `${meta}\n${String(comment.commentText || '').trim()}`;
            })
            .join('\n\n');
          if (generalCommentText) {
            commentLinks.push({ key: 'general', label: 'General Comments', text: generalCommentText });
          }

          const hardwareCommentText = hardwareIssues
            .filter((issue) => String(issue.issueRemark || '').trim())
            .map((issue) => {
              const meta = [issue.issueLabel || 'Hardware Issue', issue.locationLabel || ''].filter(Boolean).join(' · ');
              return `${meta}\n${String(issue.issueRemark || '').trim()}`;
            })
            .join('\n\n');
          if (hardwareCommentText) {
            commentLinks.push({ key: 'hardware', label: 'Hardware Comments', text: hardwareCommentText });
          }

          const cosmeticCommentText = cosmeticIssues
            .filter((issue) => String(issue.issueRemark || '').trim())
            .map((issue) => {
              const meta = [issue.issueLabel || 'Cosmetic Issue', issue.severityLabel || '', issue.locationLabel || ''].filter(Boolean).join(' · ');
              return `${meta}\n${String(issue.issueRemark || '').trim()}`;
            })
            .join('\n\n');
          if (cosmeticCommentText) {
            commentLinks.push({ key: 'cosmetic', label: 'Cosmetic Comments', text: cosmeticCommentText });
          }
        %>

