                  <% if (sortDirectionIndicator('grade_asc', 'grade_desc')) { %><span aria-hidden="true"><%= sortDirectionIndicator('grade_asc', 'grade_desc') %></span><% } %>
                </a>
                <span class="table-sort-group__separator" aria-hidden="true">/</span>
                <a class="<%= sortLinkClass('outcome_pass_first', 'outcome_fail_first') %>" href="<%= makeUnitSortUrl(nextSortValue('outcome_pass_first', 'outcome_fail_first')) %>" <%= sortAriaCurrent('outcome_pass_first', 'outcome_fail_first') ? 'aria-current="page"' : '' %>>
                  Pass-Fail
                  <% if (sortDirectionIndicator('outcome_pass_first', 'outcome_fail_first')) { %><span aria-hidden="true"><%= sortDirectionIndicator('outcome_pass_first', 'outcome_fail_first') %></span><% } %>
                </a>
              </span>
            </th>
          <% } else if (column.key === 'qc') { %>
            <th class="tech-units-browser-header tech-units-browser-header--<%= column.spacingProfile %> tech-units-qc-column" scope="col">
              <a
                class="tech-units-qc-column-label <%= sortLinkClass('qc_status_desc', 'qc_status_asc') %>"
                href="<%= makeUnitSortUrl(nextSortValue('qc_status_desc', 'qc_status_asc')) %>"
                <%= sortAriaCurrent('qc_status_desc', 'qc_status_asc') ? 'aria-current="page"' : '' %>
                aria-label="Sort Units by Quality Control status"
              >
                QC
                <% if (sortDirectionIndicator('qc_status_desc', 'qc_status_asc', '↓', '↑')) { %><span aria-hidden="true"><%= sortDirectionIndicator('qc_status_desc', 'qc_status_asc', '↓', '↑') %></span><% } %>
              </a>
            </th>
          <% } else if (['amazon_ids', 'amazon_logistics', 'completion', 'system_bios', 'display_power', 'security_locks', 'comments'].includes(column.key)) { %>
            <th class="tech-units-browser-header tech-units-browser-header--<%= column.spacingProfile %>"><%= column.label %></th>
          <% } else if (column.key === 'unit_actions') { %>
            <th class="tech-units-browser-header tech-units-browser-header--<%= column.spacingProfile %> tech-units-actions-column" scope="col">
              <span class="tech-units-actions-column-label">Unit Actions</span>
            </th>
          <% } %>
        <% }) %>
      </tr>
    </thead>

    <% if (result.units.length === 0) { %>
      <tbody data-unit-empty-state>
