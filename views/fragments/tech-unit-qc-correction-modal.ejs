<%
  const safeErrors = Array.isArray(errorMessages) ? errorMessages : [];
  const unitLabel = unit && unit.assetTag ? unit.assetTag : (unit && unit.unitId ? `Unit ${unit.unitId}` : 'Selected Unit');
  const correctionInputId = `tech-qc-correction-notes-${unit && unit.unitId ? unit.unitId : 'unit'}`;
  const correctionHintId = `${correctionInputId}-hint`;
%>
<div class="modal-backdrop" data-modal-backdrop>
  <section
    class="modal-panel site-clean-modal tech-qc-review-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tech-qc-correction-title"
    aria-describedby="tech-qc-correction-description"
    tabindex="-1"
  >
    <header class="modal-header">
      <div>
        <p class="eyebrow">Quality Control Correction</p>
        <h2 id="tech-qc-correction-title">Mark Unit Corrected</h2>
        <p id="tech-qc-correction-description" class="modal-description">
          Confirm that the rejected Unit is ready for Quality Control to review again.
        </p>
      </div>
      <button type="button" class="modal-close-button" data-modal-close aria-label="Close Quality Control correction">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M5.5 5.5 14.5 14.5M14.5 5.5 5.5 14.5" /></svg>
      </button>
    </header>

    <div class="modal-body">
      <% if (safeErrors.length > 0) { %>
        <div class="message error" role="alert" aria-live="assertive">
          <% safeErrors.forEach((errorMessage) => { %><p><%= errorMessage %></p><% }) %>
        </div>
      <% } %>

      <% if (unit && latestQcReview) { %>
        <dl class="tech-qc-review-summary">
          <div><dt>Unit</dt><dd><strong><%= unitLabel %></strong></dd></div>
          <div><dt>Assigned Technician</dt><dd><%= unit.assignedToName || 'Unassigned' %></dd></div>
          <div><dt>QC Rejection Reason</dt><dd><%= latestQcReview.notes || 'No rejection reason was recorded.' %></dd></div>
        </dl>
      <% } %>

      <% if (unit && latestCompletion && latestQcReview && latestQcReview.decisionCode === 'rejected' && !latestQcCorrection) { %>
        <form method="post" action="/tech/units/<%= unit.unitId %>/qc-correction" data-qc-correction-form>
          <label class="form-field" for="<%= correctionInputId %>">
            <span>Correction Notes (optional)</span>
            <textarea
              id="<%= correctionInputId %>"
              name="correctionNotes"
              rows="5"
              maxlength="2000"
              aria-describedby="<%= correctionHintId %>"
              data-modal-initial-focus
              placeholder="Briefly describe what was corrected for the QC recheck."
            ><%= correctionNotes || '' %></textarea>
          </label>
          <p id="<%= correctionHintId %>" class="field-hint">These notes will be visible to Quality Control and retained in Unit History.</p>

          <p class="visually-hidden" data-qc-submit-status aria-live="polite" aria-atomic="true"></p>

          <div class="action-row tech-qc-modal-actions">
            <button type="submit" class="primary-button" data-qc-submit-button>Ready for QC Recheck</button>
            <button type="button" class="secondary-button" data-modal-close>Cancel</button>
          </div>
        </form>
      <% } else { %>
        <div class="action-row tech-qc-modal-actions"><button type="button" class="secondary-button" data-modal-close data-modal-initial-focus>Close</button></div>
      <% } %>
    </div>
  </section>
</div>
