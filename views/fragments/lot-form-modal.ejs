<%
  const safeErrors = Array.isArray(errorMessages) ? errorMessages : [];
  const safeFormData = formData || {};
  const safeFormOptions = formOptions || { capabilities: {}, parentLots: [], lotTypes: [], requirementPolicies: [], grades: [], productionWeightOptions: [] };
  const safeMode = mode === 'edit' ? 'edit' : 'create';
  const safeLot = lot || null;
  const safeReturnTo = typeof returnTo !== 'undefined' && returnTo === 'lot-detail' ? 'lot-detail' : 'lot-browser';
  const formAction = safeMode === 'edit' && safeLot
    ? `/management/lots/${safeLot.lot_id}/edit/modal`
    : '/management/lots';
  const title = safeMode === 'edit' ? 'Edit Lot' : 'Create Lot';
  const submitLabel = safeMode === 'edit' ? 'Save Lot Changes' : 'Create Lot';
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel site-clean-modal lot-modal" role="dialog" aria-modal="true" aria-labelledby="lot-form-modal-title">
    <header class="modal-header">
      <div>
        <h2 id="lot-form-modal-title"><%= title %></h2>
      </div>

      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </header>

    <div class="modal-body">
      <% if (safeErrors.length > 0) { %>
        <div class="message error">
          <% safeErrors.forEach((errorMessage) => { %>
            <p><%= errorMessage %></p>
          <% }) %>
        </div>
      <% } %>

      <% if (safeFormOptions.capabilities.hasLotType && safeFormOptions.lotTypes.length === 0) { %>
        <div class="message error">
          <p>The lots table expects a lot type, but no lot type config values were found.</p>
        </div>
      <% } %>

      <% if (safeFormOptions.capabilities.hasRequirementPolicy && safeFormOptions.requirementPolicies.length !== 3) { %>
        <div class="message error">
          <p>Requirement enforcement needs active Strict, Warn Only, and Open / Mixed config values before a Lot can be saved.</p>
        </div>
      <% } %>

      <form class="app-form app-form-clean lot-form-modal-form" method="post" action="<%= formAction %>" hx-post="<%= formAction %>" hx-target="#modal-root" hx-swap="innerHTML" data-lot-form>
        <% if (safeMode === 'edit') { %><input type="hidden" name="returnTo" value="<%= safeReturnTo %>" /><% } %>
        <div class="form-section">
          <div class="form-section-header">
            <div>
              <h3>Lot Identity</h3>
            </div>
          </div>

          <div class="form-grid lot-form-grid">
            <% if (safeFormOptions.capabilities.hasAssignableState) { %>
              <label class="lot-inline-option plain-checkbox-row form-field-wide" for="isAssignableModal">
                <input
                  id="isAssignableModal"
                  type="checkbox"
                  name="isAssignable"
                  value="1"
                  <%= safeFormData.isAssignable === '1' ? 'checked' : '' %>
                />
                <span>
                  <strong>Allow Units to be assigned directly to this Lot</strong>
                  <small>Hierarchy and assignability are separate. This Lot may still have child Lots whether this setting is on or off.</small>
                </span>
              </label>
            <% } %>
            <% if (safeFormOptions.capabilities.hasQcRequired) { %>
              <label class="lot-inline-option plain-checkbox-row form-field-wide" for="qcRequiredModal">
                <input
                  id="qcRequiredModal"
                  type="checkbox"
                  name="qcRequired"
                  value="1"
                  <%= safeFormData.qcRequired === '1' ? 'checked' : '' %>
                />
                <span>
                  <strong>Require Quality Control (QC) for Units in this Lot</strong>
                  <small>When off, Units in this Lot do not enter the QC Review queue. Existing QC history is preserved, and the change is recorded in Unit History.</small>
                </span>
              </label>
            <% } %>
            <% if (safeFormOptions.capabilities.hasDuplicateUnitAssumption) { %>
              <label class="lot-inline-option plain-checkbox-row form-field-wide" for="allowDuplicateUnitAssumptionModal">
                <input
                  id="allowDuplicateUnitAssumptionModal"
                  type="checkbox"
                  name="allowDuplicateUnitAssumption"
                  value="1"
                  <%= safeFormData.allowDuplicateUnitAssumption === '1' ? 'checked' : '' %>
                />
                <span>
                  <strong>Allow duplicate-match unit assumption</strong>
                  <small>Affects duplicate-match behavior for regular Techs in this lot.</small>
                </span>
              </label>
            <% } %>
            <% if (safeFormOptions.capabilities.hasGenerateAmazonAssetTag) { %>
              <label class="lot-inline-option plain-checkbox-row form-field-wide" for="generateAmazonAssetTagModal">
                <input
                  id="generateAmazonAssetTagModal"
                  type="checkbox"
                  name="generateAmazonAssetTag"
                  value="1"
                  <%= safeFormData.generateAmazonAssetTag === '1' ? 'checked' : '' %>
                />
                <span>
                  <strong>Generate Amazon Asset Tag (AZ)</strong>
                  <small>New Units and Units moved into this Lot receive a permanent AZ tag if missing. Enabling this setting does not modify Units already in the Lot.</small>
                </span>
              </label>
            <% } %>
            <% if (safeFormOptions.capabilities.hasStartNewProductionCycleOnMove) { %>
              <label class="lot-inline-option plain-checkbox-row form-field-wide" for="startNewProductionCycleOnMoveModal">
                <input
                  id="startNewProductionCycleOnMoveModal"
                  type="checkbox"
                  name="startNewProductionCycleOnMove"
                  value="1"
                  <%= safeFormData.startNewProductionCycleOnMove === '1' ? 'checked' : '' %>
                />
                <span>
                  <strong>Start a new production cycle for completed Units moved into this Lot</strong>
                  <small>Use for rework/reprocessing Lots. The physical Unit is not duplicated; after the move it must be completed again before the new production unit and weight are earned.</small>
                </span>
              </label>
            <% } %>
            <label class="form-field">
              <span>Lot Name</span>
              <input type="text" name="lotName" value="<%= safeFormData.lotName || '' %>" maxlength="120" placeholder="Example: Dell Latitude 5400 - Customer Lot" required />
            </label>

            <% if (safeFormOptions.capabilities.hasParentLotId) { %>
              <label class="form-field">
                <span>Parent Lot</span>
                <select name="parentLotId" data-hierarchical-lot-select>
                  <%- include('../partials/parent-lot-options', {
                    parentLots: safeFormOptions.parentLots,
                    selectedParentLotId: safeFormData.parentLotId,
                    excludedLotId: safeLot ? safeLot.lot_id : null,
                    emptyLabel: 'No parent lot',
                    showHiddenStatus: true
                  }) %>
                </select>
                <% if (mode === 'edit') { %>
                  <small>Changing the Parent Lot automatically restores Requirement inheritance from the new parent. Existing direct Requirements on this Lot remain child-specific overrides.</small>
                <% } %>
                </label>
            <% } %>

            <% if (safeFormOptions.capabilities.hasLotType) { %>
              <label class="form-field">
                <span>Lot Type</span>
                <select name="lotTypeConfigValueId" required>
                  <option value="">Select lot type</option>
                  <% safeFormOptions.lotTypes.forEach((lotType) => { %>
                    <option value="<%= lotType.config_value_id %>" <%= String(safeFormData.lotTypeConfigValueId || '') === String(lotType.config_value_id) ? 'selected' : '' %>>
                      <%= lotType.label || lotType.code %>
                    </option>
                  <% }) %>
                </select>
              </label>
            <% } %>

            <% if (safeFormOptions.capabilities.hasDefaultGrade) { %>
              <label class="form-field">
                <span>Default Grade</span>
                <select name="defaultGradeConfigValueId">
                  <option value="">No default grade</option>
                  <% safeFormOptions.grades.forEach((grade) => { %>
                    <option value="<%= grade.config_value_id %>" <%= String(safeFormData.defaultGradeConfigValueId || '') === String(grade.config_value_id) ? 'selected' : '' %>>
                      <%= grade.label || grade.code %>
                    </option>
                  <% }) %>
                </select>
              </label>
            <% } %>

            <% if (safeFormOptions.capabilities.hasDefaultProductionWeight) { %>
              <label class="form-field">
                <span>Lot Production Weight</span>
                <input type="number" name="defaultProductionWeight" value="<%= safeFormData.defaultProductionWeight || '' %>" min="0.10" step="0.01" placeholder="Example: 1.25" list="production-weight-examples" required />
                <small class="field-hint">Required. Minimum 0.10 with no application maximum. Saving a Lot weight immediately becomes the effective weight for every Unit currently in this Lot unless that Unit has an individual override.</small>
                <datalist id="production-weight-examples">
                  <% safeFormOptions.productionWeightOptions.forEach((weightOption) => { %>
                    <% if (weightOption.formattedWeightValue && weightOption.formattedWeightValue !== '—') { %>
                      <option value="<%= weightOption.formattedWeightValue %>"><%= weightOption.label %></option>
                    <% } %>
                  <% }) %>
                </datalist>
              </label>
            <% } else if (safeFormOptions.capabilities.hasDefaultProductionWeightConfigValueId) { %>
              <label class="form-field">
                <span>Default Production Weight</span>
                <select name="defaultProductionWeightConfigValueId" required>
                  <option value="">Select default production weight</option>
                  <% safeFormOptions.productionWeightOptions.forEach((weightOption) => { %>
                    <option value="<%= weightOption.configValueId %>" <%= String(safeFormData.defaultProductionWeightConfigValueId || '') === String(weightOption.configValueId) ? 'selected' : '' %>>
                      <%= weightOption.label %> — <%= weightOption.formattedWeightValue %>
                    </option>
                  <% }) %>
                </select>
              </label>
            <% } %>
          </div>
        </div>

        <% if (safeFormOptions.capabilities.hasRequirementPolicy) { %>
          <div class="form-section">
            <div class="form-section-header">
              <div>
                <h3>Requirement Enforcement</h3>
              </div>
            </div>

            <div class="form-grid single-column">
              <% safeFormOptions.requirementPolicies.forEach((policy) => { %>
                <label class="checkbox-card" for="requirementPolicyModal-<%= policy.code %>">
                  <input
                    id="requirementPolicyModal-<%= policy.code %>"
                    type="radio"
                    name="requirementPolicyConfigValueId"
                    value="<%= policy.config_value_id %>"
                    <%= String(safeFormData.requirementPolicyConfigValueId || '') === String(policy.config_value_id) ? 'checked' : '' %>
                    required
                  />
                  <span>
                    <strong><%= policy.label %></strong>
                    <small><%= policy.description %></small>
                  </span>
                </label>
              <% }) %>
            </div>
          </div>
        <% } %>

        <% if (safeFormOptions.capabilities.hasUnitAmountGoal || safeFormOptions.capabilities.hasDeadline || safeFormOptions.capabilities.hasLabelFormat) { %>
          <div class="form-section">
            <div class="form-section-header">
              <div>
                <h3>Lot Planning</h3>
              </div>
            </div>

            <div class="form-grid lot-form-grid">
              <% if (safeFormOptions.capabilities.hasUnitAmountGoal) { %>
                <label class="lot-inline-option form-field-wide" for="hasUnlimitedGoalModal">
                  <input id="hasUnlimitedGoalModal" type="checkbox" name="hasUnlimitedGoal" value="1" data-lot-unlimited-toggle <%= safeFormData.hasUnlimitedGoal === '1' ? 'checked' : '' %> />
                  <span>
                    <strong>Unlimited / Open Lot</strong>
                  </span>
                </label>
              <% } %>
              <% if (safeFormOptions.capabilities.hasUnitAmountGoal) { %>
                <label class="form-field" data-lot-goal-field>
                  <span>Unit Amount Goal</span>
                  <input type="number" name="unitAmountGoal" value="<%= safeFormData.unitAmountGoal || '' %>" min="1" step="1" placeholder="Example: 100" data-lot-goal-input />
                </label>
              <% } %>

              <% if (safeFormOptions.capabilities.hasDeadline) { %>
                <label class="form-field">
                  <span>Deadline</span>
                  <input type="date" data-date-picker-only inputmode="none" autocomplete="off" name="deadline" value="<%= safeFormData.deadline || '' %>" />
                </label>
              <% } %>

              <% if (safeFormOptions.capabilities.hasLabelFormat) { %>
                <label class="form-field">
                  <span>Label Format</span>
                  <input type="text" name="labelFormat" value="<%= safeFormData.labelFormat || '' %>" maxlength="120" placeholder="Example: Standard BWT Laptop Label" />
                </label>
              <% } %>
            </div>
          </div>
        <% } %>

        <% if (safeFormOptions.capabilities.hasObjectives || safeFormOptions.capabilities.hasNotes) { %>
          <div class="form-section">
            <div class="form-section-header">
              <div>
                <h3>Instructions</h3>
              </div>
            </div>

            <div class="form-grid single-column">
              <% if (safeFormOptions.capabilities.hasObjectives) { %>
                <label class="form-field">
                  <span>Objectives</span>
                  <textarea name="objectives" rows="4" placeholder="Describe what this lot is intended to accomplish."><%= safeFormData.objectives || '' %></textarea>
                </label>
              <% } %>

              <% if (safeFormOptions.capabilities.hasNotes) { %>
                <label class="form-field">
                  <span>Notes</span>
                  <textarea name="notes" rows="4" placeholder="Internal notes for Management or Leads."><%= safeFormData.notes || '' %></textarea>
                </label>
              <% } %>
            </div>
          </div>
        <% } %>

        <div class="form-actions">
          <button type="submit" class="primary-button"><%= submitLabel %></button>
          <button type="button" class="secondary-button" data-modal-close>Cancel</button>
        </div>
      </form>
    </div>
  </section>
</div>
