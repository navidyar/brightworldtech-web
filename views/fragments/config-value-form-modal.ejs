<%
  const safeErrors = Array.isArray(errorMessages) ? errorMessages : [];
  const safeCategories = Array.isArray(categories) ? categories : [];
  const safeFormData = formData || {};
  const safeMode = mode === 'edit' ? 'edit' : 'create';
  const safeConfigValue = configValue || null;
  const formAction = safeMode === 'edit' && safeConfigValue
    ? `/management/config/values/${safeConfigValue.config_value_id}/edit/modal`
    : '/management/config/values';
  const title = safeMode === 'edit' ? 'Edit Config Value' : 'Create Config Value';
  const submitLabel = safeMode === 'edit' ? 'Save Config Value' : 'Create Config Value';
  const isPasswordLinkExpirySetting = Boolean(locals.isPasswordLinkExpirySetting);
  const isProtectedValue = Boolean(safeConfigValue && safeConfigValue.isProtected);
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel site-clean-modal configuration-value-modal" role="dialog" aria-modal="true" aria-labelledby="config-value-form-title">
    <header class="modal-header">
      <div>
        <p class="eyebrow">Admin Configuration</p>
        <h2 id="config-value-form-title"><%= title %></h2>
      </div>

      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </header>

    <div class="modal-body">
      <% if (safeErrors.length > 0) { %>
        <div class="message error">
          <% safeErrors.forEach((errorMessage) => { %>
            <p><%= errorMessage %></p>
          <% }) %>
        </div>
      <% } %>

      <p class="configuration-form-note">
        <% if (isPasswordLinkExpirySetting) { %>
          This security setting supplies the default for non-interactive setup/reset link generation. User Management chooses a 1–8 hour lifetime before each link is generated.
        <% } else if (isProtectedValue) { %>
          This is a protected system value. Its database ID remains unchanged. Renaming it also changes how current and historical records display this value. It may be deactivated, but it cannot be deleted or moved to another category.
        <% } else { %>
          Labels are user-facing. The database ID is the stable identity used by the application.
        <% } %>
      </p>

      <form class="app-form configuration-value-form" data-configuration-value-form data-form-mode="<%= safeMode %>" data-original-category-id="<%= safeConfigValue ? safeConfigValue.config_category_id : '' %>" data-original-active="<%= safeConfigValue && safeConfigValue.isActive ? '1' : '0' %>" method="post" action="<%= formAction %>" hx-post="<%= formAction %>" hx-target="#modal-root" hx-swap="innerHTML" autocomplete="off">
        <input type="hidden" name="includeInactive" value="<%= safeFormData.includeInactive || '0' %>" />

        <% if (isPasswordLinkExpirySetting) { %>
          <input type="hidden" name="configCategoryId" value="<%= safeFormData.configCategoryId || '' %>" />
          <input type="hidden" name="label" value="<%= safeFormData.label || '' %>" />
          <input type="hidden" name="description" value="<%= safeFormData.description || '' %>" />
          <input type="hidden" name="sortOrder" value="<%= safeFormData.sortOrder || '0' %>" />
          <input type="hidden" name="isActive" value="1" />

          <label class="form-field">
            <span>Password setup/reset link expiration</span>
            <input type="number" name="value" value="<%= safeFormData.value || '1' %>" min="1" max="8" step="1" inputmode="numeric" required autofocus />
            <small class="field-hint">Whole hours from 1 through 8. Existing links keep the expiration they were issued with. Management can choose a specific 1–8 hour lifetime when generating a user link.</small>
          </label>
        <% } else { %>
          <div class="configuration-value-form-grid">
            <label class="form-field configuration-value-form-category">
              <span>Category</span>
              <% if (isProtectedValue) { %>
                <input type="hidden" name="configCategoryId" value="<%= safeFormData.configCategoryId || '' %>" />
              <% } %>
              <select name="<%= isProtectedValue ? '' : 'configCategoryId' %>" <%= isProtectedValue ? 'disabled' : 'required' %>>
                <option value="">Choose an option</option>
                <% safeCategories.forEach((category) => { %>
                  <option
                    value="<%= category.config_category_id %>"
                    data-drag-order-managed="<%= category.dragOrderingManaged ? '1' : '0' %>"
                    data-popularity-sorted="<%= category.usesPopularitySorting ? '1' : '0' %>"
                    data-active-value-count="<%= category.activeValueCount || 0 %>"
                    <%= String(safeFormData.configCategoryId || '') === String(category.config_category_id) ? 'selected' : '' %>>
                    <%= category.label || `Category #${category.config_category_id}` %><%= category.isActive ? '' : ' (Inactive category)' %>
                  </option>
                <% }) %>
              </select>
              <small class="field-hint"><%= isProtectedValue ? 'Protected values remain in their current category.' : 'Choose where this value appears in the application.' %></small>
              <small class="field-hint configuration-form-ordering-note" data-configuration-form-ordering-note hidden></small>
            </label>

            <label class="form-field">
              <span>Label</span>
              <input type="text" name="label" value="<%= safeFormData.label || '' %>" maxlength="120" placeholder="Example Config Value" required />
              <small class="field-hint">Text shown to users in forms, tables, and dropdowns.</small>
            </label>

            <label class="form-field">
              <span>Stored Value</span>
              <input type="text" name="value" value="<%= safeFormData.value || '' %>" maxlength="120" placeholder="Optional" />
              <small class="field-hint">Optional. Production Weight Types use values such as 1.00 or 0.50.</small>
            </label>

            <label class="form-field configuration-value-form-sort" data-configuration-sort-order-field>
              <span>Sort Order</span>
              <input type="number" name="sortOrder" value="<%= safeFormData.sortOrder || '0' %>" step="1" inputmode="numeric" />
              <small class="field-hint">Lower numbers appear first. Gaps such as 10, 20, and 30 are easier to maintain.</small>
            </label>

            <label class="configuration-inline-checkbox" for="configValueIsActive">
              <input id="configValueIsActive" type="checkbox" name="isActive" value="1" <%= String(safeFormData.isActive || '0') === '1' ? 'checked' : '' %> />
              <span>
                <strong>Active</strong>
                <small>Available in normal application dropdowns.</small>
              </span>
            </label>
          </div>

          <label class="form-field">
            <span>Description</span>
            <textarea name="description" rows="3" maxlength="500" placeholder="Optional Admin-facing explanation"><%= safeFormData.description || '' %></textarea>
            <small class="field-hint">Explain when or why this value should be selected.</small>
          </label>
        <% } %>

        <div class="form-actions">
          <button type="submit" class="primary-button"><%= submitLabel %></button>
          <button type="button" class="secondary-button" data-modal-close>Cancel</button>
        </div>
      </form>
    </div>
  </section>
</div>
