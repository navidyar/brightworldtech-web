<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel site-clean-modal virtual-huddle-detail-modal" data-huddle-management-detail-modal data-message-id="<%= message.virtual_huddle_message_id %>" role="dialog" aria-modal="true" aria-labelledby="virtual-huddle-detail-title">
    <header class="modal-header">
      <div>
        <p class="eyebrow"><%= messageTypeLabel(message.message_type_code) %> Huddle</p>
        <h2 id="virtual-huddle-detail-title"><%= message.subject %></h2>
        <p class="field-hint">Sent <%= formatDateTime(message.sent_at) %> by <%= message.sender_name_snapshot %> (<%= formatRoleLabel(message.sender_role_code_snapshot) %>).</p>
      </div>
      <button type="button" class="modal-close-button" data-modal-close aria-label="Close Virtual Huddle details">×</button>
    </header>

    <div class="modal-body virtual-huddle-detail-body">
      <% if (successMessage) { %><div class="message success"><p><%= successMessage %></p></div><% } %>
      <div class="action-row virtual-huddle-detail-actions">
        <% if (canSendHuddles) { %><a class="secondary-button" href="/management/virtual-huddle/<%= message.virtual_huddle_message_id %>/related/modal" hx-get="/management/virtual-huddle/<%= message.virtual_huddle_message_id %>/related/modal" hx-target="#modal-root" hx-swap="innerHTML">Send Related Huddle</a><% } %>
        <% if (canAddRecipients) { %><a class="secondary-button" href="/management/virtual-huddle/<%= message.virtual_huddle_message_id %>/recipients/add/modal" hx-get="/management/virtual-huddle/<%= message.virtual_huddle_message_id %>/recipients/add/modal" hx-target="#modal-root" hx-swap="innerHTML">Add Recipients</a><% } %>
        <% if (canDeleteMessages) { %><a class="danger-button" href="/management/virtual-huddle/<%= message.virtual_huddle_message_id %>/delete/modal" hx-get="/management/virtual-huddle/<%= message.virtual_huddle_message_id %>/delete/modal" hx-target="#modal-root" hx-swap="innerHTML">Delete Permanently</a><% } %>
      </div>

      <section class="virtual-huddle-detail-section" aria-labelledby="virtual-huddle-original-message-title">
        <div class="content-header"><div><p class="eyebrow">Message</p><h3 id="virtual-huddle-original-message-title">Original Message</h3></div></div>
        <% if (message.parent_subject) { %><div class="message info"><p><strong>Related to:</strong> <%= message.parent_subject %></p></div><% } %>
        <div class="virtual-huddle-message-copy"><%= message.message_body %></div>
        <% if (message.confirmation_phrase) { %><p class="field-hint"><strong>Required phrase:</strong> <%= message.confirmation_phrase %></p><% } %>
      </section>

      <%- include('virtual-huddle-recipient-status', { message, recipients, canRevokeRecipients, canRequireRecipients }) %>

      <% if (relatedMessages.length > 0) { %>
        <section class="virtual-huddle-detail-section" aria-labelledby="virtual-huddle-related-title">
          <div class="content-header"><div><p class="eyebrow">Thread</p><h3 id="virtual-huddle-related-title">Related Huddles</h3></div></div>
          <div class="table-card virtual-huddle-detail-table"><table><thead><tr><th>Sent</th><th>Type</th><th>Subject</th></tr></thead><tbody>
            <% relatedMessages.forEach((related) => { if (Number(related.virtual_huddle_message_id) !== Number(message.virtual_huddle_message_id)) { %>
              <tr><td><%= formatDateTime(related.sent_at) %></td><td><%= messageTypeLabel(related.message_type_code) %></td><td><a href="/management/virtual-huddle?openHuddle=<%= related.virtual_huddle_message_id %>" hx-get="/management/virtual-huddle/<%= related.virtual_huddle_message_id %>/modal" hx-target="#modal-root" hx-swap="innerHTML"><%= related.subject %></a></td></tr>
            <% } }) %>
          </tbody></table></div>
        </section>
      <% } %>
    </div>
  </section>
</div>
