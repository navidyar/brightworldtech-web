<%
  const safeErrors = Array.isArray(errorMessages) ? errorMessages : [];
  const safeConfigValue = configValue || null;
  const safeIncludeInactive = includeInactiveValues ? '1' : '0';
  const safeActionType = ['activate', 'deactivate', 'error'].includes(actionType) ? actionType : 'error';
  const isActivate = safeActionType === 'activate';
  const title = safeActionType === 'error'
    ? 'Config Value Not Found'
    : `${isActivate ? 'Activate' : 'Deactivate'} Config Value`;
  const actionPath = safeConfigValue
    ? `/management/config/values/${safeConfigValue.config_value_id}/${isActivate ? 'activate' : 'deactivate'}`
    : '';
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel site-clean-modal configuration-value-modal configuration-value-status-modal" role="dialog" aria-modal="true" aria-labelledby="config-value-status-title">
    <header class="modal-header">
      <div>
        <p class="eyebrow">Admin Configuration</p>
        <h2 id="config-value-status-title"><%= title %></h2>
      </div>

      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </header>

    <div class="modal-body">
      <% if (safeErrors.length > 0) { %>
        <div class="message error">
          <% safeErrors.forEach((errorMessage) => { %>
            <p><%= errorMessage %></p>
          <% }) %>
        </div>
      <% } %>

      <% if (safeConfigValue) { %>
        <dl class="configuration-value-summary">
          <div><dt>Category</dt><dd><%= safeConfigValue.category_label || 'Configuration' %></dd></div>
          <div><dt>Label</dt><dd><strong><%= safeConfigValue.label || `Value #${safeConfigValue.config_value_id}` %></strong></dd></div>
          <% if (safeConfigValue.value) { %><div><dt>Stored Value</dt><dd><%= safeConfigValue.value %></dd></div><% } %>
        </dl>

        <p class="configuration-confirm-copy">
          <% if (isActivate) { %>
            Activating this value makes it available again wherever this category is used.
          <% } else { %>
            Deactivating this value removes it from normal selection without deleting existing history.
          <% } %>
        </p>

        <form method="post" action="<%= actionPath %>" hx-post="<%= actionPath %>" hx-target="#modal-root" hx-swap="innerHTML">
          <input type="hidden" name="includeInactive" value="<%= safeIncludeInactive %>" />

          <div class="form-actions">
            <button type="submit" class="<%= isActivate ? 'primary-button' : 'danger-button' %>"><%= isActivate ? 'Activate Value' : 'Deactivate Value' %></button>
            <button type="button" class="secondary-button" data-modal-close>Cancel</button>
          </div>
        </form>
      <% } else { %>
        <div class="form-actions">
          <button type="button" class="secondary-button" data-modal-close>Close</button>
        </div>
      <% } %>
    </div>
  </section>
</div>
