<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel site-clean-modal tech-recent-prints-modal" role="dialog" aria-modal="true" aria-labelledby="tech-recent-prints-title">
    <div class="modal-header">
      <h2 id="tech-recent-prints-title">Recent Prints</h2>
      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </div>

    <div class="modal-body">
      <div
        id="tech-recent-prints-live"
        hx-get="/tech/print-queue/live"
        hx-trigger="every 3s"
        hx-swap="innerHTML"
      >
        <%- include('tech-recent-prints-live', { settings, sets }) %>
      </div>

      <div class="form-actions">
        <button type="button" class="primary-button" data-modal-close>Close</button>
      </div>
    </div>
  </section>
</div>
