<%
  const safeErrors = Array.isArray(errorMessages) ? errorMessages.filter(Boolean) : [];
  const safePrinters = Array.isArray(printers) ? printers : [];
  const safeResults = Array.isArray(searchResults) ? searchResults : [];
  const templateId = Number(template?.label_template_id || 0);
  const selectedUnitId = Number(unit?.unitId || 0);
  const selectedLotName = String(unitFieldValues?.['lot.name'] || lot?.name || lot?.lot_name || '');
  const representative = representativeFieldValues || {};
  const usingRepresentativeData = Boolean(useRepresentativeData);
  const requiresLotContext = String(template?.print_scope || 'lot') === 'lot';
  const scopeLabel = requiresLotContext ? 'Lot Selection' : 'Standalone';
  const statusLabel = String(template?.status || 'draft');
  const canSubmit = !Boolean(submitBlocked)
    && Boolean(selectedPrinterId)
    && safePrinters.length > 0
    && Boolean(previewDataUri);
%>
<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel site-clean-modal label-library-direct-print-modal" role="dialog" aria-modal="true" aria-labelledby="label-builder-test-print-title">
    <header class="modal-header">
      <div>
        <h2 id="label-builder-test-print-title">Builder Test Print</h2>
        <p><%= template?.name || 'Label Template' %></p>
      </div>
      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </header>

    <div class="modal-body">
      <% if (successMessage) { %>
        <div class="message success"><p><%= successMessage %></p></div>
        <div class="label-library-direct-print-recent-link">
          <a class="secondary-button" href="/tech/print-queue/modal" hx-get="/tech/print-queue/modal" hx-target="#modal-root" hx-swap="innerHTML">View Recent Prints</a>
        </div>
      <% } %>

      <% if (safeErrors.length > 0) { %>
        <div class="message error">
          <% safeErrors.forEach((message) => { %><p><%= message %></p><% }) %>
        </div>
      <% } %>

      <div class="message info"><p><strong>Test Print:</strong> this sends one physical label from the saved Builder layout. It does not change template status or Lot assignments and does not count as production template usage.</p></div>

      <div class="label-library-direct-print-summary">
        <div><small>Template</small><strong><%= template?.name || '—' %></strong></div>
        <div><small>Print Availability</small><strong><%= scopeLabel %></strong></div>
        <div><small>Status</small><strong><%= statusLabel.charAt(0).toUpperCase() + statusLabel.slice(1) %></strong></div>
        <div><small>Media</small><strong><%= template?.media_code || '—' %></strong></div>
      </div>

      <section class="label-library-direct-print-section">
        <div class="label-library-direct-print-section-heading">
          <div>
            <h3>Test Data</h3>
            <p>Representative Data is automatic. A real Unit is optional when you want to verify a specific Unit/Lot combination.</p>
          </div>
        </div>

        <% if (usingRepresentativeData) { %>
          <div class="label-library-direct-print-unit-selected">
            <div>
              <small>Data Source</small>
              <strong>Representative Data</strong>
              <span><%= representative['unit.primary_label'] || 'BWT123456' %><% if (representative['unit.model_display']) { %> · <%= representative['unit.model_display'] %><% } %><% if (representative['lot.name']) { %> · Sample Lot: <%= representative['lot.name'] %><% } %></span>
            </div>
            <span class="pill slate">Automatic</span>
          </div>
          <details class="label-library-direct-print-unit-change">
            <summary>Use a real Unit instead</summary>
        <% } else if (unit) { %>
          <div class="label-library-direct-print-unit-selected">
            <div>
              <small>Selected Unit</small>
              <strong><%= unitFieldValues?.['unit.primary_label'] || unit.assetTag || `Unit #${unit.unitId}` %></strong>
              <span><%= unitFieldValues?.['unit.model_display'] || 'Model not recorded' %><% if (selectedLotName) { %> · Lot: <%= selectedLotName %><% } %></span>
            </div>
            <div class="label-library-direct-print-result-actions">
              <% if (unit.isParked) { %><span class="pill slate">Parked</span><% } %>
              <a
                class="secondary-button compact-button"
                href="/management/label-library/templates/<%= templateId %>/builder/test-print/modal"
                hx-get="/management/label-library/templates/<%= templateId %>/builder/test-print/modal"
                hx-target="#modal-root"
                hx-swap="innerHTML"
              >Use Representative Data</a>
            </div>
          </div>
          <details class="label-library-direct-print-unit-change">
            <summary>Change Unit</summary>
        <% } %>

        <form
          class="label-library-direct-print-unit-search"
          method="get"
          action="/management/label-library/templates/<%= templateId %>/builder/test-print/modal"
          hx-get="/management/label-library/templates/<%= templateId %>/builder/test-print/modal"
          hx-target="#modal-root"
          hx-swap="innerHTML"
        >
          <label class="form-field">
            <span>Find Unit</span>
            <input
              type="search"
              name="q"
              value="<%= searchTerm %>"
              autocomplete="off"
              placeholder="Asset Tag, Unit ID, serial, or UUID"
            />
          </label>
          <button class="secondary-button" type="submit">Find Unit</button>
        </form>

        <% if (usingRepresentativeData || unit) { %>
          </details>
        <% } %>

        <% if (searchTerm) { %>
          <div class="label-library-direct-print-unit-results">
            <% if (safeResults.length === 0) { %>
              <div class="message info"><p>No Units matched “<%= searchTerm %>”.</p></div>
            <% } %>
            <% safeResults.forEach((result) => { %>
              <article>
                <div>
                  <strong><%= result.assetTag || `Unit #${result.unitId}` %></strong>
                  <small><%= result.modelDisplay || 'Model not recorded' %><% if (result.lotName) { %> · Lot: <%= result.lotName %><% } %></small>
                </div>
                <div class="label-library-direct-print-result-actions">
                  <% if (result.isParked) { %><span class="pill slate">Parked</span><% } %>
                  <% if (!requiresLotContext || result.lotId) { %>
                    <a
                      class="secondary-button compact-button"
                      href="/management/label-library/templates/<%= templateId %>/builder/test-print/modal?unitId=<%= result.unitId %>"
                      hx-get="/management/label-library/templates/<%= templateId %>/builder/test-print/modal?unitId=<%= result.unitId %>"
                      hx-target="#modal-root"
                      hx-swap="innerHTML"
                    >Use Unit</a>
                  <% } else { %>
                    <span class="pill slate">No Current Lot</span>
                  <% } %>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="label-library-direct-print-section">
        <div class="label-library-direct-print-section-heading">
          <div>
            <h3>Test Preview</h3>
            <p><%= usingRepresentativeData ? 'Rendered from the saved structured layout, Representative Data, and reusable assets.' : 'Rendered from the saved structured layout, selected Unit data, and reusable assets.' %></p>
          </div>
        </div>
        <% if (previewDataUri) { %>
          <div class="label-library-direct-print-preview">
            <img src="<%= previewDataUri %>" alt="Test-print preview for <%= template?.name || 'label template' %>" />
          </div>
        <% } else { %>
          <div class="label-library-direct-print-preview-empty">The saved layout could not be rendered for Test Print.</div>
        <% } %>
      </section>

      <form
        class="app-form label-library-direct-print-form"
        method="post"
        action="/management/label-library/templates/<%= templateId %>/builder/test-print"
        hx-post="/management/label-library/templates/<%= templateId %>/builder/test-print"
        hx-target="#modal-root"
        hx-swap="innerHTML"
      >
        <% if (selectedUnitId) { %><input type="hidden" name="unitId" value="<%= selectedUnitId %>" /><% } %>
        <div class="form-grid label-library-direct-print-controls">
          <label class="form-field">
            <span>Printer or Group</span>
            <select name="printerId" required data-modal-initial-focus>
              <% safePrinters.forEach((printer) => { %>
                <option value="<%= printer.id %>" <%= printer.id === selectedPrinterId ? 'selected' : '' %>><%= printer.label %></option>
              <% }) %>
            </select>
          </label>
          <div class="form-field">
            <span>Quantity</span>
            <strong>1 test label</strong>
          </div>
        </div>

        <div class="form-actions">
          <button class="primary-button" type="submit" <%= canSubmit ? '' : 'disabled' %>>Queue Test Print</button>
          <button class="secondary-button" type="button" data-modal-close>Close</button>
        </div>
      </form>
    </div>
  </section>
</div>
