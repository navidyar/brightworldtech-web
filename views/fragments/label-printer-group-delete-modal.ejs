<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="printer-group-delete-title">
    <div class="modal-header"><div><p class="eyebrow">Printer Group</p><h2 id="printer-group-delete-title">Delete Printer Group</h2></div><button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button></div>
    <div class="modal-body">
      <p>Delete <strong><%= group.name %></strong>?</p>
      <p class="field-hint">This removes the group and its memberships. It does not remove the printers themselves.</p>
      <form method="post" action="/management/printer-groups/<%= group.label_printer_group_id %>/delete" hx-post="/management/printer-groups/<%= group.label_printer_group_id %>/delete" hx-target="#modal-root" hx-swap="innerHTML">
        <div class="form-actions"><button class="primary-button danger-button" type="submit">Delete Group</button><button class="secondary-button" type="button" data-modal-close>Cancel</button></div>
      </form>
    </div>
  </section>
</div>
