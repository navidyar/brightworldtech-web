<%
  const safeMatches = Array.isArray(duplicateMatches) ? duplicateMatches : [];
  const editDuplicateCheck = typeof isEditDuplicateCheck !== 'undefined' && Boolean(isEditDuplicateCheck);
  const canCreateIntentionalDuplicateRequest = !editDuplicateCheck
    && typeof canRequestIntentionalDuplicate !== 'undefined'
    && Boolean(canRequestIntentionalDuplicate);
  const hasIntentionalDuplicateDestination = typeof destinationLotId !== 'undefined'
    && Boolean(String(destinationLotId || '').trim());

  function displayAssetTag(match) {
    return match && match.assetTag ? match.assetTag : 'Existing unit without an Asset Tag';
  }

  function statusLabel(match) {
    return match && match.isParked ? 'Parked' : 'Active';
  }

  function lotLabel(match) {
    if (!match || match.isParked) {
      return 'No current lot';
    }

    if (!match.lotName) {
      return 'No current lot';
    }

    return match.isClosedLot ? `${match.lotName} (Closed)` : match.lotName;
  }


  function directActionLabel(assumption) {
    return assumption && assumption.actionKind === 'move'
      ? 'Move Existing Unit'
      : 'Move / Take Over Existing Unit';
  }

  function requestActionLabel(assumption) {
    return assumption && assumption.actionKind === 'move'
      ? 'Request Lot Move'
      : 'Request Move / Takeover';
  }
  function matchedByLabel(match) {
    const identifiers = Array.isArray(match && match.matchedIdentifiers) ? match.matchedIdentifiers : [];

    return identifiers
      .map((identifier) => {
        const inputLabels = Array.isArray(identifier.matchingInputs) ? identifier.matchingInputs.join(' / ') : '';
        const typeLabel = identifier.identifierTypeLabel || 'serial identifier';
        const value = identifier.identifierValue || '—';

        return `${inputLabels || 'Serial'} matched ${typeLabel}: ${value}`;
      })
      .join('; ');
  }
%>

<div data-duplicate-check-result data-duplicate-match-count="<%= safeMatches.length %>">
<% if (hasSerialSearch && safeMatches.length === 0) { %>
  <div class="message success">
    <% if (editDuplicateCheck) { %>
      <p><strong>No new duplicate serial identity was introduced.</strong> Existing Unit Serial or BIOS Serial values already attached to this Unit remain valid while you edit its other details.</p>
    <% } else { %>
      <p><strong>No existing Unit Serial or BIOS Serial matches were found.</strong> You can continue entering this unit.</p>
    <% } %>
  </div>
<% } %>

<% if (safeMatches.length > 0) { %>
  <div class="message warning">
    <% if (editDuplicateCheck) { %>
      <p><strong>This edit introduces a new duplicate serial identity.</strong> Existing approved duplicate values may be retained, but a different Unit Serial or BIOS Serial already assigned to another Unit cannot be added through Edit Unit.</p>
    <% } else { %>
      <p><strong>Possible existing unit<%= safeMatches.length === 1 ? '' : 's' %> found.</strong> Choose the action that matches the physical unit in front of you.</p>
      <p><strong>Same physical unit:</strong> move or take over the existing record. <strong>Different physical unit:</strong> request an Intentional Duplicate. Open the existing record when you need to inspect it first.</p>
    <% } %>
  </div>

  <div class="workflow-list">
    <% safeMatches.forEach((match) => { %>
      <% const assumption = match.duplicateAssumption || {}; %>
      <article class="workflow-item warning tech-duplicate-candidate-card">
        <span></span>
        <div style="width: 100%;">
          <strong><%= displayAssetTag(match) %> — <%= statusLabel(match) %></strong>
          <p><%= matchedByLabel(match) %></p>
          <p>Current lot: <strong><%= lotLabel(match) %></strong></p>

          <div class="tech-override-summary" style="margin-top: 12px;">
            <dl>
              <div>
                <dt>Unit Serial</dt>
                <dd><%= match.unitSerialNumber || '—' %></dd>
              </div>
              <div>
                <dt>BIOS Serial</dt>
                <dd><%= match.biosSerialNumber || '—' %></dd>
              </div>
              <div>
                <dt>Manufacturer</dt>
                <dd><%= match.manufacturerLabel || '—' %></dd>
              </div>
              <div>
                <dt>Model</dt>
                <dd><%= match.modelLabel || match.modelSummary || '—' %></dd>
              </div>
              <div>
                <dt>CPU</dt>
                <dd><%= match.cpuSummary || '—' %></dd>
              </div>
              <div>
                <dt>Assigned To</dt>
                <dd><%= match.assignedToName || (match.isParked ? 'Unassigned while Parked' : 'Unassigned') %></dd>
              </div>
            </dl>
          </div>

          <% if (!editDuplicateCheck) { %>
            <div class="message <%= assumption.allowed ? 'success' : (assumption.requiresOverride ? 'warning' : 'info') %> tech-duplicate-candidate-decision" style="margin-top: 12px;">
              <p><%= assumption.message || 'This existing unit cannot be moved through the current Create Unit workflow.' %></p>
            </div>
          <% } %>

          <div class="form-actions tech-duplicate-candidate-actions">
            <% if (!editDuplicateCheck && assumption.allowed) { %>
              <button type="button" class="primary-button" data-duplicate-assume-unit-id="<%= match.unitId %>"><%= directActionLabel(assumption) %></button>
            <% } else if (!editDuplicateCheck && assumption.requiresOverride && !match.isParked) { %>
              <button type="button" class="primary-button" data-duplicate-request-override-unit-id="<%= match.unitId %>"><%= requestActionLabel(assumption) %></button>
            <% } %>

            <% if (canCreateIntentionalDuplicateRequest) { %>
              <button
                type="button"
                class="secondary-button"
                data-intentional-duplicate-request-unit-id="<%= match.unitId %>"
                <%= hasIntentionalDuplicateDestination ? 'aria-disabled="false"' : 'disabled aria-disabled="true"' %>
              >Request Intentional Duplicate</button>
              <small class="field-hint" data-intentional-duplicate-request-readiness>
                <%= hasIntentionalDuplicateDestination
                  ? 'Use this only for a different physical unit that reuses the serial. The complete Create Unit form is verified before submission.'
                  : 'Select an Assignable Lot before requesting an intentional duplicate.' %>
              </small>
            <% } %>

            <a class="secondary-button" href="/tech/units/<%= match.unitId %>" target="_blank" rel="noopener">Open Existing Unit</a>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>
</div>
