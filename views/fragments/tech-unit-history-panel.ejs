<%
  const safeTimeline = timeline || {
    events: [],
    totalEvents: 0,
    totalChanges: 0,
    hasLegacyEvents: false,
    hasAuditEvents: false
  };
  const events = Array.isArray(safeTimeline.events) ? safeTimeline.events : [];
  const safeErrorMessages = Array.isArray(errorMessages) ? errorMessages : [];
%>

<div class="tech-unit-history-panel tech-audit-timeline-panel">
  <div class="tech-history-panel-summary" aria-label="Unit history totals">
    <span><strong><%= safeTimeline.totalEvents %></strong> events</span>
    <span><strong><%= safeTimeline.totalChanges %></strong> changes</span>
  </div>

  <% if (safeErrorMessages.length > 0) { %>
    <div class="message error">
      <% safeErrorMessages.forEach((message) => { %>
        <p><%= message %></p>
      <% }) %>
    </div>
  <% } else if (schemaReady === false && events.length === 0) { %>
    <div class="message error">
      <p>Some historical tables were not detected. Run the required database migrations before using Unit History.</p>
    </div>
  <% } else if (events.length === 0) { %>
    <div class="message success">
      <p>No history has been recorded for this Unit yet.</p>
    </div>
  <% } %>

  <% if (safeTimeline.hasLegacyEvents) { %>
    <p class="tech-audit-timeline-note">
      Older activity is reconstructed only from available historical records. New actions are grouped by their shared audit event.
    </p>
  <% } %>

  <% if (events.length > 0) { %>
    <ol class="tech-audit-timeline" aria-label="Unit activity timeline">
      <% events.forEach((event) => { %>
        <li class="tech-audit-event <%= event.isCreation ? 'is-creation' : '' %> <%= event.isLegacy ? 'is-legacy' : '' %>">
          <div class="tech-audit-event-marker" aria-hidden="true"></div>

          <div class="tech-audit-event-time">
            <time datetime="<%= event.occurredAt ? new Date(event.occurredAt).toISOString() : '' %>">
              <%= event.occurredAt ? formatDateTime(event.occurredAt) : 'No date recorded' %>
            </time>
          </div>

          <article class="tech-audit-event-content">
            <header class="tech-audit-event-header">
              <div>
                <strong><%= event.actorName || 'System' %></strong>
                <span><%= event.title || 'Updated Unit' %></span>
              </div>

              <% if (event.isLegacy) { %>
                <span class="tech-audit-event-source">Legacy record</span>
              <% } else if (event.isCreation) { %>
                <span class="tech-audit-event-source is-current">Creation snapshot</span>
              <% } %>
            </header>

            <% if (Array.isArray(event.changes) && event.changes.length > 0) { %>
              <ul class="tech-audit-change-list <%= event.isCreation ? 'is-creation-snapshot' : '' %>">
                <% event.changes.forEach((change) => { %>
                  <li>
                    <span class="tech-audit-change-label"><%= change.label || 'Change' %></span>
                    <span class="tech-audit-change-value"><%= change.text || 'Changed' %></span>
                  </li>
                <% }) %>
              </ul>
            <% } %>

            <% if (Array.isArray(event.notes) && event.notes.length > 0) { %>
              <div class="tech-audit-event-notes">
                <% event.notes.forEach((note) => { %>
                  <p><%= note %></p>
                <% }) %>
              </div>
            <% } %>
          </article>
        </li>
      <% }) %>
    </ol>
  <% } %>
</div>
