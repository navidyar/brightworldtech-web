<%
  const safeUnit = unit || {};
  const safeErrors = Array.isArray(errorMessages) ? errorMessages.filter(Boolean) : [];
  const safePrinters = Array.isArray(printers) ? printers : [];
  const safeTemplates = Array.isArray(templateOptions) ? templateOptions : [];
  const canSubmit = !Boolean(submitBlocked)
    && safeUnit.unitId
    && safePrinters.length > 0
    && safeTemplates.some((template) => template.available);
  const completionText = latestCompletion && latestCompletion.completedAt
    ? formatDateTime(latestCompletion.completedAt)
    : '—';
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel site-clean-modal tech-print-label-modal" role="dialog" aria-modal="true" aria-labelledby="tech-print-label-title">
    <div class="modal-header">
      <h2 id="tech-print-label-title">Print Unit Label</h2>
      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </div>

    <div class="modal-body">
      <% if (successMessage) { %>
        <div class="message success"><p><%= successMessage %></p></div>
        <div class="tech-print-success-recent-link">
          <a class="secondary-button" href="/tech/print-queue/modal" hx-get="/tech/print-queue/modal" hx-target="#modal-root" hx-swap="innerHTML">View Recent Prints</a>
        </div>
      <% } %>

      <% if (safeErrors.length > 0) { %>
        <div class="message error">
          <% safeErrors.forEach((message) => { %><p><%= message %></p><% }) %>
        </div>
      <% } %>

      <% if (safeUnit.unitId) { %>
        <div class="tech-override-summary tech-print-label-summary">
          <dl>
            <div><dt>Unit</dt><dd><%= safeUnit.assetTag || `Unit #${safeUnit.unitId}` %></dd></div>
            <div><dt>Lot</dt><dd><%= safeUnit.lotName || '—' %></dd></div>
            <div><dt>Completed</dt><dd><%= completionText %></dd></div>
          </dl>
        </div>
      <% } %>

      <% if (templateSetNotice) { %>
        <div class="message info tech-label-template-source"><p><%= templateSetNotice %></p></div>
      <% } %>

      <% if (safeTemplates.length > 0) { %>
        <form
          class="app-form tech-unit-form tech-label-print-form"
          method="post"
          action="/tech/units/<%= safeUnit.unitId %>/print-label"
          hx-post="/tech/units/<%= safeUnit.unitId %>/print-label"
          hx-target="#modal-root"
          hx-swap="innerHTML"
        >
          <div class="form-section tech-label-printer-section">
            <div class="form-section-header">
              <div>
                <h3>Printer or Group</h3>
                <p class="field-hint">All labels selected below are submitted through the existing CUPS print path.</p>
              </div>
            </div>
            <div class="form-grid tech-label-printer-grid">
              <label class="form-field">
                <span>Printer or Group</span>
                <select name="printerId" required data-modal-initial-focus>
                  <% safePrinters.forEach((printer) => { %>
                    <option value="<%= printer.id %>" <%= printer.id === selectedPrinterId ? 'selected' : '' %>><%= printer.label %></option>
                  <% }) %>
                </select>
              </label>
            </div>
          </div>

          <div class="form-section">
            <div class="form-section-header">
              <div>
                <h3>Labels</h3>
                <p class="field-hint">Labels in the normal print set are preselected. Optional labels can be selected when needed. Quantities come from the effective Lot configuration.</p>
              </div>
            </div>

            <div class="tech-label-template-list">
              <% safeTemplates.forEach((template) => { %>
                <article class="tech-label-template-choice <%= template.selected ? 'is-selected' : '' %> <%= template.available ? '' : 'is-unavailable' %>">
                  <div class="tech-label-template-choice-header">
                    <label class="tech-label-template-choice-toggle">
                      <input
                        type="checkbox"
                        name="templateKey"
                        value="<%= template.key %>"
                        <%= template.selected && template.available ? 'checked' : '' %>
                        <%= template.available ? '' : 'disabled' %>
                      />
                      <span><strong><%= template.name %></strong></span>
                    </label>
                    <div class="tech-label-template-badges">
                      <% if (template.isRequired) { %><span class="pill good">Normal set</span><% } else { %><span class="pill slate">Optional</span><% } %>
                    </div>
                  </div>

                  <% if (template.previewDataUri) { %>
                    <div class="tech-label-preview" aria-label="Preview for <%= template.name %>">
                      <img class="tech-label-preview-image" src="<%= template.previewDataUri %>" alt="Preview of <%= template.name %>" />
                    </div>
                  <% } %>

                  <% if (!template.available || template.previewError) { %>
                    <div class="message error tech-label-template-inline-error">
                      <p><%= template.unavailableReason || template.previewError %></p>
                    </div>
                  <% } %>

                  <label class="form-field tech-label-template-quantity">
                    <span>Copies</span>
                    <input
                      type="number"
                      name="quantity[<%= template.key %>]"
                      min="1"
                      max="<%= maxCopies %>"
                      step="1"
                      value="<%= template.quantity %>"
                      <%= template.available ? '' : 'disabled' %>
                    />
                  </label>
                </article>
              <% }) %>
            </div>
          </div>

          <div class="form-actions">
            <button class="primary-button" type="submit" <%= canSubmit ? '' : 'disabled' %>>Print Selected</button>
            <button type="button" class="secondary-button" data-modal-close>Close</button>
          </div>
        </form>
      <% } else { %>
        <div class="message info"><p>No labels are currently available for this Lot.</p></div>
        <div class="form-actions"><button type="button" class="primary-button" data-modal-close>Close</button></div>
      <% } %>
    </div>
  </section>
</div>
