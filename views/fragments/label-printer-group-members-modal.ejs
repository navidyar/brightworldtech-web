<div class="modal-backdrop" data-modal-backdrop><section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="printer-group-members-title"><div class="modal-header"><div><p class="eyebrow">Printer Group</p><h2 id="printer-group-members-title"><%= group.name %></h2></div><button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button></div><div class="modal-body"><p class="field-hint">Managed printers and shared solo printers can be members. Private solo printers stay outside shared groups.</p><form class="app-form" method="post" action="/management/printer-groups/<%= group.label_printer_group_id %>/members" hx-post="/management/printer-groups/<%= group.label_printer_group_id %>/members" hx-target="#modal-root" hx-swap="innerHTML"><div class="label-printer-member-list"><% if (!printers.length) { %><div class="message info"><p>No eligible printers are available.</p></div><% } %><% printers.forEach((printer) => { %><label class="checkbox-row"><input type="checkbox" name="printerId" value="<%= printer.label_printer_id %>" <%= selectedIds.has(Number(printer.label_printer_id)) ? 'checked' : '' %> /><span><strong><%= printer.display_name %></strong><small><%= printer.location_label || 'No location' %> · <%= printer.scope_code === 'managed' ? 'Managed' : 'Shared Solo' %></small></span></label><% }) %></div><div class="form-actions"><button class="primary-button" type="submit">Save Members</button><button class="secondary-button" type="button" data-modal-close>Cancel</button></div></form></div></section></div>
