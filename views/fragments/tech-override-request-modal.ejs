<%
  const isDuplicateIntakeRequest = typeof requestContext !== 'undefined' && requestContext === 'duplicate_intake';
  const safeDuplicateIntakeContext = typeof duplicateIntakeContext !== 'undefined' && duplicateIntakeContext
    ? duplicateIntakeContext
    : {};
  const safeAssignableLots = typeof assignableLots !== 'undefined' && Array.isArray(assignableLots)
    ? assignableLots
    : [];
  const selectedDestinationLotId = typeof requestedDestinationLotId !== 'undefined'
    ? Number(requestedDestinationLotId || 0)
    : 0;
  const isMoveOnlyRequest = isDuplicateIntakeRequest
    && typeof duplicateIntakeActionKind !== 'undefined'
    && duplicateIntakeActionKind === 'move';
  const isParkedTakeover = typeof isParkedTakeoverRequest !== 'undefined' && Boolean(isParkedTakeoverRequest);
  const duplicateRequestTitle = isMoveOnlyRequest ? 'Request Lot Move' : 'Request Move / Takeover Existing Unit';
  const duplicateRequestReasonLabel = isMoveOnlyRequest ? 'Reason for Lot Move' : 'Reason for Move / Takeover';
  const duplicateRequestButtonLabel = isMoveOnlyRequest ? 'Send Lot Move Request' : 'Send Move / Takeover Request';
  const modalEyebrow = isDuplicateIntakeRequest ? 'Existing Unit Request' : (isParkedTakeover ? 'Parked Unit Request' : 'Override Request');
  const modalTitle = isDuplicateIntakeRequest ? duplicateRequestTitle : (isParkedTakeover ? 'Request Parked Unit Takeover' : 'Request Management Override');
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel tech-override-modal" role="dialog" aria-modal="true" aria-labelledby="tech-override-title">
    <div class="modal-header">
      <div>
        <p class="eyebrow"><%= modalEyebrow %></p>
        <h2 id="tech-override-title"><%= modalTitle %></h2>
      </div>

      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </div>

    <div class="modal-body">
      <% if (successMessage) { %>
        <div class="message success">
          <p><%= successMessage %></p>
        </div>

        <div class="tech-override-summary">
          <dl>
            <div>
              <dt>Unit</dt>
              <dd><%= unitLabel %></dd>
            </div>

            <div>
              <dt>Current Lot</dt>
              <dd><%= lotLabel %></dd>
            </div>

            <div>
              <dt>Requested Destination</dt>
              <dd><%= existingPendingRequest && existingPendingRequest.requestedDestinationLotName ? existingPendingRequest.requestedDestinationLotName : '—' %></dd>
            </div>

            <div>
              <dt>Status</dt>
              <dd>Pending Tech Lead+ Review</dd>
            </div>
          </dl>
        </div>

        <div class="form-actions">
          <% if (existingPendingRequest && existingPendingRequest.unitOverrideRequestId) { %>
            <a class="primary-button" href="/unit-requests/override/<%= existingPendingRequest.unitOverrideRequestId %>">View Request</a>
          <% } %>
          <button type="button" class="secondary-button" data-modal-close>Done</button>
        </div>
      <% } else { %>
        <% if (errorMessages.length > 0) { %>
          <div class="message error">
            <% errorMessages.forEach((errorMessage) => { %>
              <p><%= errorMessage %></p>
            <% }) %>
          </div>
        <% } %>

        <div class="tech-override-summary">
          <dl>
            <div>
              <dt>Unit</dt>
              <dd><%= unitLabel %></dd>
            </div>

            <div>
              <dt>Current Lot</dt>
              <dd><%= lotLabel %></dd>
            </div>

            <% if (existingPendingRequest && existingPendingRequest.requestedDestinationLotName) { %>
              <div>
                <dt>Requested Destination</dt>
                <dd><%= existingPendingRequest.requestedDestinationLotName %></dd>
              </div>
            <% } %>
          </dl>
        </div>

        <% if (existingPendingRequest) { %>
          <div class="message warning">
            <p>
              Override request #<%= existingPendingRequest.unitOverrideRequestId %> is already pending for this Unit.
              Management must approve or deny it before another request can be created.
            </p>
          </div>

          <div class="form-actions">
            <a class="primary-button" href="/unit-requests/override/<%= existingPendingRequest.unitOverrideRequestId %>">View Request</a>
            <button type="button" class="secondary-button" data-modal-close>Close</button>
          </div>
        <% } else if (supported) { %>
          <% if (isParkedTakeover) { %>
            <div class="message info">
              <p>
                This Unit is Parked and has no active Lot or assignment. Approval will return the existing Unit to Active in the selected destination Lot and assign it to you. No new Asset Tag will be created.
              </p>
            </div>
          <% } %>
          <% if (isDuplicateIntakeRequest) { %>
            <div class="message info">
              <p>
                <% if (isMoveOnlyRequest) { %>
                  This Unit is already assigned to you. Use this request only when Tech Lead+ approval is required to move it into another Lot. No assignment takeover and no new Asset Tag will occur.
                <% } else { %>
                  Use this request when the serial match belongs to the same physical Unit and Tech Lead+ approval is needed to move, reassign, or intentionally rework the existing record. No new Asset Tag will be created.
                <% } %>
              </p>
            </div>
          <% } %>

          <form
            class="app-form tech-override-form"
            method="post"
            action="/tech/units/<%= unit.unit_id %>/override"
            hx-post="/tech/units/<%= unit.unit_id %>/override"
            hx-target="#modal-root"
            hx-swap="innerHTML"
          >
            <input type="hidden" name="requestContext" value="<%= isDuplicateIntakeRequest ? 'duplicate_intake' : 'manual' %>" />
            <% if (isDuplicateIntakeRequest) { %>
              <input type="hidden" name="duplicateIntakeUnitSerialNumber" value="<%= safeDuplicateIntakeContext.unitSerialNumber || '' %>" />
              <input type="hidden" name="duplicateIntakeBiosSerialNumber" value="<%= safeDuplicateIntakeContext.biosSerialNumber || '' %>" />
              <input type="hidden" name="duplicateAssumptionNonce" value="<%= safeDuplicateIntakeContext.duplicateAssumptionNonce || '' %>" />
            <% } %>
            <label class="form-field">
              <span>Requested Destination Lot</span>
              <select name="requestedDestinationLotId" required data-hierarchical-lot-select>
                <option value="">Select destination Lot</option>
                <%- include('../partials/hierarchical-lot-options', {
                  lotOptions: typeof assignableLotHierarchyOptions !== 'undefined' && Array.isArray(assignableLotHierarchyOptions) && assignableLotHierarchyOptions.length > 0 ? assignableLotHierarchyOptions : safeAssignableLots,
                  selectedLotId: selectedDestinationLotId
                }) %>
              </select>
              <small class="field-hint">
                <%= isParkedTakeover
                  ? 'Choose the open Lot where this Parked Unit should return to Active after approval.'
                  : isMoveOnlyRequest
                    ? 'Choose the different Lot this already-assigned Unit should enter after approval.'
                    : 'Select the current Lot for an assignment-only takeover, or another Lot when Tech Lead+ should move the existing Unit after approval.' %>
              </small>
            </label>

            <label class="form-field">
              <span><%= isDuplicateIntakeRequest ? duplicateRequestReasonLabel : (isParkedTakeover ? 'Reason for Takeover' : 'Reason for Override') %></span>
              <textarea
                name="reason"
                rows="5"
                maxlength="1000"
                required
                placeholder="<%= isDuplicateIntakeRequest ? (isMoveOnlyRequest ? 'Explain why your existing Unit should move to the selected Lot.' : 'Explain why the existing Unit should be moved, reassigned, or reworked.') : (isParkedTakeover ? 'Explain why this Parked Unit should be returned to Active and assigned to you.' : 'Explain why this Unit should be reassigned or moved after Tech Lead+ review.') %>"
              ><%= formData.reason %></textarea>
              <small class="field-hint">
                Minimum 10 characters. This request remains Pending until Tech Lead+ approves or denies it.
              </small>
            </label>

            <div class="form-actions">
              <button class="primary-button" type="submit"><%= isDuplicateIntakeRequest ? duplicateRequestButtonLabel : (isParkedTakeover ? 'Send Takeover Request' : 'Send Override Request') %></button>
              <button type="button" class="secondary-button" data-modal-close>Cancel</button>
            </div>
          </form>
        <% } else { %>
          <div class="form-actions">
            <button type="button" class="primary-button" data-modal-close>Close</button>
          </div>
        <% } %>
      <% } %>
    </div>
  </section>
</div>
