<%
  const safeErrors = Array.isArray(errorMessages) ? errorMessages : [];
  const safeRequirements = Array.isArray(requirements) ? requirements : [];
  const safeSuppressions = typeof requirementInheritanceSuppressions !== 'undefined' && Array.isArray(requirementInheritanceSuppressions) ? requirementInheritanceSuppressions : [];
  const safeLot = lot || null;
  const safeSuccessMessage = typeof successMessage === 'string' ? successMessage : '';
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel site-clean-modal lot-modal lot-requirements-list-modal" role="dialog" aria-modal="true" aria-labelledby="lot-requirements-modal-title">
    <header class="modal-header">
      <div>
        <h2 id="lot-requirements-modal-title">Requirements</h2>
      </div>

      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </header>

    <div class="modal-body">
      <% if (safeErrors.length > 0) { %>
        <div class="message error">
          <% safeErrors.forEach((errorMessage) => { %>
            <p><%= errorMessage %></p>
          <% }) %>
        </div>
      <% } %>

      <% if (safeSuccessMessage) { %>
        <div class="message success"><p><%= safeSuccessMessage %></p></div>
      <% } %>

      <% if (safeLot && Number(safeLot.parent_lot_id) > 0) { %>
        <p class="lot-requirements-inheritance-note">
          Requirements inherit from the direct parent only. Customize an inherited field to replace the parent's rules for that field, or stop inheriting it when this child Lot should have no requirement for that field. Deleting every direct child rule for a field restores parent inheritance unless inheritance has been explicitly stopped.
        </p>
      <% } %>

      <% if (safeLot) { %>
        <div class="lot-requirements-modal-toolbar site-clean-actions">
          <a class="primary-button" href="/management/lots/<%= safeLot.lot_id %>/requirements/new/modal" hx-get="/management/lots/<%= safeLot.lot_id %>/requirements/new/modal" hx-target="#modal-root" hx-swap="innerHTML">Add Requirement</a>
        </div>
      <% } %>

      <div class="table-card lot-requirements-table-card lot-requirements-modal-table-card">
        <table>
          <colgroup>
            <col class="requirements-field-column" />
            <col class="requirements-rule-column" />
            <col class="requirements-value-column" />
            <col class="requirements-status-column" />
            <col class="requirements-notes-column" />
            <col class="requirements-actions-column" />
          </colgroup>
          <thead>
            <tr>
              <th>Field</th>
              <th>Rule</th>
              <th>Value</th>
              <th>Status</th>
              <th>Notes</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <% if (safeRequirements.length === 0 && safeSuppressions.length === 0) { %>
              <tr>
                <td colspan="6">No direct or inherited requirements apply to this lot yet.</td>
              </tr>
            <% } %>

            <% safeRequirements.forEach((requirement) => { %>
              <tr>
                <td>
                  <strong><%= requirement.requirement_label || requirement.requirement_key || '—' %></strong>
                  <% if (Number(requirement.is_inherited) === 1) { %>
                    <small>Inherited from <%= requirement.source_lot_name || `Lot ${requirement.source_lot_id}` %></small>
                  <% } else { %>
                    <small>This Lot</small>
                  <% } %>
                </td>
                <td><%= requirement.operator_label || requirement.operator_code || 'Equals' %></td>
                <td><%= requirement.required_value || '—' %></td>
                <td>
                  <% if (Number(requirement.is_active) === 1) { %>
                    <span class="pill good">Active</span>
                  <% } else { %>
                    <span class="pill bad">Inactive</span>
                  <% } %>
                </td>
                <td><%= requirement.notes || '—' %></td>
                <td>
                  <% if (safeLot && Number(requirement.is_inherited) !== 1) { %>
                    <div class="lot-requirement-row-actions">
                      <a class="secondary-button" href="/management/lots/<%= safeLot.lot_id %>/requirements/<%= requirement.lot_requirement_id %>/edit/modal" hx-get="/management/lots/<%= safeLot.lot_id %>/requirements/<%= requirement.lot_requirement_id %>/edit/modal" hx-target="#modal-root" hx-swap="innerHTML">Edit</a>
                      <a class="secondary-button danger-button" href="/management/lots/<%= safeLot.lot_id %>/requirements/<%= requirement.lot_requirement_id %>/delete/modal" hx-get="/management/lots/<%= safeLot.lot_id %>/requirements/<%= requirement.lot_requirement_id %>/delete/modal" hx-target="#modal-root" hx-swap="innerHTML">Delete</a>
                    </div>
                  <% } else if (safeLot && Number(requirement.is_inherited) === 1) { %>
                    <div class="lot-requirement-row-actions">
                      <form
                        method="post"
                        action="/management/lots/<%= safeLot.lot_id %>/requirements/<%= requirement.lot_requirement_id %>/customize"
                        hx-post="/management/lots/<%= safeLot.lot_id %>/requirements/<%= requirement.lot_requirement_id %>/customize"
                        hx-target="#modal-root"
                        hx-swap="innerHTML"
                      >
                        <button type="submit" class="secondary-button">Customize</button>
                      </form>
                      <form
                        method="post"
                        action="/management/lots/<%= safeLot.lot_id %>/requirements/<%= requirement.lot_requirement_id %>/stop-inheriting"
                        hx-post="/management/lots/<%= safeLot.lot_id %>/requirements/<%= requirement.lot_requirement_id %>/stop-inheriting"
                        hx-target="#modal-root"
                        hx-swap="innerHTML"
                      >
                        <button type="submit" class="secondary-button danger-button">Stop Inheriting</button>
                      </form>
                      <a class="secondary-button" href="/management/lots/<%= requirement.source_lot_id %>">View Parent</a>
                    </div>
                  <% } else { %>
                    —
                  <% } %>
                </td>
              </tr>
            <% }) %>

            <% safeSuppressions.forEach((suppression) => { %>
              <tr class="lot-requirement-suppressed-row">
                <td>
                  <strong><%= suppression.requirement_label || suppression.requirement_key || 'Requirement' %></strong>
                  <small>Parent inheritance stopped for this Lot</small>
                </td>
                <td>—</td>
                <td>—</td>
                <td><span class="pill muted">Not inherited</span></td>
                <td>
                  <% if (Number(suppression.source_lot_id) > 0) { %>
                    Parent: <%= suppression.source_lot_name || `Lot ${suppression.source_lot_id}` %>
                  <% } else { %>
                    Parent requirement suppression retained
                  <% } %>
                </td>
                <td>
                  <div class="lot-requirement-row-actions">
                    <form
                      method="post"
                      action="/management/lots/<%= safeLot.lot_id %>/requirements/inheritance/<%= suppression.requirement_type_config_value_id %>/restore"
                      hx-post="/management/lots/<%= safeLot.lot_id %>/requirements/inheritance/<%= suppression.requirement_type_config_value_id %>/restore"
                      hx-target="#modal-root"
                      hx-swap="innerHTML"
                    >
                      <button type="submit" class="secondary-button">Restore Inheritance</button>
                    </form>
                    <% if (Number(suppression.source_lot_id) > 0) { %>
                      <a class="secondary-button" href="/management/lots/<%= suppression.source_lot_id %>">View Parent</a>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>
