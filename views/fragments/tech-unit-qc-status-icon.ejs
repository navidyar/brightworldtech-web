<%
  const rawStatusCode = String(
    typeof statusCode !== 'undefined' && statusCode ? statusCode : decisionCode || ''
  ).trim().toLowerCase();
  const qcStatusCode = ['not_reviewed', 'not-reviewed', 'unreviewed', 'none'].includes(rawStatusCode)
    ? 'not-reviewed'
    : (rawStatusCode === 'ready_recheck'
      ? 'ready-recheck'
      : (['accepted', 'corrected'].includes(rawStatusCode) ? 'accepted' : 'rejected'));
%>
<svg
  class="tech-qc-status-indicator tech-qc-status-indicator--<%= qcStatusCode %>"
  viewBox="0 0 22 22"
  width="22"
  height="22"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
  focusable="false"
  shape-rendering="geometricPrecision"
>
  <circle class="tech-qc-status-indicator__disc" cx="11" cy="11" r="9.25" />
  <circle class="tech-qc-status-indicator__ring" cx="11" cy="11" r="9.25" />
  <% if (qcStatusCode === 'accepted') { %>
    <path class="tech-qc-status-indicator__mark" d="M6.8 11.1 9.7 14 15.5 8.2" />
  <% } else if (qcStatusCode === 'ready-recheck') { %>
    <path class="tech-qc-status-indicator__mark" d="M15.2 8.3A5 5 0 1 0 15.5 13" />
    <path class="tech-qc-status-indicator__mark" d="m15.1 6.2.1 2.3-2.3.1" />
  <% } else if (qcStatusCode === 'not-reviewed') { %>
    <path class="tech-qc-status-indicator__mark tech-qc-status-indicator__mark--neutral" d="M7.8 11h6.4" />
  <% } else { %>
    <path class="tech-qc-status-indicator__mark" d="M7.5 7.5 14.5 14.5M14.5 7.5 7.5 14.5" />
  <% } %>
</svg>
