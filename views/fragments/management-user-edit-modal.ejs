<%
  const safeErrors = Array.isArray(errorMessages) ? errorMessages : [];
  const safeRoles = Array.isArray(roles) ? roles : [];
  const safeFormData = formData || {};
  const selectedRoles = Array.isArray(safeFormData.roleCodes) ? safeFormData.roleCodes : [];
  const safeReturnPath = returnPath === 'inactive' ? 'inactive' : 'active';
  const isRoleEditingLocked = Boolean(roleEditingLocked);
  const canEditRoleAssignments = Boolean(canEditRoles);
  const lockedRoleCode = roleEditingLockCode === 'admin' ? 'admin' : 'management';
  const lockedRoleLabel = lockedRoleCode === 'admin' ? 'Admin' : 'Management';
  const currentRoleLabel = user.role_names || user.primary_role_name || selectedRoles.join(', ') || 'No role assigned';
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel management-user-modal management-user-form-modal flat-form-modal" role="dialog" aria-modal="true" aria-labelledby="management-user-edit-title">
    <header class="modal-header">
      <div>
        <p class="eyebrow">Management</p>
        <h2 id="management-user-edit-title">Edit User</h2>
      </div>

      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </header>

    <div class="modal-body">
      <% if (safeErrors.length > 0) { %>
        <div class="message error">
          <% safeErrors.forEach((errorMessage) => { %>
            <p><%= errorMessage %></p>
          <% }) %>
        </div>
      <% } %>

      <form class="auth-form management-user-edit-form" method="post" action="/management/users/<%= user.user_id %>/edit/modal" hx-post="/management/users/<%= user.user_id %>/edit/modal" hx-target="#modal-root" hx-swap="innerHTML" autocomplete="off">
        <input type="hidden" name="returnPath" value="<%= safeReturnPath %>" />

        <div class="management-user-modal-summary">
          <span class="pill <%= user.is_active ? 'good' : 'bad' %>"><%= user.is_active ? 'Active Employee' : 'Inactive Employee' %></span>
          <span class="pill <%= user.account_status_code === 'active' ? 'good' : 'bad' %>"><%= user.account_status_label || user.account_status_code || 'Unknown Account Status' %></span>
        </div>

        <div class="form-grid">
          <label class="form-field">
            <span>First Name</span>
            <input type="text" name="firstName" value="<%= safeFormData.firstName || '' %>" autocomplete="off" required />
          </label>

          <label class="form-field">
            <span>Last Name</span>
            <input type="text" name="lastName" value="<%= safeFormData.lastName || '' %>" autocomplete="off" required />
          </label>
        </div>

        <label class="form-field">
          <span>BWT Username</span>
          <input type="text" value="<%= user.username || '' %>" readonly autocomplete="off" aria-describedby="management-user-username-help" />
          <small id="management-user-username-help" class="management-user-role-help">Generated when the account is created and kept stable for ScanTools, TechTools, and future API matching.</small>
        </label>

        <div class="form-grid">
          <label class="form-field">
            <span>Work / Login Email</span>
            <input type="email" name="email" value="<%= safeFormData.email || '' %>" autocomplete="off" inputmode="email" spellcheck="false" required />
          </label>

          <label class="form-field">
            <span>Personal Email (optional)</span>
            <input type="email" name="personalEmail" maxlength="255" value="<%= safeFormData.personalEmail || '' %>" autocomplete="off" inputmode="email" spellcheck="false" />
          </label>
        </div>

        <label class="form-field">
          <span>Phone (optional)</span>
          <input type="tel" name="phone" value="<%= safeFormData.phone || '' %>" autocomplete="off" inputmode="tel" maxlength="50" />
        </label>

        <div class="form-grid">
          <label class="form-field">
            <span>Start Date (optional)</span>
            <input type="date" name="startDate" value="<%= safeFormData.startDate || '' %>" />
          </label>

          <label class="form-field">
            <span>End Date (optional)</span>
            <input type="date" name="endDate" value="<%= safeFormData.endDate || '' %>" />
          </label>
        </div>

        <% if (canManageLoginInactivity) { %>
          <label class="form-field">
            <span>Login Inactivity Monitoring</span>
            <select name="loginInactivityMode">
              <option value="inherit" <%= (safeFormData.loginInactivityMode || 'inherit') === 'inherit' ? 'selected' : '' %>>Inherit from assigned role(s)</option>
              <option value="allow" <%= safeFormData.loginInactivityMode === 'allow' ? 'selected' : '' %>>Monitor this user</option>
              <option value="deny" <%= safeFormData.loginInactivityMode === 'deny' ? 'selected' : '' %>>Do not monitor this user</option>
            </select>
            <small class="field-hint">This user-level setting overrides the role default. Monitored active users are flagged after more than 5 business days without a login.</small>
          </label>
        <% } %>

        <% if (canEditRoleAssignments || isRoleEditingLocked) { %>
        <div>
          <p class="eyebrow management-user-modal-roles-label">Access Roles</p>
          <% if (isRoleEditingLocked) { %>
            <p class="management-user-role-help">Your current <%= lockedRoleLabel %> role is locked while you edit your own account. Another authorized user must make any role change.</p>
            <% selectedRoles.forEach((roleCode) => { %>
              <input type="hidden" name="roleCodes" value="<%= roleCode %>" />
            <% }) %>

            <div class="workflow-list management-user-modal-roles">
              <div class="workflow-item active" aria-label="Current access roles">
                <span aria-hidden="true"></span>
                <div>
                  <strong><%= currentRoleLabel %></strong>
                  <p>Current roles — role editing is unavailable for your own <%= lockedRoleLabel %> account.</p>
                </div>
              </div>
            </div>
          <% } else { %>
            <p class="management-user-role-help">Select one or more roles. Approved default permissions from every assigned role combine; an unapproved permission on one role does not cancel a grant from another role.</p>

            <div class="workflow-list management-user-modal-roles">
              <% safeRoles.forEach((role) => { %>
                <% const roleSelected = selectedRoles.includes(role.code); %>
                <label class="workflow-item <%= roleSelected ? 'active' : '' %> <%= role.assignmentLocked ? 'is-disabled' : '' %>">
                  <input type="checkbox" name="roleCodes" value="<%= role.code %>" <%= roleSelected ? 'checked' : '' %> <%= role.assignmentLocked ? 'disabled' : '' %> />
                  <% if (role.assignmentLocked && roleSelected) { %><input type="hidden" name="roleCodes" value="<%= role.code %>" /><% } %>

                  <div>
                    <strong><%= role.name %></strong>
                    <p><%= role.description || 'No description.' %><% if (!role.is_active) { %> · Inactive role currently assigned<% } %><% if (role.assignmentLocked) { %> · Protected assignment requires Super Admin authority<% } %></p>
                  </div>
                </label>
              <% }) %>
            </div>
          <% } %>
        </div>

        <% } %>

        <div class="action-row">
          <button type="submit" class="primary-button">Save User Changes</button>
          <button type="button" class="secondary-button" data-modal-close>Cancel</button>
        </div>
      </form>
    </div>
  </section>
</div>
