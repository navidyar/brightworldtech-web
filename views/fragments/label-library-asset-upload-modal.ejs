<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel site-clean-modal label-library-asset-upload-modal" role="dialog" aria-modal="true" aria-labelledby="label-library-asset-upload-title">
    <header class="modal-header">
      <div>
        <h2 id="label-library-asset-upload-title">Upload Shared Asset</h2>
        <p>Reusable PNG or SVG artwork for Label Builder templates.</p>
      </div>
      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </header>

    <div class="modal-body">
      <div class="message info">
        <p>Only PNG and SVG are accepted. You can choose a file, drag it here, or paste a PNG image from the clipboard.</p>
      </div>

      <div class="message error label-library-asset-upload-errors" data-label-asset-errors hidden></div>

      <form class="label-library-asset-upload-form" method="post" data-history-allow="true" data-label-asset-upload-form novalidate>
        <div class="label-library-asset-dropzone" data-label-asset-dropzone tabindex="0" role="button" aria-label="Choose, drop, or paste a PNG or SVG Label Asset">
          <input type="file" data-label-asset-file-input accept=".png,.svg,image/png,image/svg+xml" hidden />
          <div class="label-library-asset-dropzone-copy">
            <strong>Drop PNG or SVG here</strong>
            <span>or click to choose a file</span>
            <small>Clipboard: copy an image, then press Ctrl+V while this window is open.</small>
          </div>
          <div class="label-library-asset-selection" data-label-asset-selection hidden>
            <div class="label-library-asset-selection-preview" data-label-asset-selection-preview></div>
            <div>
              <strong data-label-asset-selection-name></strong>
              <small data-label-asset-selection-meta></small>
            </div>
          </div>
        </div>

        <div class="form-grid label-library-asset-upload-details">
          <label>
            <span>Asset Name</span>
            <input type="text" name="assetName" maxlength="160" placeholder="Example: HP Logo" required />
            <small>After choosing the file, change this name before uploading if needed.</small>
          </label>

          <label>
            <span>Asset Type</span>
            <select name="assetKind" required>
              <% assetKinds.forEach((kind) => { %>
                <option value="<%= kind %>"><%= kind.charAt(0).toUpperCase() + kind.slice(1) %></option>
              <% }) %>
            </select>
          </label>
        </div>

        <p class="label-library-asset-upload-note">JPEG, GIF, WebP, BMP, PDF, and other formats are rejected rather than converted.</p>

        <div class="form-actions">
          <button type="button" class="secondary-button" data-modal-close>Cancel</button>
          <button type="submit" class="primary-button" data-label-asset-upload-submit disabled>Upload Asset</button>
        </div>
      </form>
    </div>
  </section>
</div>
