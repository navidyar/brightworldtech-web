<%
  const safeErrors = Array.isArray(errorMessages) ? errorMessages : [];
  const review = latestQcReview && Number(latestQcReview.qcCheckId) === Number(qcCheckId) ? latestQcReview : null;
  const unitLabel = unit && unit.assetTag ? unit.assetTag : (unit && unit.unitId ? `Unit ${unit.unitId}` : 'Selected Unit');
  const canSubmit = Boolean(unit && latestCompletion && review && qcCheckId && !pendingRequest && safeErrors.length === 0);
  const reasonInputId = `tech-qc-reversion-request-reason-${qcCheckId || 'decision'}`;
  const reasonHintId = `${reasonInputId}-hint`;
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section
    class="modal-panel site-clean-modal tech-qc-review-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tech-qc-reversion-request-title"
    aria-describedby="tech-qc-reversion-request-description"
    tabindex="-1"
  >
    <header class="modal-header">
      <div>
        <p class="eyebrow">Quality Control</p>
        <h2 id="tech-qc-reversion-request-title">Request QC Decision Reversion</h2>
        <p id="tech-qc-reversion-request-description" class="modal-description">
          Ask Tech Lead+ to review whether your current QC decision should be reverted.
        </p>
      </div>
      <button type="button" class="modal-close-button" data-modal-close aria-label="Close QC reversion request">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M5.5 5.5 14.5 14.5M14.5 5.5 5.5 14.5" /></svg>
      </button>
    </header>

    <div class="modal-body">
      <% if (safeErrors.length > 0) { %>
        <div class="message error" role="alert" aria-live="assertive">
          <% safeErrors.forEach((errorMessage) => { %><p><%= errorMessage %></p><% }) %>
        </div>
      <% } %>

      <% if (unit && review) { %>
        <dl class="tech-qc-review-summary">
          <div><dt>Unit</dt><dd><strong><%= unitLabel %></strong></dd></div>
          <div><dt>Exact QC Decision</dt><dd><%= review.decisionLabel %> · QC #<%= review.qcCheckId %></dd></div>
          <div><dt>Recorded By</dt><dd><%= review.reviewedByName %></dd></div>
        </dl>
      <% } %>

      <% if (pendingRequest) { %>
        <div class="message info">
          <p>A reversion request is already pending for this exact QC decision.</p>
        </div>
        <div class="action-row tech-qc-modal-actions">
          <a class="secondary-button" href="/unit-requests/<%= pendingRequest.unitRequestId %>">View Request Details</a>
          <button type="button" class="secondary-button" data-modal-close>Close</button>
        </div>
      <% } else if (canSubmit) { %>
        <form method="post" action="/tech/units/<%= unit.unitId %>/qc-review/<%= qcCheckId %>/reversion-request<%= qcPortalMode ? '?qcPortal=1' : '' %>" data-qc-reversion-request-form>
          <label class="form-field" for="<%= reasonInputId %>">
            <span>Reason for Reversion Request (required)</span>
            <textarea
              id="<%= reasonInputId %>"
              name="requesterNote"
              rows="5"
              minlength="3"
              maxlength="1000"
              required
              aria-describedby="<%= reasonHintId %>"
              data-modal-initial-focus
              placeholder="Explain why your exact QC decision should be reverted."
            ><%= requesterNote || '' %></textarea>
          </label>
          <p id="<%= reasonHintId %>" class="field-hint">
            Your <%= review.decisionLabel %> decision remains current while this request is pending. If Tech Lead+ approves, this reason becomes the permanent QC reversion reason and the Unit returns to Awaiting QC. The original decision remains in audit history.
          </p>
          <p class="visually-hidden" data-qc-submit-status aria-live="polite" aria-atomic="true"></p>
          <div class="action-row tech-qc-modal-actions">
            <button type="submit" class="primary-button" data-qc-submit-button>Submit Reversion Request</button>
            <button type="button" class="secondary-button" data-modal-close>Cancel</button>
          </div>
        </form>
      <% } else if (!pendingRequest) { %>
        <div class="action-row tech-qc-modal-actions">
          <button type="button" class="secondary-button" data-modal-close data-modal-initial-focus>Close</button>
        </div>
      <% } %>
    </div>
  </section>
</div>
