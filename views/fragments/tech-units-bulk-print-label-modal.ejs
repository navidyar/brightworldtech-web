<%
  const safeErrors = Array.isArray(errorMessages) ? errorMessages.filter(Boolean) : [];
  const safePrinters = Array.isArray(printers) ? printers : [];
  const safeTemplates = Array.isArray(templateOptions) ? templateOptions : [];
  const safeCandidates = Array.isArray(candidates) ? candidates : [];
  const safeResults = Array.isArray(printResults) ? printResults : [];
  const lotName = lot ? (lot.lot_name || lot.name || 'Selected Lot') : 'Selected Lot';
  const canSubmit = !Boolean(submitBlocked)
    && selectedCount > 0
    && safePrinters.length > 0
    && safeTemplates.some((template) => template.available);
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel site-clean-modal tech-print-label-modal tech-bulk-print-label-modal" role="dialog" aria-modal="true" aria-labelledby="tech-bulk-print-label-title">
    <div class="modal-header">
      <h2 id="tech-bulk-print-label-title">Print Labels · <%= lotName %></h2>
      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </div>

    <div class="modal-body">
      <% if (successMessage) { %>
        <div class="message success"><p><%= successMessage %></p></div>
        <div class="tech-print-success-recent-link">
          <a class="secondary-button" href="/tech/print-queue/modal" hx-get="/tech/print-queue/modal" hx-target="#modal-root" hx-swap="innerHTML">View Recent Prints</a>
        </div>
      <% } %>

      <% if (safeErrors.length > 0) { %>
        <div class="message error">
          <% safeErrors.forEach((message) => { %><p><%= message %></p><% }) %>
        </div>
      <% } %>

      <div class="tech-override-summary tech-bulk-print-summary">
        <dl>
          <div><dt>Lot</dt><dd><%= lotName %></dd></div>
          <div><dt>Current page</dt><dd><%= pagination ? `${pagination.page} of ${pagination.totalPages || 1}` : '—' %></dd></div>
          <div><dt>Eligible</dt><dd><%= eligibleCount %> completed Unit<%= eligibleCount === 1 ? '' : 's' %></dd></div>
        </dl>
      </div>

      <% if (templateSetNotice) { %>
        <div class="message info tech-label-template-source"><p><%= templateSetNotice %></p></div>
      <% } %>

      <% if (safeCandidates.length > 0) { %>
        <form
          class="app-form tech-unit-form tech-label-print-form tech-bulk-label-print-form"
          method="post"
          action="<%= bulkPostUrl %>"
          hx-post="<%= bulkPostUrl %>"
          hx-target="#modal-root"
          hx-swap="innerHTML"
        >
          <div class="form-section">
            <div class="form-section-header tech-bulk-unit-section-header">
              <div>
                <h3>Units</h3>
                <p class="field-hint">Completed Units on the current browser page are selected by default. Deselect any Units you do not need, or reselect them before printing.</p>
              </div>
              <div class="tech-bulk-unit-controls">
                <span class="tech-chip"><strong data-bulk-label-selected-count><%= selectedCount %></strong>&nbsp;selected</span>
                <button type="button" class="button-link" data-bulk-label-select-all>Select All</button>
                <button type="button" class="button-link" data-bulk-label-clear-all>Clear All</button>
              </div>
            </div>

            <div class="tech-bulk-label-unit-list" role="group" aria-label="Units to print">
              <% safeCandidates.forEach((candidate) => { %>
                <label class="tech-bulk-label-unit-row <%= candidate.eligible ? '' : 'is-unavailable' %>">
                  <span class="tech-bulk-label-unit-select">
                    <input
                      type="checkbox"
                      name="unitId"
                      value="<%= candidate.unitId %>"
                      data-bulk-label-unit-checkbox
                      <%= candidate.selected ? 'checked' : '' %>
                      <%= candidate.eligible ? '' : 'disabled' %>
                    />
                    <strong><%= candidate.assetTag %></strong>
                  </span>
                  <span><%= candidate.assignedToName %></span>
                  <span><%= candidate.completedAt ? formatDateTime(candidate.completedAt) : candidate.ineligibleReason || 'Not completed' %></span>
                </label>
              <% }) %>
            </div>
          </div>

          <div class="form-section tech-label-printer-section">
            <div class="form-section-header">
              <div>
                <h3>Printer or Group</h3>
                <p class="field-hint">Choose a printer directly or a printer group. For a bulk submission, a group selects one available compatible printer and keeps the entire batch together at that pickup location.</p>
              </div>
            </div>
            <div class="form-grid tech-label-printer-grid">
              <label class="form-field">
                <span>Printer or Group</span>
                <select name="printerId" required data-modal-initial-focus>
                  <% safePrinters.forEach((printer) => { %>
                    <option value="<%= printer.id %>" <%= printer.id === selectedPrinterId ? 'selected' : '' %>><%= printer.label %></option>
                  <% }) %>
                </select>
              </label>
            </div>
          </div>

          <div class="form-section">
            <div class="form-section-header">
              <div>
                <h3>Labels</h3>
                <p class="field-hint">Each selected Unit prints with its own current data.<% if (previewUnitLabel) { %> The previews below use <strong><%= previewUnitLabel %></strong> as the sample Unit so the preview follows the same hydrated data path as physical printing.<% } %></p>
              </div>
            </div>

            <div class="tech-label-template-list">
              <% safeTemplates.forEach((template) => { %>
                <article class="tech-label-template-choice <%= template.selected ? 'is-selected' : '' %> <%= template.available ? '' : 'is-unavailable' %>">
                  <div class="tech-label-template-choice-header">
                    <label class="tech-label-template-choice-toggle">
                      <input
                        type="checkbox"
                        name="templateKey"
                        value="<%= template.key %>"
                        <%= template.selected && template.available ? 'checked' : '' %>
                        <%= template.available ? '' : 'disabled' %>
                      />
                      <span><strong><%= template.name %></strong></span>
                    </label>
                    <div class="tech-label-template-badges">
                      <% if (template.isRequired) { %><span class="pill good">Normal set</span><% } else { %><span class="pill slate">Optional</span><% } %>
                    </div>
                  </div>

                  <% if (template.previewDataUri) { %>
                    <div class="tech-label-preview" aria-label="Sample preview for <%= template.name %>">
                      <img class="tech-label-preview-image" src="<%= template.previewDataUri %>" alt="Sample preview of <%= template.name %>" />
                    </div>
                  <% } %>

                  <% if (!template.available || template.previewError) { %>
                    <div class="message error tech-label-template-inline-error"><p><%= template.unavailableReason || template.previewError %></p></div>
                  <% } %>

                  <label class="form-field tech-label-template-quantity">
                    <span>Copies per Unit</span>
                    <input
                      type="number"
                      name="quantity[<%= template.key %>]"
                      min="1"
                      max="<%= maxCopies %>"
                      step="1"
                      value="<%= template.quantity %>"
                      <%= template.available ? '' : 'disabled' %>
                    />
                  </label>
                </article>
              <% }) %>
            </div>
          </div>

          <% if (safeResults.length > 0) { %>
            <div class="form-section">
              <div class="form-section-header"><div><h3>Submission Results</h3></div></div>
              <div class="tech-bulk-print-results">
                <% safeResults.forEach((result) => { %>
                  <div class="tech-bulk-print-result-row">
                    <strong><%= result.unitLabel %></strong>
                    <span class="pill <%= result.status === 'queued' ? 'good' : 'slate' %>"><%= result.status === 'queued' ? 'Queued' : result.status === 'partial' ? 'Partial' : 'Failed' %></span>
                    <span><%= result.copiesQueued %> queued<% if (result.printerLabels && result.printerLabels.length) { %> · <%= result.printerLabels.join(', ') %><% } %></span>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

          <div class="form-actions">
            <button class="primary-button" type="submit" <%= canSubmit ? '' : 'disabled' %>>Print Selected Units</button>
            <button type="button" class="secondary-button" data-modal-close>Close</button>
          </div>
        </form>
      <% } else { %>
        <div class="message info"><p>No Units are available on this filtered browser page.</p></div>
        <div class="form-actions"><button type="button" class="primary-button" data-modal-close>Close</button></div>
      <% } %>
    </div>
  </section>
</div>
