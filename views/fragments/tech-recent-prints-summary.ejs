<%
  const safeSummary = summary || {};
  const recentItems = Number(safeSummary.recentItems || 0);
  const issueItems = Number(safeSummary.issueItems || 0);
%>
<a
  class="secondary-button tech-recent-prints-button"
  href="/tech/print-queue/modal"
  hx-get="/tech/print-queue/modal"
  hx-target="#modal-root"
  hx-swap="innerHTML"
  data-tech-modal-trigger
>
  Recent Prints<% if (recentItems > 0) { %> · <%= recentItems %> recent<% } %><% if (issueItems > 0) { %> · <%= issueItems %> issue<%= issueItems === 1 ? '' : 's' %><% } %>
</a>
