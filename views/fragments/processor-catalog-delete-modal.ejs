<%
  const safeErrors = Array.isArray(errorMessages) ? errorMessages : [];
  const willRetire = Number(processor.unitCount || 0) > 0 || Number(processor.lotRequirementCount || 0) > 0;
  const returnParams = new URLSearchParams();
  if (returnTo) returnParams.set('returnTo', returnTo);
  if (filters?.processorBrandId) returnParams.set('processorBrandId', String(filters.processorBrandId));
  if (filters?.includeInactive) returnParams.set('includeInactive', '1');
  if (filters?.needsReview) returnParams.set('needsReview', '1');
  if (filters?.search) returnParams.set('search', filters.search);
  const formAction = `/management/config/processors/${processor.id}/delete${returnParams.toString() ? `?${returnParams.toString()}` : ''}`;
%>
<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel site-clean-modal processor-catalog-modal" role="dialog" aria-modal="true" aria-labelledby="processor-delete-modal-title">
    <header class="modal-header">
      <div>
        <h2 id="processor-delete-modal-title">Delete Processor</h2>
        <p><strong><%= processor.brandName %> <%= processor.modelCode %></strong></p>
      </div>
      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </header>

    <div class="modal-body">
      <% if (safeErrors.length) { %>
        <div class="message error"><% safeErrors.forEach((message) => { %><p><%= message %></p><% }) %></div>
      <% } %>

      <div class="site-clean-section site-clean-surface">
        <% if (willRetire) { %>
          <p>This processor is still referenced by existing Units or direct Lot requirements, so it will be removed from the active catalog instead of physically deleted.</p>
          <p>The processor record and its historical relationships will be preserved so existing Unit history and Lot evaluation remain intact. It will no longer appear in normal active processor selections.</p>
        <% } else { %>
          <p>This permanently removes the processor from the Processor Catalog, Unit Model compatibility lists, and Processor Family memberships.</p>
          <p>Approved Processor Request records are preserved, but their link to this deleted processor is cleared.</p>
        <% } %>

        <div class="site-summary-stats">
          <article><span><small>Models</small><strong><%= formatNumber(processor.unitModelCount || 0) %></strong></span></article>
          <article><span><small>Families</small><strong><%= formatNumber(processor.processorFamilyCount || 0) %></strong></span></article>
          <article><span><small>Units</small><strong><%= formatNumber(processor.unitCount || 0) %></strong></span></article>
          <article><span><small>Requests</small><strong><%= formatNumber(processor.requestCount || 0) %></strong></span></article>
          <article><span><small>Lot Requirements</small><strong><%= formatNumber(processor.lotRequirementCount || 0) %></strong></span></article>
        </div>
      </div>

      <% if (willRetire) { %>
        <div class="message info">
          <p>Because this processor is already in use, this action is a safe removal from the active catalog. Ask an Admin to use Resolve Duplicate if those existing references should be moved to another canonical processor.</p>
        </div>
      <% } %>

      <form class="app-form app-form-clean" method="post" action="<%= formAction %>" data-processor-catalog-form>
        <div class="form-actions">
          <button type="submit" class="danger-button"><%= willRetire ? 'Remove from Active Catalog' : 'Permanently Delete Processor' %></button>
          <button type="button" class="secondary-button" data-modal-close>Cancel</button>
        </div>
      </form>
    </div>
  </section>
</div>
