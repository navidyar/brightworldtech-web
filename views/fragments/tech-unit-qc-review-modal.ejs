<%
  const safeErrors = Array.isArray(errorMessages) ? errorMessages : [];
  const isReject = decisionCode === 'rejected';
  const unitLabel = unit && unit.assetTag ? unit.assetTag : (unit && unit.unitId ? `Unit ${unit.unitId}` : 'Selected Unit');
  const canSubmitReview = Boolean(
    unit
    && latestCompletion
    && ['accepted', 'rejected'].includes(decisionCode)
    && (!latestQcReview || (latestQcReview.decisionCode === 'rejected' && latestQcCorrection))
  );
  const notesInputId = `tech-qc-review-notes-${unit && unit.unitId ? unit.unitId : 'unit'}`;
  const notesHintId = `${notesInputId}-hint`;
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section
    class="modal-panel site-clean-modal tech-qc-review-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tech-qc-review-title"
    aria-describedby="tech-qc-review-description"
    tabindex="-1"
  >
    <header class="modal-header">
      <div>
        <p class="eyebrow">Quality Control</p>
        <h2 id="tech-qc-review-title"><%= isReject ? 'Reject Unit' : 'Accept Unit' %></h2>
        <p id="tech-qc-review-description" class="modal-description">
          <%= isReject ? 'Record the correction required before this Unit can return for QC recheck.' : 'Confirm that this completed Unit meets Quality Control standards.' %>
        </p>
      </div>

      <button type="button" class="modal-close-button" data-modal-close aria-label="Close Quality Control review">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M5.5 5.5 14.5 14.5M14.5 5.5 5.5 14.5" /></svg>
      </button>
    </header>

    <div class="modal-body">
      <% if (safeErrors.length > 0) { %>
        <div class="message error" role="alert" aria-live="assertive">
          <% safeErrors.forEach((errorMessage) => { %>
            <p><%= errorMessage %></p>
          <% }) %>
        </div>
      <% } %>

      <% if (unit) { %>
        <dl class="tech-qc-review-summary">
          <div><dt>Unit</dt><dd><strong><%= unitLabel %></strong></dd></div>
          <div><dt>Assigned Technician</dt><dd><%= unit.assignedToName || 'Unassigned' %></dd></div>
          <div><dt>Current QC Status</dt><dd><%= latestQcReview ? latestQcReview.decisionLabel : 'Not reviewed' %></dd></div>
        </dl>
      <% } %>

      <% if (canSubmitReview) { %>
        <form method="post" action="/tech/units/<%= unit.unitId %>/qc-review" data-qc-review-form>
          <input type="hidden" name="decisionCode" value="<%= decisionCode %>" />

          <label class="form-field" for="<%= notesInputId %>">
            <span>QC Notes <%= isReject ? '(required)' : '(optional)' %></span>
            <textarea
              id="<%= notesInputId %>"
              name="reviewNotes"
              rows="5"
              maxlength="2000"
              aria-describedby="<%= notesHintId %>"
              aria-required="<%= isReject ? 'true' : 'false' %>"
              <%= isReject ? 'required' : '' %>
              data-modal-initial-focus
              placeholder="<%= isReject ? 'Describe what must be corrected before QC can accept this Unit.' : 'Optional acceptance note.' %>"
            ><%= reviewNotes || '' %></textarea>
          </label>
          <p id="<%= notesHintId %>" class="field-hint">
            <%= isReject ? 'A clear rejection reason is required and will be visible to the assigned technician in Unit History.' : 'Acceptance notes are optional and will be retained in Unit History.' %>
          </p>

          <p class="visually-hidden" data-qc-submit-status aria-live="polite" aria-atomic="true"></p>

          <div class="action-row tech-qc-modal-actions">
            <button type="submit" class="<%= isReject ? 'danger-button' : 'primary-button' %>" data-qc-submit-button>
              <%= isReject ? 'Reject Unit' : 'Accept Unit' %>
            </button>
            <button type="button" class="secondary-button" data-modal-close>Cancel</button>
          </div>
        </form>
      <% } else { %>
        <div class="action-row tech-qc-modal-actions">
          <button type="button" class="secondary-button" data-modal-close data-modal-initial-focus>Close</button>
        </div>
      <% } %>
    </div>
  </section>
</div>
