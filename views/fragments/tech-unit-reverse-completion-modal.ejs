<%
  const safePreview = preview || {};
  const safeErrors = Array.isArray(errorMessages) ? errorMessages.filter(Boolean) : [];
  const canSubmit = Boolean(safePreview.ready) && !successMessage && safeErrors.length === 0;
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel tech-complete-work-modal" role="dialog" aria-modal="true" aria-labelledby="tech-reverse-completion-title">
    <div class="modal-header">
      <div>
        <p class="eyebrow">Unit Completion</p>
        <h2 id="tech-reverse-completion-title">Undo Unit Completion</h2>
      </div>

      <button type="button" class="modal-close" data-modal-close aria-label="Close modal">×</button>
    </div>

    <div class="modal-body">
      <% if (successMessage) { %>
        <div class="message success">
          <p><%= successMessage %></p>
        </div>
      <% } %>

      <% if (safeErrors.length > 0) { %>
        <div class="message error">
          <% safeErrors.forEach((message) => { %><p><%= message %></p><% }) %>
        </div>
      <% } %>

      <div class="tech-override-summary">
        <dl>
          <div><dt>Unit</dt><dd><%= safePreview.unitLabel || '—' %></dd></div>
          <div><dt>Lot</dt><dd><%= safePreview.lotName || '—' %></dd></div>
          <div><dt>Completed By</dt><dd><%= safePreview.completedByName || '—' %></dd></div>
          <div><dt>Completed At</dt><dd><%= safePreview.completedAt ? formatDateTime(safePreview.completedAt) : '—' %></dd></div>
          <div><dt>Credited Weight</dt><dd><%= safePreview.formattedProductionWeight || '—' %></dd></div>
        </dl>
      </div>

      <% if (canSubmit) { %>
        <p class="field-hint">
          Undoing completion removes this credit from active productivity totals and allows completion to be recorded again. The original record remains in Unit History.
        </p>

        <form
          class="app-form"
          method="post"
          action="/tech/units/<%= safePreview.unitId %>/completions/<%= safePreview.unitWorkCompletionId %>/reverse"
          hx-post="/tech/units/<%= safePreview.unitId %>/completions/<%= safePreview.unitWorkCompletionId %>/reverse"
          hx-target="#modal-root"
          hx-swap="innerHTML"
        >
          <label class="form-field">
            <span>Reason <span aria-hidden="true">*</span></span>
            <textarea name="reason" rows="4" maxlength="1000" required><%= reason || '' %></textarea>
          </label>

          <div class="form-actions">
            <button class="danger-button" type="submit">Undo Completion</button>
            <button type="button" class="secondary-button" data-modal-close>Cancel</button>
          </div>
        </form>
      <% } else { %>
        <div class="form-actions">
          <button type="button" class="primary-button" data-modal-close>Close</button>
        </div>
      <% } %>
    </div>
  </section>
</div>
