<div class="modal-backdrop" data-modal-backdrop><section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="printer-group-title"><div class="modal-header"><div><p class="eyebrow">Label Printing</p><h2 id="printer-group-title">New Printer Group</h2></div><button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button></div><div class="modal-body"><% if (errorMessages.length) { %><div class="message error"><% errorMessages.forEach((m) => { %><p><%= m %></p><% }) %></div><% } %><form class="app-form" method="post" action="/management/printer-groups" hx-post="/management/printer-groups" hx-target="#modal-root" hx-swap="innerHTML"><label class="form-field"><span>Name</span><input name="name" maxlength="120" required value="<%= formData.name %>" data-modal-initial-focus /></label><label class="form-field"><span>Description</span><textarea name="description" maxlength="500"><%= formData.description %></textarea></label><div class="form-actions"><button class="primary-button" type="submit">Create Group</button><button class="secondary-button" type="button" data-modal-close>Cancel</button></div></form></div></section></div>
