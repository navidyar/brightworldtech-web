<%
  const safeErrors = Array.isArray(errorMessages) ? errorMessages : [];
  const safePreview = preview || null;
  const sourceLot = safePreview ? safePreview.sourceLot : null;
  const safeOptions = formOptions || { parentLots: [], capabilities: {} };
  const safeFormData = formData || {};
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel site-clean-modal lot-modal" role="dialog" aria-modal="true" aria-labelledby="lot-duplicate-modal-title">
    <header class="modal-header">
      <div>
        <h2 id="lot-duplicate-modal-title">Duplicate Lot</h2>
      </div>
      <button type="button" class="modal-close-button" data-modal-close aria-label="Close modal">×</button>
    </header>

    <div class="modal-body">
      <% if (safeErrors.length > 0) { %>
        <div class="message error">
          <% safeErrors.forEach((message) => { %><p><%= message %></p><% }) %>
        </div>
      <% } %>

      <% if (sourceLot) { %>
        <form class="app-form app-form-clean lot-form-modal-form" method="post" action="/management/lots/<%= sourceLot.lot_id %>/duplicate" hx-post="/management/lots/<%= sourceLot.lot_id %>/duplicate" hx-target="#modal-root" hx-swap="innerHTML" data-lot-duplicate-form data-source-lot-name="<%= sourceLot.lot_name %>">
          <div class="form-section">
            <div class="form-section-header">
              <div><h3>New Lot</h3></div>
              <p>Configuration is copied from <strong><%= sourceLot.lot_name %></strong>. Direct Requirements are copied automatically; when the duplicate has a Parent Lot, every other Requirement inherits from that destination parent. The inheritance choice below applies only to Unit Form and Unit Browser behavior. Units, child Lots, history, validation decisions, and production records are not copied. The new Lot starts hidden.</p>
            </div>

            <div class="form-grid lot-form-grid">
              <label class="form-field form-field-wide">
                <span>New Lot Name</span>
                <input type="text" name="newLotName" value="<%= safeFormData.newLotName || '' %>" maxlength="120" required />
              </label>

              <fieldset class="form-field form-field-wide lot-choice-fieldset">
                <legend>Placement</legend>
                <div class="form-grid single-column lot-choice-list">
                  <label class="checkbox-card" for="duplicatePlacementTopLevel">
                    <input id="duplicatePlacementTopLevel" type="radio" name="placementMode" value="top_level" <%= safeFormData.placementMode !== 'child' ? 'checked' : '' %> />
                    <span>
                      <strong>Top-Level Lot</strong>
                      <small>Create the duplicate without a Parent Lot.</small>
                    </span>
                  </label>
                  <label class="checkbox-card" for="duplicatePlacementChild">
                    <input id="duplicatePlacementChild" type="radio" name="placementMode" value="child" <%= safeFormData.placementMode === 'child' ? 'checked' : '' %> />
                    <span>
                      <strong>Child of selected Lot</strong>
                      <small>Place the duplicate beneath another Lot in the hierarchy.</small>
                    </span>
                  </label>
                </div>
              </fieldset>

              <label class="form-field form-field-wide" data-lot-duplicate-parent-field <%= safeFormData.placementMode === 'child' ? '' : 'hidden' %>>
                <span>Parent Lot</span>
                <select name="parentLotId" data-lot-duplicate-parent-select data-hierarchical-lot-select <%= safeFormData.placementMode === 'child' ? '' : 'disabled' %>>
                  <%- include('../partials/parent-lot-options', {
                    parentLots: safeOptions.parentLots,
                    selectedParentLotId: safeFormData.parentLotId,
                    emptyLabel: 'Select Parent Lot'
                  }) %>
                </select>
              </label>
            </div>
          </div>

          <div class="form-section">
            <div class="form-section-header">
              <div><h3>Inheritance</h3></div>
              <p>
                Source: <strong><%= sourceLot.lot_name %></strong>
                · Destination: <strong data-lot-duplicate-destination-label>Root-level Lot (no Parent Lot)</strong>
              </p>
              <p data-lot-duplicate-requirement-description>Requirements: Direct Requirements from <strong><%= sourceLot.lot_name %></strong> are copied. This is a root-level Lot, so there is no Parent Lot to inherit additional Requirements from.</p>
            </div>
            <div class="form-grid single-column">
              <label class="checkbox-card" for="duplicateInheritancePreserve">
                <input id="duplicateInheritancePreserve" type="radio" name="inheritanceMode" value="preserve_source" <%= safeFormData.inheritanceMode !== 'new_parent' ? 'checked' : '' %> data-lot-duplicate-preserve-inheritance />
                <span>
                  <strong data-lot-duplicate-preserve-title>Keep Unit Form & Browser Behavior from <%= sourceLot.lot_name %></strong>
                  <small data-lot-duplicate-preserve-description>Create the duplicate as a root-level Lot and copy the effective Unit Form behavior and Unit Browser layout currently used by <%= sourceLot.lot_name %>.</small>
                </span>
              </label>
              <label class="checkbox-card" for="duplicateInheritanceParent">
                <input id="duplicateInheritanceParent" type="radio" name="inheritanceMode" value="new_parent" <%= safeFormData.inheritanceMode === 'new_parent' ? 'checked' : '' %> data-lot-duplicate-parent-inheritance />
                <span>
                  <strong data-lot-duplicate-parent-title>Inherit Unit Form & Browser from Destination Parent</strong>
                  <small data-lot-duplicate-parent-description>Available only when the duplicate is placed under another Parent Lot. Requirements follow the automatic rule above either way.</small>
                </span>
              </label>
            </div>
          </div>


          <div class="modal-actions">
            <button type="button" class="secondary-button" data-modal-close>Cancel</button>
            <button type="submit" class="primary-button">Duplicate Lot</button>
          </div>
        </form>
      <% } %>
    </div>
  </section>
</div>
