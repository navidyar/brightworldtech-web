<%
  const safePreview = preview || {};
  const safeErrorMessages = Array.isArray(errorMessages) ? errorMessages.filter(Boolean) : [];
  const canSubmit = Boolean(safePreview.ready) && !successMessage && safeErrorMessages.length === 0;
  const showProductionWeight = Boolean(canViewProductionWeight);
  const grantsProductionCredit = safePreview.grantsProductionCredit !== false;
%>

<div class="modal-backdrop" data-modal-backdrop>
  <section class="modal-panel tech-complete-work-modal" role="dialog" aria-modal="true" aria-labelledby="tech-complete-work-title">
    <div class="modal-header">
      <div>
        <p class="eyebrow">Unit Completion</p>
        <h2 id="tech-complete-work-title">Confirm Unit Complete</h2>
      </div>

      <button type="button" class="modal-close" data-modal-close aria-label="Close modal">×</button>
    </div>

    <div class="modal-body">
      <% if (successMessage) { %>
        <div class="message success">
          <p><%= successMessage %></p>
        </div>

        <div class="tech-override-summary">
          <dl>
            <div>
              <dt>Unit</dt>
              <dd><%= safePreview.unitLabel || '—' %></dd>
            </div>
            <div>
              <dt>Lot</dt>
              <dd><%= safePreview.lotName || '—' %></dd>
            </div>
            <div>
              <dt>Completed By</dt>
              <dd><%= creditedToName %></dd>
            </div>
            <% if (showProductionWeight) { %>
              <div>
                <dt>Production Credit</dt>
                <dd>
                  <% if (grantsProductionCredit) { %>
                    <%= safePreview.formattedProductionWeight || '—' %> new credit
                  <% } else { %>
                    Existing cycle retained · no additional credit
                  <% } %>
                </dd>
              </div>
            <% } %>
          </dl>
        </div>

        <div class="form-actions">
          <button type="button" class="primary-button" data-modal-close>Done</button>
        </div>
      <% } else { %>
        <% if (safeErrorMessages.length > 0) { %>
          <div class="message error">
            <% safeErrorMessages.forEach((errorMessage) => { %>
              <p><%= errorMessage %></p>
            <% }) %>
          </div>
        <% } %>

        <div class="tech-override-summary">
          <dl>
            <div>
              <dt>Unit</dt>
              <dd><%= safePreview.unitLabel || '—' %></dd>
            </div>
            <div>
              <dt>Current Lot</dt>
              <dd><%= safePreview.lotName || '—' %></dd>
            </div>
            <div>
              <dt><%= canChooseCompletionAttribution ? 'Currently Assigned To' : 'Completed By' %></dt>
              <dd><%= canChooseCompletionAttribution ? (safePreview.assignedToName || '—') : creditedToName %></dd>
            </div>
            <% if (showProductionWeight) { %>
              <div>
                <dt><%= grantsProductionCredit ? 'New Production Credit' : 'Production Credit' %></dt>
                <dd>
                  <% if (grantsProductionCredit) { %>
                    <%= safePreview.formattedProductionWeight || '—' %>
                  <% } else { %>
                    Existing cycle retained · no additional unit or weight
                  <% } %>
                </dd>
              </div>
            <% } %>
          </dl>
        </div>

        <p class="field-hint">
          This records the Unit as completed for the current Lot.
          <% if (grantsProductionCredit) { %>
            This production cycle will earn one Unit of production credit at the current effective weight.
          <% } else { %>
            This is a continuation of an existing production cycle, so completing this Lot workflow will not add another completed Unit or another production weight.
          <% } %>
          It does not change the Unit’s assignment, Lot, grade, or Pass/Fail status. Tech Lead+ completion attribution changes only who receives the completion/production credit.
        </p>

        <% if (canSubmit) { %>
          <form
            class="app-form"
            method="post"
            action="/tech/units/<%= safePreview.unitId %>/complete-work"
            hx-post="/tech/units/<%= safePreview.unitId %>/complete-work"
            hx-target="#modal-root"
            hx-swap="innerHTML"
          >
            <% if (canChooseCompletionAttribution) { %>
              <div class="form-section">
                <div class="form-section-header">
                  <div>
                    <h3>Record Completion For</h3>
                    <p class="field-hint">Tech Lead+ may record the completion for the technician currently assigned to this Unit or for themselves.</p>
                  </div>
                </div>
                <div class="form-grid single-column">
                  <% completionAttributionOptions.forEach((option) => { %>
                    <label class="checkbox-card">
                      <input
                        type="radio"
                        name="completedByUserId"
                        value="<%= option.userId %>"
                        <%= Number(selectedCompletedByUserId) === Number(option.userId) ? 'checked' : '' %>
                        required
                      />
                      <span>
                        <strong><%= option.name %></strong>
                        <small>
                          <% if (option.isAssignedUser) { %>
                            Currently assigned technician — preserve their completion and production credit.
                          <% } else { %>
                            Current user — record the completion and production credit under your own account.
                          <% } %>
                        </small>
                      </span>
                    </label>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <div class="form-actions">
              <button class="primary-button" type="submit">Confirm Unit Complete</button>
              <button type="button" class="secondary-button" data-modal-close>Cancel</button>
            </div>
          </form>
        <% } else { %>
          <div class="form-actions">
            <button type="button" class="primary-button" data-modal-close>Close</button>
          </div>
        <% } %>
      <% } %>
    </div>
  </section>
</div>
